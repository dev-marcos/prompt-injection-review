@INPROCEEDINGS{11594513,
  author={Hasan, Najmul and BusiReddyGari, Prashanth and Zhao, Haitao and Ren, Yihao and Xu, Jinsheng and Zhang, Shaohu},
  booktitle={2026 56th Annual IEEE International Conference on Dependable Systems and Networks Workshops (DSN-W)}, 
  title={LLM-PEA: Leveraging Large Language Models Against Phishing Email Attacks}, 
  year={2026},
  volume={},
  number={},
  pages={114-120},
  abstract={Large Language Models (LLMs) are increasingly deployed inside email-security pipelines, raising the question of how they behave not just on benign messages but on adversarially crafted phishing content. We present LLM-PEA, an evaluation framework that probes GPT-4o, Claude Sonnet 4, and Grok-3 under three prompting strategies (structured, zero-shot, chain-of-thought) across a clean baseline and three attack dimensions: adversarial rephrasing, prompt injection, and cross-lingual translation. The three models attain 95%, 94%, and 88% accuracy on the balanced baseline, but susceptibility depends on the attack. Adversarial rephrasing of 189 matched phishing samples yields attack success rates of 4.2% (GPT-4o), 12.7% (Claude Sonnet 4), and 0% (Grok-3); a separate single-template instruction-override on 1,000 original emails yields 4.2%, 1.3%, and 12.3% respectively—a different susceptibility ordering. Applying six injection templates to the same 189 rephrased samples yields 1.1%, 2.9%, and 1.6%, together with the adversarial-only results covering three of four cells of a 2×2 factorial on matched inputs. The sharpest degradation is cross-lingual: Claude Sonnet 4’s false-positive rate rises from 2.4% in English to a mean of 24.1% across Bangla, Chinese, and Hindi (a +904% relative increase), peaking at 30.6% in Bangla and erasing its baseline advantage. All runs use temperature 0; adversarial rephrases are generated by GPT-4o, itself one of the evaluated detectors. No single model is uniformly robust across these three attack dimensions.},
  keywords={Electronic mail;Modeling;Phishing;Multilingual;Signal detection;Large language models;Printing;Generative Pre-trained transformer;Poles and zeros;Conferences;Phishing email attack;LLM;prompt injection},
  doi={10.1109/DSN-W70714.2026.00038},
  ISSN={2325-6664},
  month={June},}

@INPROCEEDINGS{11593451,
  author={Li, Yakai and Hu, Jiekang and Sang, Weiduan and Ma, Luping and Nie, Dongsheng and Zhang, Weijuan and Yu, Aimin and Su, Yi and Huang, Qingjia and Zhou, Qihang},
  booktitle={2026 56th Annual IEEE International Conference on Dependable Systems and Networks (DSN)}, 
  title={Bypassing Safety Alignment via API Design: A Systematic Risk Analysis of Response Prefill in LLM Systems}, 
  year={2026},
  volume={},
  number={},
  pages={485-497},
  abstract={Response prefill, an API feature for tasks such as structured output and continuation, exposes an unintended attack surface in large language model systems. This paper presents a cross-platform risk analysis of prefill-level jailbreaks, where attackers manipulate the initial generation state to bypass safety alignment. Unlike prompt-based attacks that rely on semantic persuasion, prefill enables direct state manipulation by injecting content into the response position before generation. We identify seven attack categories exploiting distinct behavioral and procedural vulnerabilities and implement both static template and adaptive optimization strategies. Evaluation across 14 models from 8 providers shows that adaptive strategies achieve attack success rates exceeding 99% and can amplify existing jailbreak methods by 10–15 percentage points. Token-level probability analysis reveals that prefill shifts the distribution from refusal to compliance at the initial generation phase, overwriting the model’s safety state. We demonstrate that standard input filters fail due to the semantic dependency between prompt and prefill, where harmless prefill content becomes harmful only when combined with malicious prompts. Defense evaluation shows that effective mitigation requires analyzing the joint relationship between API inputs rather than filtering components individually. We conclude that the prefill API feature can compromise safety alignment.},
  keywords={Modeling;Large language models;Safety;Printing;Waste materials;Optimization;Equations;Probability;Application programming interfaces;Generative Pre-trained transformer},
  doi={10.1109/DSN69566.2026.00054},
  ISSN={2158-3927},
  month={June},}

@INPROCEEDINGS{11593453,
  author={Malladi, Gayatri and Thamilarasu, Geethapriya},
  booktitle={2026 56th Annual IEEE International Conference on Dependable Systems and Networks (DSN)}, 
  title={RIPE-II: Retrieval In-Place Poisoning Evaluation with Indirect Injections}, 
  year={2026},
  volume={},
  number={},
  pages={800-812},
  abstract={Retrieval Augmented Generation (RAG) systems have enhanced the performance of Large Language Models (LLMs) by effectively addressing challenges such as hallucinations and generating irrelevant responses. However, integrating the RAG technique into LLMs introduces privacy risks and potential data leakage issues from the retrieval pipeline. Indirect Prompt Injections (IPIs) occur when hidden instructions inside retrieved documents slip into a model’s context as trusted evidence, exploiting weak guardrails in RAG systems and leading to unauthorized data leaks, ambiguous outcomes, and policy overrides. Existing defenses rely on brittle delimiter heuristics or limited retriever adjustments, leaving RAG systems vulnerable to adversarial directives blended seamlessly into retrieved content.In this paper, we present RIPE-II, a corpus-level benchmark that evaluates IPIs under a realistic content-poisoning threat model. RIPE-II constructs delimiter-free, position-aware poisoned corpora across multiple domains and includes both textual and visual injections. Our design explicitly models mid-document placement, chunking, truncation, and cross-component propagation, reflecting how enterprise RAG systems ingest and process content. We introduce a two-stage evaluation framework that separates retrieval exposure from generation-time compliance and distinguishes embedding-based similarity from semantic override using a calibrated LLM-based judge. Across biomedical, financial, scientific, open-domain question answering, including multi-hop reasoning and web passage retrieval settings, we find that poisoned documents can reach the final model context in up to 97% of queries and rank first in up to 94% of cases, showing that retriever and reranker choices substantially shape RAG security exposure. We further show that cosine-based attack scoring can underreport semantic compromise by more than 5×, demonstrating that lexical or embedding similarity alone is insufficient for evaluating indirect prompt injection risk.},
  keywords={Modeling;Toxicology;Ranking (statistics);Retrieval augmented generation;Erbium;Automatic speech recognition;Printing;Context;Optical character recognition;Large language models;Retrieval-Augmented Generation;Indirect Prompt Injections;Adversarial Retrieval;Multimodal Attacks},
  doi={10.1109/DSN69566.2026.00078},
  ISSN={2158-3927},
  month={June},}

@INPROCEEDINGS{11583634,
  author={Bajaria, Samikshaa and Arya, Yash and Verma, Shreya and Bohat, Vijay Kumar and Singh, Jagendra},
  booktitle={2026 1st International Conference on AI, Data Science, Cyber Security and Smart Manufacturing for Sustainable Development (ICADCS)}, 
  title={Stacked Ensemble Learning Approach Enhanced LLM Safety Against Jailbreak Attacks}, 
  year={2026},
  volume={},
  number={},
  pages={1028-1033},
  abstract={Large Language models like GPT, Llama, and Gemini is prominent at understanding and processing natural language because they are trained on large amounts of text data. However, these models are inclined to security attacks, especially jailbreak attacks. These attacks include such prompts that push to apply the model to induce harmful content or rule-breaking consequences. Some of the methods, such as Supervised Fine-Tuning(SFT), Reinforcement Learning from Human Feedback (RLHF),and Direct Preference Optimisation (DPO) is used to enhance model safety. However, advanced attacks can bypass LLMs. These advanced attacks impact the internal working of the models and bypass their safety rules. Some defense techniques used to tackle distinct situations include prompt filtering, fine- tuning, and proxy monitoring. These techniques still fail to work against attackers who momentarily change their strategies. These findings show the vulnerabilities of LLMs and discuss the flaws of current defense methods. To tackle this issue, we propose a modern ensemble learning approach integrating transformer models and embedding techniques that make the system stronger and harder to attack. To enhance our analysis, we assembled a comprehensive dataset incorporating 55,218 prompts, including 17,029 benign prompts sourced from existing datasets and 38,189 synthetically generated jailbreak prompts. The dataset is developed as a hybrid corpus, combining real-world jailbreak prompts collected from research papers and existing studies, along with synthetically generated prompts built using a fine-tuned GPT model to closely spoof realistic jailbreak attack patterns. We have proposed a framework for the detection and analysis of prompt-based attacks in LLM by using artificial data, attack analysis, and to detect weaknesses and make the model safer.},
  keywords={Modeling;Equations;Transformers;Large language models;Signal detection;Tagging;Labeling;Printing;Safety;Accuracy},
  doi={10.1109/ICADCS70036.2026.11583634},
  ISSN={},
  month={May},}

@ARTICLE{11598769,
  author={Hossain, Elias and Nipu, Md. Mehedi Hasan Bhuiyan and Mahmood, Mohammad Sakib and Hossen, Md. Jakir and Mridha, M. F.},
  journal={IEEE Transactions on Systems, Man, and Cybernetics: Systems}, 
  title={Safe and Scalable Collaboration in Multiagent LLM Systems: A Comprehensive Review}, 
  year={2026},
  volume={56},
  number={10},
  pages={6139-6155},
  abstract={Large language model (LLM)-based multiagent systems are a rapidly evolving frontier of artificial intelligence that enables complex coordination, communication, and autonomous reasoning across distributed agents. This article presents a comprehensive review of multiagent LLM ecosystems, organized around four foundational pillars: coordination strategies, communication frameworks, safety challenges, and trust and alignment mechanisms. We synthesize a range of architectural approaches to agent interaction, including shared latent representations, strategic autonomy, task decomposition, and neuro-symbolic communication protocols. We then systematically examine the critical vulnerabilities distinctive to multiagent environments, namely prompt injection, perceptual adversarial attacks, reward misalignment, and operational overreach. To address these issues, we propose the trust stack: a multilayered trust framework spanning epistemic reliability, behavioral alignment, role awareness, social accountability, and institutional governance. Beyond synthesizing the literature, this review contributes a novel integrated perspective. It models the interdependencies among these four pillars, formalizes the trust stack as an operational framework with runtime-computable metrics, and derives design principles from a cross-system analysis of real multiagent deployment failures—contributions absent from prior surveys. We further investigate the prospects for superalignment through constitutional AI principles, multiagent value aggregation, and dynamic preference shaping. Collectively, this work establishes a theoretical and practical foundation for the secure, reliable, and dependable deployment of multiagent LLM systems and offers a roadmap for future research at the intersection of coordination, communication, and alignment.},
  keywords={Modeling;Large language models;Multi-agent systems;Safety;Artificial intelligence;Collaboration;Cognition;Cognitive systems;Learning (artificial intelligence);Stacking;Alignment and superalignment;cognitive security;communication protocols;coordination strategies;distributed reasoning;large language models (LLMs);multiagent systems;preference shaping;safety and robustness;trust stack},
  doi={10.1109/TSMC.2026.3704902},
  ISSN={2168-2232},
  month={Oct},}

