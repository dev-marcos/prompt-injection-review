@INPROCEEDINGS{11600455,
  author={Wei, Yu-Chih and Wu, Yu-Ren and Chen, Yen-Yun and Tsai, Chuan-Tse},
  booktitle={2026 IEEE International Conference on Software Testing, Verification and Validation Workshops (ICSTW)}, 
  title={A Fragment-Based Multilingual Jailbreak Testing Framework for Large Language Models with Implications for Healthcare Deployment}, 
  year={2026},
  volume={},
  number={},
  pages={270-278},
  abstract={Large language models (LLMs) have seen rapid adoption owing to their scale and emergent reasoning capabilities, however, they remain significantly vulnerable to jailbreak and prompt-injection attacks. This study conceptualizes multilingual "Do Anything Now" (DAN) style prompts as a form of structured prompt-space exploration and proposes a reproducible, fragment-based assessment framework for probing model robustness. At the core of this framework is a DAN-style multilingual dataset generator coupled with an automated test harness. This setup evaluates robustness within a minimal adversarial setting in which the model is instructed to output only a designated forbidden token. Accordingly, the forbidden-token task should be interpreted as a controlled proxy for jailbreak robustness, rather than as direct evidence of real-world clinical misuse risk. The dataset is constructed by composing prompt fragments to generate semantically equivalent but lexically diverse jailbreak variants across multiple languages. The evaluation framework categorizes responses into six distinct groups, enabling the precise differentiation and tracking of successful and failed cases. Empirical results demonstrate that multilingual variants broaden the attack coverage and expose language-specific vulnerabilities. We quantify robustness using Strict-ASR (exact-token attack success rate), Leak-ASR (token exposure rate), and Non-Refusal Rate (NRR), which captures the model’s propensity to provide a response rather than an explicit refusal. The main contributions of this study are a fragment-based multilingual prompt-generation framework, an automated evaluation pipeline integrating normalization, refusal detection, behavioral classification, and metric aggregation, and an empirical analysis showing that multilingual variants and stylistic decorators broaden coverage and reveal language-dependent jailbreak vulnerabilities. We further discuss how these observed failure modes may inform deployment risk assessment in sensitive domains such as healthcare.},
  keywords={Modeling;Multilingual;Automatic speech recognition;Large language models;Medical services;Labeling;Robustness;Testing;Printing;Safety;large language models;jailbreak;prompt injection;multilingual robustness;evaluation framework;healthcare deployment},
  doi={10.1109/ICSTW72326.2026.00052},
  ISSN={2159-4848},
  month={May},}

@INPROCEEDINGS{11599973,
  author={Manoj, Neha and S G, Deepak and Pranav, Turala and Rajeev, Devi},
  booktitle={2026 Fourth International Conference on Secure Cyber Computing and Communications (ICSCCC)}, 
  title={Ensemble Deep Learning for Robust Prompt Injection Detection in Banking LLMs}, 
  year={2026},
  volume={},
  number={},
  pages={1254-1259},
  abstract={The threat of prompt injection to banking Large Language Model (LLM) systems is severe, as it allows malicious instructions to be injected, potentially leading to information leakage or unauthorized operations. Current solutions are mostly rule-based or single-model solutions, which are vulnerable to paraphrasing and domain-specific language. In this paper, a domain-aligned transformer ensemble is proposed, which combines logits from BERT, RoBERTa, and DistilBERT models, with SHAP-based token explanations to facilitate auditability. The model is trained on a carefully selected banking dataset of 154,374 samples, and it achieves 86.93% accuracy, 99.98% recall, and an F1 score of 88.43%. The high recall value ensures that there are very few missed injections, and SHAP explanations facilitate compliance-driven analysis of model outputs. Code and processing scripts are provided for reproducibility.},
  keywords={Modeling;Printing;Banking;Signal detection;Transformers;Large language models;Bit error rate;Robustness;Training;Security;Prompt Injection;Large Language Models;Banking Security;Transformer Ensemble;SHAP Explainability;Adversarial Evaluation;Cybersecurity},
  doi={10.1109/ICSCCC69031.2026.11599973},
  ISSN={},
  month={May},}

@INPROCEEDINGS{11602220,
  author={Seth, Vani and Alla, Srikar and Rahman, Sd Md Abidar and Sichani, Ali Shiri and Calyam, Prasad},
  booktitle={2026 IEEE International Conference on Human-Machine Systems (ICHMS)}, 
  title={ALTR: Adaptive Defense Framework Against Adversarial LLM Threats in Critical-Domain Applications}, 
  year={2026},
  volume={},
  number={},
  pages={602-609},
  abstract={The fast deployment of large language models (LLMs) in critical-domain applications such as financial systems has introduced new types of security vulnerabilities (e.g., adversarial prompt injections, semantic obfuscation, and multi-stage social engineering attacks) that conventional countermeasures cannot typically handle. These vulnerabilities need to be detected through the natural language interface interactions, and relevant security policies need to be applied based on the context of the interactions. In this paper, we present a novel Adaptive LLM Threat Response (ALTR) framework, that supports trustworthy decision-making in LLM-enabled applications by integrating real-time behavioral anomaly detection with context-aware prompt validation to mitigate the risks of vulnerable LLMs. Specifically, we develop a Behavioral Anomaly Engine (BAE) that uses Isolation Forests to identify anomalies in user behavior during LLM interactions in financial systems. In addition, we develop a Context-Aware Prompt Classifier (CAPC) that employs DistilBERT and syntactic analysis to determine malicious inputs. To address the latency requirements in threat response, we create a Threat Response Memory (TRM) knowledge base that stores the aggregated behavioral and semantic risk signals from prior user sessions, and uses LSTM to perform longitudinal threat analysis to predict threat severity. We perform validation experiments using public datasets and a taxonomy of AI-based threats outlined in the Cisco AI Defense Capture-the-Flag (CTF) challenge. Our experiment results show the effectiveness of our ALTR approach by achieving an accuracy of 0.961, an AUC of 0.961, and a low false-negative rate of 0.9%, while maintaining an inference latency ($<\mathbf{2 0 m s}$) of across a range of LLM security vulnerabilities.},
  keywords={Modeling;Large language models;Security;Artificial intelligence;Timing;Memory;Printing;Computer security;Algorithms;Cognition;Human AI Decision Support;Adversarial LLM Prompt Attacks;Critical Application Security;Financial Systems},
  doi={10.1109/ICHMS69701.2026.11602220},
  ISSN={},
  month={July},}

@ARTICLE{11603946,
  author={Liu, Wenxiao and Liu, Zhiquan and Xu, Chong and Li, Chaozhuo and Guo, Jingjing and Ma, Jianfeng and Huang, Feiran},
  journal={IEEE Transactions on Dependable and Secure Computing}, 
  title={A Multi-Stage Adversarial Framework for Compact and Effective Jailbreaking of Large Language Models}, 
  year={2026},
  volume={23},
  number={5},
  pages={11326-11342},
  abstract={Large Language Models (LLMs) remain vulnerable to jailbreak attacks, yet many existing prompt-based methods rely on verbose and rigid attack templates that are costly to optimize, easy to detect, and less robust under token-budget or transfer settings. To address these limitations, we propose ComJail, a compression-aware adversarial framework for generating compact and effective jailbreak prompts. Instead of separating jailbreak generation from prompt compression, ComJail unifies them in a generator-discriminator joint optimization framework, where compactness is incorporated directly into the adversarial objective. The framework combines similarity-based contextual reconstruction with token-level and sentence-level compression, enabling concise prompts that preserve adversarial utility while reducing overt prompt artifacts. Experiments on AdvBench and JailbreakBench show that ComJail outperforms the compared baselines across both proprietary and open-source LLMs under automatic and human evaluation. On proprietary models, ComJail achieves 74% ASR on GPT-4 and 88% on Gemini-Pro. On open-source models, it remains effective on DeepSeek-V3, DeepSeek-R1, Vicuna-7B, and LLaMA2-13B. Further analyses demonstrate that ComJail maintains stronger performance under fixed token budgets, defense-aware settings, and source-to-target transfer scenarios while using substantially shorter prompts. These results suggest that prompt compactness is not merely an efficiency-oriented property, but a key factor in effective and practical jailbreak prompt design.},
  keywords={Modeling;Optimization;Large language models;Automatic speech recognition;Generative Pre-trained transformer;Generators;Educational institutions;Labeling;Glass box;Conferences;Compact jailbreaking;jailbreak attacks;LLM safety;large language models;prompt compression;prompt-based jailbreaking},
  doi={10.1109/TDSC.2026.3712350},
  ISSN={1941-0018},
  month={Sep.},}

