  number={},
  pages={1-1},
  abstract={With the integration of an additional modality, large vision-language models (LVLMs) exhibit greater vulnerability to safety risks (e.g., jailbreaking) compared to their language-only predecessors. Although recent studies have devoted considerable effort to the post-hoc alignment of LVLMs, the inner safety mechanisms remain largely unexplored. In this paper, we discover that activations of LVLM attention heads can pose significant linear separability of malicious and benign prompts. We hypothesize that the model’s inherent safety perception is governed by sparse attention heads, which we term “safety heads.” Further analysis reveals that these heads act as specialized shields against malicious prompts; ablating them leads to higher attack success rates, while the model’s utility remains unaffected, which further confirms our hypothesis. Beyond empirical evidence, we also conduct a semantic analysis showing that safety heads are capable of isolating and amplifying unsafe semantics in both image and text inputs, offering interpretable insights into their protective role. By locating these safety heads and concatenating their activations, we construct a straightforward but powerful malicious prompt detector that integrates seamlessly into the generation process with minimal extra inference overhead. Despite its simple structure of a logistic regression model, the detector surprisingly exhibits strong zero-shot generalization capabilities. Experiments across various prompt-based attacks in both image and video domains confirm the effectiveness of leveraging safety heads to protect LVLMs.},
  keywords={Modeling;Head;Safety;Training;Large language models;Probes;Accuracy;Detectors;Visualization;Videos;Large vision language model;safety;model interpretability;efficient model defense},
  doi={10.1109/TCSVT.2026.3710895},
  ISSN={1558-2205},
  month={},}

@ARTICLE{11599032,
  author={Ren, Zichu and Zhu, Donghai and Hong, Haibo and Shao, Jun},
  journal={IEEE Internet of Things Journal}, 
  title={IC-GCG: Jailbreaking Large Language Models via Intermediate Consistency Optimization}, 
  year={2026},
  volume={13},
  number={17},
  pages={39099-39111},
  abstract={Recent jailbreak attacks demonstrate that large language models (LLMs) can be manipulated to generate harmful outputs through adversarial prompts even after robust alignment. However, prevailing methods typically focus on forcing a desired response at the output layer—a surface-level strategy that is brittle and often fails to bypass the more fundamental safety checks embedded within the model’s internal mechanisms. In contrast, we propose intermediate consistency greedy coordinate gradient (IC-GCG), an approach that extends the GCG framework to explicitly target the model’s internal alignment mechanism. Our method forces a harmful prompt’s hidden representations to mimic those of a semantically related benign counterpart within critical middle layers. By adapting a greedy coordinate optimization strategy to craft an adversarial suffix that minimizes this representational distance, IC-GCG creates “semantic camouflag” that bypasses the model’s internal safety judgments. Experiments on several aligned LLMs indicate that IC-GCG substantially outperforms state-of-the-art baselines, increasing the average attack success rate to 94.3% and proving particularly effective against strongly aligned models such as LLAMA2-7B-CHAT, where it boosts success by over 56 percentage points. Furthermore, the resulting suffixes display superior transferability to other models. Ablation studies confirm that this high efficacy critically depends on a strong semantic link between the harmful and benign prompt pair, empirically validating that the integrity of intermediate representations is a crucial vulnerability and highlighting the need for a new class of defenses that operate directly on the model’s internal states.},
  keywords={Modeling;Optimization;Safety;Integrated circuits;Large language models;Glass box;Distance measurement;Generative Pre-trained transformer;Algorithms;Correlation;Consistency optimization;intermediate representations;jailbreak attacks;large language models (LLMs);prompt-based manipulation},
  doi={10.1109/JIOT.2026.3707160},
  ISSN={2327-4662},
  month={Sep.},}

@INPROCEEDINGS{11591723,
  author={Ahmad, Abrar and Naseer, Mehwish and Ahmad, Mahreen},
  booktitle={2026 5th International Conference on Computing, Mathematics and Engineering Technologies (iCoMET)}, 
  title={AB-JB (Jailbreaking): A Budgeted Hybrid Pipeline for Dataset-Scale Red-Teaming of 7B Aligned LLMs}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Aligned large language models (LLMs) can still be subverted through the jailbreaking, where inputs that actually bypass refusal behavior and elicit policy-violating responses. We present AB-JB, a budgeted hybrid red-teaming pipeline designed for dataset-scale stress testing of open-weight 7B instruction-tuned models under a fixed and a reproducible compute budget. AB-JB combines (i) black-box semantic variant generation to explore diverse paraphrases of each harmful behavior, (ii) the LLM based judge-guided scoring to prune weak candidates early, and (iii) a suffix-only optimization step performed in embedding space with ℓ2 regularization and per-iteration projection to valid tokens, which is capped at 22 iterations. We evaluate on four datasets, AdvBench, HarmBench, JailbreakBench, and Malicious-Instruct across five 7B targets (Llama2, Falcon, Vicuna, Mistral, and MPT) using JudgeLM for automated evaluation and scoring. AB-JB achieves consistently high dataset-level attack success (ASR-DS 92.0–94.6%) while per-variant success remains moderate (ASR-APV 54.0–59.3%), reflects the coverage-first trade-off. We compare AB-JB with representative jailbreak families and discuss the implications for reproducible safety evaluation in the modest lab settings.},
  keywords={Modeling;Optimization;Printing;Automatic speech recognition;Glass box;Large language models;Pipelines;Tuning;Media;Safety;LLM safety;jailbreaking;adversarial attacks;red teaming;hybrid attacks;black-box attacks;white-box attacks;LLMs},
  doi={10.1109/iCoMET69771.2026.11591723},
  ISSN={2996-1688},
  month={May},}

@INPROCEEDINGS{11591776,
  author={Siddiqui, Hania and Taj, Rizwan and Yasin, Qadeer and Shahid, Muhammad Sarfraz and Mehfooz, Saba and Bibi, Assma},
  booktitle={2026 5th International Conference on Computing, Mathematics and Engineering Technologies (iCoMET)}, 
  title={A Hybrid Neural Semantic Framework for Prompt Injection Detection in LLMs}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={Prompt injection attacks imply that they lead to a very severe risk to the dependability of Large Language Model (LLM) systems by allowing a user to control the behavior of the model using constructed inputs. This paper proposes a Hybrid-PI neural-semantic architecture to improve the detection of these attacks. Hybrid-PI with the DeepSet prompt-injection dataset uses a neural prompt encoder with a Semantic Consistency Oracle to jointly learn surface and higher-level semantic inconsistencies via a trade-off between the two. The experimental findings indicate that Hybrid-PI performs much better than the classical and transformer-based baselines, achieving 97.4% accuracy and 97.5% F1-score, with significantly reduced false positives. The robustness tests also indicate the ability to withstand paraphrase and obfuscation-based adversarial variations. The results suggest that Hybrid-PI is a viable and scalable approach to strengthening safety controls around LLMs against emerging threats such as prompt injection.},
  keywords={Modeling;Large language models;Accuracy;Equations;Signal detection;Training;Printing;Tagging;Conferences;Labeling;Prompt Injection Detection;Large Language Models (LLMs);Adversarial Attacks;Security for AI models;Hybrid Neural–Semantic Framework},
  doi={10.1109/iCoMET69771.2026.11591776},
  ISSN={2996-1688},
  month={May},}

@INPROCEEDINGS{11588474,
  author={S, Uthayashangar and A, Devesh and D, Hari Pragash and S, Dharshini and S, Yukthasri},
  booktitle={2026 International Conference on System, Computation, Automation and Networking (ICSCAN)}, 
  title={Forensic LLM-Trace: Interpretable Multi-Agent AI Forensic Architecture for Prompt Injection Investigation}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={The increasing deployment of autonomous Large Language Model agents in enterprise platforms, cloud services, and intelligent automation systems has introduced new cybersecurity challenges associated with prompt injection, unauthorized reasoning manipulation, and chained-agent compromise. Existing digital forensic methodologies are ineffective in reconstructing distributed AI-agent execution behavior because modern LLM ecosystems generate fragmented contextual traces, temporary reasoning states, and decentralized interaction logs. Current forensic systems primarily analyze static operating-system artifacts and network events, making them unsuitable for AI-native infrastructures. To address these limitations, this paper proposes Forensic LLM-Trace, an interpretable forensic architecture designed for hostile-operation reconstruction within multi-agent LLM ecosystems. The proposed approach integrates semantic artifact normalization, confidence-oriented attribution evaluation, graph-driven relationship reconstruction, and automated threat-intelligence reporting into a unified analytical pipeline. Neo4j-based interaction mapping is employed to visualize malicious prompt propagation between interconnected agents, APIs, and memory contexts. Additionally, transformer-assisted entity extraction improves contextual forensic interpretation by identifying hidden hostile instruction transitions embedded within communication chains. Experimental evaluation using simulated prompt-manipulation scenarios demonstrates improved timeline reconstruction precision, reduced false attribution, and enhanced forensic transparency compared with conventional log-oriented examination systems. The proposed architecture establishes a scalable investigative foundation for future AI-native digital forensic environments.},
  keywords={Forensics;Artificial intelligence;Architecture;Computer architecture;Cognition;Cognitive systems;Large language models;Printing;Ecosystems;Memory;LLM Forensics;Prompt Manipulation;AI-Agent Investigation;Digital Forensic Intelligence;Multi-Agent Security;Semantic Reconstruction;Threat Attribution;Graph-Based Analysis},
  doi={10.1109/ICSCAN66520.2026.11588474},
  ISSN={},
  month={June},}
