@INBOOK{11505495,
  author={Edwards, Jason},
  booktitle={Adversarial Machine Learning: Mechanisms, Vulnerabilities, and Strategies for Trustworthy AI}, 
  title={The Generative AI Attack Surface}, 
  year={2026},
  volume={},
  number={},
  pages={147-167},
  abstract={Summary <p>This chapter explores the unique and expanding attack surface of generative artificial intelligence (AI) systems, particularly large language models, highlighting how their architectural design introduces vulnerabilities distinct from traditional predictive models. By examining key components such as transformer attention mechanisms, token embeddings, autoregressive output patterns, and contextual conditioning, the chapter reveals how adversaries can exert influence without needing access to source code or system internals. The inherent flexibility and openness of generative outputs make these systems highly susceptible to manipulation through subtle prompt engineering, data poisoning, and internal activation triggers.</p> <p>The chapter also delves into the risks posed by retrieval&#x2010;augmented generation (RAG) systems, where external documents are dynamically incorporated into model context during inference. These integrations open the door to indirect prompt injection, corpus poisoning, and semantic redirection&#x2014;often without triggering visible model misbehavior during standard evaluations. Fine&#x2010;tuning, especially when performed with unvetted or third&#x2010;party data, is shown to be a powerful vector for embedding persistent backdoors and trigger&#x2010;based behaviors that evade traditional QA processes but remain reliably exploitable in production environments.</p> <p>For professionals securing AI applications, this chapter reframes the threat model around generative systems as a dynamic behavioral risk, not just a static software flaw. It emphasizes the importance of understanding internal model structures, context&#x2010;aware manipulation techniques, and adversarial testing that mirrors how attackers condition models across time, input structure, and retrieved data. With clear analysis and applied framing, this chapter equips readers to identify, evaluate, and begin defending against the behavioral exploits that define modern generative AI threats.</p>},
  keywords={Payloads;Feeds;Filtering;Filters;Circuits and systems;Circuits;Feedback;MIMICs;Millimeter wave integrated circuits;Monolithic integrated circuits},
  doi={10.1002/9781394402069.ch8},
  ISSN={},
  publisher={Wiley},
  isbn={9781394402052},
  url={https://ieeexplore.ieee.org/document/11505495},}

@INBOOK{11505604,
  author={Edwards, Jason},
  booktitle={Adversarial Machine Learning: Mechanisms, Vulnerabilities, and Strategies for Trustworthy AI}, 
  title={Anatomy of AI Systems and Their Attack Surfaces}, 
  year={2026},
  volume={},
  number={},
  pages={21-38},
  abstract={Summary <p>As artificial intelligence (AI) systems move from research labs into production environments, they introduce fundamentally different architectures and operational behaviors that redefine what it means to secure software. This chapter explores the structural distinctions between predictive, generative, and agentic AI, explaining how their internal mechanisms shape risk exposure, attack surfaces, and defensive priorities. From supervised models optimized for speed and accuracy to large language models capable of generating text and executing tools, each architecture comes with unique adversarial challenges&#x2014;ranging from input manipulation to autonomous decision hijacking.</p> <p>The chapter also walks through the AI development lifecycle, from data ingestion to post&#x2010;deployment monitoring, revealing how vulnerabilities can be introduced at each phase. It emphasizes the importance of recognizing adversarial entry points&#x2014;not just in APIs or user prompts, but in training data, model fine&#x2010;tuning, and third&#x2010;party integrations. Readers gain practical insight into how attacks like model poisoning, prompt injection, and supply chain compromise exploit architectural and process&#x2010;level blind spots.</p> <p>Crucially, this chapter introduces the concept of security debt&#x2014;accumulated risk resulting from rushed development, lack of robustness testing, or weak observability. It shows how ignoring security early in the lifecycle compounds risk downstream, often surfacing only during high&#x2010;stakes deployment. By combining architectural literacy with lifecycle threat awareness, this chapter equips cybersecurity professionals to proactively assess and defend AI systems before adversaries do.</p>},
  keywords={Telemetry;Aerospace and electronic systems;Weapons;Feeds;Filtering;Feedback;Filters;Circuits;Memory modules;Circuits and systems},
  doi={10.1002/9781394402069.ch2},
  ISSN={},
  publisher={Wiley},
  isbn={9781394402052},
  url={https://ieeexplore.ieee.org/document/11505604},}

@INPROCEEDINGS{11493291,
  author={R, Likitha and D C, Dhanyashree and H R, Lavanya and Preeti},
  booktitle={2026 International Conference on Emerging Smart Computing and Informatics (ESCI)}, 
  title={AI Prompt Injection Attack Tester}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models are widely integrated into chatbots, enterprise applications, and automation systems. However, these systems are vulnerable to prompt injection attacks - malicious instructions embedded in text, files, images, or translated content, attempting to override system rules. This paper presents the design and implementation of the AI Prompt Injection Attack Tester: a multi-modal system for detecting and mitigating Prompt Injection attempts against Large Language Models. While the ubiquitous deployment of LLMs has introduced a critical security vulnerability, where untrusted user input hijacks the model’s policy and system prompt, we introduce the following concept: a Heuristic-Based Prompt Injection Detection Engine integrated into a pre-processing guardrail layer. The PIDE applies a specialized ruleset, which includes instruction-overriding pattern matching and sensitive keyword identification, to incoming data for a risk score. Importantly, the system normalizes and scans inputs from four different modalities: direct text, embedded code comments/literals, image text via OCR, and text that has been processed through a mock translation service. On detection, a Mitigation Pipeline applies sequential steps of sanitization, instruction stripping, and policy-based blocking prior to any input reaching the LLM. As confirmed within a safe, mock environment for LLMs, experimental results validate that this approach provides both successful detection and neutralization of malicious instructions across all types of input tested in this work. This paper confirms that a robust, multi-modal pre-processing policy layer is required as an integral component of a broad defense-in-depth strategy against sophisticated Prompt Injection attacks.},
  keywords={Feedback;Filtering;Circuits;Filters;Graphical user interfaces;Product development;Internet;Bot (Internet);Protocols;Communication systems;Prompt Injection;LLM Security;OCR;AI Safety;Streamlit;Multi-Modal Detection},
  doi={10.1109/ESCI68015.2026.11493291},
  ISSN={2996-1815},
  month={March},}

@INPROCEEDINGS{11462306,
  author={Sun, Mengjie and Zheng, Yaowen and Lv, Shichao and Li, Zhi and Liu, Kaixiang and Wang, Yuncheng and Chen, Yongle and Sun, Limin},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={A Malicious Policy Detection Approach Enhanced by Threat Knowledge in LLM-Based Embodied Robots}, 
  year={2026},
  volume={},
  number={},
  pages={20072-20076},
  abstract={Integrating Large Language Models (LLMs) into robot systems enables natural language task planning but also raises safety risks, e.g., jailbreak attacks. Existing LLM safety alignment efforts primarily address textual harms, while insufficiently covering physical risks from malicious task planning. Moreover, current defenses against embodied robots lack interpretability and generalization to diverse, real-world attack scenarios. To address these challenges, we propose a novel threat knowledge-enhanced approach for malicious policy detection. Our method builds a structured knowledge base of known malicious behaviors by standardizing multi-format sub-task policies into unified semantic representations. During inference, we retrieve relevant malicious cases and leverage chain-of-thought reasoning for analogy-based semantic analysis. Experiments demonstrate that our approach effectively detects malicious behaviors and generalizes well across tasks. It reduces attack success rates to an average of 2.67% on SafeAgentBench and 2.30% on BadRobot benchmarks, while maintaining high clean task performance of 76.04% on SafeAgentBench.},
  keywords={Protocols;HTTP;Radio access networks;Regional area networks;Artificial intelligence;Cognitive systems;Large language models;Retrieval augmented generation;Generative Pre-trained transformer;Logic;Embodied Robots;Attack Detection},
  doi={10.1109/ICASSP55912.2026.11462306},
  ISSN={2379-190X},
  month={May},}

@INPROCEEDINGS{11463457,
  author={Yang, Xikang and Tang, Xuehai and Han, Jizhong and Hu, Songlin},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={DarkCite: Unveiling Authority Bias as Implicit Rag Jailbreak Attacks}, 
  year={2026},
  volume={},
  number={},
  pages={13402-13406},
  abstract={This paper reveals a critical and underexplored vulnerability in the safety alignment of Large Language Models (LLMs): an inherent bias toward authoritative information. We demonstrate that this authority bias can be exploited to bypass safety filters, transforming a beneficial model feature into a significant flaw. We hypothesize and show that this attack vector functions as a form of Implicit Retrieval-Augmented Generation (RAG), where a fabricated citation prompts the model to internally retrieve and surface harmful knowledge, bypassing typical safeguards. To systematize this exploit, we introduce DarkCite, a black-box jailbreak framework that adaptively matches risk types with optimal citation styles to generate potent adversarial prompts. Our experiments show DarkCite achieves a state-of-the-art Attack Success Rate (ASR), reaching 63% on average and outperforming prior methods across a range of models. To address this, we propose a practical defense based on authenticity and harm verification, which elevates the average Defense Pass Rate (DPR) from a mere 11% to 74%. Our code is available at https://github.com/YancyKahn/DarkCite},
  keywords={Weapons;Feeds;Filtering;Filters;Feedback;Circuits;Circuits and systems;Protocols;HTTP;Internet;Jailbreak;LLM Safety;Cognitive Bias},
  doi={10.1109/ICASSP55912.2026.11463457},
  ISSN={2379-190X},
  month={May},}

@INPROCEEDINGS{11463087,
  author={Liu, Huan and Sun, Xiaoshan and Zhang, Yingjun and Zhang, Yang},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={JAILFUZZ: A Zero-Knowledge and State Feedback Based Gray-Box Fuzzing Framework for Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={3311-3315},
  abstract={The security of Large Language Models (LLMs) is a critical issue in their practical deployment. Current safety alignment relies primarily on fine-tuning to achieve human-aligned behavior. However, recent jailbreak attacks have revealed limitations in these alignment techniques. Similarly to software security issues, automated testing through fuzzing can be applied to LLMs to uncover potential vulnerabilities. Existing jailbreaking fuzzing approaches largely depend on known attack patterns, which often fail to expose deeper security flaws. In this context, we introduce JAILFUZZ, a grey-box fuzzing framework that performs fuzz testing entirely guided by the model’s inner state feedback, without requiring any prior knowledge of jailbreak techniques. Experiments on multiple open-source models show that our approach not only generates successful jailbreak samples more efficiently but also discovers a wider variety of jailbreak strategies. Moreover, our state-guided methodology can provide actionable insights for mitigating corresponding vulnerabilities, thereby contributing to improved model security.},
  keywords={Feedback;Circuits;Cyberspace;Protocols;Communication networks;Computer networks;HTTP;Radio access networks;Regional area networks;Large language models;Large Language Model;Artificial Intelligence Security;Jailbreak Vulnerability;Fuzzing},
  doi={10.1109/ICASSP55912.2026.11463087},
  ISSN={2379-190X},
  month={May},}

@INPROCEEDINGS{11464668,
  author={Li, Xiaolong and Lao, Mingrui and Du, Chengsi and Bai, Liang and Guo, Yanming},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={CAS-J: Cross-Modal Attention Synergy for Jailbreaking Large Vision-Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={13907-13911},
  abstract={Large Visual-Language Models (LVLMs) have demonstrated outstanding performance across various multimodal tasks, but their security remains vulnerable to jailbreak attacks. Most current adversarial attacks are restricted to unimodal perturbations, and although several recent methods attempt to integrate text and visual modalities to enhance attack effectiveness, they still rely on output layer signals, overlooking the critical role of internal attention interactions designed to circumvent security constraints. To address the aforementioned limitation, we propose the Cross-Modal Attention Synergy Jailbreaking (CAS-J) framework, which manipulates the attention scores of the target model to finely adjust the internal fusion of information across modalities, strengthening the focus on key adversarial elements for images and suffixes while suppressing the sensitivity of the target model to harmful inputs. Our experimental results demonstrate that CAS-J improves the attack success rate across multiple benchmarks and exhibits high interpretability.},
  keywords={Protocols;HTTP;Local area networks;Communication systems;Fuses;Electronic components;Large language models;Vision language model;Artificial intelligence;Attention mechanisms;Multimodal Jailbreak;White-box Jailbreak;Adversarial Examples},
  doi={10.1109/ICASSP55912.2026.11464668},
  ISSN={2379-190X},
  month={May},}

@INPROCEEDINGS{11464275,
  author={Wakai, Yuki and Ito, Kunihiro and Kashima, Hisashi},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Robust In-context Defenses Against Jailbreaking of LLMs via Role Specification}, 
  year={2026},
  volume={},
  number={},
  pages={14037-14041},
  abstract={Although large language models (LLMs) are widely deployed in society, "jailbreaks" have raised serious security concerns. They use prompts to circumvent the safety alignment of LLMs and induce inappropriate outputs. As jailbreak strategies are rapidly evolving, it is difficult to cover them through additional training. In-context defenses aim to prevent jailbreak by adding texts describing expected behavior to prompts, but such texts can degrade responses to benign inputs (e.g., excessive refusals). We propose "Role Specification," an in-context defense that clarifies prompt structure and prioritizes objectives. The experiment showed that our method improves defense by 1.4×–5× and response quality by 1.1×–1.4×. Furthermore, when applied in combination with existing approaches, it yields up to 6.6× gains in defense and 1.6× in quality.},
  keywords={Nuclear weapons;Weapons;Protocols;HTTP;Artificial intelligence;Large language models;Learning (artificial intelligence);Conversational artificial intelligence;Machine learning;Computational and artificial intelligence;Large Language Model;AI safety;Responsible AI;Jailbreak Attack;In-context Defense},
  doi={10.1109/ICASSP55912.2026.11464275},
  ISSN={2379-190X},
  month={May},}

@INPROCEEDINGS{11463331,
  author={Pan, Yu and Yu, Wenlong and Wu, Tiejun and Ye, Xiaohu and Si, Qiannan and Xu, Guangquan and Wu, Bin},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={SFCoT: Safer Chain-Of-Thought via Active Safety Evaluation and Calibration}, 
  year={2026},
  volume={},
  number={},
  pages={19837-19841},
  abstract={Large language models (LLMs) have demonstrated remarkable capabilities in complex reasoning tasks. However, they remain highly susceptible to jailbreak attacks that undermine their safety alignment. Existing defense mechanisms typically rely on post hoc filtering applied only to the final output, leaving intermediate reasoning steps unmonitored and vulnerable to adversarial manipulation. To address this gap, this paper proposes a SaFer Chain-of-Thought (SF-CoT) framework, which proactively evaluates and calibrates potentially unsafe reasoning steps in real time. SFCoT incorporates a three-tier safety scoring system alongside a multi-perspective consistency verification mechanism, designed to detect potential risks throughout the reasoning process. A dynamic intervention module subsequently performs targeted calibration to redirect reasoning trajectories toward safe outcomes. Experimental results demonstrate that SFCoT reduces the attack success rate from 58.97% to 12.31%, demonstrating it as an effective and efficient LLM safety enhancement method without a significant decline in general performance.},
  keywords={Filtering;Filters;Circuits;Circuits and systems;Feedback;Protocols;HTTP;Cognitive systems;Large language models;Artificial intelligence;Large language model;Safety;Chain-of-Thought},
  doi={10.1109/ICASSP55912.2026.11463331},
  ISSN={2379-190X},
  month={May},}

@INPROCEEDINGS{11464814,
  author={Li, Yuhong and Zhang, Jiabao and Chen, Yan and Zhao, Zhihui and Wang, Jianhua},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Audio-Text Jailbreak Attack on Large Audio-Language Models: Towards Generality and Stealthiness}, 
  year={2026},
  volume={},
  number={},
  pages={13592-13596},
  abstract={In recent years, research on jailbreak attacks targeting large audio-language models (LALMs) has gained increasing attention. However, existing studies have predominantly focused on single-modality attacks, with limited exploration of multimodal attack strategies. Moreover, current attack methods offer limited generalization and stealth capabilities for audio-based attacks. In this paper, to the best of our knowledge, we are the first to propose a multimodal Jailbreak, namely Audio-Text Jailbreak, against LALMs. The Audio-Text Jailbreak jointly optimize slightly adversarial audio perturbations and malicious text suffixes to induce highly harmful affirmative responses. Additionally, by designing attacks that enhance the stealth and generalization of the audio component, our method achieves a more powerful effect. Our Audio-Text Jailbreak achieves attack success rates of 91.00% on Qwen2-Audio and 92.73% on Qwen2.5-Omni, demonstrating the substantial security risk posed by cross-modal interactions. Code is available at https://github.com/SKLIISAIS/AudioTextJailbreak.},
  keywords={Nuclear weapons;Weapons;Feeds;Protocols;Internet;HTTP;Internet security;Large language models;Artificial intelligence;Machine learning;Jailbreak Attacks;Multimodal Large Language Models},
  doi={10.1109/ICASSP55912.2026.11464814},
  ISSN={2379-190X},
  month={May},}

@INPROCEEDINGS{11462247,
  author={Yang, Shuangning and Yang, Haoran and Zhao, Guoli and Zhou, Mengting and Tai, Jianwei and Jia, Xiaoqi},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={What is the risk? Evaluating the impact of knowledge distillation on LLM vulnerabilities}, 
  year={2026},
  volume={},
  number={},
  pages={14177-14181},
  abstract={Knowledge distillation has significantly accelerated the development of efficient language models. With the rapid proliferation of these methods in the open-source communities, a systematic evaluation of their implications for model security is urgently needed. To quantify the security risks introduced by various distillation methods, we propose a general and extensible evaluation framework that reflects complex, real-world distillation workflows. Additionally, we analyze the impact of the distillation process on models’ tendencies toward harmful behavior by extending JailbreakBench with a harm-level dataset comprising 10 malicious query categories. Our results demonstrate that knowledge distillation significantly increases model vulnerability, and joint learning of the two primary forms of knowledge further exacerbates this risk. Furthermore, our analysis reveals different effects across harmful query categories, with the risk levels of discrimination and economic harm showing significant increases that warrant particular attention.},
  keywords={Feedback;Circuits;Protocols;Communication systems;HTTP;Computer networks;Internet;Radio access networks;Regional area networks;Pins;Knowledge distillation;Jailbreak attack;Harmful behavior;Model security},
  doi={10.1109/ICASSP55912.2026.11462247},
  ISSN={2379-190X},
  month={May},}

@INPROCEEDINGS{11463981,
  author={Zhou, Yi and Xing, Wenpeng and Lin, Changting and Kong, Dezhang and Hu, Chunqiang and Han, Meng},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Parameter Localization and Relearning for Safety Disalignment in Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={3461-3465},
  abstract={Large language models (LLMs) excel in natural language generation but remain susceptible to malicious prompts that can elicit harmful outputs. To address this, alignment techniques such as reinforcement learning from human feedback (RLHF), instruction tuning, and adversarial training are employed to enforce safety constraints. However, recent studies reveal vulnerabilities to white-box and black-box attacks that undermine these safeguards. This paper introduces a novel, interpretable jailbreak framework for LLMs, comprising three key steps: (i) activating safety-related parameters by inputting pre-processed harmful and harmless prompts; (ii) identifying critical safety-constraint parameters using gradient-driven conditional localization combined with similarity-based neuron recognition; and (iii) relearning selected parameters with a weighted cross-entropy loss to restore the model’s ability to generate previously restricted responses. Experiments on mainstream models, including Llama2, Qwen2.5, DeepSeek, and Mistral, demonstrate a 100% Attack Success Rate (ASR), surpassing existing fine-tuning-based white-box attacks while minimally impacting overall model performance. Our approach achieves jailbreaks by updating only a small fraction of parameters, offering high interpretability and transferability across diverse LLM architectures. While aimed at advancing safety research, we acknowledge the potential misuse of open-source LLMs and advocate for strengthened safety strategies to foster a secure AI ecosystem.},
  keywords={Feeds;Antennas;Feedback;Circuits;LoRa;Location awareness;Mobile communication;Protocols;Data communication;HTTP;LLM Safety Disalignment;White-box Jailbreak Attack;Parameter Localization;Parameter Relearning},
  doi={10.1109/ICASSP55912.2026.11463981},
  ISSN={2379-190X},
  month={May},}

@INPROCEEDINGS{11462407,
  author={Liu, Jiani and He, Yixin and Fan, Lanlan and Zhong, Qidi and Cheng, Yushi and Zhang, Meng and Chen, Yanjiao and Xu, Wenyuan},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={PINA: Prompt Injection Attack Against Navigation Agents}, 
  year={2026},
  volume={},
  number={},
  pages={13897-13901},
  abstract={Navigation agents powered by large language models (LLMs) convert natural language instructions into executable plans and actions. Compared to text-based applications, their security is far more critical: a successful prompt injection attack does not just alter outputs but can directly misguide physical navigation, leading to unsafe routes, mission failure, or real-world harm. Despite this high-stakes setting, the vulnerability of navigation agents to prompt injection remains largely unexplored. In this paper, we propose PINA, an adaptive prompt optimization framework tailored to navigation agents under black-box, long-context, and action-executable constraints. Experiments on indoor and outdoor navigation agents show that PINA achieves high attack success rates with an average ASR of 87.5%, surpasses all baselines, and remains robust under ablation and adaptive-attack conditions. This work provides the first systematic investigation of prompt injection attacks in navigation and highlights their urgent security implications for embodied LLM agents.},
  keywords={Feedback;Circuits;Protocols;HTTP;Artificial intelligence;Generative Pre-trained transformer;Large language models;Conversational artificial intelligence;Chatbots;Cognitive systems;Prompt Injection Attack;LLM Agents},
  doi={10.1109/ICASSP55912.2026.11462407},
  ISSN={2379-190X},
  month={May},}

@INPROCEEDINGS{11463282,
  author={Liu, Yu and Chen, Ping},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={PromptPatch: Towards Precise and Stable Behavioral Patching in Large Language Models via Feedback-Driven Prompt Optimization}, 
  year={2026},
  volume={},
  number={},
  pages={14322-14326},
  abstract={The security and reliability of Large Language Model (LLM) applications are fundamentally dependent on the robustness of their system prompts. However, these prompts are often susceptible to adversarial attacks like prompt injection, leading to unpredictable and harmful model behavior. Existing defenses typically focus on runtime input filtering or model-level retraining, which can be costly and imprecise. In this work, we introduce PromptPatch, a novel framework that treats the system prompt as a software artifact and applies a feedback-driven optimization process to automatically discover and repair security vulnerabilities. Our methodology employs a "Critic-Repairer" architecture, where a Critic LLM performs a semantic security audit, and a Repairer LLM generates precise, surgical patches to harden the prompt. This offline, design-time approach aims to create intrinsically robust system prompts, enhancing behavioral stability at the source. We conduct a rigorous evaluation across five modern LLMs, demonstrating that PromptPatch dramatically reduces the average Attack Success Rate (ASR) from as high as 41.67% to as low as 0.00% on several models, while maintaining high functional integrity. Our analysis also reveals the varying efficacy of prompt hardening across different model architectures, highlighting the challenge of "one-size-fits-all" defenses and suggesting a need for model-aware repair strategies.},
  keywords={Feedback;Filtering;Circuits;Filters;Circuits and systems;Protocols;HTTP;Pins;Artificial intelligence;Large language models;Large Language Models;Prompt Injection;System Prompt Hardening;AI Safety},
  doi={10.1109/ICASSP55912.2026.11463282},
  ISSN={2379-190X},
  month={May},}
