  title={Evaluating Robustness and Generalization in LLMs under Adversarial and Real-World Conditions}, 
  year={2026},
  volume={},
  number={},
  pages={341-349},
  abstract={In this paper, we present a comprehensive survey on the robustness and generalization of large language models (LLMs) under adversarial and real-world conditions, covering research published between 2020 and 2025. The survey systematically analyzes adversarial vulnerabilities, including prompt injection attacks and word level perturbations, and examines the extent to which LLMs can generalize effectively across diverse domains and unseen tasks. Evaluation frameworks such as CheckList, TextAttack, and Robustness Gym are thoroughly reviewed, along with adversarial robustness benchmarks including ANLI, AdvGLUE, and datasets produced through the Dynabench platform. Additionally, key metrics used to measure model robustness and generalization—such as adversarial accuracy, robustness degradation, and performance consistency are critically evaluated.The robustness characteristics of state-of-the-art models, including GPT-4, Claude, and LLaMA, are compared and synthesized, highlighting their strengths and vulnerabilities in adversarial scenarios and under distribution shifts. Despite significant advancements, the findings indicate persistent vulnerabilities across all models under targeted adversarial attacks or domain variation. Furthermore, the paper reviews and assesses robustness improvement techniques, including adversarial training, data augmentation strategies, instruction tuning, and constitutional AI, identifying their effectiveness as well as limitations. Ultimately, this survey emphasizes the necessity for comprehensive robustness evaluations that reflect diverse adversarial and practical stressors, underscoring the critical role of robust language models for safe and reliable real-world deployments.},
  keywords={Surveys;Measurement;Perturbation methods;Large language models;Benchmark testing;Robustness;Natural language processing;Safety;Tuning;Standards;Large Language Models;Natural Language Processing;Transformers;Deep Learning},
  doi={10.1109/BigComp68355.2026.00058},
  ISSN={2375-9356},
  month={Feb},}

@INPROCEEDINGS{11397027,
  author={Gil, SangHyeon and Kim, JaeSeong and Lee, Suan},
  booktitle={2026 IEEE International Conference on Big Data and Smart Computing (BigComp)}, 
  title={Analyzing LLM Safety Circumvention via Multilingual Euphemistic Coating}, 
  year={2026},
  volume={},
  number={},
  pages={261-264},
  abstract={In this paper, we systematically analyze how euphemistic coating in multilingual settings can enable jailbreaks that bypass the safety mechanisms of large language models (LLMs). To this end, we translate AdvBench, a benchmark designed to assess compliance with harmful requests, into seven high-internet-usage non-English languages using GPT-4o. We then apply an embedding-based cosine similarity filter (≥ 0.8) to improve translation fidelity and retain only high-quality pairs, from which we construct two prompt variants: a Non-Coating version that is a direct translation of the original, and a Coating version expressed euphemistically. This process leaves 372 out of the original 512 AdvBench items as a balanced subset and provides a quantitative signal regarding translation directionality and quality.We evaluate six open models (including Llama-3.1-8B-Instruct, Qwen2.5-7B-Instruct, and OpenR1-Qwen-7B) across eight languages, including English, and use Attack Success Rate (ASR) as our primary metric. Judgments follow the JailbreakBench framework, with GPT-4 serving as the judging model, and the decoding temperature is fixed to 0 for reproducibility.Empirically, when averaging over all model-language combinations, ASR in the Non-Coating condition is higher than in the Coating condition, indicating that euphemistic phrasing tends to lower attack success rates on average. However, for certain model-language pairs such as Korean with Llama-3.1-8B-Instruct and Japanese with Qwen2.5-7B-Instruct, we observe a "rebound" effect in which ASR increases after coating, suggesting that English-centric keyword and heuristic filtering can be vulnerable to euphemistic expressions. At the language level, English exhibits the highest ASR (85.5% Non-Coating, 50.9% Coating), while Japanese shows the lowest (38.8% Non-Coating, 19.5% Coating). At the model level, OpenR1-Qwen-7B is the most robust (39.7% Non-Coating, 11.9% Coating), whereas Llama-3.1-8B-Instruct records the highest ASR in both conditions (79.3%).The proposed benchmark enables realistic quantification of the defensive limits of LLMs in multilingual euphemistic contexts and highlights the need for semantic-centric multilingual safety tuning and evaluation frameworks.},
  keywords={Training;Translation;Stochastic processes;Benchmark testing;Multilingual;Safety;Decoding;Coatings;Surface treatment;Tuning;Jailbreak;Multilingual;Benchmark;Euphemistic Coating;AdvBench Multilingual Extension},
  doi={10.1109/BigComp68355.2026.00047},
  ISSN={2375-9356},
  month={Feb},}

@ARTICLE{11405858,
  author={Shao, Yangguang and Yu, Jiahao and Miao, Hanwen and Gou, Gaopeng and Li, Zhen and Shi, Junzheng},
  journal={IEEE Transactions on Information Forensics and Security}, 
  title={PromptFuzz: Harnessing Fuzzing Techniques for Robust Testing of Prompt Injection in LLMs}, 
  year={2026},
  volume={21},
  number={},
  pages={2727-2741},
  abstract={Large Language Models (LLMs) have gained widespread use in various applications due to their powerful capability to generate human-like text. However, prompt injection attacks, which involve overwriting a model’s original instructions with malicious prompts to manipulate the generated text, have raised significant concerns about the security and reliability of LLMs. In this paper, we propose PromptFuzz, a novel testing framework that leverages fuzzing techniques to systematically assess the robustness of LLMs against prompt injection attacks. Inspired by software fuzzing, PromptFuzz selects promising seed prompts and generates a diverse set of prompt injections to evaluate the target LLM’s resilience. PromptFuzz operates in two stages: the prepare phase, which involves selecting promising initial seeds and collecting few-shot examples, and the focus phase, which uses the collected examples to generate diverse, high-quality prompt injections. By deploying the generated attack prompts from PromptFuzz in a real-world competition, we achieved the 7th ranking out of over 4000 participants (top 0.14%) within 2 hours, demonstrating PromptFuzz’s effectiveness compared to experienced human attackers. Additionally, we also deploy the generated attack prompts on 50 popular LLM-integrated online applications, including those from Coze and OpenAI, and found that 92% of them can be exploited by PromptFuzz. We also run PromptFuzz on 15 online LLM-based resume judging applications and found that 13 of these applications’ responses can be hijacked by PromptFuzz.},
  keywords={Fuzzing;Robustness;Security;Testing;Closed box;Manuals;Large language models;Transformers;Resumes;Natural language processing;Prompt injection;fuzzing;large language model;red teaming},
  doi={10.1109/TIFS.2026.3666893},
  ISSN={1556-6021},
  month={},}
