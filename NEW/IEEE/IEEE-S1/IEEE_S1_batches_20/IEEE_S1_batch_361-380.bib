  author={Zhao, Bingbing and Lu, Bin and Gao, Xu and Shi, Meng},
  booktitle={2025 IEEE 6th International Seminar on Artificial Intelligence, Networking and Information Technology (AINIT)}, 
  title={Adversarial Paraphrase Substitution: Jailbreak Attacks on Text-to-Image Diffusion Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Recent advancements in Text-to-Image (T2I) diffusion models (DMs) have transformed image synthesis, enabling the generation of high-quality and diverse visual content from textual descriptions. However, alongside their impressive capabilities and expanding applications, T2I models carry significant risks, particularly their potential misuse to produce unsafe imagery. While safety mechanisms have been integrated into T2I models, their robustness and reliability remain underexplored, highlighting the need for more systematic and rigorous evaluation. In this paper, we present Adversarial Paraphrase Substitution (APS), a novel automated attack framework designed to expose vulnerabilities in the safety mechanisms of state-of-the-art T2I models. Functioning as a model-agnostic, black-box jailbreak attack targeting text encoders, APS operates without requiring any prior knowledge of the underlying T2I architecture, ensuring its adaptability across a broad spectrum of platforms. The APS framework follows a two-stage process: first, it leverages the generative capabilities of large language models (LLMs) to construct a tailored subset vocabulary for each sensitive word. Subsequently, it generates an optimized adversarial paraphrase from the corresponding subset vocabulary to replace the sensitive word in the original prompt, thereby effectively aligning unsafe concepts within the text encoder's embedding space. Through extensive experiments on open-source T2I models with concept removal mechanisms and commercial platforms with proprietary defenses, APS consistently bypasses safety measures, generating unsafe yet semantically coherent images closely aligned with the original prompts. These results highlight critical vulnerabilities in current defenses and stress the urgent need for more robust safeguards against adversarial exploitation. Content Warning: This paper includes examples of NSFW content.},
  keywords={Seminars;Vocabulary;Adaptation models;Visualization;Systematics;Text to image;Diffusion models;Superluminescent diodes;Safety;Stress;adversarial attack;jailbreak attack;not-safe-for-work (NSFW);diffusion models},
  doi={10.1109/AINIT65432.2025.11035508},
  ISSN={},
  month={April},}

@INPROCEEDINGS{11033427,
  author={Li, Yanshu and Wang, Yan and Yang, Haitian and Liu, Wen and Li, Ning},
  booktitle={2025 28th International Conference on Computer Supported Cooperative Work in Design (CSCWD)}, 
  title={A Jailbreak Prompt Detector Based on Selective Perturbation and Contrastive Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1838-1843},
  abstract={Jailbreak attacks pose a significant threat to the reliable deployment of large language models (LLMs) in critical applications. Although existing LLMs are supervised fine-tuning and aligned through reinforcement learning from human feedback, automated jailbreak attack algorithms can still identify potential jailbreak prompts that lead to harmful outputs. In this paper, we propose JPS, a jailbreak attack detector based on selective perturbation and contrastive learning. JPS leverages the robustness of jailbreak attacks, which is achieved through complex multi-step optimization, by using perturbation methods to enhance the training data for jailbreak prompts. In order to mitigate noise from perturbation, we introduce a selective strategy based on token importance. Additionally, we employ supervised contrastive learning to effectively differentiate between jailbreak and benign samples. Extensive experiments on the popular jailbreak attacks and benign datasets show that JPS outperforms all the baseline approaches according to F1-score. Furthermore, detailed ablation experiments were conducted to analyze each module of the model, demonstrating the effectiveness of our approach.},
  keywords={Federated learning;Perturbation methods;Large language models;Noise;Training data;Detectors;Contrastive learning;Reinforcement learning;Robustness;Optimization;large language model;jailbreak defense;selective perturbation;contrastive learning},
  doi={10.1109/CSCWD64889.2025.11033427},
  ISSN={2768-1904},
  month={May},}
