@ARTICLE{11595604,
  author={Hayashi, Victor Takashi and Neto, Milton Pedro Pagliuso and Miers, Charles Christian and Redígolo, Fernando Frota and Arakaki, Reginaldo and Simplicio, Marcos Antonio},
  journal={IEEE Access}, 
  title={DeepSeek Under Attack: An Analysis of Jailbreak Attacks and Prompt-Level Defenses}, 
  year={2026},
  volume={14},
  number={},
  pages={103944-103961},
  abstract={Large Language Models (LLMs) with reasoning capabilities (e.g., DeepSeek-R1) gained substantial research and industry interest. However, their novel reasoning features may introduce vulnerabilities, especially to specific jailbreak attacks that exploit weaknesses in safety alignment. Despite growing awareness of the associated risks in related works, experimental evaluations of defensive mechanisms applied to reasoning models and the comparison with their non-reasoning versions are not yet available in the literature. The objective of this work is to evaluate the security of reasoning model DeepSeek-R1 against jailbreaks, compare it with the non-reasoning model DeepSeek-V3, and assess the effectiveness of two prompt-level defenses: Self-Reminder and Intention Analysis. We used a dataset of 75 jailbreaks with 10 malicious tasks, totaling 750 static attacks. The models were tested in three settings: 1) baseline (i.e., no defense), 2) using Self-Reminder, and 3) using Intention Analysis. Using automated classification with Llama-3.3-70B to measure the Attack Success Rate (ASR), we found that DeepSeek-R1 exhibited a baseline ASR of 70.27%, significantly higher than DeepSeek-V3 (53.47%). Results demonstrate that while Intention Analysis was more effective for DeepSeek-R1 (reducing ASR to 6.00%), Self-Reminder showed greater efficacy for DeepSeek-V3 (reducing ASR to 17.60%). As conclusion, the reasoning model DeepSeek-R1 was more susceptible to jailbreak attacks than the non-reasoning model DeepSeek-V3, and different prompt-level defenses were effective against static jailbreaks. As contributions, this work combines a focused literature review with a empirical evaluation to provide insights into the security of reasoning-based models and the effectiveness of two prompt-level defenses. Warning: this work contains inappropriate language in AI model outputs and jailbreaks.},
  keywords={Modeling;Cognition;Cognitive systems;Large language models;Security;Safety;Automatic speech recognition;Reinforcement learning;Training;Tuning;DeepSeek;jailbreak;large language models;reasoning;security},
  doi={10.1109/ACCESS.2026.3710427},
  ISSN={2169-3536},
  month={},}

@INPROCEEDINGS{11582392,
  author={Wu, Tingting and Gao, Qi and Yu, Zhiwen},
  booktitle={2026 13th International Conference on Machine Intelligence Theory and Applications (MiTA)}, 
  title={Enhancing Jailbreak Defense with Diverse Perturbation Combinations}, 
  year={2026},
  volume={},
  number={},
  pages={31-38},
  abstract={While aligning large language models (LLMs) with human preferences can prevent undesired outputs, recent research indicates that jailbreak prompts can easily bypass such safeguards, resulting in the generation of prohibited content. In response, perturbation strategies are explored to damage attacks. However, some methods entail iterative checks of prompt subsequences, introducing uncontrollable complexity. Moreover, certain defenses relying on random perturbation are inadequate in disrupting malicious requests, leading to the defense being bypassed. Others depending on a single type of perturbation may incorrectly respond to benign requests while countering attacks. To address these issues, we propose a simple but effective defense strategy called Diverse Perturbation Combinations (DPC). It refines existing perturbations and achieves enough interference on attacks through targeted perturbation, enabling defense against multiple jailbreak attacks. Moreover, by strategically combining different operations, DPC ensures stable detection of benign or harmful requests. We conduct exhaustive theoretical analysis, providing effectiveness guarantees for the defense. Experimental validation on datasets featuring diverse jailbreak prompts across multiple closed-source and open-source LLMs further confirms the empirical effectiveness of our approach.},
  keywords={Modeling;Large language models;Printing;Generative Pre-trained transformer;Equations;Algorithms;Automatic speech recognition;Probability;Signal detection;LLMs;Jailbreak prompts;Perturbation strategies;Diverse Perturbation Combinations},
  doi={10.1109/MiTA69365.2026.11582392},
  ISSN={},
  month={Feb},}

@INPROCEEDINGS{11582731,
  author={Zhang, Beilei and Hu, Tao and He, Weizhen and Li, Baolin and Ouyang, Qi and Shao, Chenyang and Zhang, Chaoqin and Ma, Hailong},
  booktitle={2026 29th International Conference on Computer Supported Cooperative Work in Design (CSCWD)}, 
  title={RL-Shield: Endogenous Moving Target Defense against Jailbreak Attacks in LLMs}, 
  year={2026},
  volume={},
  number={},
  pages={4037-4042},
  abstract={Large Language Models (LLMs) face a systemic vulnerability to automated jailbreak attacks, which mathematically exploit the deterministic nature of static inference configurations to optimize adversarial suffixes. Existing defense mechanisms—whether reliant on static alignment or reactive filtering—fail to effectively disrupt these gradient-based exploitations. To address this inherent defense-offense asymmetry, we propose RL-Shield, an endogenous Moving Target Defense (MTD) mechanism. By reformulating the passive decoding process into a sequential Markov Decision Process (MDP), RL-Shield acts as an active defense layer. We employ an integrated Proximal Policy Optimization (PPO) agent that dynamically modulates continuous decoding hyperparameters (e.g., Temperature, Top-P) in real-time, guided by continuous semantic threat assessments. This dynamic hyperparameter adaptation introduces endogenous stochasticity, which severely destabilizes the attacker’s gradient landscape and exponentially increases the computational cost of convergence. Extensive evaluations across five diverse LLM architectures demonstrate that RL-Shield reduces the Attack Success Rate (ASR) by an average of 65.1% against state-of-the-art automated attacks while rigorously preserving the generation utility for benign queries. Our findings establish continuous hyperparameter modulation as a robust, lightweight, and deployment-ready defense paradigm against adaptive adversaries.},
  keywords={Modeling;Optimization;Large language models;Printing;Automatic speech recognition;Safety;Decoding;Temperature;Security;Conferences;Large Language Models;Jailbreak Defense;Reinforcement Learning;Moving Target Defense;AI Safety},
  doi={10.1109/CSCWD68734.2026.11582731},
  ISSN={2768-1904},
  month={May},}

@INPROCEEDINGS{11582223,
  author={Feng, Qujing and Liu, Jiaming and Xiang, Nan and Pan, Yushan and Wang, Hao},
  booktitle={2026 29th International Conference on Computer Supported Cooperative Work in Design (CSCWD)}, 
  title={HAVOC:Hybrid Adversarial Visual Obfuscation and Confusion for Universal MLLM Jailbreak}, 
  year={2026},
  volume={},
  number={},
  pages={3372-3377},
  abstract={Jailbreak attacks on multimodal large language models (MLLMs) pose growing safety risks, especially when adversarial prompts not only bypass refusals but also produce concretely harmful, executable outputs. Existing methods often prioritize attack success rate (ASR) while neglecting malicious intent fulfillment rate (MIFR), leading to evasive yet ineffective responses. We present HAVOC (Hybrid Adversarial Visual Obfuscation and Confusion), a unified framework that synchronously manipulates visual and textual pathways. HAVOC combines targeted visual blending with adaptive perturbation for robust safety bypass, while obfuscated and iteratively refined prompts elicit high-risk completions. We adopt ASR and MIFR as joint metrics for evaluating both bypass and intent realization. HAVOC achieves over 93% ASR and 88% MIFR on four MLLMs, surpassing the best baseline by up to 34 percentage points on GPT-4V. It also generalizes to unseen models, reaching 92.87% ASR / 88.12% MIFR on LLaVA-1.6 and 91.35% / 84.78% on Gemini-1.5 without re-optimization. These results highlight HAVOC’s ability to exploit structural vulnerabilities in multimodal fusion, underscoring the need for stronger cross-modal alignment in safety-critical MLLM deployments.},
  keywords={Modeling;Visualization;Automatic speech recognition;Safety;Printing;Optimization;Large language models;Filtering;Filters;Modules (abstract algebra);Multimodal language models;Jailbreak attacks;Visual perturbations;Prompt injection;Safety bypass},
  doi={10.1109/CSCWD68734.2026.11582223},
  ISSN={2768-1904},
  month={May},}

@INPROCEEDINGS{11582504,
  author={Zou, Xide and Wang, Dongyu and Tang, Chaoxing and Zhang, Lan},
  booktitle={2026 29th International Conference on Computer Supported Cooperative Work in Design (CSCWD)}, 
  title={GRED: Gradual Jailbreak Attack via Relational Decomposition on Large Language Model}, 
  year={2026},
  volume={},
  number={},
  pages={2923-2928},
  abstract={Jailbreak attack is effective in verifying the security of large language models (LLMs). With the development of LLMs, an increasing number of jailbreak attack methods have been proposed to explore the security boundaries of LLMs. Most existing methods employ more universal black-box approaches, that is, using carefully constructed prompts to bypass the security mechanisms of LLMs, enabling the models to answer malicious questions. Previous methods have attempted techniques such as specific templates and semantic obfuscation to transform the original questions into transition questions and achieve jailbreak attacks through multi-round dialogues. However, they lack to guarantee of semantic coherence and purpose consistency throughout the process. Our method uses an attack LLM, starts from the semantic perspective, extracting multiple entity-relation-entity triples from the original question and generating subquestions based on these triples. By sending these sub-questions to the target model, we create a context with background knowledge related to the original question. Then, we summarize the context and gradually generate transition questions with reference to the semantics of the original question, guiding the target LLM to answer the original question, thus completing the jailbreak attack. We call this jailbreak attack GRED (Gradual jailbreak attack based on Relational Decomposition). We conducted extensive experiments on AdvBench, and the results demonstrate that our method achieves the state-of-the-art performance.Warning: This paper contains malicious content from some model outputs.},
  keywords={Modeling;Large language models;Printing;Modules (abstract algebra);Triples (Data structure);Aluminum;Optimization;Glass box;Security;Context;large language model;jailbreak attack;security},
  doi={10.1109/CSCWD68734.2026.11582504},
  ISSN={2768-1904},
  month={May},}

@ARTICLE{11594973,
  author={Chen, Wenjing and Cui, Jie and Huang, Wenjie and Zhang, Jing and Wei, Lu and Min, Geyong},
  journal={IEEE Transactions on Dependable and Secure Computing}, 
  title={Efficient Prompt Security Detection for LLM Service Deployment in Edge-Cloud Networks}, 
  year={2026},
  volume={23},
  number={5},
  pages={11069-11083},
  abstract={While Large Language Models (LLMs) have achieved revolutionary advancements in natural language processing, their inherent vulnerability to prompt injection attacks has raised significant security concerns. Existing security detection approaches for LLM deployment often fail to fully leverage edge-cloud collaboration and largely overlook the issue of user heterogeneity, resulting in reduced detection efficiency and security risks. To address these challenges, this paper proposes a Belief-updating and User-aware Security (BUUAS) framework for LLM service deployment in edge–cloud networks. BUUAS integrates a Bayesian-inspired belief update method with a belief-weighted contextual multi-armed bandit (BWCB) mechanism to achieve dynamic and user-aware scheduling of security detection tasks. This design enables the system to prioritize high-risk requests while improving overall task allocation and execution efficiency. Extensive experimental results demonstrate that BUUAS outperforms state-of-the-art methods in terms of detection accuracy, network throughput, and resource efficiency in dynamic network conditions characterized by fluctuating user loads and varying malicious user ratios.},
  keywords={Modeling;Security;Signal detection;Large language models;Clouds;Detectors;Bismuth;Business intelligence;Schedules;Scheduling;Large language models (LLMs);prompt injection attacks;edge-cloud networks;security detection;resource optimization},
  doi={10.1109/TDSC.2026.3709894},
  ISSN={1941-0018},
  month={Sep.},}

@ARTICLE{11595140,
  author={Ma, Wanlun and Han, Qing-Long and Zhu, Xiaogang and Zhou, Wei and Xiong, Junwu and Ren, Zhihang and Wen, Sheng and Xiang, Yang},
  journal={IEEE/CAA Journal of Automatica Sinica}, 
  title={OpenClaw in the Wild: Security Analysis of Autonomous Agents}, 
  year={2026},
  volume={13},
  number={6},
  pages={1257-1273},
  abstract={Autonomous self-hosted AI agent platforms are rapidly evolving from prompt-response assistants into persistent systems that can maintain long-lived state, invoke tools, ingest external content, and execute environment-changing actions. While this transition enables practical automation, it also introduces lifecycle security risks that cannot be fully explained by prompt-level analysis alone. In this paper, a security analysis of OpenClaw is presented, with OpenClaw serving as a representative autonomous agent operating environment and a concrete case study for broader security challenges in emerging agent ecosys-tems. A trust-boundary-first perspective is adopted to examine how attacks propagate across five boundary classes: Channel-Access, Session-and-State, Tool-Execution, External-Content, and Extension Supply-Chain. The results presented in this paper show that threats such as indirect prompt injection, memory poisoning, unsafe tool invocation, data exfiltration, and malicious skill abuse are not isolated anomalies; rather, they are stage-specific mani-festations of a common systems problem in which untrusted influence progressively crosses into higher-privilege contexts. Based on this analysis, the defense-in-depth implications for OpenClaw deployments are discussed, including boundary-aware isolation, capability-scoped tool mediation, memory integrity controls, extension governance, and evidence-oriented operational oversight. This study provides a practical framework for evaluating and hardening long-running, tool-capable, autonomous AI agents in realistic deployment settings.},
  keywords={Memory;Modeling;Security;Tools;Printing;Artificial intelligence;Context;Large language models;Runtime;Design methodology;Agent security;Agentic AI;autonomous systems;LLM agents;tool-use safety},
  doi={10.1109/JAS.2026.126209},
  ISSN={2329-9274},
  month={June},}

@INPROCEEDINGS{11581043,
  author={Starukh, Kirill and Koshelev, Anton},
  booktitle={2026 IEEE Ural-Siberian Conference on Biomedical Engineering, Radioelectronics and Information Technology (USBEREIT)}, 
  title={Evaluating a Multilayered Defense Against Prompt Injection in LLM-Augmented Educational Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-4},
  abstract={Prompt injection attacks represent a persistent threat to production systems built on large language models (LLMs), particularly in educational environments where system integrity and student data protection are critical. This work investigates the effectiveness of a multilayered defensive architecture against prompt injection in an LLM-augmented educational bot deployed in a university setting. The proposed approach combines pattern-based input validation, prompt engineering via a sandwich technique, and LLM-based semantic post-filtering as sequential defense layers. We consider both direct user-crafted attacks and instruction-like content that can be embedded in external text, reflecting the broadened attack surface of modern LLM applications. The architecture is evaluated under two complementary regimes: synthetic prompts covering representative attack patterns and benign queries, and real-world interactions collected during a controlled in-vivo red-team exercise with student participants. The analysis reports overall blocking behavior together with per-layer contributions and identifies typical bypass mechanisms and operational failure modes observed in deployment. The findings suggest that a coordinated defense-in-depth strategy can distribute the protective burden across stages, improving robustness to paraphrase, obfuscation, and previously unseen variants. The paper contributes deploymentoriented evidence supporting architectural diversity as a practical principle for securing educational LLM systems.},
  keywords={Modeling;Large language models;Filtering;Filters;Printing;Safety;Measurement;prompt injection;LLM security;multilayered defense;AI safety;educational technology},
  doi={10.1109/USBEREIT70063.2026.11581043},
  ISSN={2769-3635},
  month={May},}

@INPROCEEDINGS{11582854,
  author={Shanid, Mohammed and Prasad, Gaurav and Bawgi, Veeresh and Gowda, Srujan},
  booktitle={2026 IEEE International Conference on Emerging Synergy Science and Technology (ICESST)}, 
  title={MedRAGShield: A Three-Tier Defense Framework Against Document Poisoning and Adversarial Attacks in Medical Retrieval-Augmented Generation Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Retrieval-Augmented Generation (RAG) systems deployed in medical question-answering applications introduce novel attack surfaces not addressed by existing large language model (LLM) safety mechanisms. This research presents MedRAGShield, a three-tier middleware defense framework designed to detect and neutralise document injection poisoning, hallucination exploitation, prompt injection, and jailbreak attacks against medical RAG pipelines. The proposed system operates across three independently togglable defense modes: a baseline mode with no filtering, a confidence and hallucination gating mode, and a full defense mode augmenting the prior modes with Domain-Aware Sanity Check (DASC) rules that apply medical ontological constraints to generated outputs. This experiment constructs a 40-query adversarial evaluation dataset spanning four attack categories and conducts an empirical evaluation on a clinical pharmacology RAG system built on Llama 3.2:3B and ChromaDB. Results demonstrate that confidence-based defenses alone are insufficient against high-similarity document poisoning attacks, which achieve retrieval confidence exceeding 0.85 while delivering clinically dangerous misinformation, a phenomenon this research terms the high-confidence poisoning paradox. The full MedRAGShield defense reduces Attack Success Rate (ASR) from 13.2% (undefended) to 0.0%, with block rate increasing from 0% to 62.5%, while maintaining sub-second query latency. This work establishes a reproducible evaluation methodology for medical RAG security and identifies domain-specific semantic rule checking as a critical missing layer in current LLM defense architectures. Code, dataset, and defense rules are openly available.},
  keywords={Modeling;Retrieval augmented generation;Large language models;Toxicology;Drugs;Printing;Safety;Automatic speech recognition;Drug interactions;Middleware;retrieval-augmented generation;medical AI safety;document poisoning;adversarial machine learning;large language models;prompt injection;hallucination detection;drugdrug interaction safety},
  doi={10.1109/ICESST69086.2026.11582854},
  ISSN={},
  month={April},}

@INPROCEEDINGS{11580105,
  author={Bandara, Eranga and Hass, Amin and Shetty, Sachin and Mukkamala, Ravi and Gore, Ross and Rajapakse, Sachini and Liang, Xueping and Bouk, Safdar H.},
  booktitle={2026 International Wireless Communications and Mobile Computing (IWCMC)}, 
  title={ASTRIDE: A Security Threat Modeling Platform for Agentic-AI Applications}, 
  year={2026},
  volume={},
  number={},
  pages={386-393},
  abstract={AI agent-based systems are becoming increasingly integral to modern software architectures, enabling autonomous decision-making, dynamic task execution, and multimodal interactions through large language models (LLMs). However, these systems introduce novel and evolving security challenges, including prompt injection attacks, context poisoning, model manipulation, and opaque agent-to-agent communication that are not effectively captured by traditional threat modeling frameworks. In this paper, we introduce ASTRIDE, an automated threat modeling platform purpose-built for AI agent-based systems. ASTRIDE extends the classical STRIDE framework by introducing a new threat category, A for AI Agent–Specific Attacks, which encompasses emerging vulnerabilities such as prompt injection, unsafe tool invocation, and reasoning subversion, unique to agent-based applications. To automate threat modeling, ASTRIDE integrates a consortium of fine-tuned vision-language models (VLMs) with the OpenAI-gpt-oss reasoning LLM to perform end-to-end analysis directly from visual agent architecture diagrams, such as data flow diagrams (DFDs). The consortium-based approach enables consensus-driven reasoning, where predictions from multiple VLMs are systematically evaluated, reconciled, and refined by the reasoning LLM. This process mitigates single-model bias, enforces policy and safety constraints, and produces transparent, traceable, and explainable threat assessments. Our evaluations demonstrate that ASTRIDE provides accurate, scalable, and explainable threat modeling for next-generation intelligent systems. To the best of our knowledge, ASTRIDE is the first framework to both extend STRIDE with AI-specific threat categories and integrate a consortium of fine-tuned vision-language models with a reasoning LLM to fully automate diagram-driven threat modeling for AI agent-based applications, while explicitly supporting Responsible and Explainable AI requirements.},
  keywords={Modeling;Threat modeling;Cognition;Cognitive systems;Large language models;Artificial intelligence;Tuning;Generative Pre-trained transformer;Printing;Vision language model;Agentic AI;Responsible AI;Explainable AI;Vision-Language-Model;Threat-Modeling;STRIDE},
  doi={10.1109/IWCMC69287.2026.11580105},
  ISSN={2376-6506},
  month={June},}

@INPROCEEDINGS{11579902,
  author={Ghouil, Chaima and Aloui, Radhoine and Khalfaoui, Nejib and Mhatli, Sofien and Aldalbahi, Adel and Garro, Ignacio Llamas},
  booktitle={2026 International Wireless Communications and Mobile Computing (IWCMC)}, 
  title={A Comprehensive Framework for Secure Multi-Agent Retrieval-Augmented Generation Systems}, 
  year={2026},
  volume={},
  number={},
  pages={225-231},
  abstract={This paper presents a comprehensive framework for securing Retrieval-Augmented Generation (RAG) systems in multi-agent environments. We introduce two complementary architectures: the Secure RAG Framework (SecRAG) for layered defense mechanisms and the Secure Multi-Agent RAG Simulator (SMARS) for systematic security evaluation. Our framework addresses critical vulnerabilities including prompt injection, data poisoning, and coordinated attacks through quantitative risk assessment and mitigation strategies. Experimental results demonstrate that our hybrid defense approach reduces attack success rates by up to 89% while maintaining system performance within acceptable thresholds. The proposed framework provides a holistic solution for securing complex multi-agent RAG systems in real-world deployments.},
  keywords={Retrieval augmented generation;Security;Modeling;Printing;Simulation;Measurement;Multi-agent systems;Risk management;Architecture;Computer architecture;Multi-Agent Systems;Retrieval-Augmented Generation;RAG Security;Cybersecurity;Adversarial Attacks;Simulation Framework},
  doi={10.1109/IWCMC69287.2026.11579902},
  ISSN={2376-6506},
  month={June},}

@INPROCEEDINGS{11582014,
  author={Ma, Shuoyoucheng and Liu, Wei and Xie, Wei and Wen, Ling and Wang, Pengfei and Chen, Rongmao and Chen, Shuhui},
  booktitle={2026 ICEENG International Conference for Innovations in Intelligent Computing and Cybersecurity (IICC)}, 
  title={DUA: Automated Jailbreak via Dual-Use Ambiguity and Semantic-Operational Disentanglement}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={While Large Language Models (LLMs) are safeguarded by strict alignment protocols, current defense mechanisms primarily focus on detecting malicious intent within the explicit text of a prompt. In this paper, we target the "Context-Content Gap," a critical vulnerability where LLMs reject harmful instructions in isolation yet readily divulge identical operational procedures when embedded within benign, dual-use scenarios (e.g., emergency rescue). To systematically exploit this gap, we propose DUA(Dual-Use Attack), a Two-Stage Decoupled Framework that automates the jailbreak process. Unlike optimization-based baselines that necessitate computationally expensive iterative feedback, DUA operates via a non-iterative, deterministic workflow: (1) Intent Disguise coupled with Hybrid Strategy Filtering generates and selects the optimal benign scenario to bypass intent detection, and (2) Malicious Reconstruction decouples the harmful logic from the benign response to restore the prohibited intent. Extensive evaluations on six state-of-the-art LLMs—including GPT-4o, DeepSeek-V3, and Qwen3-80B— demonstrate that DUA achieves a state-of-the-art Attack Success Rate (ASR) of 95.0%. Crucially, DUA eliminates the need for multi-turn optimization, strictly limiting the attack overhead to a fixed budget of two queries.},
  keywords={Modeling;Safety;Optimization;Context;Filtering;Printing;Large language models;Automatic speech recognition;Conferences;Aluminum;Large Language Models;Jailbreak Attacks;AI Safety;Contextual Reframing},
  doi={10.1109/IICC69623.2026.11582014},
  ISSN={},
  month={May},}

@INPROCEEDINGS{11582295,
  author={Liu, Wei and Ma, Shuoyoucheng and Xie, Wei and Wen, Ling and Wang, Pengfei and Chen, Rongmao and Chen, Shuhui},
  booktitle={2026 ICEENG International Conference for Innovations in Intelligent Computing and Cybersecurity (IICC)}, 
  title={ISDP: A Decoupled Iterative Pipeline for Balancing Defensive Robustness and User Usability in LLMs}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models (LLMs) are increasingly vulnerable to sophisticated jailbreaking attacks. Conventional defense mechanisms, such as single-pass filtering and preset refusal, often fail to provide robust protection against nuanced adversarial prompts while also degrading user experience. Motivated by the concept of LLM self-defense and representation-level analysis, we propose the Iterative Safety Defense Pipeline (ISDP) to enhance both the robustness and usability of LLMs. ISDP employs a dual-model architecture decoupling content generation from security analysis. Unlike conventional single-pass filtering, ISDP introduces a conditional iterative refinement mechanism driven by intent recognition to effectively enhance detection accuracy. The guard model first distinguishes underlying malice from superficial adversarial noise; subsequently, a purification cycle is triggered only upon detecting harm or contamination to neutralize threats and strip noise for restored usability, while safe responses are passed directly to minimize latency. Experimental evaluation across three open-source LLMs (Llama2, Mistral, Qwen2.5) demonstrates that ISDP achieves an average true positive rate (TPR) of 95.5% for harmful prompts and reduces the false positive rate (FPR) to 5.5% for benign prompts. With an additional average latency of only 2.95s, ISDP offers an efficient, reliable, and user-friendly framework for secure LLM deployment.},
  keywords={Modeling;Large language models;Printing;Safety;Aluminum;Filtering;Filters;Usability;Robustness;Security;Large Language Models;Jailbreaking Attacks;Adversarial Prompts;Representation Engineering;Iterative Safety Defense Pipeline},
  doi={10.1109/IICC69623.2026.11582295},
  ISSN={},
  month={May},}

@INPROCEEDINGS{11581521,
  author={K, Manikandan. and S, Bharanidharan. and K, Sudha. and R, Arulalan. and R, Manoja. and M, Chandru.},
  booktitle={2026 2nd International Conference on Computing, Communication and Green Engineering (CCGE)}, 
  title={Automated Framework for Red-Team Prompt Injection Testing of LLMs}, 
  year={2026},
  volume={},
  number={},
  pages={1-4},
  abstract={The main aim of this work is to improve Large Language Models (LLMs)security assessment by creating an automated framework for red team prompt injection testing of LLMs. Materials and Methods: The system uses reasoning-based prompt generation together with adaptive feedback to construct its framework. The system compares its performance against baseline random and static attack techniques by testing both methods during 30 prompt iterations. At present, two types of red-teaming models exist which include static models and random models. The automated framework develops better adversarial prompts through model feedback which improves their performance with time. Results: The proposed method reduces the average number of iterations to 15.1, raises the coverage to 74.2%, and raises the attack success rate to 62.3%, which is higher than the rates for static and random attacks, which are 36.8% and 19.4%, respectively. The proposed framework provides an effective LLM security assessment method which outperforms traditional assessment techniques in both speed and accuracy.},
  keywords={Modeling;Large language models;Security;Testing;Printing;Convergence;Large Language Models (LLMs);LLM Security;Red Teaming;Multi-Agent;Meta-Reasoning;Prompt Injection;Adversarial Testing;LLMs vulnerability},
  doi={10.1109/CCGE67142.2026.11581521},
  ISSN={},
  month={May},}

@INPROCEEDINGS{11573502,
  author={Wu, Jialin and Li, Kecen and Huang, Zhicong and Li, Xinfeng and Wang, Xiaofeng and Hong, Cheng},
  booktitle={2026 IEEE Symposium on Security and Privacy (SP)}, 
  title={ENCHTABLE: Unified Safety Alignment Transfer in Fine-Tuned Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={3358-3376},
  abstract={Nowadays, many machine learning models are finetuned from large language models (LLMs) to achieve high performance in specialized domains such as code generation, biomedical analysis, and mathematical problem solving. However, researchers have shown that such fine-tuning process often introduces a critical vulnerability: the systematic degradation of safety alignment, which undermines ethical guidelines and increases the risk of harmful outputs. Addressing this challenge, we introduce EnchTable, a novel and unified framework designed to transfer and maintain safety alignment in downstream LLMs without requiring extensive retraining. EnchTable leverages a Neural Tangent Kernel (NTK)based safety vector distillation method to decouple safety constraints from task-specific reasoning, ensuring compatibility across diverse model architectures and sizes. Additionally, our interference-aware merging technique effectively balances the trade-offs between safety and utility, minimizing performance compromises across various task domains. We have implemented a fully functional prototype of EnchTable on three different task domains and three distinct LLM architectures, and evaluated its performance through extensive experiments on eleven diverse datasets, assessing both downstream utility and model safety. Our evaluations include assessments of LLMs from different vendors, demonstrating the generalization capability of EnchTable. Furthermore, EnchTable exhibits robust resistance to both static and dynamic jailbreaking attacks, outperforming vendor-released safety models in mitigating adversarially designed prompts. Comparative analyses with six parameter modification methods and two inference-time alignment baselines reveal that EnchTable achieves significantly lower unsafe rate and higher utility score and universal applicability across different task domains. Additionally, we validate that EnchTable can be seamlessly integrated into various deployment pipelines without significant overhead.},
  keywords={Interference;Modeling;Printing;Safety;Tuning;Codes;Large language models;Vectors;Training;Conferences;large language models;safety alignment},
  doi={10.1109/SP63933.2026.00072},
  ISSN={2375-1207},
  month={May},}

@INPROCEEDINGS{11573588,
  author={Wang, Xunguang and Ji, Zhenlan and Wang, Wenxuan and Li, Zongjie and Wu, Daoyuan and Wang, Shuai},
  booktitle={2026 IEEE Symposium on Security and Privacy (SP)}, 
  title={Sok: Evaluating Jailbreak Guardrails for Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={39-58},
  abstract={Large Language Models (LLMs) have achieved remarkable progress, but their deployment has exposed critical vulnerabilities, particularly to jailbreak attacks that circumvent safety alignments. Guardrails—external defense mechanisms that monitor and control LLM interactions—have emerged as a promising solution. However, the current landscape of LLM guardrails is fragmented, lacking a unified taxonomy and comprehensive evaluation framework. In this Systematization of Knowledge (SoK) paper, we present the first holistic analysis of jailbreak guardrails for LLMs. We propose a novel, multi-dimensional taxonomy that categorizes guardrails along six key dimensions, and introduce a Security-Efficiency-Utility evaluation framework to assess their practical effectiveness. Through extensive analysis and experiments, we identify the strengths and limitations of existing guardrail approaches, provide insights into optimizing their defense mechanisms, and explore their universality across attack types. Our work offers a structured foundation for future research and development, aiming to guide the principled advancement and deployment of robust LLM guardrails.},
  keywords={Large language models;Modeling;Printing;Safety;Optimization;Turning;Automatic speech recognition;Memory;Security;Generative Pre-trained transformer},
  doi={10.1109/SP63933.2026.00076},
  ISSN={2375-1207},
  month={May},}

@INPROCEEDINGS{11573507,
  author={Zhu, Wentian and Xiang, Zhen and Niu, Wei and Guan, Le},
  booktitle={2026 IEEE Symposium on Security and Privacy (SP)}, 
  title={MetaBreak: Jailbreaking Online LLM Services via Special Token Manipulation}, 
  year={2026},
  volume={},
  number={},
  pages={98-117},
  abstract={Unlike regular tokens derived from existing text corpora, special tokens are artificially created to annotate structured conversations during the fine-tuning process of Large Language Models (LLMs). Serving as metadata of training data, these tokens play a crucial role in instructing LLMs to generate coherent and context-aware responses. We demonstrate that special tokens can be exploited to construct four attack primitives, with which malicious users can reliably bypass the internal safety alignment of online LLM services and circumvent state-of-the-art (SOTA) external content moderation systems simultaneously. Moreover, we found that addressing this threat is challenging, as aggressive defense mechanisms-such as input sanitization by removing special tokens entirely, as suggested in academia-are less effective than anticipated. This is because such defense can be evaded when the special tokens are replaced by regular ones with high semantic similarity within the tokenizer's embedding space. We systemically evaluated our method, named MetaBreak, on both lab environment and commercial LLM platforms. Our approach achieves jailbreak rates comparable to SOTA prompt-engineering-based solutions when no content moderation is deployed. However, when there is content moderation, MetaBreak outperforms SOTA solutions PAP and GPTFuzzer by $\mathbf{1 1. 6} \boldsymbol{\%}$ and 34.8 %, respectively. Finally, since MetaBreak employs a fundamentally different strategy from prompt engineering, the two approaches can work synergistically. Notably, empowering MetaBreak on PAP and GPTFuzzer boosts jailbreak rates by $\mathbf{2 4. 3 \%}$ and $\mathbf{2 0. 2 \%}$, respectively.},
  keywords={Large language models;Modeling;Printing;Security;Context;Safety;Application programming interfaces;Automatic speech recognition;Turning;Prompt engineering},
  doi={10.1109/SP63933.2026.00095},
  ISSN={2375-1207},
  month={May},}

@INPROCEEDINGS{11573441,
  author={Sun, Yiheng and Du, Linkang and Su, Zhou and Wang, Yuntao and Liu, Han},
  booktitle={2026 IEEE Symposium on Security and Privacy (SP)}, 
  title={URLcoat: Exploiting Web Search Capability to Jailbreak Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={59-77},
  abstract={Large language models (LLMs) achieve remarkable advances in understanding and reasoning with human language, which are widely applied in software development, content creation, healthcare, etc. However, their vulnerabilities to security threats, especially jailbreak attacks, remain a significant issue. Existing research on jailbreak mainly focuses on the security risks of LLMs' inherent thinking and reasoning, overlooking the new attack surface introduced by web search capability. Attackers can exploit this by guiding LLMs to retrieve information from external URLs, which is then used to implicitly reconstruct harmful instructions and circumvent safety mechanisms, leading to the generation of harmful content. In this paper, we propose a novel jailbreak attack, named URLcoat. The core idea is to exploit the web search capabilities of LLMs to circumvent their security safeguards. URLcoat incorporates three core strategies: obfuscating the feature of sensitive words to evade input detection, reconstructing harmful instructions via implicit associations with external URLs, and contextual narrative guidance to bypass output filtering. The experimental results reveal that URLcoat attains 100 % attack success rates in mainstream LLMs, including GPT5, GPT-4o, Gemini 2.0 Flash Thinking, DeepSeek R1, Kimi 1.5, ChatGLM-4, Grok 3, Gemini 2.5 Pro, Gemini 2.5 Flash, and Gemini 2.0 Flash, exceeding the performance of state-of-the-art jailbreak techniques. This study examines the security vulnerabilities arising from lLMs' web search capability, which facilitates the LLMs to produce harmful output.},
  keywords={Large language models;Modeling;Printing;Uniform resource locators;Filtering;Filters;Safety;Cognition;Cognitive systems;Security},
  doi={10.1109/SP63933.2026.00082},
  ISSN={2375-1207},
  month={May},}

@INPROCEEDINGS{11573584,
  author={Lee, Suyoung and Keum, Seongho and Lee, Changoo and Shin, Dongwon and Hong, Sanghyun and Lee, Byoungyoung and Son, Sooel},
  booktitle={2026 IEEE Symposium on Security and Privacy (SP)}, 
  title={Site Isolation is Dead: How Site Isolation is Broken in Agentic Browsers and Extensions}, 
  year={2026},
  volume={},
  number={},
  pages={1804-1821},
  abstract={Site isolation is a cornerstone of modern web browser security. By strictly separating renderer processes that render untrusted webpages across different origins, it prevents malicious websites from accessing sensitive data belonging to other websites, thus underpinning the integrity of web services. However, as browsers increasingly integrate large language models (LLMs) and web agents to automate complex user tasks, these agents should often perform LLM-driven operations across isolation boundaries, thereby introducing new security risks. Despite this shift, no previous studies have investigated how agentic browsers implement security mechanisms to protect LLM-driven agent operations from untrusted web content. In this work, we analyze the security designs of two open-source agentic browsers and seven agentic extensions, identifying a common architectural pattern: privileged processes manage user prompts and agent operations, while untrusted renderer processes are isolated, with inter-process communication (IPC) channels serving as their bridge. Building on this observation, we present two novel end-to-end attacks that exploit these IPC channels to perform (1) malicious prompt injections and (2) LLM-related data exfiltration. These attacks allow adversaries to interact with other websites or access sensitive user data through web agents, which have been considered challenging under strict site isolation. Our evaluation shows that all tested agentic browsers and extensions are vulnerable to these attacks, revealing that existing implementations often fail to properly account for IPC channels. We conclude with actionable defense guidelines for strengthening site isolation in agentic browsers and extensions. To the best of our knowledge, our work presents the first systematic study of the (in)security of site isolation in agentic browsers and extensions.},
  keywords={Browsers;Large language models;Security;Printing;Conferences;Electronic mail;Application programming interfaces;Planning;Design methodology;History},
  doi={10.1109/SP63933.2026.00241},
  ISSN={2375-1207},
  month={May},}

@INPROCEEDINGS{11573506,
  author={Jia, Yuqi and Liu, Yupei and Shao, Zedian and Jia, Jinyuan and Gong, Neil Zhenqiang},
  booktitle={2026 IEEE Symposium on Security and Privacy (SP)}, 
  title={PromptLocate: Localizing Prompt Injection Attacks}, 
  year={2026},
  volume={},
  number={},
  pages={4243-4261},
  abstract={Prompt injection attacks deceive a large language model into completing an attacker-specified task instead of its intended task by contaminating its input data with an injected prompt, which consists of injected instruction(s) and data. Localizing the injected prompt within contaminated data is crucial for post-attack forensic analysis and data recovery. Despite its growing importance, prompt injection localization remains largely unexplored. In this work, we bridge this gap by proposing PromptLocate, the first method for localizing injected prompts. PromptLocate comprises three steps: ① splitting the contaminated data into semantically coherent segments, ② identifying segments contaminated by injected instructions, and ③ pinpointing segments contaminated by injected data. We show PromptLocate accurately localizes injected prompts across eight existing and eight adaptive attacks. Our code and data are available at: https://github.com/liu00222/Open-Prompt-Injection.},
  keywords={Large language models;Printing;Signal detection;Cleaning;Location awareness;Reviews;Detectors;Modeling;Optimization;Indexes},
  doi={10.1109/SP63933.2026.00105},
  ISSN={2375-1207},
  month={May},}
