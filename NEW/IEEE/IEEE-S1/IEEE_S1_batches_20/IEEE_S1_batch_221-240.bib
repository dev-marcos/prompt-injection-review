@ARTICLE{11363579,
  author={Meng, Wenlong and Zhang, Fan and Yao, Wendao and Guo, Zhenyuan and Li, Yuwei and Wei, Chengkun and Chen, Wenzhi},
  journal={IEEE Transactions on Information Forensics and Security}, 
  title={Dialogue Injection Attack: Jailbreaking LLMs Through Context Manipulation}, 
  year={2026},
  volume={21},
  number={},
  pages={1577-1592},
  abstract={Large language models (LLMs) have demonstrated significant utility in a wide range of applications; however, their deployment is plagued by security vulnerabilities, notably jailbreak attacks. These attacks manipulate LLMs to generate harmful or unethical content by crafting adversarial prompts. While much of the current research on jailbreak attacks has focused on single-turn interactions, it has largely overlooked the impact of historical dialogues on model behavior. Although recent studies have explored multi-turn jailbreak attacks, they generally assume that the attacker can only manipulate the user prompt. In contrast, we highlight that an attacker can also control the model’s previous outputs. To this end, we introduce  $\textsf {DIA}$ , a new paradigm that leverages fabricated dialogue history to enhance jailbreak effectiveness.  $\textsf {DIA}$  operates in a black-box setting, requiring only access to the chat API or knowledge of the LLM’s chat template. We propose two methods for constructing adversarial historical dialogues: one adapts gray-box prefilling attacks, and the other exploits deferred responses. Our experiments demonstrate that  $\textsf {DIA}$  achieves state-of-the-art attack success rates on recent LLMs, including Llama-3.1 and GPT-4o. Additionally, we show that DIA can bypass 6 different defense mechanisms, highlighting its robustness. Code is available at https://github.com/meng-wenlong/DIA},
  keywords={Closed box;Safety;Engines;Chatbots;History;Training;Security;Internet;Glass box;Ethics;Jailbreak attacks;dialogue injection;safety alignment},
  doi={10.1109/TIFS.2026.3657898},
  ISSN={1556-6021},
  month={},}

@ARTICLE{11363592,
  author={You, Shen and Jiang, Wei and Mei, Hefei and Gong, Danei and Li, Zhongshen and Yu, Jixiang and Ji, Junkai and Lin, Qiuzhen and Li, Xiangtao and Wong, Ka-Chun},
  journal={IEEE Transactions on Evolutionary Computation}, 
  title={UniBreak: A Unified Evolutionary Token-Level Jailbreaking Framework for Large Language Models}, 
  year={2026},
  volume={30},
  number={4},
  pages={1450-1464},
  abstract={Large language models (LLMs) demonstrate promising capabilities in natural language understanding and reasoning with enormous parameter spaces and vast amount of training data. These attributes have facilitated their deployment into diverse application domains. However, the underlying parameters implicitly assume decision-making boundaries, resulting in significant decision space regions not covered by training data. It makes them susceptible to adversarial manipulations through carefully crafted inputs. To illuminate the vulnerabilities of LLMs, we propose a unified token-level jailbreaking attack that makes victim models generate responses for potentially harmful queries. Specifically, we propose an evolutionary algorithm to evolve perturbation sets, utilizing gradient-based and crossover-based operators to enhance performance under multiple scenarios. Furthermore, we develop a repository for reusing past perturbations and conduct an analysis of token sensitivity within LLMs, facilitating zero-shot attacks with convergence. Extensive benchmark experiments validate its effectiveness across three different models, achieving the increases of 62.36%, 57.89%, and 64.81% in attack success rates compared to baseline methods under white-box scenarios. In addition, the evaluation experiments demonstrate that the proposed method is effective for multiple scenarios and different LLM sizes. This study reveals the vulnerabilities of LLMs, provides theoretical foundations for developing robust defense strategies, and contributes to building reliable AI systems.},
  keywords={Perturbation methods;Semantics;Computational modeling;Threat modeling;Probability distribution;Sensitivity;Adversarial machine learning;Large language models;Artificial intelligence;Safety;Adversarial examples;AI safety;evolutionary algorithms;jailbreaking attacks;Large language models (LLMs)},
  doi={10.1109/TEVC.2026.3656951},
  ISSN={1941-0026},
  month={Aug},}

@ARTICLE{11359704,
  author={Damacena Duarte, Jaqueline and Cândido, Guilherme D. and De Britto Filho, José Ricardo A. and Souza Neto, João and Da Costa, Elena J. and Da Costa, João Paulo Javidi and Peotta De Melo, Laerte},
  journal={IEEE Access}, 
  title={A Systematic Review of Prompt Injection Attacks on Large Language Models: Trends, Taxonomy, Evaluation, Defenses, and Opportunities}, 
  year={2026},
  volume={14},
  number={},
  pages={12875-12899},
  abstract={Large Language Models (LLMs) are increasingly integrated into various infrastructure and interactive applications. However, their inherent linguistic flexibility introduces security vulnerabilities, particularly through Prompt Injection (PI) attacks. This systematic review provides a comprehensive synthesis of the evolving landscape of PI attacks, including their development trends, classification schemes, evaluation methodologies, defense strategies, and areas for future research. We analyze the evolution of attacks from basic natural language overrides to complex multi-turn manipulations, indirect injections using structured formats such as JSON and XML, and tool-assisted exploits involving automated prompt generation and multi-modal inputs like images. PI attacks are categorized by the level of manipulation, including character, word, sentence, and semantic levels, and by adversarial intent, such as prompt leaking and harmful content generation. The study analyzes these techniques within different LLM architectures and application contexts, including machine translation and Chain of Thought reasoning. It also reviews common evaluation benchmarks, datasets, and metrics. Mitigation strategies examined include automated red teaming frameworks, input validation, content filtering, and alignment through training. It differentiates itself from previous works by conducting a systematic review specifically focused on immediate injection, organizing its attacks, defenses and research gaps. Finally, this review identifies major research challenges and suggests critical directions for improving LLM safety and robustness.},
  keywords={Artificial intelligence;Cognition;Transformers;Prompt engineering;Security;Large language models;Training;Safety;Computational modeling;Training data;Large language models (LLMs);prompt attack;prompt injection;artificial intelligence;security},
  doi={10.1109/ACCESS.2026.3656849},
  ISSN={2169-3536},
  month={},}

@ARTICLE{11218933,
  author={Xu, Qianqiao and Tian, Zhiliang and Wu, Hongyan and Huang, Zhen and Liang, Dong and Song, Yiping and Pan, Ziyi and Liu, Feng and Li, Dongsheng},
  journal={IEEE Transactions on Information Forensics and Security}, 
  title={Disguise While Defense: Avoid Refusal Responses in LLM’s Defense via a Multi-Agent Attacker–Disguiser Game}, 
  year={2026},
  volume={21},
  number={},
  pages={1006-1020},
  abstract={With the enhanced performance of large language models (LLMs) on natural language processing tasks, potential moral and ethical issues of LLMs arise in the Web service. Malicious attackers exist who induce LLMs to jailbreak and generate information containing illegal, privacy-invasive information through techniques such as prompt engineering. As a result, LLMs counter malicious attackers’ attacks using techniques such as safety alignment. However, the strong defense mechanism of the LLMs through rejection replies, which are typically unrelated to the attacker’s query, is easily identified by attackers and leaks information that strengthens their capabilities. We propose an LLM-driven defense task that generates safe and disguised responses which remain relevant to the attack request while concealing defensive intent and withholding any useful information from the attacker. To achieve this task, we construct an LLM-based multi-agent attacker-disguiser game that trains two LLM-based players to select in-context learning (ICL) examples and strategies, guiding them to better generation and approach to Nash equilibrium. To enhance the LLMs’ generation via ICL, we apply the Minimax Q-learning to optimize the players for choosing ICL examples. To further refine generation, we use policy gradient (PG) to train the strategy selectors to select prompt strategies for LLMs. To improve the ICL examples and prompts for LLMs’ generation, we iteratively train the players with ICL sample selection training and prompt strategy training. The goal of this game is to arrive at the Nash equilibrium. Through training, we obtain an LLM-based defender which can receive jailbreak prompts from malicious users and output safe and disguised responses. The experiments reveal that our method strengthens the LLM’s ability to disguise the defense intent compared to other methods. Our method also minimizes the attacker-perceived drop in attack success rate, while delivering the largest actual reduction. This effectively misleads the attacker’s evaluation and enhances practical defense utility.},
  keywords={Games;Security;Safety;Training;Adaptation models;Nash equilibrium;Multi-agent systems;Prompt engineering;Ethics;Q-learning;LLMs jailbreaking defense;multi-agent system;game with LLMs},
  doi={10.1109/TIFS.2025.3626228},
  ISSN={1556-6021},
  month={},}

@INPROCEEDINGS{11580539,
  author={Shah, Rhythm and Sheth, Darshil and Shah, Shreya and Shah, Pooja and Lohiya, Ritika},
  booktitle={2025 IEEE 7th International Conference on Cybernetics, Cognition and Machine Learning Applications (ICCCMLA)}, 
  title={ScrapLLM: Benchmarking Data Acquisition for Research in Hate Speech Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This study explores the role of Large Language Models (LLMs) in the domain of hate speech detection through dataset generation and analysis. By combining social media scraping with prompt engineering, we developed a benchmark dataset of 1,000 entries encompassing multiple categories of hate speech using ChatGPT as a case study. The methodology demonstrates how LLMs can be harnessed not only for detection but also for synthetic data generation, thereby enriching resources for research. At the same time, the work highlights the risks of adversarial misuse, particularly through jailbreaking prompts that bypass safety filters and elicit harmful outputs. Addressing such vulnerabilities remains a critical challenge for the responsible deployment of LLMs. Ethical concerns-including privacy, consent, and potential misuse-were integrated throughout the study to ensure that the dataset serves constructive purposes only. Overall, this research contributes to responsible AI by providing both technical insights and ethical considerations for LLM-based dataset generation.},
  keywords={Modeling;Hate speech;Printing;Large language models;Social networking (online);Voice activity detection;Filtering;Chatbots;Artificial intelligence;Filters;Hate speech detection;Large Language Models;Data acquisition;JailBreaking;Benchmarking;Ethical AI},
  doi={10.1109/ICCCMLA66092.2025.11580539},
  ISSN={},
  month={Nov},}

@INPROCEEDINGS{11581051,
  author={Sodankoor, Prerana and Joshi, Sampada and K, Vinodha},
  booktitle={2025 IEEE 7th International Conference on Cybernetics, Cognition and Machine Learning Applications (ICCCMLA)}, 
  title={SecurePrompt – Detecting and Mitigating Prompt Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Prompt injection attacks pose serious security and privacy risks in applications that use large language models (LLMs) and sensitive data. Conventional techniques that rely on input validation at the single layer are unable to identify intricate attack vectors or stop the disclosure of private information. To solve these issues in LLM-based systems, a multi-layer defense architecture is suggested. The design adds a Response layer and a Prompt Validation layer. To assess the safety of prompts and responses, each layer combines machine learning models with static rule-based classification. Unsafe instances are either blocked or referred for further administrative review. Feedback loops facilitate continuous filtering rule improvement. The architecture incorporates administrative interfaces for updating validation criteria and integrates with the current LLM infrastructure. To lessen the possibility that private information will be exposed by outside retrieval methods, the system supports retrieval augmented generation settings. According to preliminary tests, injection attempts can be detected more accurately than with baseline methods while preserving tolerable latency and user performance.},
  keywords={Modeling;Large language models;Retrieval augmented generation;Filtering;Machine learning;Filters;Architecture;Computer architecture;Finance;Pipelines;Large Language Models;Prompt Injection;Input Validation;Response Filtering;Secure NLP;Retrieval Augmented Generation;AI Safety;Machine Learning Security;Content Moderation;Adversarial Attacks},
  doi={10.1109/ICCCMLA66092.2025.11581051},
  ISSN={},
  month={Nov},}

@INPROCEEDINGS{11526251,
  author={Hossain, S M Asif and Shayoni, Ruksat Khan and Ameen, Mohd Ruhul and Islam, Akif and Mridha, M. F. and Shin, Jungpil},
  booktitle={2025 IEEE International Women in Engineering (WIE) Conference on Electrical and Computer Engineering (WIECON-ECE)}, 
  title={A Multi-Agent LLM Defense Pipeline Against Prompt Injection Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={207-212},
  abstract={Prompt injection attacks represent a major vulnerability in Large Language Model (LLM) deployments, where malicious instructions embedded in user inputs can override system prompts and induce unintended behaviors. This paper presents a novel multi-agent defense framework that employs specialized LLM agents in coordinated pipelines to detect and neutralize prompt injection attacks in real-time. We evaluate our approach using two distinct architectures: a sequential chain-ofagents pipeline and a hierarchical coordinator-based system. Our comprehensive evaluation on 55 unique prompt injection attacks, grouped into 8 categories and totaling 400 attack instances across two LLM platforms (ChatGLM and Llama2), demonstrates significant security improvements. Without defense mechanisms, baseline Attack Success Rates (ASR) reached $\mathbf{3 0 \%}$ for ChatGLM and 20 % for Llama2. Our multi-agent pipeline achieved 100 % mitigation, reducing ASR to 0 % across all tested scenarios. The framework demonstrates robustness across multiple attack categories including direct overrides, code execution attempts, data exfiltration, and obfuscation techniques, while maintaining system functionality for legitimate queries.},
  keywords={Modeling;Large language models;Pipelines;Automatic speech recognition;Printing;Architecture;Computer architecture;Taxonomy;Security;Filtering;Large Language Models;Prompt Injection;Multi-Agent Systems;Cybersecurity;AI Safety},
  doi={10.1109/WIECON-ECE69386.2025.11526251},
  ISSN={2837-8245},
  month={Dec},}

@INPROCEEDINGS{11501150,
  author={Bhardwaj, Nimit and Bhardwaj, Anvit and Garg, Lavanya},
  booktitle={2025 3rd International Conference on Sustainable Computing and Smart Systems (ICSCSS)}, 
  title={Hallucination-Aware, Injection-Resistant LLMs for Scientific Text Integrity}, 
  year={2025},
  volume={},
  number={},
  pages={2117-2123},
  abstract={Large language models are increasingly used in scientific writing and enterprise applications, yet remain vulnerable to two critical issues: hallucination and prompt injection. Hallucinations introduce fabricated or inaccurate information, undermining trust and reproducibility in generated text. Prompt injections manipulate model behavior by exploiting instruction-following tendencies, posing security risks in dynamic input environments. This paper proposes SciGuard, a unified framework designed to detect hallucinated content and defend against prompt-based adversarial manipulation. The architecture integrates token-level classification, contradiction-aware logic validation, and semantic prompt rewriting to handle both threats in real time. Experiments conducted on scientific and enterprise benchmarks show that SciGuard outperforms existing models across precision, recall, and F1 metrics while maintaining low latency. The results highlight the effectiveness of integrating factual verification and input control into a single system, offering a robust foundation for secure and reliable generative AI deployments.},
  keywords={Filtering;Filters;Circuits and systems;Internet of Things;Communication systems;Internet;Protocols;HTTP;Wide area networks;Computer networks;Hallucination Detection;Prompt Injection Defense;Large Language Models;Scientific Text Verification;Adversarial Prompt Rewriting;Real-Time AI Security},
  doi={10.1109/ICSCSS64956.2025.11501150},
  ISSN={},
  month={Aug},}

@INPROCEEDINGS{11500704,
  author={Yadav, Mohit},
  booktitle={2025 3rd International Conference on Sustainable Computing and Smart Systems (ICSCSS)}, 
  title={The Role of Large Language Models in Cybersecurity: Strengths, Vulnerabilities, and Mitigation Strategies}, 
  year={2025},
  volume={},
  number={},
  pages={1983-1990},
  abstract={Large Language Models (LLMs) have transformed cybersecurity by enhancing threat detection, predictive analysis, and automated security response. These models analyse vast cybersecurity datasets, identify anomalies, and support real-time decision-making in applications such as phishing detection, malware classification, and intrusion detection. However, despite their advantages, LLMs pose critical risks, including adversarial attacks, data leakage, and biased decision-making. Cybercriminals actively exploit these vulnerabilities through prompt injection, model inversion, and misinformation generation. Traditional cybersecurity approaches rely on rule-based systems and signature-based detection methods, which struggle against evolving threats such as zero-day attacks and polymorphic malware. The increasing complexity and volume of cyber threats demand more adaptive solutions. Recent advancements in AI-driven security have integrated LLMs with deep learning (DL) techniques, improving detection accuracy and response efficiency. Transfer learning (TL), adversarial training, and fine-tuning techniques have enhanced the adaptability and robustness of LLM-based cybersecurity frameworks. This research explores the role of LLMs in cybersecurity, analysing their strengths, vulnerabilities, and mitigation strategies. It evaluates key challenges, including adversarial robustness, privacy risks, and model bias, while investigating AI-driven solutions to enhance security operations. Research highlights the effectiveness of LLMs in improving automated threat detection and response, with recommendations for enhancing model interpretability, mitigating security risks, and integrating hybrid AI frameworks to develop scalable cybersecurity solutions. By addressing the evolving domain of AI-driven cybersecurity, this research provides valuable insights into the optimization of LLMs for cyber threat detection, resilience against adversarial attacks, and the future of AI-enhanced security infrastructure.},
  keywords={Feeds;Antennas;Radio broadcasting;Frequency modulation;Filtering;System-on-chip;Filters;Circuits;Feedback;Application specific integrated circuits;Large Language Models;Cybersecurity;Threat Detection;Adversarial Attacks;Mitigation Strategies;AI-Driven Security},
  doi={10.1109/ICSCSS64956.2025.11500704},
  ISSN={},
  month={Aug},}

@INPROCEEDINGS{11491276,
  author={Islam, Md. Mazharul and Ahmed, Mubasshir and Khan, Niaz Ashraf},
  booktitle={2025 28th International Conference on Computer and Information Technology (ICCIT)}, 
  title={CPS-Guard: Defensive Architectures for Securing Large Language Models in Cyber-Physical Systems}, 
  year={2025},
  volume={},
  number={},
  pages={2802-2807},
  abstract={Cyber-physical systems (CPS) are increasingly adopting large language models (LLMs) for log analysis, operator support, and anomaly triage. While LLMs enable powerful reasoning and flexible natural-language interaction, their probabilistic and opaque behavior introduces new attack surfaces, including prompt injection, adversarial manipulation, and privacy leakage. Existing CPS defenses largely assume deterministic models and do not account for LLM-specific threats, whereas current LLM safety work rarely targets real-time, safety-critical control environments. To bridge this gap, we propose CPS-Guard, a defense-in-depth architecture for LLM-enabled CPS that operates under advisory-only semantics. CPS-Guard combines secure prompt handling, explicit threat modeling, a deterministic safety validator with policy and bounds checking, and anomaly-based veto over plant telemetry. We implement CPS-Guard as middleware between CPS controllers and an aligned LLM, and evaluate it on 300 synthetically generated adversarial inputs spanning prompt injection, adversarial perturbations, and poisoning-style triggers. Compared to an unprotected LLM advisory baseline, CPS-Guard reduces failure rates by more than 85 % while incurring only 10 18 % additional latency across small to large CPS workloads. These results indicate that system-level hardening can make LLM-assisted CPS substantially more robust without violating real-time constraints.},
  keywords={Telemetry;Aerospace and electronic systems;Filtering;Filters;Central Processing Unit;System-on-chip;Feedback;Circuits;Circuits and systems;Electronic circuits;Cyber-Physical Systems (CPS);Large Language Models (LLMs);Prompt Injection;Adversarial Robustness;Anomaly Detection;Defense-in-Depth;LLM Security},
  doi={10.1109/ICCIT68739.2025.11491276},
  ISSN={2474-9656},
  month={Dec},}

@INPROCEEDINGS{11490549,
  author={Rahman, Md. Musfiqur and Eti, Afsana Mimi and Mokit, Junaid Rahman and Mou, Sadia Afrin and Sarkar, Soumitro and Shibly, Mir Moynuddin Ahmed},
  booktitle={2025 28th International Conference on Computer and Information Technology (ICCIT)}, 
  title={A Reproducible Benchmark for Prompt Injection Vulnerability Assessment in Small-To-Medium Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents a reproducible, automated benchmarking infrastructure to automatically evaluate promptinjection and jailbreak vulnerabilities across small- to mediumscale language models. Our assessment uses a dynamic set of 225 adversarial prompts, sourced from 75 baselines across AdvBench, HarmfulQA, and JailbreakBench, resulting in 2,250 model-prompt interactions across ten Ollama-hosted systems. Model output is evaluated according to a hybrid dual-judge approach-an LLM-based judge with phi-3 fallback-aidsed by keyword-driven heuristics, the results being analyzed under strict statistical controls (Welch's t-tests adjusted for Bonferroni multiple-comparison penalty). Empirical results report a mean Attack Success Rate (ASR) of 65.2 %, albeit significant variance across models $(0.44 \%-97.3 \%$; e.g., TinyLlama, 97.3 %, SmolLM-135M, 93.8%, LLaMA-3, 0.44%). Additional analysis reveals variance between attack typologies and prompt sources, authority-based attacks achieving an ASR, on average, of 69.1 %, and JailbreakBench prompts the most effective overall (74.4 %). Collectively, these results demonstrate wide disparities in model robustness, establish principled methodology for vulnerability evaluation, and provide actionable guidance toward mitigating adversarial exploitation of language models.},
  keywords={Payloads;Radio broadcasting;Frequency modulation;Filtering;Filters;Circuits and systems;Radio access networks;Regional area networks;Protocols;HTTP;Prompt injection;Jailbreaking;Language models;Adversarial attacks;Model vulnerability;Machine learning security;Statistical analysis;Ollama;Automated benchmarking},
  doi={10.1109/ICCIT68739.2025.11490549},
  ISSN={2474-9656},
  month={Dec},}

@INPROCEEDINGS{11491067,
  author={Sami, Aftar Ahmad and Debnath, Gourob and Dey, Rajon and Chowdhury, Abdulla Nasir},
  booktitle={2025 28th International Conference on Computer and Information Technology (ICCIT)}, 
  title={Code Poisoning Through Misleading Comments: Jailbreaking Large Language Models via Contextual Deception}, 
  year={2025},
  volume={},
  number={},
  pages={3812-3817},
  abstract={Large language models (LLMs) increasingly underpin everyday software tooling; yet, their deference to surrounding comments creates a subtle yet potent attack surface. We demonstrate a new jail-break technique that hides prohibited requests inside ostensibly educational or maintenance comments, inducing models to emit disallowed code and instructions despite alignment safeguards. To quantify the risk, we assemble a 200 prompt benchmark covering seven harm categories (e.g., physical, economic, malware) and five narrative frames (e.g., research simulation, penetration testing), each expressed as short Python snippets with carefully crafted deceptive annotations. A $3 \times 3$ factorial study probes three state-of-the-art LLMs like Gemini-2.0Flash, DeepSeek-R1-Distill-LLaMA-70B, and LLaMA-3.3-70BVersatile, evaluating $\mathbf{1, 8 0 0}$ generations with automated rules plus expert adjudication for both “harmfulness” and “harm awareness”. Attacks succeed in $\mathbf{6 3 \%} \boldsymbol{-} \mathbf{9 3. 5 \%}$ of cases; LLaMA-3.3-70B-Versatile proves most susceptible, while malware and illegal activity prompts achieve near-perfect bypass rates. More than half of successful outputs are produced “harmful & unaware,” indicating that current safety layers frequently fail silently rather than refuse. The results call for comment-level auditing whenever LLMs are deployed in production code workflows.},
  keywords={Filtering;Feedback;Filters;Circuits;Circuits and systems;Internet;Protocols;Communication systems;Computer networks;HTTP;Adversarial attack;Code poisoning;Large language models (LLMs);Jailbreaking;Contextual deception;Code comments;LLM vulnerabilities;AI safety},
  doi={10.1109/ICCIT68739.2025.11491067},
  ISSN={2474-9656},
  month={Dec},}

@INPROCEEDINGS{11491115,
  author={Parupally, Vamshidhar Reddy and Gottam, Monisha},
  booktitle={2025 28th International Conference on Computer and Information Technology (ICCIT)}, 
  title={HiddenGuard: Real-Time Detection and Mitigation of Steganographic Prompt Injection Attacks in Multimodal Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={2360-2365},
  abstract={Multimodal Large Language Models (MLLMs) enable powerful cross-modal reasoning but expose new security risks. One such threat is steganographic prompt injection, where malicious instructions are hidden in images. Existing defenses either incur high latency or fail to detect sophisticated attacks. We propose HiddenGuard, a real-time detection framework integrating (1) cross-modal consistency analysis, (2) wavelet-based steganographic detection, and (3) context-aware threat assessment. HiddenGuard achieves 94.7% accuracy with under 50 ms latency, outperforming prior methods while reducing overhead by 67%.},
  keywords={Payloads;Military aircraft;Space technology;Feeds;Filtering;Filters;Circuits and systems;Protocols;Pixel;HTTP;Multimodal AI security;steganographic prompt injection;vision-language models;real-time threat detection;cross-modal consistency;wavelet steganalysis;adaptive threat assessment;adversarial robustness;MLLMs;AI safety},
  doi={10.1109/ICCIT68739.2025.11491115},
  ISSN={2474-9656},
  month={Dec},}

@INPROCEEDINGS{11446016,
  author={Zhao, Shiji and Duan, Ranjie and Wang, Fengxiang and Chen, Chi and Kang, Caixin and Ruan, Shouwei and Tao, Jialing and Chen, YueFeng and Xue, Hui and Wei, Xingxing},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={Jailbreaking Multimodal Large Language Models via Shuffle Inconsistency}, 
  year={2025},
  volume={},
  number={},
  pages={2045-2054},
  abstract={Multimodal Large Language Models (MLLMs) have achieved impressive performance and have been put into practical use in commercial applications, but they still have potential safety mechanism vulnerabilities. Jailbreak attacks are red teaming methods that aim to bypass safety mechanisms and discover MLLMs' potential risks. Existing MLLMs' jailbreak methods often bypass the model's safety mechanism through complex optimization methods or carefully designed image and text prompts. Despite achieving some progress, they have a low attack success rate on commercial closed-source MLLMs. Unlike previous research, we empirically find that there exists a Shuffle Inconsistency between MLLMs' comprehension ability and safety ability for the shuffled harmful instruction. That is, from the perspective of comprehension ability, MLLMs can understand the shuffled harmful text-image instructions well. However, they can be easily bypassed by the shuffled harmful instructions from the perspective of safety ability, leading to harmful responses. Then we innovatively propose a text-image jailbreak attack named SI-Attack. Specifically, to fully utilize the Shuffle Inconsistency and overcome the shuffle randomness, we apply a query-based black-box optimization method to select the most harmful shuffled inputs based on the feedback of the toxic judge model. A series of experiments show that SI-Attack can effectively improve the attack's performance on three benchmarks for both open-source and closed-source MLLMs. Warning: This paper contains examples of harmful texts and images, and reader discretion is recommended.},
  keywords={Filtering;Feedback;Filters;Circuits;Circuits and systems;Pixel;Communication systems;Protocols;Internet;HTTP;jailbreak attack;mllms;shullfe inconsistency;ai safety},
  doi={10.1109/ICCV51701.2025.00198},
  ISSN={2380-7504},
  month={Oct},}

@INPROCEEDINGS{11446151,
  author={Wang, Ruofan and Li, Juncheng and Wang, Yixu and Wang, Bo and Wang, Xiaosen and Teng, Yan and Wang, Yingchun and Ma, Xingjun and Jiang, Yu-Gang},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={Ideator: Jailbreaking and Benchmarking Large Vision-Language Models Using Themselves}, 
  year={2025},
  volume={},
  number={},
  pages={8875-8884},
  abstract={As large Vision-Language Models (VLMs) gain prominence, ensuring their safe deployment has become critical. Recent studies have explored VLM robustness against jailbreak at-tacks-techniques that exploit model vulnerabilities to elicit harmful outputs. However, the limited availability of diverse multimodal data has constrained current approaches to rely heavily on adversarial or manually crafted images derived from harmful text datasets, which often lack effectiveness and diversity across different contexts. In this paper, we propose IDEATOR, a novel jailbreak method that autonomously generates malicious image-text pairs for black-box jailbreak attacks. IDEATOR is grounded in the insight that VLMs themselves could serve as powerful red team models for generating multimodal jailbreak prompts. Specifically, IDEATOR leverages a VLM to create targeted jailbreak texts and pairs them with jailbreak images generated by a state-of-the-art diffusion model. Extensive experiments demonstrate IDEATOR's high effectiveness and transferability, achieving a 94% attack success rate (ASR) in jailbreaking MiniGPT-4 with an average of only 5.34 queries, and high ASRs of $82 \%, 88 \%$, and 75 % when transferred to LLaVA, InstructBLIP, and Chameleon, respectively. Building on IDEATOR's strong transferability and automated process, we introduce the VLJailbreakBench, a safety benchmark comprising 3,654 multimodal jailbreak samples. Our benchmark results on 11 recently released VLMs reveal significant gaps in safety alignment. For instance, our challenge set achieves ASRs of 46.31% on GPT40 and 19.65% on Claude-3.5-Sonnet, underscoring the urgent need for stronger defenses. Disclaimer: This paper contains content that may be disturbing or offensive.},
  keywords={Weapons;Filtering;Filters;Feedback;Circuits;Circuits and systems;Internet;Communication systems;Protocols;Radio access networks;red teaming;jailbreak attack;black-box attack;vision-language model},
  doi={10.1109/ICCV51701.2025.00830},
  ISSN={2380-7504},
  month={Oct},}

@INPROCEEDINGS{11444556,
  author={Ma, Teng and Jia, Xiaojun and Duan, Ranjie and Li, Xinfeng and Huang, Yihao and Jia, Xiaoshuang and Chu, Zhixuan and Ren, Wenqi},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={Heuristic-Induced Multimodal Risk Distribution Jailbreak Attack for Multimodal Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={2686-2696},
  abstract={With the rapid advancement of multimodal large language models (MLLMs), concerns regarding their security have increasingly captured the attention of both academia and industry. Although MLLMs are vulnerable to jailbreak attacks, designing effective jailbreak attacks poses unique challenges, especially given the highly constrained adversarial capabilities in real-world deployment scenarios. Previous works concentrate risks into a single modality, resulting in limited jailbreak performance. In this paper, we propose a heuristic-induced multimodal risk distribution jailbreak attack method, called HIMRD, which is black-box and consists of two elements: multimodal risk distribution strategy and heuristic-induced search strategy. The multimodal risk distribution strategy is used to distribute harmful semantics into multiple modalities to effectively circumvent the single-modality protection mechanisms of MLLMs. The heuristic-induced search strategy identifies two types of prompts: the understanding-enhancing prompt, which helps MLLMs reconstruct the malicious prompt, and the inducing prompt, which increases the likelihood of affirmative outputs over refusals, enabling a successful jailbreak attack. HIMRD achieves an average attack success rate (ASR) of 90% across seven open-source MLLMs and an average ASR of around 68% in three closed-source MLLMs. HIMRD reveals cross-modal security vulnerabilities in current MLLMs and underscores the imperative for developing defensive strategies to mitigate such emerging risks. Code is available at https://github.com/MaTengSYSU/HIMRDjailbreak.},
  keywords={Feeds;Communication systems;Protocols;Regional area networks;Radio access networks;HTTP;Local area networks;Amplitude shift keying;Internet;Location awareness;mllm security;jailbreak attack},
  doi={10.1109/ICCV51701.2025.00258},
  ISSN={2380-7504},
  month={Oct},}

@INPROCEEDINGS{11445897,
  author={Wang, Jiawei and Zuo, Yushen and Chai, Yuanjun and Liu, Zhendong and Fu, Yicheng and Feng, Yichun and Lam, Kin-Man},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={Safeguarding Vision-Language Models: Mitigating Vulnerabilities to Gaussian Noise in Perturbation-Based Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={2773-2782},
  abstract={Vision-Language Models (VLMs) extend the capabilities of Large Language Models (LLMs) by incorporating visual information, yet they remain vulnerable to jailbreak attacks, especially when processing noisy or corrupted images. Although existing VLMs adopt security measures during training to mitigate such attacks, vulnerabilities associated with noise-augmented visual inputs are overlooked. In this work, we identify that missing noise-augmented training causes critical security gaps: many VLMs are susceptible to even simple perturbations such as Gaussian noise. To address this challenge, we propose Robust-VLGuard, a multimodal safety dataset with aligned / misaligned imagetext pairs, combined with noise-augmented fine-tuning that reduces attack success rates while preserving functionality of VLM. For stronger optimization-based visual perturbation attacks, we propose DiffPure-VLM, leveraging diffusion models to convert adversarial perturbations into Gaussian-like noise, which can be defended by VLMs with noise-augmented safety fine-tuning. Experimental results demonstrate that the distribution-shifting property of diffusion model aligns well with our fine-tuned VLMs, significantly mitigating adversarial perturbations across varying intensities. The dataset and code are available at https://github.com/JarvisUSTC/DiffPureRobustVLM},
  keywords={Feeds;Feedback;Circuits;Pixel;LoRa;Protocols;Product development;Radio access networks;Regional area networks;HTTP;multimodal large language models;gaussian noise;adversarial defense;safety alignment},
  doi={10.1109/ICCV51701.2025.00266},
  ISSN={2380-7504},
  month={Oct},}

@INPROCEEDINGS{11476245,
  author={Lopez-Juarez, Ismael and Lopez-Valadez, Kieran I and Castillo-Barrientos, Luis A.},
  booktitle={2025 IEEE CHILEAN Conference on Electrical, Electronics Engineering, Information and Communication Technologies (CHILECON)}, 
  title={Zero-Shot Robotic Control via Custom LLM Agents: A Lightweight Framework for Embodied Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={This work presents an AI-powered framework for autonomous robot control using a custom large language model (LLM) agent built with DeepSeek. By leveraging document-based prompt injection, the system incorporates domain-specific knowl-edge—such as robot specifications and API documentation—into the LLM to enable zero-shot Python code generation. The agent extracts and executes code in real time to control a myCobot 280 Pi robotic arm, operating entirely offline without persistent cloud connectivity. A modular pipeline automates the workflow from natural language input to subprocess-based code execution. Experimental results demonstrate the agent's ability to interpret high-level voice or text instructions and translate them into functional robot behaviors. Although the current implementation is focused on motion tasks without sensory feedback, the architecture lays the groundwork for future integration of multimodal perception and closed-loop control. This study highlights the potential of lightweight, locally-deployable LLMs for intuitive human-robot interaction and rapid prototyping in edge robotics.},
  keywords={Feedback;Circuits;Graphical user interfaces;Communications technology;Product development;Information and communication technology;Radio access networks;Regional area networks;Protocols;Electronic mail;Large Language Models;Zero-Shot Learning;Robot Control;myCobot;DeepSeek;Edge AI;Prompt Engineering},
  doi={10.1109/CHILECON66915.2025.11476245},
  ISSN={2832-1537},
  month={Oct},}

@INPROCEEDINGS{11473001,
  author={Farlow, Harriet and Garratt, Matt and Mount, Gavin and Lynar, Tim},
  booktitle={2025 International Conference on Computational Intelligence, Security, and Artificial Intelligence (IntelliSecAI)}, 
  title={Quantifying AI Security Coverage: A Metric-Based Evaluation Across Five Governance Frameworks}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={As artificial intelligence (AI) systems are increasingly integrated into more systems, there is a requirement to extend cyber and information security risk management into AI security. AI security refers to the technical and governance mechanisms that protect AI systems from external threats. A gap analysis of AI security coverage was conducted across five AI risk frameworks: National Institute of Standards and Technology's (NIST) AI Risk Management Framework (RMF), the European Union (EU) AI Act, Microsoft's Guide for Securing the AI-Powered Enterprise (GSAIPE), International Standards Organisation (ISO)/IEC 42001, and the United Kingdom's National Cyber Security Centre (NCSC) AI Security Guidelines. We define a Normalised Coverage-Depth Score (CDS) metric to systematically compare controls recommended by each framework and which risk factors they address. We perform qualitative assessment on two case studies: prompt injection and model evasion. We combine these insights to build on existing AI risk management scholarship and propose targeted recommendations for addressing AI security risk assessment and strategic prioritisation.},
  keywords={Filtering;Filters;HTTP;Protocols;Unsolicited e-mail;Artificial intelligence;Machine learning;Large language models;Computational intelligence;Retrieval augmented generation;AI Security;Cybersecurity Frameworks;Risk Management;Adversarial Machine Learning;Compliance;Regulation;AI Governance},
  doi={10.1109/IntelliSecAI66368.2025.11473001},
  ISSN={},
  month={Dec},}

@INPROCEEDINGS{11472287,
  author={Kim, Hyun Jung and Yoo, Sang Hyun},
  booktitle={2025 5th International Conference on Electrical, Computer and Energy Technologies (ICECET)}, 
  title={Prompt Injection Vulnerabilities and Data Leakage in ChatGPT and Claude: Toward Safer Conversational AI}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={The security vulnerabilities of large language models (LLMs) have emerged as a critical concern due to their widespread adoption. Conversational AI systems such as ChatGPT and Claude, in particular, are exposed to prompt injection attacks and data-leakage risks. However, there has been limited research directly comparing the security vulnerabilities of models employing different alignment techniques (reinforcement learning from human feedback, RLHF, vs. Constitutional AI). In this paper, we analyze the responses of ChatGPT and Claude to over 50 diverse prompt attacks under identical experimental conditions. Both models completely defended against simple one-shot attacks (attack success rate, ASR = 0%), but for complex multi-turn attacks, ChatGPT and Claude exhibited ASRs of 22% and 17%, respectively. Interestingly, ChatGPT proved more susceptible to gradual context manipulation, whereas Claude was more vulnerable to authority-mimicking attacks—patterns we attribute to their respective alignment methods. Based on these findings, we propose novel defense strategies, including multi-layer AI filtering, attention-based detection mechanisms, and continual adversarial retraining. The limitations of this study include the rapid evolution of tested model versions and a restricted attack set. Future work should focus on deploying the proposed defenses in operational environments and developing standardized benchmarks for adversarial robustness across different alignment paradigms.},
  keywords={Nuclear weapons;Feedback;Filtering;Filters;MIMICs;Circuits;Millimeter wave integrated circuits;Monolithic integrated circuits;Circuits and systems;Internet of Things;Conversational AI;prompt injection;data leakage;security vulnerabilities;reinforcement learning from human feedback (RLHF);Constitutional AI;adversarial attacks;multi-layer defense;continual learning},
  doi={10.1109/ICECET63943.2025.11472287},
  ISSN={},
  month={July},}
