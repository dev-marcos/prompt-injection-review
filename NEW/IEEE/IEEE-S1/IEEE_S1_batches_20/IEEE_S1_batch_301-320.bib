@INPROCEEDINGS{11348502,
  author={Saad, Muhammad and Mughal, Shafaq Fatima and Mustafa, Muhammad and Ahmed, Ikhlas and Masood, Adnan},
  booktitle={2025 27th International Multitopic Conference (INMIC)}, 
  title={Assessing and Mitigating Multi-Turn Jailbreak Vulnerabilities in Large Language Models: A Crescendo Attack Study}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models (LLMs) are vulnerable to multi-turn jailbreak attacks like Crescendo, which exploit context retention to bypass safety mechanisms and generate harmful outputs. This study is among the first to address the gap in understanding vulnerabilities of LLMs released after 2024 by reproducing the Crescendo attack on six recent models. We introduce two novel mitigation strategies—prompt hardening and LLM-as-guardrail—evaluated via Attack Success Rates (ASRs) across 15 tasks. Our contributions include these mitigation strategies, a comprehensive vulnerability assessment, and an open-source framework shared under the MIT License to foster collaborative AI safety research. Findings reveal that Llama-3.1-8b-Instruct (Llama 3.1) was the most resistant, achieving the lowest ASRs in 9 of 15 categories due to robust safety alignment, while DeepSeek-R1-Distill-Qwen-32B (DeepSeek R1) was highly vulnerable with 1.0 ASRs in 13 categories. Prompt hardening significantly outperformed LLM-as-guardrail, reducing ASRs effectively across models, though DeepSeek R1 maintained 1.0 ASRs despite mitigations. These results underscore prompt hardening as a superior defense, enhancing LLM security for safer deployment in critical domains like healthcare, education, and public policy.},
  keywords={Resistance;Ethics;Prevention and mitigation;Large language models;Education;Medical services;Licenses;Safety;Security;Public policy;Large Language Models;Crescendo Attack;Jailbreaking;Prompt Hardening;LLM-as-guardrail;AI Safety;Ethical AI},
  doi={10.1109/INMIC65900.2025.11348502},
  ISSN={2835-8864},
  month={Dec},}

@INPROCEEDINGS{11344243,
  author={Ding, Zi Han and Labrinidis, Alexandros},
  booktitle={2025 IEEE International Conference on Collaborative Advances in Software and COmputiNg (CASCON)}, 
  title={DaMiT-SQL: Detecting and Mitigating Text-to-SQL Prompt Injection Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={641-646},
  abstract={Large Language Models (LLMs) are known for their ability to understand and respond to human instructions/prompts. As such, LLMs can be used to produce natural language interfaces for databases. However, LLMs also have an attack surface that, if not properly secured, can cause serious damage. This paper aims to explore the possibilities of exploiting LLMs as an attack surface for SQL injection. The paper proposes a time- and cost-efficient approach to quickly detect malicious prompts by comparing the semantic similarity of the attack against a dedicated list of known patterns.},
  keywords={Databases;Large language models;Computational modeling;Semantics;Natural languages;Collaboration;SQL injection;Software;Hardware;Data models;security;text-to-sql injection;prompt injection;embeddings},
  doi={10.1109/CASCON66301.2025.00116},
  ISSN={},
  month={Nov},}

@INPROCEEDINGS{11337832,
  author={Obeng, Collins P and Narasinghe, Nethshan M and Striker, Ryan and Vazquez, Enrique Alvarez},
  booktitle={2025 Cyber Awareness and Research Symposium (CARS)}, 
  title={Security Framework for Agentic Home AI in Preventive Healthcare: Cyber Threats Worth Noting}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={The integration of agentic artificial intelligence (AI) into home-based preventive healthcare promises a new era of personalized, proactive wellness management. However, the autonomy of these systems introduces significant cybersecurity and data privacy challenges, particularly concerning the handling of Protected Health Information (PHI). This paper seeks to create awareness on some of the cyber threats' worth noting, and how a proposed locally hosted architectural model as a primary strategy can mitigate certain risks like prompt injection. The proposed architecture utilizes an open-source stacks-comprising n8n (an open-source workflow automation tool) for workflow orchestration, Ollama for serving Large Language Model (LLM) locally, and Supabase for on-premise vector data storage. A “dual-agent guardrail” system is introduced, featuring a dedicated input agent to detect and neutralize prompt injection attacks and an output agent to scan for and prevent PHI leakage, ensuring HIPAA compliance. Our findings conclude that while local hosting is a necessary foundation for establishing data sovereignty and mitigating external threats, it is insufficient on its own. It introduces new risks, including physical security vulnerabilities and a heightened insider threat potential. The dual-agent guardrail system provides a critical second layer of defense, addressing model-level vulnerabilities directly. This multi layered, defense-in-depth strategy, combining a sovereign infrastructure with intelligent, task-specific security agents, presents a risk reduction and practical framework for the secure deployment of agentic AI in personal healthcare.},
  keywords={Agentic AI;Data privacy;Automation;Large language models;Memory;Medical services;Vectors;Automobiles;Computer crime;LLM;agentic AI;cyber threats;cyber security;prompt injection;preventive health care;artificial intelligence},
  doi={10.1109/CARS67163.2025.11337832},
  ISSN={},
  month={Oct},}

@INPROCEEDINGS{11336372,
  author={Zou, Xide},
  booktitle={2025 6th International Conference on Machine Learning and Computer Application (ICMLCA)}, 
  title={KG-Guard: Dynamic Knowledge Graph-Guided Multi-Turn Jailbreak Defense Framework for Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={930-933},
  abstract={Large Language Models (LLMs) are increasingly vulnerable to multi-turn jailbreak attacks that exploit accumulated conversational context to bypass safety constraints. These progressive attacks challenge existing defenses, which often rely on static filters or per-turn steering and lack awareness of long-range semantic evolution. We propose KG-Guard, a dynamic knowledge graph-guided defense framework that models entity-relation evolution across dialogue turns. By incrementally constructing a conversation-level knowledge graph (KG), KGGuard identifies emerging relational patterns that converge toward unsafe objectives. A novel Relation-Convergence Detector (RCD) integrates rule-based path matching and neural graph reasoning to assess convergence risk, enabling proactive intervention through prompt re-steering or response regulation. Experiments on benchmark multi-turn jailbreak datasets show that KG-Guard achieves superior robustness and interpretability, reducing Attack Success Rate (ASR) by 5-8% compared with state-of-the-art defenses while maintaining dialogue fluency.},
  keywords={Large language models;Semantics;Knowledge graphs;Detectors;Robustness;Regulation;Real-time systems;Trajectory;Safety;Security;Large Language Models;Jailbreak Attack Defense;Knowledge Graph;Multi-turn Dialogue Security},
  doi={10.1109/ICMLCA66850.2025.11336372},
  ISSN={},
  month={Oct},}

@INPROCEEDINGS{11334327,
  author={Shan, Wenliang and Fu, Michael and Yang, Rui and Tantithamthavorn, Chakkrit},
  booktitle={2025 2nd IEEE/ACM International Conference on AI-powered Software (AIware)}, 
  title={SEALGuard: Safeguarding the Multilingual Conversations in Southeast Asian Languages for AI-Powered Software}, 
  year={2025},
  volume={},
  number={},
  pages={197-206},
  abstract={Safety alignment is critical for AI-powered systems. While recent LLM-powered guardrail approaches such as LlamaGuard achieve high detection accuracy of unsafe inputs written in English (e.g., “How to create a bomb?”), they struggle with multilingual unsafe inputs. This limitation leaves LLM systems vulnerable to unsafe and jailbreak prompts written in low-resource languages such as those in Southeast Asia. This paper introduces SEALGuard, a multilingual guardrail designed to improve the safety alignment across diverse languages. It aims to address the multilingual safety alignment gap of existing guardrails and ensure effective filtering of unsafe and jailbreak prompts in AI-powered systems. We adapt a generalpurpose multilingual language model into a multilingual guardrail using low-rank adaptation (LoRA). We construct SEALSBench, a large-scale multilingual safety alignment dataset containing over 260,000 prompts in ten languages, including safe, unsafe, and jailbreak cases. We evaluate SEALGuard against state-of-the-art guardrails such as LlamaGuard on this benchmark. Our findings show that multilingual unsafe and jailbreak prompts substantially degrade the performance of the state-of-the-art LlamaGuard, which experiences a drop in Defense Success Rate (DSR) by 9 % and 18 %, respectively, compared to its performance on English-only prompts. In contrast, SEALGuard outperforms existing guardrails in detecting multilingual unsafe and jailbreak prompts, improving DSR by 48 % over LlamaGuard and achieving the best DSR, precision, and F1-score. Our ablation study further reveals the contributions of adaptation strategies and model size to the overall performance of SEALGuard. We release our pre-trained model and benchmark at https://github.com/awsm-research/SEALGuard to support further research.},
  keywords={Human computer interaction;Adaptation models;Filtering;Weapons;Focusing;Oral communication;Benchmark testing;Software systems;Multilingual;Safety;Multilingual safety alignment;AI powered software},
  doi={10.1109/AIware69974.2025.00029},
  ISSN={},
  month={Nov},}

@INPROCEEDINGS{11334709,
  author={Gomez-Rangel, Julia and Lee, Young and Liu, Bozhen},
  booktitle={2025 2nd IEEE/ACM International Conference on AI-powered Software (AIware)}, 
  title={Security in the Wild: An Empirical Analysis of LLM-Powered Applications and Local Inference Frameworks}, 
  year={2025},
  volume={},
  number={},
  pages={149-159},
  abstract={The rapid rise of open-source applications and frameworks powered by large language models (LLMs) has introduced new and complex security risks. While recent studies have explored prompt injection, model misuse, and runtime vulnerabilities in isolated cases, the system-wide security risks of this ecosystem remain underexamined. In this paper, we present an empirical study of security advisories reported through GitHub for popular LLM-Powered Applications (LPAs) and their underlying Local Inference Frameworks (LIFs, such as llama.cpp and vLLM), aiming to surface system-wide security risks across the LLM software stack. We curate and analyze a dataset of $\mathbf{5 0}$ real-world vulnerabilities, classifying them by type, severity, and root cause. Our analysis reveals different risk profiles: LPAs tend to suffer from input-driven web vulnerabilities, while LIFs exhibit memory safety and dependency-related issues. We also identify common and unique characteristics of security vulnerabilities in LPAs and LIFs when compared to traditional open-source projects. Our findings highlight the urgent need for systematic security practices, better disclosure mechanisms, and lifecycleaware defenses across the rapidly evolving LLM software stack.},
  keywords={Systematics;Runtime;Ecosystems;Pipelines;Full stack;Safety;Maintenance;Security;Open source software;Software development management;LLM-Powered Application;Local Inference Framework;GitHub Security Advisory;Open-Source Software Development},
  doi={10.1109/AIware69974.2025.00024},
  ISSN={},
  month={Nov},}

@INPROCEEDINGS{11327728,
  author={Shi, Tuo and Li, Danyang},
  booktitle={2025 International Conference on Advances in Electrical Engineering and Computer Applications (AEECA)}, 
  title={ACPO: An Automated Contextual Prompt Optimization Using the Snake Optimizer and Self-Feedback Mechanism}, 
  year={2025},
  volume={},
  number={},
  pages={827-833},
  abstract={Prompt-based learning has become a powerful strategy for adapting large language models (LLMs) to various natural language processing (NLP) tasks. However, manually crafting effective prompts remains labor-intensive and often suboptimal. To address this challenge, we propose Automated Contextual Prompt Optimization (ACPO)—a novel three-stage framework that integrates self-reflective feedback, Easy Data Augmentation (EDA), and heuristic search via a Snake Optimizer. Starting from a base prompt, ACPO iteratively improves task instructions by analyzing classification errors, generating diversified prompt variants, and adaptively searching the prompt space for optimal performance. Extensive experiments on three benchmark datasets—Ethos, Liar, and Jailbreak—demonstrate that ACPO significantly outperforms existing prompt optimization baselines such as ProTeGi, PromptBoosting, and APO in terms of F1-score, accuracy, and convergence stability. Moreover, ablation and base-model transfer experiments confirm the robustness and generalizability of ACPO under various model architectures. Our results highlight the potential of combining reflective generation, semantic augmentation, and biologically inspired optimization for automated prompt engineering.},
  keywords={Accuracy;Large language models;Text categorization;Semantics;Data augmentation;Stability analysis;Robustness;Prompt engineering;Iterative methods;Optimization;prompt optimization;large language models;text classification;snake optimizer;data augmentation;self-feedback learning},
  doi={10.1109/AEECA65693.2025.00150},
  ISSN={},
  month={Aug},}

@INPROCEEDINGS{11329228,
  author={Özçelik, Melik Buğra and Şentaş, Ali and Koçyiğit, Berkecan and Özen, Sinan and Akmeşe, Arda},
  booktitle={2025 16th International Conference on Electrical and Electronics Engineering (ELECO)}, 
  title={A Study on Cross-Lingual Security Vulnerabilities in Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={In this study, we look at how Large Language Models (LLMs) trained mostly in English react to prompt injection (PI) attacks written in other languages, especially Turkish. We tested several open-weight models such as Gemma3n-e4b, Gemma3-27b, and Llama3.3-70b. In our tests, we compared direct and indirect attacks and tried simple defenses. The results show that direct attacks are usually stronger, reaching more than 90% success in bigger models. Indirect attacks are weaker but still a real risk. We also saw that English prompts often succeed more than Turkish ones, but this gap becomes smaller as the model size grows. Current defenses only lower the risk a little and sometimes even make it worse. Our study shows that LLM security depends on both language and model size, and that better multilingual defenses are needed.},
  keywords={Large language models;Cross lingual;Multilingual;Security},
  doi={10.1109/ELECO69582.2025.11329228},
  ISSN={},
  month={Nov},}

@INPROCEEDINGS{11323496,
  author={Hu, Shijing and Wang, Xinyu and Guo, Hengqi and Lu, Zhihui},
  booktitle={2025 IEEE Cyber Science and Technology Congress (CyberSciTech)}, 
  title={GuardCache: Memory-Augmented Adaptive Input Security for LLM Semantic Caching in FinTech}, 
  year={2025},
  volume={},
  number={},
  pages={140-147},
  abstract={Large-language-model (LLM) services are rapidly permeating the financial sector, yet their high-throughput workloads expose new attack surfaces—especially when semantic caching is used to amortise inference cost. We present Guard-Cache, a memory-augmented, adaptive input-security layer that protects LLM semantic caches deployed in latency-critical financial applications. The framework couples a two-stage "fast-first" filter—regular-expression scans for explicit patterns followed by a distilled transformer for nuanced semantics—with a lightweight behavioural-memory module. The memory component assigns time-decayed privacy-leakage factors and malicious-intent indices, enabling dynamic thresholds that distinguish accidental disclosures from persistent adversarial behaviour. Evaluated on a multi-risk benchmark reflecting real-world FinTech traffic, GuardCache improves average F1-score from 0.86 to 0.91 over a full-BERT baseline while cutting mean detection latency by 32.6%. False-positive rates drop by 38% for benign users, and jailbreak detection F1 rises by 12 absolute points. Ablation studies confirm that (i) regex pre-filters remove 34% of risky inputs at negligible cost, and (ii) behavioural memory raises cache-hit ratios by up to 25% under iterative attacks. These results indicate that memory-driven, adaptively-thresholded input screening is a practical prerequisite for trustworthy, real-time LLM analytics in regulated financial environments, and can be generalised to other privacy-sensitive domains.},
  keywords={Costs;Filtering;Fintech;Large language models;Semantics;Production;Benchmark testing;Transformers;Real-time systems;Security;Large Language Models (LLMs);Semantic Caching;Input Security;FinTech},
  doi={10.1109/CyberSciTech68397.2025.00025},
  ISSN={},
  month={Oct},}

@ARTICLE{11316569,
  author={Xu, Shurui and Luo, Feng and Li, Shuyan and Fan, Mengzhen and Sun, Zhongtian},
  journal={Frontiers of Information Technology & Electronic Engineering}, 
  title={Three Trustworthiness Challenges in Large Language Model-Based Financial Systems: Real-World Examples and Mitigation Strategies}, 
  year={2025},
  volume={26},
  number={10},
  pages={1871-1878},
  abstract={The integration of large language models (LLMs) into financial applications has demonstrated remarkable potential for enhancing decision-making processes, automating operations, and delivering personalized services. However, the high-stakes nature of financial systems demands a very high level of trustworthiness that current LLMs often fail to meet. This study identifies and examines three major trustworthiness challenges in LLM-based financial systems: (1) jailbreak prompts that exploit vulnerabilities in model alignment to produce harmful or noncompliant responses; (2) hallucination, where models generate factually incorrect outputs that can mislead financial decision-making; (3) bias and fairness concerns, where demographic or institutional bias embedded in LLMs may result in unfair treatment of individuals or regions. To make these risks concrete, we design three finance-relevant probes and evaluate a set of mainstream LLMs spanning both proprietary and open-source families. Across models, we observe risky behavior in at least one scenario per probe. Based on these findings, we systematically summarize the existing mitigation strategies that aim to address these risks. We argue that resolving these issues is vital not only for ensuring the responsible use of artificial intelligence (AI) in the financial sector but also for enabling its safe and scalable deployment.},
  keywords={Technological innovation;Prevention and mitigation;Large language models;Decision making;Materials reliability;Machine learning;Regulation;Software reliability;Probes;Intelligent systems},
  doi={10.1631/FITEE.2500421},
  ISSN={2095-9230},
  month={October},}

@INPROCEEDINGS{11319129,
  author={Abdallah, Razane and Sanan, Majed and Nassar, Mohamad},
  booktitle={2025 IEEE International Conference on Emerging Trends in Engineering and Computing (ETECOM)}, 
  title={Evaluating MLLM Security for the Arabic and French Languages}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Warning: This paper contains examples of harmful language and images, and reader discretion is recommended. With the rapid advancement of Multimodal Large Language Models (MLLMs), ensuring their safety against adversarial attacks has become a pressing concern. Most prior research has focused on jailbreaking techniques for text-only Large Language Models (LLMs). The unique vulnerabilities of MLLMs, especially those arising from cross-modal interactions, remain under-explored, especially for the Arabic and French Languages, which are widely used in Lebanon and the region. In this work, we extend the MLLMGuard benchmark, originally designed for the English and Chinese languages, to include Arabic and French by the means of translation. Using the GuardRank framework which accompanies the benchmark, we assess the safety of an MLLM model across five dimensions: privacy, bias, toxicity, legality, and truthfulness. The results demonstrate that MLLMs remain susceptible to adversarial prompts in both Arabic and French. We further demonstrate that the integration of a lightweight safety prompt reduces the attack success rate by 10%. The research aims at raising awareness on the insecurities of MLLM and calls for more robust adversarial defenses.},
  keywords={Privacy;Translation;Toxicology;Large language models;Computational modeling;Pressing;Benchmark testing;Market research;Safety;Security;MLLM;AI Safety;AI;Privacy;Adversarial Attacks},
  doi={10.1109/ETECOM66111.2025.11319129},
  ISSN={},
  month={Oct},}

@INPROCEEDINGS{11310042,
  author={Zhang, Jielun and Li, Fuhao},
  booktitle={MILCOM 2025 - 2025 IEEE Military Communications Conference (MILCOM)}, 
  title={Model-Agnostic Unsupervised Detection of Prompt Injection with Multiscale Perplexity Signatures}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Prompt injection represents a critical and increasingly prevalent threat to the safety and reliability of large language models (LLMs). These attacks enable adversaries to override intended instructions using only natural language, often without access to model parameters or system internals. In this work, we propose a model-agnostic, unsupervised framework for prompt injection detection based on token-level uncertainty dynamics. Specifically, we introduce multi-scale perplexity signatures, i.e., structured representations of model perplexity computed across multiple sliding window sizes, to capture local and global fluctuations in predictive confidence. These signatures serve as input to lightweight statistical classifiers, such as OC-SVMs, which are trained exclusively on clean prompts to detect anomalous inputs. Extensive experiments are conducted on an open dataset, and the results demonstrate that the multiscale perplexity signatures captured by the proposed approach are effective in distinguishing injected prompts from clean ones across multiple detection models.},
  keywords={Military communication;Uncertainty;Fluctuations;Computational modeling;Large language models;Natural languages;Predictive models;Data models;Safety;Anomaly detection;Prompt injection;Large Language Models (LLMs);perplexity signatures;anomaly detection},
  doi={10.1109/MILCOM64451.2025.11310042},
  ISSN={2155-7586},
  month={Oct},}

@INPROCEEDINGS{11306795,
  author={Ding, Hua and Jiang, Yi and Zhan, Zhi-Hui and Zhang, Jun and Kwong, Sam},
  booktitle={2025 15th International Conference on Information Science and Technology (ICIST)}, 
  title={Some Optimization Problems in Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={86-92},
  abstract={Large language model (LLM) is a research hotspot in the field of artificial intelligence (AI). Currently, various LLMs have been designed and have demonstrated outstanding language understanding and generation capabilities in various natural language processing tasks. With the development of LLM research, a spectrum of optimization problems have emerged, posing challenges to the pursuit of further performance gains of LLMs. To enlighten future research on the optimization problems in LLMs, this paper summarizes some significant optimization problems in LLMs and proposes a classification method based on the model’s scope to categorize them. Specifically, this paper focuses on three types of cutting-edge issues namely model merging, prompt engineering, and jailbreaking attack. First, the model merging refers to the optimization problem of the integration of different pre-trained models. Second, the prompt engineering refers to the optimization problem that involves designing effective input prompts to guide LLMs to generate desired responses. Third, the jailbreaking attack refers to the optimization problem that indicates the process of crafting adversarial inputs that can circumvent the safety constraints or ethical guidelines programmed into LLMs. Also, we deeply analyze how evolutionary computation (EC) can empower LLMs with customized optimization solutions through their autonomous learning and efficient search capabilities, significantly improving the automation efficiency. Based on the above analyses, we finally discuss some potential future problem directions of LLM, aiming at promoting the deep integration and innovative development of LLMs in the field of automated optimization, leading to the next generation of AI.},
  keywords={Hands;Technological innovation;Large language models;Computational modeling;Merging;Collaboration;Evolutionary computation;Prompt engineering;Optimization;Systematic literature review;large language models;optimization problems;evolutionary computation;model merging;prompt engineering;jailbreaking attack},
  doi={10.1109/ICIST66592.2025.11306795},
  ISSN={2573-3311},
  month={Dec},}

@INPROCEEDINGS{11308512,
  author={Depuru, SivaKumar and Lakshmi, Kurugunda Radha and Chandrahas, Gopa and Chetana, Mopuri and Reddy, Madduri Vinay Krishna},
  booktitle={2025 International Conference on Sustainable Communication Networks and Application (ICSCN)}, 
  title={Adaptive and Privacy-Preserving Detection of Evolving Prompt Injection Attacks in Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1445-1450},
  abstract={Large Language Models (LLMs) have demonstrated impressive abilities but are extremely vulnerable to prompt injection attacks where malicious inputs bypass the intended instructions, bypass safety mechanisms, or leak sensitive data. Current defences have two severe shortcomings: they are fixed and unresponsive to new attack techniques like obfuscation and multi-turn manipulation, and frequently they impact the privacy of the user by sending unprocessed queries to third-party validation services. Such constraints render existing solutions inappropriate to real-world, privacy-aware activities. This research suggests a privacy-sensitive and adaptive detection architecture that combines continual learning and context-sensitive embeddings, and federated detection pipelines. The framework becomes flexible to new adversarial actions and provides local data confidentiality. According to experimental findings, the detection accuracy is 94.8% and the false positive rate is 4.1, which is higher than that of baseline methods, meanwhile, the obfuscation attack and multi-turn attacks are detected more, with gains of 12.4 and 15.7 percentage points respectively, and latency is real-time (112 ms/query). The model provides a measurable and reliable framework of securing systems powered by LLM.},
  keywords={Resistance;Continuing education;Data privacy;Steganography;Accuracy;Large language models;Semantics;Pipelines;Vectors;Safety;Large Language Models (LLMs);Prompt Injection Attacks;Privacy-Preserving Machine Learning;Continual Learning;Federated Detection;Adversarial Robustness},
  doi={10.1109/ICSCN67106.2025.11308512},
  ISSN={},
  month={Oct},}

@INPROCEEDINGS{11312923,
  author={Liang, Wei and Guo, Zhengkai and Li, Junqiang and Li, Xiaocui and Yang, Junfeng and Zeng, Yangyan and Zhou, Xiaokang},
  booktitle={2025 IEEE International Symposium on Product Compliance Engineering - Asia (ISPCE-ASIA)}, 
  title={Adaptive Two-Layer Inspection Framework for Mitigating Security Risks in Large-Scale Vertical Domain Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Large language models (LLMs) are trained on large amounts of data with diverse and imbalance distribution, therein leading to capability bottlenecks. In vertical domains, incremental domain-specific pre-training has become a common method to capability enhancement. However, without subsequent safety alignment, injecting domain data can perturb the base model’s distribution and increase jailbreak success rates, which may increase the risk of security vulnerabilities in LLMs. Prior work largely emphasizes domain performance gaining from fine-tuning or incremental pre-training, with limited attention to safety risks induced by distributional shifts. In this study, we address this gap by proposing an adaptive twolayer inspection framework that enforces safety checks at both the input and output token levels. On the input side, semantic embeddings and clustering-based intent tagging drive dynamic rule injection against adversarial prompts. On the output side, a speculative decoding guard performs per-token safety classification with thresholding and resampling-based fallback. Experiments on open-source LLMs demonstrate that our framework reduces Attack Success Rate (ASR) under multiple temperatures and remains effective after domain-specific post-training, mitigating Boundary Risk Exposure (BRE) fragmentation while preserving task utility.},
  keywords={Adaptation models;Large language models;Semantics;Asia;Inspection;Tagging;Data models;Safety;Decoding;Security;Large Language Models (LLMs);Safety Alignment;Domain-specific;Post-training},
  doi={10.1109/ISPCE-ASIA69076.2025.11312923},
  ISSN={2831-3410},
  month={Nov},}

@INPROCEEDINGS{11300550,
  author={R S, Amogh and Muthudhanush, A R and M D, Shwetha},
  booktitle={2025 International Conference on Intelligent Systems and Pioneering Innovations in Robotics and Electric Mobility (INSPIRE)}, 
  title={Modern Day LLMs : A GOLDMINE or a LANDMINE ?}, 
  year={2025},
  volume={},
  number={},
  pages={513-520},
  abstract={This paper presents a systematic analysis of Indirect Prompt Injection (IPI) attacks on Large Language Models (LLMs), examining their dual role as enablers of advanced AI applications and as sources of significant security risk. The study addresses three core research objectives: (1) identifying adversarial techniques that enable effective IPI execution, (2) comparing vulnerabilities across leading LLM architectures, and (3) evaluating the efficacy of existing mitigation strategies. Through empirical testing of Blackbox AI 3.1.6, ChatGPT 3.5, and Gemini 2.0, we find that multi-turn escalation, privilege manipulation, and role-conditioning consistently bypass baseline safety defenses. Our results reveal critical weaknesses in refusal consistency and context-aware filtering. To address these issues, we propose a structured evaluation framework for benchmarking model resilience and outline mitigation pathways with direct deployment relevance, contributing to adversarial robustness research and safer LLM design.},
  keywords={Technological innovation;Landmine detection;Systematics;Prevention and mitigation;Large language models;Closed box;Chatbots;Robustness;Safety;Security;Indirect Prompt Injection Attacks;LLM Security;AI Goldmine to Landmine;Adversarial Robustness;Model Vulnerabilities;Jailbreak Techniques;AI Ethics and Safety;Multi-Turn Attack Mitigation;Large Language Model Exploits},
  doi={10.1109/INSPIRE67328.2025.11300550},
  ISSN={},
  month={Nov},}

@INPROCEEDINGS{11293682,
  author={Tod-Raileanu, Gabriela and Axinte, Sabina-Daniela and Dincă, Ana-Maria and Bacivarov, Ioan C.},
  booktitle={2025 IEEE 31st International Symposium for Design and Technology in Electronic Packaging (SIITME)}, 
  title={Security Posture Evaluation of Model Context Protocol Servers Against Prompt Injection}, 
  year={2025},
  volume={},
  number={},
  pages={249-252},
  abstract={This study presents a security-oriented evaluation of the Model Context Protocol (MCP), an open standard enabling large language models (LLMs) to interface with external tools through structured interactions. The experiment was deployed in a controlled environment using an open-source MCP server with basic file manipulation tools. A set of prompt injection tests was designed to probe the system's ability to handle adversarial instructions, ambiguous input, and encoded payloads. Despite expectations, the system failed to reject adversarial instructions embedded in user input and did not detect anomalous tool usage patterns-such as suspicious parameters. These failures underscore the current vulnerability of LLM-tool integrations to prompt injection threats. The results highlight the urgent need for defense-in-depth strategies within MCP implementations, including stricter input validation, contextaware filtering, strong access control policies and transparent logging. Collectively, these measures are essential for securing AI-assisted tool chains against emerging adversarial techniques.},
  keywords={Protocols;Large language models;Supply chains;Servers;Reliability;Probes;Standards;Context modeling;Testing;Resilience;Artificial Intelligence;Model Context Protocol;Large Language Models;Cybersecurity;Secured Architecture},
  doi={10.1109/SIITME67657.2025.11293682},
  ISSN={2642-7036},
  month={Oct},}

@INPROCEEDINGS{11290523,
  author={Cheng, Zhengzhe and Zhang, Jian and Wu, Yanan and Zhu, Yuliang},
  booktitle={2025 5th International Conference on Artificial Intelligence, Automation and High Performance Computing (AIAHPC)}, 
  title={Jailbreak Attack Method for Large Language Models Based on Semantic Space}, 
  year={2025},
  volume={},
  number={},
  pages={527-531},
  abstract={Although large language models (LLMs) have gained security alignment mechanisms through artificial alignment, their vulnerability to semantic jailbreak attacks remains under-explored. This paper introduces AutoSDAN—a Jailbreak attack method employing semantic space perturbations, pioneering the integration of dynamic semantic space optimization into jailbreak prompt generation. The method extends the AutoDAN framework through the following core innovations: (1) constructs a context-based semantic space using Bert-MLM, ensuring word replacements consistently align with the current semantic context; (2) Constructing a spelling error space to enhance the aggressiveness of jailbreak prompts. Experiments demonstrate that our method achieves a 10%-20% increase in attack success rates on mainstream models like GPT-3.5 and Llama-2, while reducing the semantic perplexity (PPL) of jailbreak prompts by approximately 30%. This collectively increases the transfer attack success rate of jailbreak attack methods by about 11%.},
  keywords={Deep learning;Technological innovation;Large language models;Perturbation methods;Computational modeling;High performance computing;Semantics;Security;Optimization;Genetic algorithms;large language models;jailbreak attacks;deep learning;masked language models},
  doi={10.1109/AIAHPC66801.2025.11290523},
  ISSN={},
  month={Sep.},}

@INPROCEEDINGS{11290591,
  author={Zhou, Yi and Hou, Xinyao and Zhou, Luohui},
  booktitle={2025 5th International Conference on Artificial Intelligence, Automation and High Performance Computing (AIAHPC)}, 
  title={New Paradigms of Adversarial Attacks Against Large Language Models and Their Defense Mechanisms}, 
  year={2025},
  volume={},
  number={},
  pages={554-557},
  abstract={Large language models are gaining immense popularity, enhancing the usability of intelligent services while introducing unprecedented security challenges. Systems designed to improve question-answering quality may inadvertently leak personal privacy, while jailbreak and prompt injection attacks persistently threaten model defenses and trust. Traditional countermeasures either require additional computational steps or deep insight into model internals—approaches that are costly and ineffective in complex network environments, especially as attack methods evolve rapidly. We developed a novel defense method called LeakSealer, specifically designed for large language models. This approach performs a deep examination of historical dialogues, using semantic fingerprinting and unsupervised clustering to map usage patterns and attack vectors in static scenarios. In dynamic environments, it employs semi-supervised classification combined with human-machine collaboration for real-time defense. This approach requires no insight into the model's inner workings. It is lightweight, scalable, fast, and provides explanations along with recommendations for improvement. Experimental results are promising. LeakSealer outperforms other methods in numerous adversarial scenarios. When detecting jailbreaks, its grouping accuracy reaches 0.97; and in protecting sensitive information, it achieved 0.95 for recovered information and 0.97 AUPRC—both outperforming current methods. This approach not only reduces privacy leakage risks but also enables large language models to operate stably and securely over the long term. Our research demonstrates that combining static analysis with dynamic defense is feasible in adversarial AI environments, offering new insights for managing security issues in large language models.},
  keywords={Privacy;Accuracy;Large language models;Computational modeling;Human-machine systems;Semantics;Collaboration;Fingerprint recognition;Real-time systems;Vectors;Large Language Models;Prompt Injection;Personal Information Leakage;Adversarial Defense;Human-Machine Collaboration},
  doi={10.1109/AIAHPC66801.2025.11290591},
  ISSN={},
  month={Sep.},}

@INPROCEEDINGS{11273791,
  author={Kuzmanova, Elitsa and Dimanova, Donika},
  booktitle={2025 10th International Conference on Energy Efficiency and Agricultural Engineering (EE&AE)}, 
  title={Technical Privacy Risks in Generative AI (GenAI) – Lessons from OWASP and Real-World Failures}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={The rapid deployment of generative Artificial Intelligence (GenAI) systems has introduced a new class of technical privacy risks that exceed the scope of traditional data protection frameworks. This paper investigates these emerging vulnerabilities through the lens of the OWASP Top 10 for Large Language Models (LLMs) - 2025 edition, correlating them with real-world privacy failures from $2023-2025$. It categorizes incidents such as prompt injection, model poisoning, excessive agency, and improper output handling, drawing connections between architectural design choices and user-level data exposure. High-profile cases - including OpenAI's GDPR fine by Italy's Garante, the Hugging Face transformer compromise, and the Reddit-Anthropic dispute illustrate the systemic nature of GenAI risks. In parallel, the study evaluates international regulatory and governance responses, including the EU AI Act, NIST AI RMF, ISO/IEC 42001, and China's algorithmic controls, highlighting their strengths and implementation gaps. The analysis reveals that technical vulnerabilities often cascade across the GenAI lifecycle, creating enforcement blind spots and compliance challenges. The paper concludes by advocating for a holistic, cross-functional risk management strategy that integrates secure-by-design principles, real-time oversight, and proactive alignment with evolving regulatory standards.},
  keywords={Regulators;Generative AI;ISO Standards;NIST;Transformers;Real-time systems;Risk management;Security;Artificial intelligence;IEC Standards;GenerativeAI;Technical privacy risks;OWASP},
  doi={10.1109/EEAE65901.2025.11273791},
  ISSN={},
  month={Nov},}
