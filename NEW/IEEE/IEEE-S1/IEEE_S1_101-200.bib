  number={},
  pages={21-38},
  abstract={Summary <p>As artificial intelligence (AI) systems move from research labs into production environments, they introduce fundamentally different architectures and operational behaviors that redefine what it means to secure software. This chapter explores the structural distinctions between predictive, generative, and agentic AI, explaining how their internal mechanisms shape risk exposure, attack surfaces, and defensive priorities. From supervised models optimized for speed and accuracy to large language models capable of generating text and executing tools, each architecture comes with unique adversarial challenges&#x2014;ranging from input manipulation to autonomous decision hijacking.</p> <p>The chapter also walks through the AI development lifecycle, from data ingestion to post&#x2010;deployment monitoring, revealing how vulnerabilities can be introduced at each phase. It emphasizes the importance of recognizing adversarial entry points&#x2014;not just in APIs or user prompts, but in training data, model fine&#x2010;tuning, and third&#x2010;party integrations. Readers gain practical insight into how attacks like model poisoning, prompt injection, and supply chain compromise exploit architectural and process&#x2010;level blind spots.</p> <p>Crucially, this chapter introduces the concept of security debt&#x2014;accumulated risk resulting from rushed development, lack of robustness testing, or weak observability. It shows how ignoring security early in the lifecycle compounds risk downstream, often surfacing only during high&#x2010;stakes deployment. By combining architectural literacy with lifecycle threat awareness, this chapter equips cybersecurity professionals to proactively assess and defend AI systems before adversaries do.</p>},
  keywords={Telemetry;Aerospace and electronic systems;Weapons;Feeds;Filtering;Feedback;Filters;Circuits;Memory modules;Circuits and systems},
  doi={10.1002/9781394402069.ch2},
  ISSN={},
  publisher={Wiley},
  isbn={9781394402052},
  url={https://ieeexplore.ieee.org/document/11505604},}@INPROCEEDINGS{11493291,
  author={R, Likitha and D C, Dhanyashree and H R, Lavanya and Preeti},
  booktitle={2026 International Conference on Emerging Smart Computing and Informatics (ESCI)}, 
  title={AI Prompt Injection Attack Tester}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models are widely integrated into chatbots, enterprise applications, and automation systems. However, these systems are vulnerable to prompt injection attacks - malicious instructions embedded in text, files, images, or translated content, attempting to override system rules. This paper presents the design and implementation of the AI Prompt Injection Attack Tester: a multi-modal system for detecting and mitigating Prompt Injection attempts against Large Language Models. While the ubiquitous deployment of LLMs has introduced a critical security vulnerability, where untrusted user input hijacks the model’s policy and system prompt, we introduce the following concept: a Heuristic-Based Prompt Injection Detection Engine integrated into a pre-processing guardrail layer. The PIDE applies a specialized ruleset, which includes instruction-overriding pattern matching and sensitive keyword identification, to incoming data for a risk score. Importantly, the system normalizes and scans inputs from four different modalities: direct text, embedded code comments/literals, image text via OCR, and text that has been processed through a mock translation service. On detection, a Mitigation Pipeline applies sequential steps of sanitization, instruction stripping, and policy-based blocking prior to any input reaching the LLM. As confirmed within a safe, mock environment for LLMs, experimental results validate that this approach provides both successful detection and neutralization of malicious instructions across all types of input tested in this work. This paper confirms that a robust, multi-modal pre-processing policy layer is required as an integral component of a broad defense-in-depth strategy against sophisticated Prompt Injection attacks.},
  keywords={Feedback;Filtering;Circuits;Filters;Graphical user interfaces;Product development;Internet;Bot (Internet);Protocols;Communication systems;Prompt Injection;LLM Security;OCR;AI Safety;Streamlit;Multi-Modal Detection},
  doi={10.1109/ESCI68015.2026.11493291},
  ISSN={2996-1815},
  month={March},}@INPROCEEDINGS{11462306,
  author={Sun, Mengjie and Zheng, Yaowen and Lv, Shichao and Li, Zhi and Liu, Kaixiang and Wang, Yuncheng and Chen, Yongle and Sun, Limin},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={A Malicious Policy Detection Approach Enhanced by Threat Knowledge in LLM-Based Embodied Robots}, 
  year={2026},
  volume={},
  number={},
  pages={20072-20076},
  abstract={Integrating Large Language Models (LLMs) into robot systems enables natural language task planning but also raises safety risks, e.g., jailbreak attacks. Existing LLM safety alignment efforts primarily address textual harms, while insufficiently covering physical risks from malicious task planning. Moreover, current defenses against embodied robots lack interpretability and generalization to diverse, real-world attack scenarios. To address these challenges, we propose a novel threat knowledge-enhanced approach for malicious policy detection. Our method builds a structured knowledge base of known malicious behaviors by standardizing multi-format sub-task policies into unified semantic representations. During inference, we retrieve relevant malicious cases and leverage chain-of-thought reasoning for analogy-based semantic analysis. Experiments demonstrate that our approach effectively detects malicious behaviors and generalizes well across tasks. It reduces attack success rates to an average of 2.67% on SafeAgentBench and 2.30% on BadRobot benchmarks, while maintaining high clean task performance of 76.04% on SafeAgentBench.},
  keywords={Protocols;HTTP;Radio access networks;Regional area networks;Artificial intelligence;Cognitive systems;Large language models;Retrieval augmented generation;Generative Pre-trained transformer;Logic;Embodied Robots;Attack Detection},
  doi={10.1109/ICASSP55912.2026.11462306},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11463457,
  author={Yang, Xikang and Tang, Xuehai and Han, Jizhong and Hu, Songlin},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={DarkCite: Unveiling Authority Bias as Implicit Rag Jailbreak Attacks}, 
  year={2026},
  volume={},
  number={},
  pages={13402-13406},
  abstract={This paper reveals a critical and underexplored vulnerability in the safety alignment of Large Language Models (LLMs): an inherent bias toward authoritative information. We demonstrate that this authority bias can be exploited to bypass safety filters, transforming a beneficial model feature into a significant flaw. We hypothesize and show that this attack vector functions as a form of Implicit Retrieval-Augmented Generation (RAG), where a fabricated citation prompts the model to internally retrieve and surface harmful knowledge, bypassing typical safeguards. To systematize this exploit, we introduce DarkCite, a black-box jailbreak framework that adaptively matches risk types with optimal citation styles to generate potent adversarial prompts. Our experiments show DarkCite achieves a state-of-the-art Attack Success Rate (ASR), reaching 63% on average and outperforming prior methods across a range of models. To address this, we propose a practical defense based on authenticity and harm verification, which elevates the average Defense Pass Rate (DPR) from a mere 11% to 74%. Our code is available at https://github.com/YancyKahn/DarkCite},
  keywords={Weapons;Feeds;Filtering;Filters;Feedback;Circuits;Circuits and systems;Protocols;HTTP;Internet;Jailbreak;LLM Safety;Cognitive Bias},
  doi={10.1109/ICASSP55912.2026.11463457},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11463087,
  author={Liu, Huan and Sun, Xiaoshan and Zhang, Yingjun and Zhang, Yang},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={JAILFUZZ: A Zero-Knowledge and State Feedback Based Gray-Box Fuzzing Framework for Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={3311-3315},
  abstract={The security of Large Language Models (LLMs) is a critical issue in their practical deployment. Current safety alignment relies primarily on fine-tuning to achieve human-aligned behavior. However, recent jailbreak attacks have revealed limitations in these alignment techniques. Similarly to software security issues, automated testing through fuzzing can be applied to LLMs to uncover potential vulnerabilities. Existing jailbreaking fuzzing approaches largely depend on known attack patterns, which often fail to expose deeper security flaws. In this context, we introduce JAILFUZZ, a grey-box fuzzing framework that performs fuzz testing entirely guided by the model’s inner state feedback, without requiring any prior knowledge of jailbreak techniques. Experiments on multiple open-source models show that our approach not only generates successful jailbreak samples more efficiently but also discovers a wider variety of jailbreak strategies. Moreover, our state-guided methodology can provide actionable insights for mitigating corresponding vulnerabilities, thereby contributing to improved model security.},
  keywords={Feedback;Circuits;Cyberspace;Protocols;Communication networks;Computer networks;HTTP;Radio access networks;Regional area networks;Large language models;Large Language Model;Artificial Intelligence Security;Jailbreak Vulnerability;Fuzzing},
  doi={10.1109/ICASSP55912.2026.11463087},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11464668,
  author={Li, Xiaolong and Lao, Mingrui and Du, Chengsi and Bai, Liang and Guo, Yanming},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={CAS-J: Cross-Modal Attention Synergy for Jailbreaking Large Vision-Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={13907-13911},
  abstract={Large Visual-Language Models (LVLMs) have demonstrated outstanding performance across various multimodal tasks, but their security remains vulnerable to jailbreak attacks. Most current adversarial attacks are restricted to unimodal perturbations, and although several recent methods attempt to integrate text and visual modalities to enhance attack effectiveness, they still rely on output layer signals, overlooking the critical role of internal attention interactions designed to circumvent security constraints. To address the aforementioned limitation, we propose the Cross-Modal Attention Synergy Jailbreaking (CAS-J) framework, which manipulates the attention scores of the target model to finely adjust the internal fusion of information across modalities, strengthening the focus on key adversarial elements for images and suffixes while suppressing the sensitivity of the target model to harmful inputs. Our experimental results demonstrate that CAS-J improves the attack success rate across multiple benchmarks and exhibits high interpretability.},
  keywords={Protocols;HTTP;Local area networks;Communication systems;Fuses;Electronic components;Large language models;Vision language model;Artificial intelligence;Attention mechanisms;Multimodal Jailbreak;White-box Jailbreak;Adversarial Examples},
  doi={10.1109/ICASSP55912.2026.11464668},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11464275,
  author={Wakai, Yuki and Ito, Kunihiro and Kashima, Hisashi},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Robust In-context Defenses Against Jailbreaking of LLMs via Role Specification}, 
  year={2026},
  volume={},
  number={},
  pages={14037-14041},
  abstract={Although large language models (LLMs) are widely deployed in society, "jailbreaks" have raised serious security concerns. They use prompts to circumvent the safety alignment of LLMs and induce inappropriate outputs. As jailbreak strategies are rapidly evolving, it is difficult to cover them through additional training. In-context defenses aim to prevent jailbreak by adding texts describing expected behavior to prompts, but such texts can degrade responses to benign inputs (e.g., excessive refusals). We propose "Role Specification," an in-context defense that clarifies prompt structure and prioritizes objectives. The experiment showed that our method improves defense by 1.4×–5× and response quality by 1.1×–1.4×. Furthermore, when applied in combination with existing approaches, it yields up to 6.6× gains in defense and 1.6× in quality.},
  keywords={Nuclear weapons;Weapons;Protocols;HTTP;Artificial intelligence;Large language models;Learning (artificial intelligence);Conversational artificial intelligence;Machine learning;Computational and artificial intelligence;Large Language Model;AI safety;Responsible AI;Jailbreak Attack;In-context Defense},
  doi={10.1109/ICASSP55912.2026.11464275},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11463331,
  author={Pan, Yu and Yu, Wenlong and Wu, Tiejun and Ye, Xiaohu and Si, Qiannan and Xu, Guangquan and Wu, Bin},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={SFCoT: Safer Chain-Of-Thought via Active Safety Evaluation and Calibration}, 
  year={2026},
  volume={},
  number={},
  pages={19837-19841},
  abstract={Large language models (LLMs) have demonstrated remarkable capabilities in complex reasoning tasks. However, they remain highly susceptible to jailbreak attacks that undermine their safety alignment. Existing defense mechanisms typically rely on post hoc filtering applied only to the final output, leaving intermediate reasoning steps unmonitored and vulnerable to adversarial manipulation. To address this gap, this paper proposes a SaFer Chain-of-Thought (SF-CoT) framework, which proactively evaluates and calibrates potentially unsafe reasoning steps in real time. SFCoT incorporates a three-tier safety scoring system alongside a multi-perspective consistency verification mechanism, designed to detect potential risks throughout the reasoning process. A dynamic intervention module subsequently performs targeted calibration to redirect reasoning trajectories toward safe outcomes. Experimental results demonstrate that SFCoT reduces the attack success rate from 58.97% to 12.31%, demonstrating it as an effective and efficient LLM safety enhancement method without a significant decline in general performance.},
  keywords={Filtering;Filters;Circuits;Circuits and systems;Feedback;Protocols;HTTP;Cognitive systems;Large language models;Artificial intelligence;Large language model;Safety;Chain-of-Thought},
  doi={10.1109/ICASSP55912.2026.11463331},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11464814,
  author={Li, Yuhong and Zhang, Jiabao and Chen, Yan and Zhao, Zhihui and Wang, Jianhua},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Audio-Text Jailbreak Attack on Large Audio-Language Models: Towards Generality and Stealthiness}, 
  year={2026},
  volume={},
  number={},
  pages={13592-13596},
  abstract={In recent years, research on jailbreak attacks targeting large audio-language models (LALMs) has gained increasing attention. However, existing studies have predominantly focused on single-modality attacks, with limited exploration of multimodal attack strategies. Moreover, current attack methods offer limited generalization and stealth capabilities for audio-based attacks. In this paper, to the best of our knowledge, we are the first to propose a multimodal Jailbreak, namely Audio-Text Jailbreak, against LALMs. The Audio-Text Jailbreak jointly optimize slightly adversarial audio perturbations and malicious text suffixes to induce highly harmful affirmative responses. Additionally, by designing attacks that enhance the stealth and generalization of the audio component, our method achieves a more powerful effect. Our Audio-Text Jailbreak achieves attack success rates of 91.00% on Qwen2-Audio and 92.73% on Qwen2.5-Omni, demonstrating the substantial security risk posed by cross-modal interactions. Code is available at https://github.com/SKLIISAIS/AudioTextJailbreak.},
  keywords={Nuclear weapons;Weapons;Feeds;Protocols;Internet;HTTP;Internet security;Large language models;Artificial intelligence;Machine learning;Jailbreak Attacks;Multimodal Large Language Models},
  doi={10.1109/ICASSP55912.2026.11464814},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11462247,
  author={Yang, Shuangning and Yang, Haoran and Zhao, Guoli and Zhou, Mengting and Tai, Jianwei and Jia, Xiaoqi},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={What is the risk? Evaluating the impact of knowledge distillation on LLM vulnerabilities}, 
  year={2026},
  volume={},
  number={},
  pages={14177-14181},
  abstract={Knowledge distillation has significantly accelerated the development of efficient language models. With the rapid proliferation of these methods in the open-source communities, a systematic evaluation of their implications for model security is urgently needed. To quantify the security risks introduced by various distillation methods, we propose a general and extensible evaluation framework that reflects complex, real-world distillation workflows. Additionally, we analyze the impact of the distillation process on models’ tendencies toward harmful behavior by extending JailbreakBench with a harm-level dataset comprising 10 malicious query categories. Our results demonstrate that knowledge distillation significantly increases model vulnerability, and joint learning of the two primary forms of knowledge further exacerbates this risk. Furthermore, our analysis reveals different effects across harmful query categories, with the risk levels of discrimination and economic harm showing significant increases that warrant particular attention.},
  keywords={Feedback;Circuits;Protocols;Communication systems;HTTP;Computer networks;Internet;Radio access networks;Regional area networks;Pins;Knowledge distillation;Jailbreak attack;Harmful behavior;Model security},
  doi={10.1109/ICASSP55912.2026.11462247},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11463981,
  author={Zhou, Yi and Xing, Wenpeng and Lin, Changting and Kong, Dezhang and Hu, Chunqiang and Han, Meng},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Parameter Localization and Relearning for Safety Disalignment in Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={3461-3465},
  abstract={Large language models (LLMs) excel in natural language generation but remain susceptible to malicious prompts that can elicit harmful outputs. To address this, alignment techniques such as reinforcement learning from human feedback (RLHF), instruction tuning, and adversarial training are employed to enforce safety constraints. However, recent studies reveal vulnerabilities to white-box and black-box attacks that undermine these safeguards. This paper introduces a novel, interpretable jailbreak framework for LLMs, comprising three key steps: (i) activating safety-related parameters by inputting pre-processed harmful and harmless prompts; (ii) identifying critical safety-constraint parameters using gradient-driven conditional localization combined with similarity-based neuron recognition; and (iii) relearning selected parameters with a weighted cross-entropy loss to restore the model’s ability to generate previously restricted responses. Experiments on mainstream models, including Llama2, Qwen2.5, DeepSeek, and Mistral, demonstrate a 100% Attack Success Rate (ASR), surpassing existing fine-tuning-based white-box attacks while minimally impacting overall model performance. Our approach achieves jailbreaks by updating only a small fraction of parameters, offering high interpretability and transferability across diverse LLM architectures. While aimed at advancing safety research, we acknowledge the potential misuse of open-source LLMs and advocate for strengthened safety strategies to foster a secure AI ecosystem.},
  keywords={Feeds;Antennas;Feedback;Circuits;LoRa;Location awareness;Mobile communication;Protocols;Data communication;HTTP;LLM Safety Disalignment;White-box Jailbreak Attack;Parameter Localization;Parameter Relearning},
  doi={10.1109/ICASSP55912.2026.11463981},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11462407,
  author={Liu, Jiani and He, Yixin and Fan, Lanlan and Zhong, Qidi and Cheng, Yushi and Zhang, Meng and Chen, Yanjiao and Xu, Wenyuan},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={PINA: Prompt Injection Attack Against Navigation Agents}, 
  year={2026},
  volume={},
  number={},
  pages={13897-13901},
  abstract={Navigation agents powered by large language models (LLMs) convert natural language instructions into executable plans and actions. Compared to text-based applications, their security is far more critical: a successful prompt injection attack does not just alter outputs but can directly misguide physical navigation, leading to unsafe routes, mission failure, or real-world harm. Despite this high-stakes setting, the vulnerability of navigation agents to prompt injection remains largely unexplored. In this paper, we propose PINA, an adaptive prompt optimization framework tailored to navigation agents under black-box, long-context, and action-executable constraints. Experiments on indoor and outdoor navigation agents show that PINA achieves high attack success rates with an average ASR of 87.5%, surpasses all baselines, and remains robust under ablation and adaptive-attack conditions. This work provides the first systematic investigation of prompt injection attacks in navigation and highlights their urgent security implications for embodied LLM agents.},
  keywords={Feedback;Circuits;Protocols;HTTP;Artificial intelligence;Generative Pre-trained transformer;Large language models;Conversational artificial intelligence;Chatbots;Cognitive systems;Prompt Injection Attack;LLM Agents},
  doi={10.1109/ICASSP55912.2026.11462407},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11463282,
  author={Liu, Yu and Chen, Ping},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={PromptPatch: Towards Precise and Stable Behavioral Patching in Large Language Models via Feedback-Driven Prompt Optimization}, 
  year={2026},
  volume={},
  number={},
  pages={14322-14326},
  abstract={The security and reliability of Large Language Model (LLM) applications are fundamentally dependent on the robustness of their system prompts. However, these prompts are often susceptible to adversarial attacks like prompt injection, leading to unpredictable and harmful model behavior. Existing defenses typically focus on runtime input filtering or model-level retraining, which can be costly and imprecise. In this work, we introduce PromptPatch, a novel framework that treats the system prompt as a software artifact and applies a feedback-driven optimization process to automatically discover and repair security vulnerabilities. Our methodology employs a "Critic-Repairer" architecture, where a Critic LLM performs a semantic security audit, and a Repairer LLM generates precise, surgical patches to harden the prompt. This offline, design-time approach aims to create intrinsically robust system prompts, enhancing behavioral stability at the source. We conduct a rigorous evaluation across five modern LLMs, demonstrating that PromptPatch dramatically reduces the average Attack Success Rate (ASR) from as high as 41.67% to as low as 0.00% on several models, while maintaining high functional integrity. Our analysis also reveals the varying efficacy of prompt hardening across different model architectures, highlighting the challenge of "one-size-fits-all" defenses and suggesting a need for model-aware repair strategies.},
  keywords={Feedback;Filtering;Circuits;Filters;Circuits and systems;Protocols;HTTP;Pins;Artificial intelligence;Large language models;Large Language Models;Prompt Injection;System Prompt Hardening;AI Safety},
  doi={10.1109/ICASSP55912.2026.11463282},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11465040,
  author={Huang, Chao and Zhang, Zefeng and Yue, Juwei and Sheng, Jiawei and Li, Quangang and Zhang, Chuang and Liu, Tingwen},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Safety Alignment Should be Made More than just A Few Attention Heads}, 
  year={2026},
  volume={},
  number={},
  pages={1656-1660},
  abstract={Safety alignment in large language models (LLMs) remains vulnerable, as adversarial prompts can bypass their safety measures. We find that safety mechanisms are concentrated in a small subset of attention heads, and ablating these heads severely compromises model safety. To identify these critical components, we introduce RDSHA, a targeted ablation method that leverages the model’s refusal direction. Our analysis reveals that existing jailbreak attacks exploit this concentration by manipulating these specific heads. To mitigate this, we propose AHD, a training strategy to distribute safety behaviors across numerous attention heads. Experiments show that models trained with AHD achieve significantly stronger robustness against mainstream jailbreak attacks, successfully distributing safety capabilities across attention heads, while maintaining overall model utility.},
  keywords={Protocols;HTTP;Artificial intelligence;Large language models;Machine learning;Conversational artificial intelligence;Chatbots;Representation learning;Learning (artificial intelligence);Foundation models;Safety Alignment;AI Safety;LLM},
  doi={10.1109/ICASSP55912.2026.11465040},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11465062,
  author={Lin, Liang and Hu, Songlin and Tang, Xuehai},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Paper Summary Attack: Jailbreaking LLMs Through LLM Safety Papers}, 
  year={2026},
  volume={},
  number={},
  pages={13902-13906},
  abstract={The safety of large language models (LLMs) has garnered significant research attention. In this paper, we argue that previous empirical studies demonstrate LLMs exhibit a propensity to trust information from authoritative sources, such as academic papers, implying new possible vulnerabilities. Based on this insight, a novel jailbreaking method, Paper Summary Attack (PSA), is proposed. It systematically synthesizes content from either attack-focused or defense-focused LLM safety papers to construct an adversarial prompt template, while strategically infilling harmful queries as adversarial payloads within predefined subsections. Extensive experiments show significant vulnerabilities not only in base LLMs, but also in state-of-the-art reasoning models like Deepseek-R1. Our findings highlight the urgent need to reassess LLMs’ trust mechanisms in processing authoritative sources.},
  keywords={Payloads;Nuclear weapons;Military aircraft;Space technology;Feeds;Antennas;Feedback;Circuits;Protocols;HTTP;Large Language Models;Jailbreaking;External Knowledge},
  doi={10.1109/ICASSP55912.2026.11465062},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11463266,
  author={Wang, Zikai and Yang, Xinghao and Zhang, Bingfeng and Liu, Weifeng},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Safety Anchor-Guided Adaptive Bias Decay for Jailbreak Defense}, 
  year={2026},
  volume={},
  number={},
  pages={18647-18651},
  abstract={Jailbreak defense is a crucial strategy to protect Large Language Models (LLMs) from being attacked and improve their security. However, a key limitation of existing defenses is their poor generalization ability - most methods are designed depending on specific attackers and fail to defend unseen ones. To address this problem, we attribute the success of most jailbreak attacks to the bias of the model’s rewards, and propose Safety Anchor-Guided Adaptive Bias Decay (SAG-ABD) to reduce the bias. Particularly, SAG-ABD first constructs safety anchors via LoRA fine-tuning on safety-aligned data, which does not rely on any attackers, to improve the defense generalization ability. During inference, we calculate the bias between the model output and the safety anchor to adaptively identify sensitive tokens and decay their effect so that the LLMs can refuse to answer harmful questions. Our experiments on Vicuna and LLaMA-2 demonstrate that SAG-ABD significantly improves the generalization capability of jailbreak defense, reducing the average Attack Success Rate (ASR) of six mainstream jailbreak methods by 41.3%.},
  keywords={Feeds;Feedback;Circuits;LoRa;Protocols;HTTP;Data communication;Radio communication;Radio access networks;Regional area networks;Large Language Model;Jailbreak Attack;Jailbreak Defense},
  doi={10.1109/ICASSP55912.2026.11463266},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11461745,
  author={Zhang, Ziyang and Lin, Yuechen and An, Xuanxuan and Wan, Mingyang and Jiang, Caigui and Ding, Ning},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={ATTN-Defense: Attention-Guided Detection, Location and Removal for Indirect Prompt Injection}, 
  year={2026},
  volume={},
  number={},
  pages={17532-17536},
  abstract={Large language models (LLMs) have been severely affected by prompt injection attacks due to their strong instruction-following capabilities. Among these, indirect prompt injection (IPI) attacks pose broader security threats, as their injection occurs outside the model’s system boundary. Recent research efforts to defend against such attacks primarily focus on detection and prevention strategies. However, existing detection methods often degrade user experience by directly rejecting inputs after attack identification, while prevention approaches face inherent security and utility trade-off. To address this issue, this paper proposes Attn-Defense, an IPI removal method based on the LLM attention weight. Our approach extracts attention sequence features generated during input processing to achieve both detection and location of IPI attacks, followed by precise sentence-level removal operations. This enables accurate defense implementation without compromising the model’s ability to fulfill legitimate user instructions. Our method demonstrates consistent superiority across various models, jailbreak attacks, and datasets, achieving a 10.1% lower Attack Success Rate and 14.8% higher F1 Difference compared to existing approaches on two extended and augmented datasets. Furthermore, we validate the robustness of our framework and the effectiveness of its individual components through comprehensive experiments.},
  keywords={Feeds;Antennas;Wide area networks;Protocols;Communication systems;Computer networks;HTTP;Location awareness;Mobile communication;Pins;Large Language Models;Indirect Prompt Injection;Attention Mechanism},
  doi={10.1109/ICASSP55912.2026.11461745},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11462454,
  author={Zeng, Ruilin and Zhang, Xiaoming and Miao, Dezhuang and Qi, Yirui},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={LLMS Do Not Always Say No: A Parallel Multi-Agent Jailbreak Framework Via Probabilistic Vulnerability}, 
  year={2026},
  volume={},
  number={},
  pages={18652-18656},
  abstract={Jailbreak attacks can bypass security mechanisms and trick large language models into generating insecure content, but the inherent randomness in LLM outputs limits scalability and reproducibility in existing methods. Empirical analysis shows that identical jailbreak prompts can produce inconsistent results, with some initially failed attacks achieving success through repetition. We formalize this phenomenon as probabilistic vulnerability, a potential security risk often overlooked in single-attempt attacks. To address this issue, we propose ParaMAIA, a parallel multi-agent iterative attack framework that systematically exploits the probabilistic vulnerability through coordinated external attack strategies. Orchestrated by a parallel attack controller, it amplifies the marginal probability advantage of successful jailbreaking into a high-confidence success rate. Experimental results demonstrate that ParaMAIA achieves efficient and stable attacks with strong cross-model transferability, validating the universality and practical value of probabilistic vulnerability.},
  keywords={Feedback;Circuits;Protocols;HTTP;Pins;Generative Pre-trained transformer;Large language models;Machine learning;Artificial intelligence;Cognitive systems;LLMs;Jailbreak Attacks;Multi Agent Systems;Parallel Processing;Probabilistic Vulnerability},
  doi={10.1109/ICASSP55912.2026.11462454},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11460561,
  author={Zhou, Yuxin and Ding, Xiao and Meng, Yijia and Chang, Tianle and Gao, Jinglong and Zhang, Zihan and Xiong, Kai and Shi, Qi},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Optimizing Automated Jailbreak Attacks on Large Language Models via Experience Accumulation}, 
  year={2026},
  volume={},
  number={},
  pages={18657-18661},
  abstract={Ensuring the security of Large Language Models (LLMs) is a paramount concern, with red teaming emerging as a primary methodology for vulnerability assessment. A key focus of these efforts is jailbreak attacks, which exploit model weaknesses to bypass safety alignments. Prevailing methods, however, are often constrained to session-level optimizations, exhibiting limited capacity for experience transfer, incurring high query costs, and demanding specialized knowledge. In this paper, we propose a semantic-aware framework for meta-learning adversarial prompts. Our approach systematically aggregates and leverages experiential knowledge from past interactions to inform and refine attack strategies in subsequent attempts. This cumulative learning paradigm significantly improves the efficiency and efficacy of jailbreak attacks. Through extensive experiments on the AdvBench benchmark against a suite of nine open-source and closed-source LLMs, our method consistently demonstrates a superior attack success rate while substantially decreasing the requisite number of queries and execution time, thereby setting a new standard for efficient jailbreak attack methodologies.},
  keywords={Feeds;Circuits;Feedback;Radio access networks;Regional area networks;Protocols;Internet;HTTP;Social computing;Communication systems;Large Language Models;Jailbreak Attacks;Model Security;AI Safety},
  doi={10.1109/ICASSP55912.2026.11460561},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11463376,
  author={Zhong, Qidi and Liu, Siyang and Liu, Jiani and Pan, Kaikai and Cheng, Yushi and Xu, Wenyuan},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={IPI2: Mitigating Indirect Prompt Injections on Unmanned Aerial Vehicle Agents Using Physical Invariants}, 
  year={2026},
  volume={},
  number={},
  pages={14042-14046},
  abstract={Large language model (LLM)-powered unmanned aerial vehicle (UAV) agents enable natural human–machine interaction, broadening UAV applications in complex scenarios. However, these agents are vulnerable to indirect prompt injection (IPI) attacks, where adversaries exploit untrusted external data sources (e.g., corrupted knowledge bases) to redirect LLMs from legitimate instructions toward malicious ones. Existing defenses either rely on keyword filters or auxiliary LLMs, which are often computationally costly and insufficiently robust. In this paper, we present IPI2, a defense framework that mitigates IPI attacks by leveraging UAVs’ physical invariant properties. Our key insight is that, despite the diversity of UAV tasks and attack strategies, benign UAV logs consistently exhibit stable invariant patterns. IPI2 profiles these distributions from benign data and performs similarity analysis using Kullback–Leibler divergence to detect anomalies indicative of IPI corruption. Extensive experiments across 2 UAV agents, 3 tasks, 4 LLMs, and 5 attack types demonstrate that IPI2 achieves a 68.3% reduction (92.0%→23.7%) in average attack success rate. We further show that IPI2 remains robust against adaptive adversaries.},
  keywords={Filtering;Filters;Circuits and systems;Internet of Things;Communication systems;Internet;Internet of Vehicles;Protocols;Radio access networks;HTTP;LLM-integrated UAV Agents;Prompt Injection Attack;Physical Invariants},
  doi={10.1109/ICASSP55912.2026.11463376},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11462363,
  author={Mu, Junjie and Ying, Zonghao and Fan, Zhekui and Jing, Zonglei and Zhang, Yaoyuan and Yu, Zhengmin and Zhang, Wenxin and Zou, Quanchen and Zhang, Xiangzheng},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Mask-GCG: Are All Tokens in Adversarial Suffixes Necessary for Jailbreak Attacks?}, 
  year={2026},
  volume={},
  number={},
  pages={13887-13891},
  abstract={Jailbreak attacks manipulate Large Language Models to generate harmful responses they are designed to avoid. Greedy Coordinate Gradient (GCG) has emerged as a general and effective approach that optimizes tokens in a suffix to generate jailbreakable prompts. However, GCG and its variants rely on fixed-length suffixes, and potential redundancy within these suffixes remains unexplored. We propose Mask-GCG, a plug-and-play method employing learnable token masking to identify impactful tokens within the suffix. Our approach increases update probability for high-impact tokens while pruning low-impact ones. This reduces redundancy, decreases gradient space size, and lowers computational overhead, shortening attack time. We evaluate Mask-GCG by applying it to the GCG and several improved variants. Experimental results show that most tokens in the suffix contribute significantly to attack success, and pruning a minority of low-impact tokens does not affect the loss values or compromise the attack success rate (ASR), thereby revealing token redundancy in LLM prompts. Our findings provide insights for developing efficient and interpretable LLMs from the perspective of jailbreak attacks.},
  keywords={Filtering;Filters;Circuits and systems;Protocols;HTTP;Plugs;Connectors;Artificial intelligence;Large language models;Machine learning;Jailbreak Attack;Token masking},
  doi={10.1109/ICASSP55912.2026.11462363},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11475947,
  author={Jadav, VasanthRao and Bussari, Shravya and Aurangabadkar, Mukesh and Garg, Anshul},
  booktitle={SoutheastCon 2026}, 
  title={Red-Team Prompt Injection Defense Using Multi-Context Protocol (MCP)}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Prompt injection attacks represent a critical security risk in Large Language Model (LLM)–powered applications, enabling adversaries to manipulate model behavior, bypass safety controls, and trigger unauthorized actions. Existing defenses predominantly rely on prompt hardening or output filtering, which remain brittle against adaptive and indirect attack techniques. This paper introduces a red-team–driven defense framework based on a Multi-Context Protocol (MCP) that enforces strict isolation and validation of prompt layers. MCP separates system, developer, retrieval, and user prompts into independently trusted contexts and applies context validation, version control, semantic consistency checks, and input reputation scoring prior to model inference. Through empirical evaluation using representative prompt injection attacks, the proposed approach demonstrates a significant reduction in successful injection attempts while preserving low latency and minimal false positives. The framework is model-agnostic and designed for secure deployment in enterprise and regulated LLM environments.},
  keywords={Filtering;Filters;Circuits and systems;Protocols;HTTP;Communication systems;Artificial intelligence;Large language models;Retrieval augmented generation;Logic;Prompt Injection;Large Language Models;AI Security;Red Teaming;Multi-Context Protocol;Context Isolation;Input Validation;Secure LLM Systems},
  doi={10.1109/SoutheastCon63549.2026.11475947},
  ISSN={1558-058X},
  month={Feb},}@INPROCEEDINGS{11475941,
  author={Lan, Qianlong and Kaul, Anuj and Jones, Shaun and Westrum, Stephanie},
  booktitle={SoutheastCon 2026}, 
  title={Secure by Design: Quantifying Architectural Resilience and the Agents Rule of two}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The transition of Large Language Models (LLMs) into autonomous agents equipped with tools necessitates a security paradigm shift. Current defenses typically rely on prompt engineering, which has proven insufficient to defend against Indirect Prompt Injection (IPI). This paper presents a quantitative evaluation of architectural defense patterns specifically Plan-then-Execute (P-t-E) and Context-Minimization (Context-Min), which are integrated under the strategic guidance of the Agents Rule of Two (R2). Advanced attack vectors on four distinct agent architectures, including IPI parameter hijacking and Attractive Metadata Attacks (AMA) were conducted. Our findings challenge the “Defense Tax” assumption while highlighting the limitations of a single defense mechanism. The baseline System Under Test (SUT) A proved highly vulnerable, 65% Attack Success Rate (ASR) to IPI, 100% to AMA and inefficient (3.02s latency). SUT B reduced the IPI success rate to 25% and latency to 0.50s, a 6x speed improvement. SUT C offered the highest security (21.2% ASR) but doubled the latency (1.02s) compared to SUT B. The results show that P-tE is the essential baseline for achieving efficiency and partial security and demonstrate that a layered “defense-in-depth” approach is required to fully mitigate parameter-level attacks.},
  keywords={Large language models;Autonomous agents;Prompt engineering;Metadata;Cyberattack;Trusted computing;Failure analysis;Security information and event management;Benchmark testing;Data integrity;Inference mechanisms;Software testing;LLM Agents;Agent Security;Indirect Prompt Injection;Architectural Security;Agents Rule of Two;Control Flow Integrity;Attack Surface Reduction},
  doi={10.1109/SoutheastCon63549.2026.11475941},
  ISSN={1558-058X},
  month={Feb},}@INPROCEEDINGS{11476026,
  author={Kolavennu, Gayathri Priya and Shi, Yong and Suo, Kun and Nguyen, Tu and Zhao, Chen and Xie, Zongxing},
  booktitle={SoutheastCon 2026}, 
  title={Security-Aware Retrieval-Augmented Generation System for Post-Quantum Cryptography Intelligence}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Retrieval-Augmented Generation (RAG) systems have become popular tools for adding external information sources to Large Language Models (LLMs) to enhance their capabilities. However, there are significant concerns connected with their use in cybersecurity sectors, such as the possibility of hallucinations, vulnerability to rapid injection attacks, and difficulties in confirming the reliability of the sources that are retrieved. This study proposes a production-grade, security-aware RAG framework designed for cybersecurity knowledge management and Post-Quantum Cryptography (PQC) intelligence in order to overcome these issues. Multiple security-focused improvements are included in the proposed system, such as evidence-based abstention controlled by a confidence threshold of 0.4, prompt injection defense mechanisms that achieve 100% detection on known attack patterns, multi-source agreement verification that requires corroboration across trusted sources, and trust-weighted retrieval with authority-based scoring-assigning weights of $\mathbf{1. 0}$ to NIST standards and 0.95 to CVE databases. The system generates answers to technical queries with a mean confidence score of 0.719 after processing nine NIST standard publications totaling 2.78 million characters. The addition of security-aware constraints considerably lowers hallucination rates while maintaining query accuracy, according to experimental results. With the addition of cryptographic metadata annotation to FAISS-based vector retrieval, the implementation uses the HuggingFace SmolLM2-1.7B-Instruct model for text generation and sentencetransformers to produce 384-dimensional embeddings.},
  keywords={Filtering;Central Processing Unit;Filters;Protocols;Communication systems;Computer networks;Electronic mail;Storage area networks;HTTP;Internet;Retrieval-Augmented Generation;Large Language Models;Prompt Injection Defense;Post-Quantum Cryptography;Cybersecurity;Trust-Weighted Retrieval;FAISS;Vector Databases},
  doi={10.1109/SoutheastCon63549.2026.11476026},
  ISSN={1558-058X},
  month={Feb},}@INPROCEEDINGS{11475963,
  author={Karuppuchamy, Sureshkumar},
  booktitle={SoutheastCon 2026}, 
  title={Governed Agentic AI for Software Platforms: A Reference Architecture for Safe Autonomy at Scale}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Recent advances in large language models (LLMs) have accelerated the emergence of agentic AI systems capable of reasoning, planning, and acting across software platforms [1], [9]. While such systems promise significant productivity and operational gains, unconstrained autonomy introduces substantial risks related to safety, reliability, security, regulatory compliance, and organizational trust-particularly in large, distributed enterprise environments [3], [11], [12]. These concerns are further amplified by emerging regulatory frameworks such as the European Union's Digital Services Act [5], which impose stricter requirements on transparency, accountability, and human oversight. This paper introduces a governance control plane for agentic AI systems in software platforms and empirically characterizes the trade-offs between autonomy, safety enforcement, and human oversight. The proposed architecture balances autonomous decision-making with deterministic policy enforcement and structured human control. The proposed architecture decomposes agent behavior into four controlled layers: (1) intent interpretation using LLMs [1], (2) policy-aware planning and decision logic informed by enterprise rules and risk constraints [6]–[8], (3) guarded execution over platform APIs inspired by tool-augmented LLM paradigms [9], [10], and (4) continuous telemetry, auditing, and rollback mechanisms to ensure operational safety and accountability. Central to the architecture is the concept of bounded autonomy, where agents automate routine and low-risk decisions while remaining constrained by declarative policies, approval gates, runtime validation, and execution allow-lists. We demonstrate the applicability of this approach through representative enterprise scenarios, including AI-assisted feature rollout and automated issue triage, building on established software engineering and DevOps principles [2], [4]. Beyond qualitative analysis, we report prototype-based measurements of governance overhead and safety effectiveness, including policy-evaluation latency, invalid-action blocking rates, and changes in human intervention volume across autonomy tiers. We further discuss adversarial robustness considerations such as indirect prompt injection [11], [12], concurrency and state-drift management in long-running agents, and policy conflict resolution in multi-agent settings [13]. Overall, this work contributes a practical, governance-centered blueprint for deploying agentic AI systems with explicitly bounded autonomy, observable decision-making, and enforceable safety controls in large-scale software platforms.},
  keywords={Telemetry;Aerospace and electronic systems;Accesslists;Information filters;Oscillators;Telemetry;Radio access networks;Regional area networks;Data communication;Protocols;Agentic AI;Large Language Models;Software Architecture;AI Governance;Autonomous Systems;Human in the Loop;DevOps},
  doi={10.1109/SoutheastCon63549.2026.11475963},
  ISSN={1558-058X},
  month={Feb},}@INPROCEEDINGS{11476263,
  author={Castro-Puello, Eduardo and Li, Wei and Wang, Ling and Kumar, Ajoy and Mulissa, Yonas Getachew},
  booktitle={SoutheastCon 2026}, 
  title={Small Language Model Jailbreak Defender Framework}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Large Language Models (LLMs) enable powerful language and task automation but create scalable avenues for abuse, including jailbreaks and fine tuning-driven safety collapse. Small Language Models (SLMs) are increasingly favored for cost, latency, and deployment flexibility, yet exhibit weaker safety priors and heightened vulnerability to adversarial adaptation. Existing defenses are piecemeal and often degrade task utility or efficiency. This paper proposes a modular security alignment framework that enables fine tuned SLMs to approach LLM level robustness while preserving domain performance and low latency. The framework integrates multi model dataset auditing, adversarial artifact conditioning (e.g., toxic token extraction), and an SLM based guardrail wrapper that performs multi step chain of thought intent and output judging. We outline an empirical evaluation agenda focused on reducing attack success rates and unsafe compliance while maintaining high precision and recall on benign tasks and sub second response times, enabling safer SLM deployment in security sensitive domains. Making the SLM capable to perform as an LLM in a specific domain knowledge and similar safety/security levels, this will open the door to scalable solutions with low budgets.},
  keywords={Weapons of mass destruction;Filtering;Filters;Feedback;Circuits;Central Processing Unit;Circuits and systems;Internet of Things;Radio access networks;Regional area networks;Small Language Model;Fine Tuning;Jailbreak;Security},
  doi={10.1109/SoutheastCon63549.2026.11476263},
  ISSN={1558-058X},
  month={Feb},}@ARTICLE{11483294,
  author={Chen, Bei and Li, Gaolei and Wu, Jun and Li, Jianhua and Chen, Mingzhe and Wang, Jiacheng},
  journal={IEEE Transactions on Dependable and Secure Computing}, 
  title={AgentChain: Blockchain-Empowered Multi-Agent Coordination for Trustworthy LLM Question-Answering Systems}, 
  year={2026},
  volume={23},
  number={4},
  pages={8501-8518},
  abstract={Multi-agent architectures leveraging Large Language Models (LLMs) have significantly advanced the precision of Question Answering (QA) systems across diverse domains. However, existing frameworks remain vulnerable to adversarial manipulations, including poisoning, backdoor, and jailbreak attacks, primarily due to their reliance on centralized orchestration. To mitigate these risks, we propose AgentChain, a framework that substitutes centralized control with a distributed semantic consensus process. By modeling the blockchain as an ideal functionality, AgentChain establishes a secure distributed layer to coordinate role allocation, answer proposal, evaluation and voting through a decentralized council. Specifically, we design Proof-of-Content-Quality (PoCQ) mechanism to ensure that the final answers reflect a robust semantic agreement among the majority of honest agents. Furthermore, we propose an incentive mechanism based on stake reassignment that penalizes malicious agents by reducing their rewards, ultimately phasing them out of the network. Comprehensive evaluations across eight datasets demonstrate that AgentChain achieves superior performance and resilience. AgentChain minimizes the impact of poisoning attacks on precision to less than 3% and reduces the success rate of backdoor and jailbreak attacks to less than 4%. These findings highlight the effectiveness and trustworthiness of AgentChain in mitigating security threats while maintaining high QA accuracy.},
  keywords={Feeds;Broadcasting;Broadcast technology;Filtering;Filters;Feedback;Circuits;Circuits and systems;Protocols;Consensus protocol;Question-answering systems;multi-agent;consensus mechanisms;large language model (LLM);adversarial manipulation},
  doi={10.1109/TDSC.2026.3685256},
  ISSN={1941-0018},
  month={July},}@INPROCEEDINGS{11468247,
  author={Osama, Mostafa and Hashish, Ali and Hany, Hla and Amin, Omar and Ghatas, Youssef},
  booktitle={2026 International Conference on Artificial Intelligence, Computer, Data Sciences and Applications (ACDSA)}, 
  title={Small Models, Significant Risks: Jailbreaking Attacks on Lightweight LLMs}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models (LLMs) are increasingly integrated into real-world applications, including chatbots, AI assistants, and healthcare support systems. However, jailbreaking attacks - techniques that bypass safety constraints and induce harmful content - pose a critical threat to their safe deployment. These attacks are particularly concerning because they can be easily carried out through prompt engineering alone, without access to the models' internals. In this study, we evaluate four template-based jailbreak methods: Template-Jailbreak, Parameters, DeepInception, and Fallacy Failure, targeting widely-used lightweight LLMs: Gemma-3n, Phi-2, DeepSeek-R1, Llama-3.2, and Qwen3. For evaluation, we use a publicly available dataset of 60 malicious prompts, aligned with the malicious content category defined in OpenAI's policy compliance guidelines, and a finetuned RoBERTa model to automatically detect jailbreak success. Our results demonstrate that template-based attacks remain highly effective, revealing distinct trade-offs between attack efficiency and generalization. Overall, despite lightweight LLMs being generally vulnerable to these attacks, Gemma showed substantial improvements in robustness, although it remains vulnerable under certain conditions. These findings underscore the urgency of developing stronger defenses, as even state-of-the-art lightweight LLMs remain highly vulnerable to easily exploitable prompt-based jailbreak attacks.},
  keywords={Payloads;Weapons;Feeds;Radio broadcasting;Frequency modulation;HTTP;Internet;Protocols;Cyberspace;Communication systems;Large Language Models;Machine Learning;Jail-breaking;Cyber Security},
  doi={10.1109/ACDSA67686.2026.11468247},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11467846,
  author={Wei, Wenlan and Shang, Zhengchun and Bai, Weiheng},
  booktitle={2026 International Conference on Artificial Intelligence, Computer, Data Sciences and Applications (ACDSA)}, 
  title={Evolving Security in LLMs: A Study of Jailbreak Attacks and Defenses}, 
  year={2026},
  volume={},
  number={},
  pages={01-09},
  abstract={Large Language Models (LLMs) are increasingly popular, powering a wide range of applications. Their widespread use has sparked concerns, especially through jailbreak attacks that bypass safety measures to produce harmful content. In this paper, we present a comprehensive security analysis of large language models (LLMs), addressing critical research questions on the evolution and determinants of model safety. Specifically, we begin by identifying the most effective techniques for detecting jailbreak attacks. Next, we investigate whether newer versions of LLMs offer improved security compared to their predecessors. We also assess the impact of model size on overall security and explore the potential benefits of integrating multiple defense strategies to enhance the security. Our study evaluates both open-source (e.g., LLaMA and Mistral) and closedsource models (e.g., GPT-4) by employing four state-of-the-art attack techniques and assessing the efficacy of three new defensive approaches. Our code and dataset can be found at [1].},
  keywords={Filtering;Filters;Feedback;Circuits;Circuits and systems;Protocols;Radio access networks;Regional area networks;HTTP;Communication systems;Large Language Models (LLMs);GPT-4;Jailbreak Attacks—Attack Success Rate (ASR);Defense Strategies;Adversarial Prompts},
  doi={10.1109/ACDSA67686.2026.11467846},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11468934,
  author={Haque, Taiyab Mohammad Nabil Ul and Aggarwal, Takshil and Manisha and Gupta, Khushbu and Pharswan, Ruchika},
  booktitle={2026 2nd International Conference on Cognitive Computing in Engineering, Communications, Sciences and Biomedical Health Informatics (IC3ECSBHI)}, 
  title={Cracks in the Guardrails: Comparative Study of Jailbreak Attacks on Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={1346-1350},
  abstract={Large language models (LLMs) are vulnerable to carefully engineered jailbreak prompts which allow the generation of forbidden content despite the existence of inbuilt safety measures. Even though the models have been widely implemented in vulnerable and high-stakes settings, there are limited systematic studies of their resistance to a continuum of adversarial examples. Or current assessments are often not coherent and are disjointed and fail to use standardized measurements or comparative reviews across models, which will hamper the development of holistic safety standards. The current study involved the application of adversarial suffixes, encoded prompts, role-playing conditions, and token-manipulation obfuscation to two language models, where a single benchmark of 120 prompts in 12 diverse domains was used. According to experimental findings, persona-based role-play attacks are virtually perfect on both models, whereas trivial typographic obfuscation leaves no apparent defense measures. Both models exhibit extremely high failure rates under persona-based role-play attacks, with success rates of 94.8% for ChatGPT-4o and 95.8% for Claude 4 Sonnet. ChatGPT-4o shows greater vulnerability to bit-bypass encoding $(35.7 \%)$, whereas Claude 4 Sonnet is significantly more exposed to adversarial suffix attacks $(62.5 \%)$, often exceeding 80% in domains like financial crime and cybersecurity. Differences in how systems react to encoded inputs and suffix manipulations highlight specific weaknesses. Continued benchmarking and focused defence research are needed to strengthen model reliability. These results outline distinct aspects of the lack of robustness and provide practical suggestions on the creation of the safety intervention in the future. The paper takes a comprehensive discussion of future research directions of adversarial robustness and suggests a methodological framework that will enable institutionalized pipelines of safety assessments.},
  keywords={Weapons;Nuclear weapons;Filtering;Filters;Circuits and systems;Modulation;Communications technology;Protocols;Role playing games;HTTP;Jailbreaking;Large Language Models;Adversarial Suffix Prompts;Bit-encoding Obfuscation;TokenManipulation Obfuscation;Prompt Engineering},
  doi={10.1109/IC3ECSBHI67834.2026.11468934},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11469093,
  author={Tripathi, Padmesh and Arora, Pridhi and Paroha, Krishna Kumar and Kumar, Devesh and Manisha and Katiyar, Preeti},
  booktitle={2026 2nd International Conference on Cognitive Computing in Engineering, Communications, Sciences and Biomedical Health Informatics (IC3ECSBHI)}, 
  title={Guardrail-Based Approaches for Enhancing Safety, Security, and Privacy in Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={1619-1624},
  abstract={Large Language Models are increasingly deployed in real-world applications because of their generative and reasoning capabilities. With their deployment, they also bring the risk related to safety, security and privacy. Safety concerns arise when the model generates hallucinated output, biased or harmful content. Security concerns arise with the prompt injection and jailbreaking attacks. The impact of these issues can be seen in various safety-critical domains such as healthcare, finance and legal decision-making and may cause significant harm. This paper focuses on guardrail mechanisms at the system level for handling risk concerns, including safety, security and privacy in the LLMs. The guardrail is enforced from the input level to continuous monitoring while the user is interacting with the LLM and the output level. A conceptual architecture integrating these stages is proposed. In addition, the paper proposes the evaluation criteria to assess the effectiveness of the guardrail in the real environment.},
  keywords={Filtering;Feedback;Filters;Circuits;Circuits and systems;Contacts;Protocols;Radio access networks;Regional area networks;HTTP;Large Language Models;Guardrail mechanism;AI Security;AI Safety;Privacy Protection;Prompt injection;Hallucination;Evaluation Framework},
  doi={10.1109/IC3ECSBHI67834.2026.11469093},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11468767,
  author={R, Nishmitha M and S, Tejakshi N and Sharma, Anshu and Kiran and M, Abhishek Gowda R and Karan},
  booktitle={2026 International Conference on Computing, Sciences and Communications (ICCSC)}, 
  title={PromptShield: LoRA-Based Parameter-Efficient Refusal Alignment for Election-Targeted Adversarial LLM Attacks}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large language models (LLMs) are increasingly deployed in public-facing information systems, where their misuse poses serious risks in high-stakes domains such as democratic elections. Despite extensive safety alignment, contemporary LLMs remain vulnerable to adversarial “jailbreak” prompting, enabling the generation of election-related misinformation, voter suppression narratives, and procedural manipulation. Recent election cycles have documented hundreds of verified instances of LLM-assisted disinformation campaigns, highlighting the urgent need for targeted, domain-specific defenses [1]–[3].We introduce PromptShield, a domain-specific, parameter-efficient refusal alignment approach based on Low-Rank Adaptation (LoRA) that strengthens LLM robustness against election-targeted jailbreak attacks. To support systematic training and evaluation, we present ElectionJailBench, a benchmark of $\mathbf{1 0, 0 0 0}$ synthetic adversarial prompts that combine election harm templates with diverse, state-of-the-art jailbreak strategies, including roleplaying, obfuscation, and optimization-based attacks [4]–[6]. PromptShield is trained via supervised fine-tuning on a 4-bit quantized Llama-3.1-8B-Instruct model and can be deployed in under one hour on commodity GPU hardware. Experimental results show a reduction in Attack Success Rate from $\mathbf{7 2. 0 \%}$ to $\mathbf{1 8. 0 \%}$ ($\mathbf{7 5 \%}$ relative improvement) on ElectionJailBench, while preserving general-purpose reasoning performance on the MMLU benchmark. Ablation studies further highlight the impact of dataset scale and LoRA rank on refusal robustness. Our findings demonstrate that lightweight, LoRAbased alignment can deliver effective, election-specific jailbreak resistance without incurring a measurable safety tax.},
  keywords={Feeds;Filtering;Feedback;Filters;Circuits;Recommender systems;Information filtering;Circuits and systems;LoRa;Deepfakes;Large Language Models;Adversarial Prompting;Jailbreak Defense;Election Misinformation;Parameter-Efficient Fine-Tuning;LoRA;Safety Alignment},
  doi={10.1109/ICCSC67078.2026.11468767},
  ISSN={},
  month={Feb},}@ARTICLE{11480194,
  author={Zhou, Shide and Wang, Kailong and Shi, Ling and Wang, Haoyu},
  journal={IEEE Transactions on Information Forensics and Security}, 
  title={Exposing the Ghost in the Transformer: Abnormal Detection for Large Language Models via Hidden State Forensics}, 
  year={2026},
  volume={21},
  number={},
  pages={4074-4089},
  abstract={The widespread adoption of Large Language Models (LLMs) in critical applications has introduced severe reliability and security risks, as LLMs remain vulnerable to notorious threats such as hallucinations, jailbreak attacks, and backdoor exploits. These vulnerabilities have been weaponized by malicious actors, leading to unauthorized access, widespread misinformation, and compromised LLM-embedded system integrity. In this work, we introduce a novel approach to detecting abnormal behaviors in LLMs via hidden state forensics. By systematically inspecting layer-specific activation patterns, we develop a general framework that can efficiently identify a range of security threats in real-time without imposing prohibitive computational costs. Extensive experiments indicate detection accuracies exceeding 95% and consistently robust performance across multiple models in most scenarios, while preserving the ability to detect novel attacks effectively. Furthermore, the computational overhead remains minimal, with detector inference taking merely fractions of a second. The significance of this work lies in proposing a promising strategy to reinforce the security of LLM-integrated systems, paving the way for safer and more reliable deployment in high-stakes domains. By enabling real-time detection that can also support the mitigation of abnormal behaviors, it represents a meaningful step toward ensuring the trustworthiness of AI systems amid rising security challenges.},
  keywords={Nuclear weapons;Filtering;Filters;Integrated circuits;MIMICs;Millimeter wave integrated circuits;Monolithic integrated circuits;Circuits;Circuits and systems;Internet;Large language models;abnormal behavior detection;jailbreak attacks;hallucination;backdoor attacks},
  doi={10.1109/TIFS.2026.3683279},
  ISSN={1556-6021},
  month={},}@ARTICLE{11479797,
  author={Goyal, Ishika and Sai, Siva and Gupta, Aahana and Chamola, Vinay},
  journal={IEEE Communications Standards Magazine}, 
  title={The Safety Frontier in LLMs: Risks, Defenses, and Open Challenges}, 
  year={2026},
  volume={},
  number={},
  pages={1-9},
  abstract={Large Language Models (LLMs) such as ChatGPT, Claude, and LLaMA are rapidly transforming domains including healthcare, education, law, and finance. However, their increasing adoption in high-stakes applications raises serious safety concerns. Without sufficient safeguards, LLM-powered AI systems are vulnerable to threats such as prompt injection, training data poisoning, model theft, denial-of-service through prompt abuse, misinformation generation, adversarial examples, model inversion, data leakage, and insider misuse. These vulnerabilities can produce harmful, biased, or misleading outputs, compromise privacy, and undermine trust. To address these risks, researchers have proposed safety approaches that aim to constrain and guide model behaviour, proactively detect and resist attacks, and incorporate ethical alignment into model design. Together, these methods form a multi-layered defence that combines preventive, detective, and corrective measures to improve LLM robustness and trustworthiness. This paper presents a comprehensive review of key safety mechanisms for LLMs, categorizing them into guardrails, red teaming, adversarial training, alignment techniques, jailbreak detection and prevention, watermarking, and fuzzing. For each category, recent advances are summarized, strengths and limitations are assessed, and open challenges are identified to support safer and more reliable real-world deployment of LLMs.},
  keywords={Feeds;Filtering;Filters;Feedback;Circuits;Circuits and systems;Communication systems;Internet of Things;Electronic mail;Internet},
  doi={10.1109/MCOMSTD.2026.3676030},
  ISSN={2471-2833},
  month={},}@ARTICLE{11475468,
  author={Sugio, Nobuyuki and Ito, Hokuto},
  journal={IEEE Access}, 
  title={Jailbreak-Free LLM-Assisted Malware Generation: An Empirical and Conceptual Analysis}, 
  year={2026},
  volume={14},
  number={},
