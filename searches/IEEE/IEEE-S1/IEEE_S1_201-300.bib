  booktitle={2025 IEEE International Women in Engineering (WIE) Conference on Electrical and Computer Engineering (WIECON-ECE)}, 
  title={A Multi-Agent LLM Defense Pipeline Against Prompt Injection Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={207-212},
  abstract={Prompt injection attacks represent a major vulnerability in Large Language Model (LLM) deployments, where malicious instructions embedded in user inputs can override system prompts and induce unintended behaviors. This paper presents a novel multi-agent defense framework that employs specialized LLM agents in coordinated pipelines to detect and neutralize prompt injection attacks in real-time. We evaluate our approach using two distinct architectures: a sequential chain-ofagents pipeline and a hierarchical coordinator-based system. Our comprehensive evaluation on 55 unique prompt injection attacks, grouped into 8 categories and totaling 400 attack instances across two LLM platforms (ChatGLM and Llama2), demonstrates significant security improvements. Without defense mechanisms, baseline Attack Success Rates (ASR) reached $\mathbf{3 0 \%}$ for ChatGLM and 20 % for Llama2. Our multi-agent pipeline achieved 100 % mitigation, reducing ASR to 0 % across all tested scenarios. The framework demonstrates robustness across multiple attack categories including direct overrides, code execution attempts, data exfiltration, and obfuscation techniques, while maintaining system functionality for legitimate queries.},
  keywords={Modeling;Large language models;Pipelines;Automatic speech recognition;Printing;Architecture;Computer architecture;Taxonomy;Security;Filtering;Large Language Models;Prompt Injection;Multi-Agent Systems;Cybersecurity;AI Safety},
  doi={10.1109/WIECON-ECE69386.2025.11526251},
  ISSN={2837-8245},
  month={Dec},}@INPROCEEDINGS{11501150,
  author={Bhardwaj, Nimit and Bhardwaj, Anvit and Garg, Lavanya},
  booktitle={2025 3rd International Conference on Sustainable Computing and Smart Systems (ICSCSS)}, 
  title={Hallucination-Aware, Injection-Resistant LLMs for Scientific Text Integrity}, 
  year={2025},
  volume={},
  number={},
  pages={2117-2123},
  abstract={Large language models are increasingly used in scientific writing and enterprise applications, yet remain vulnerable to two critical issues: hallucination and prompt injection. Hallucinations introduce fabricated or inaccurate information, undermining trust and reproducibility in generated text. Prompt injections manipulate model behavior by exploiting instruction-following tendencies, posing security risks in dynamic input environments. This paper proposes SciGuard, a unified framework designed to detect hallucinated content and defend against prompt-based adversarial manipulation. The architecture integrates token-level classification, contradiction-aware logic validation, and semantic prompt rewriting to handle both threats in real time. Experiments conducted on scientific and enterprise benchmarks show that SciGuard outperforms existing models across precision, recall, and F1 metrics while maintaining low latency. The results highlight the effectiveness of integrating factual verification and input control into a single system, offering a robust foundation for secure and reliable generative AI deployments.},
  keywords={Filtering;Filters;Circuits and systems;Internet of Things;Communication systems;Internet;Protocols;HTTP;Wide area networks;Computer networks;Hallucination Detection;Prompt Injection Defense;Large Language Models;Scientific Text Verification;Adversarial Prompt Rewriting;Real-Time AI Security},
  doi={10.1109/ICSCSS64956.2025.11501150},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11500704,
  author={Yadav, Mohit},
  booktitle={2025 3rd International Conference on Sustainable Computing and Smart Systems (ICSCSS)}, 
  title={The Role of Large Language Models in Cybersecurity: Strengths, Vulnerabilities, and Mitigation Strategies}, 
  year={2025},
  volume={},
  number={},
  pages={1983-1990},
  abstract={Large Language Models (LLMs) have transformed cybersecurity by enhancing threat detection, predictive analysis, and automated security response. These models analyse vast cybersecurity datasets, identify anomalies, and support real-time decision-making in applications such as phishing detection, malware classification, and intrusion detection. However, despite their advantages, LLMs pose critical risks, including adversarial attacks, data leakage, and biased decision-making. Cybercriminals actively exploit these vulnerabilities through prompt injection, model inversion, and misinformation generation. Traditional cybersecurity approaches rely on rule-based systems and signature-based detection methods, which struggle against evolving threats such as zero-day attacks and polymorphic malware. The increasing complexity and volume of cyber threats demand more adaptive solutions. Recent advancements in AI-driven security have integrated LLMs with deep learning (DL) techniques, improving detection accuracy and response efficiency. Transfer learning (TL), adversarial training, and fine-tuning techniques have enhanced the adaptability and robustness of LLM-based cybersecurity frameworks. This research explores the role of LLMs in cybersecurity, analysing their strengths, vulnerabilities, and mitigation strategies. It evaluates key challenges, including adversarial robustness, privacy risks, and model bias, while investigating AI-driven solutions to enhance security operations. Research highlights the effectiveness of LLMs in improving automated threat detection and response, with recommendations for enhancing model interpretability, mitigating security risks, and integrating hybrid AI frameworks to develop scalable cybersecurity solutions. By addressing the evolving domain of AI-driven cybersecurity, this research provides valuable insights into the optimization of LLMs for cyber threat detection, resilience against adversarial attacks, and the future of AI-enhanced security infrastructure.},
  keywords={Feeds;Antennas;Radio broadcasting;Frequency modulation;Filtering;System-on-chip;Filters;Circuits;Feedback;Application specific integrated circuits;Large Language Models;Cybersecurity;Threat Detection;Adversarial Attacks;Mitigation Strategies;AI-Driven Security},
  doi={10.1109/ICSCSS64956.2025.11500704},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11491276,
  author={Islam, Md. Mazharul and Ahmed, Mubasshir and Khan, Niaz Ashraf},
  booktitle={2025 28th International Conference on Computer and Information Technology (ICCIT)}, 
  title={CPS-Guard: Defensive Architectures for Securing Large Language Models in Cyber-Physical Systems}, 
  year={2025},
  volume={},
  number={},
  pages={2802-2807},
  abstract={Cyber-physical systems (CPS) are increasingly adopting large language models (LLMs) for log analysis, operator support, and anomaly triage. While LLMs enable powerful reasoning and flexible natural-language interaction, their probabilistic and opaque behavior introduces new attack surfaces, including prompt injection, adversarial manipulation, and privacy leakage. Existing CPS defenses largely assume deterministic models and do not account for LLM-specific threats, whereas current LLM safety work rarely targets real-time, safety-critical control environments. To bridge this gap, we propose CPS-Guard, a defense-in-depth architecture for LLM-enabled CPS that operates under advisory-only semantics. CPS-Guard combines secure prompt handling, explicit threat modeling, a deterministic safety validator with policy and bounds checking, and anomaly-based veto over plant telemetry. We implement CPS-Guard as middleware between CPS controllers and an aligned LLM, and evaluate it on 300 synthetically generated adversarial inputs spanning prompt injection, adversarial perturbations, and poisoning-style triggers. Compared to an unprotected LLM advisory baseline, CPS-Guard reduces failure rates by more than 85 % while incurring only 10 18 % additional latency across small to large CPS workloads. These results indicate that system-level hardening can make LLM-assisted CPS substantially more robust without violating real-time constraints.},
  keywords={Telemetry;Aerospace and electronic systems;Filtering;Filters;Central Processing Unit;System-on-chip;Feedback;Circuits;Circuits and systems;Electronic circuits;Cyber-Physical Systems (CPS);Large Language Models (LLMs);Prompt Injection;Adversarial Robustness;Anomaly Detection;Defense-in-Depth;LLM Security},
  doi={10.1109/ICCIT68739.2025.11491276},
