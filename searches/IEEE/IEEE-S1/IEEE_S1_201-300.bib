  journal={IEEE Transactions on Evolutionary Computation}, 
  title={UniBreak: A Unified Evolutionary Token-Level Jailbreaking Framework for Large Language Models}, 
  year={2026},
  volume={30},
  number={4},
  pages={1450-1464},
  abstract={Large language models (LLMs) demonstrate promising capabilities in natural language understanding and reasoning with enormous parameter spaces and vast amount of training data. These attributes have facilitated their deployment into diverse application domains. However, the underlying parameters implicitly assume decision-making boundaries, resulting in significant decision space regions not covered by training data. It makes them susceptible to adversarial manipulations through carefully crafted inputs. To illuminate the vulnerabilities of LLMs, we propose a unified token-level jailbreaking attack that makes victim models generate responses for potentially harmful queries. Specifically, we propose an evolutionary algorithm to evolve perturbation sets, utilizing gradient-based and crossover-based operators to enhance performance under multiple scenarios. Furthermore, we develop a repository for reusing past perturbations and conduct an analysis of token sensitivity within LLMs, facilitating zero-shot attacks with convergence. Extensive benchmark experiments validate its effectiveness across three different models, achieving the increases of 62.36%, 57.89%, and 64.81% in attack success rates compared to baseline methods under white-box scenarios. In addition, the evaluation experiments demonstrate that the proposed method is effective for multiple scenarios and different LLM sizes. This study reveals the vulnerabilities of LLMs, provides theoretical foundations for developing robust defense strategies, and contributes to building reliable AI systems.},
  keywords={Perturbation methods;Semantics;Computational modeling;Threat modeling;Probability distribution;Sensitivity;Adversarial machine learning;Large language models;Artificial intelligence;Safety;Adversarial examples;AI safety;evolutionary algorithms;jailbreaking attacks;Large language models (LLMs)},
  doi={10.1109/TEVC.2026.3656951},
