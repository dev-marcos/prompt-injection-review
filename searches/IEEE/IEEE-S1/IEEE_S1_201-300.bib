  ISSN={2474-9656},
  month={Dec},}@INPROCEEDINGS{11446016,
  author={Zhao, Shiji and Duan, Ranjie and Wang, Fengxiang and Chen, Chi and Kang, Caixin and Ruan, Shouwei and Tao, Jialing and Chen, YueFeng and Xue, Hui and Wei, Xingxing},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={Jailbreaking Multimodal Large Language Models via Shuffle Inconsistency}, 
  year={2025},
  volume={},
  number={},
  pages={2045-2054},
  abstract={Multimodal Large Language Models (MLLMs) have achieved impressive performance and have been put into practical use in commercial applications, but they still have potential safety mechanism vulnerabilities. Jailbreak attacks are red teaming methods that aim to bypass safety mechanisms and discover MLLMs' potential risks. Existing MLLMs' jailbreak methods often bypass the model's safety mechanism through complex optimization methods or carefully designed image and text prompts. Despite achieving some progress, they have a low attack success rate on commercial closed-source MLLMs. Unlike previous research, we empirically find that there exists a Shuffle Inconsistency between MLLMs' comprehension ability and safety ability for the shuffled harmful instruction. That is, from the perspective of comprehension ability, MLLMs can understand the shuffled harmful text-image instructions well. However, they can be easily bypassed by the shuffled harmful instructions from the perspective of safety ability, leading to harmful responses. Then we innovatively propose a text-image jailbreak attack named SI-Attack. Specifically, to fully utilize the Shuffle Inconsistency and overcome the shuffle randomness, we apply a query-based black-box optimization method to select the most harmful shuffled inputs based on the feedback of the toxic judge model. A series of experiments show that SI-Attack can effectively improve the attack's performance on three benchmarks for both open-source and closed-source MLLMs. Warning: This paper contains examples of harmful texts and images, and reader discretion is recommended.},
  keywords={Filtering;Feedback;Filters;Circuits;Circuits and systems;Pixel;Communication systems;Protocols;Internet;HTTP;jailbreak attack;mllms;shullfe inconsistency;ai safety},
  doi={10.1109/ICCV51701.2025.00198},
  ISSN={2380-7504},
  month={Oct},}@INPROCEEDINGS{11446151,
  author={Wang, Ruofan and Li, Juncheng and Wang, Yixu and Wang, Bo and Wang, Xiaosen and Teng, Yan and Wang, Yingchun and Ma, Xingjun and Jiang, Yu-Gang},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={Ideator: Jailbreaking and Benchmarking Large Vision-Language Models Using Themselves}, 
  year={2025},
  volume={},
  number={},
  pages={8875-8884},
  abstract={As large Vision-Language Models (VLMs) gain prominence, ensuring their safe deployment has become critical. Recent studies have explored VLM robustness against jailbreak at-tacks-techniques that exploit model vulnerabilities to elicit harmful outputs. However, the limited availability of diverse multimodal data has constrained current approaches to rely heavily on adversarial or manually crafted images derived from harmful text datasets, which often lack effectiveness and diversity across different contexts. In this paper, we propose IDEATOR, a novel jailbreak method that autonomously generates malicious image-text pairs for black-box jailbreak attacks. IDEATOR is grounded in the insight that VLMs themselves could serve as powerful red team models for generating multimodal jailbreak prompts. Specifically, IDEATOR leverages a VLM to create targeted jailbreak texts and pairs them with jailbreak images generated by a state-of-the-art diffusion model. Extensive experiments demonstrate IDEATOR's high effectiveness and transferability, achieving a 94% attack success rate (ASR) in jailbreaking MiniGPT-4 with an average of only 5.34 queries, and high ASRs of $82 \%, 88 \%$, and 75 % when transferred to LLaVA, InstructBLIP, and Chameleon, respectively. Building on IDEATOR's strong transferability and automated process, we introduce the VLJailbreakBench, a safety benchmark comprising 3,654 multimodal jailbreak samples. Our benchmark results on 11 recently released VLMs reveal significant gaps in safety alignment. For instance, our challenge set achieves ASRs of 46.31% on GPT40 and 19.65% on Claude-3.5-Sonnet, underscoring the urgent need for stronger defenses. Disclaimer: This paper contains content that may be disturbing or offensive.},
  keywords={Weapons;Filtering;Filters;Feedback;Circuits;Circuits and systems;Internet;Communication systems;Protocols;Radio access networks;red teaming;jailbreak attack;black-box attack;vision-language model},
  doi={10.1109/ICCV51701.2025.00830},
  ISSN={2380-7504},
  month={Oct},}@INPROCEEDINGS{11444556,
  author={Ma, Teng and Jia, Xiaojun and Duan, Ranjie and Li, Xinfeng and Huang, Yihao and Jia, Xiaoshuang and Chu, Zhixuan and Ren, Wenqi},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={Heuristic-Induced Multimodal Risk Distribution Jailbreak Attack for Multimodal Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={2686-2696},
  abstract={With the rapid advancement of multimodal large language models (MLLMs), concerns regarding their security have increasingly captured the attention of both academia and industry. Although MLLMs are vulnerable to jailbreak attacks, designing effective jailbreak attacks poses unique challenges, especially given the highly constrained adversarial capabilities in real-world deployment scenarios. Previous works concentrate risks into a single modality, resulting in limited jailbreak performance. In this paper, we propose a heuristic-induced multimodal risk distribution jailbreak attack method, called HIMRD, which is black-box and consists of two elements: multimodal risk distribution strategy and heuristic-induced search strategy. The multimodal risk distribution strategy is used to distribute harmful semantics into multiple modalities to effectively circumvent the single-modality protection mechanisms of MLLMs. The heuristic-induced search strategy identifies two types of prompts: the understanding-enhancing prompt, which helps MLLMs reconstruct the malicious prompt, and the inducing prompt, which increases the likelihood of affirmative outputs over refusals, enabling a successful jailbreak attack. HIMRD achieves an average attack success rate (ASR) of 90% across seven open-source MLLMs and an average ASR of around 68% in three closed-source MLLMs. HIMRD reveals cross-modal security vulnerabilities in current MLLMs and underscores the imperative for developing defensive strategies to mitigate such emerging risks. Code is available at https://github.com/MaTengSYSU/HIMRDjailbreak.},
  keywords={Feeds;Communication systems;Protocols;Regional area networks;Radio access networks;HTTP;Local area networks;Amplitude shift keying;Internet;Location awareness;mllm security;jailbreak attack},
  doi={10.1109/ICCV51701.2025.00258},
  ISSN={2380-7504},
  month={Oct},}@INPROCEEDINGS{11445897,
  author={Wang, Jiawei and Zuo, Yushen and Chai, Yuanjun and Liu, Zhendong and Fu, Yicheng and Feng, Yichun and Lam, Kin-Man},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={Safeguarding Vision-Language Models: Mitigating Vulnerabilities to Gaussian Noise in Perturbation-Based Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={2773-2782},
  abstract={Vision-Language Models (VLMs) extend the capabilities of Large Language Models (LLMs) by incorporating visual information, yet they remain vulnerable to jailbreak attacks, especially when processing noisy or corrupted images. Although existing VLMs adopt security measures during training to mitigate such attacks, vulnerabilities associated with noise-augmented visual inputs are overlooked. In this work, we identify that missing noise-augmented training causes critical security gaps: many VLMs are susceptible to even simple perturbations such as Gaussian noise. To address this challenge, we propose Robust-VLGuard, a multimodal safety dataset with aligned / misaligned imagetext pairs, combined with noise-augmented fine-tuning that reduces attack success rates while preserving functionality of VLM. For stronger optimization-based visual perturbation attacks, we propose DiffPure-VLM, leveraging diffusion models to convert adversarial perturbations into Gaussian-like noise, which can be defended by VLMs with noise-augmented safety fine-tuning. Experimental results demonstrate that the distribution-shifting property of diffusion model aligns well with our fine-tuned VLMs, significantly mitigating adversarial perturbations across varying intensities. The dataset and code are available at https://github.com/JarvisUSTC/DiffPureRobustVLM},
  keywords={Feeds;Feedback;Circuits;Pixel;LoRa;Protocols;Product development;Radio access networks;Regional area networks;HTTP;multimodal large language models;gaussian noise;adversarial defense;safety alignment},
  doi={10.1109/ICCV51701.2025.00266},
  ISSN={2380-7504},
  month={Oct},}@INPROCEEDINGS{11476245,
  author={Lopez-Juarez, Ismael and Lopez-Valadez, Kieran I and Castillo-Barrientos, Luis A.},
  booktitle={2025 IEEE CHILEAN Conference on Electrical, Electronics Engineering, Information and Communication Technologies (CHILECON)}, 
  title={Zero-Shot Robotic Control via Custom LLM Agents: A Lightweight Framework for Embodied Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={This work presents an AI-powered framework for autonomous robot control using a custom large language model (LLM) agent built with DeepSeek. By leveraging document-based prompt injection, the system incorporates domain-specific knowl-edge—such as robot specifications and API documentation—into the LLM to enable zero-shot Python code generation. The agent extracts and executes code in real time to control a myCobot 280 Pi robotic arm, operating entirely offline without persistent cloud connectivity. A modular pipeline automates the workflow from natural language input to subprocess-based code execution. Experimental results demonstrate the agent's ability to interpret high-level voice or text instructions and translate them into functional robot behaviors. Although the current implementation is focused on motion tasks without sensory feedback, the architecture lays the groundwork for future integration of multimodal perception and closed-loop control. This study highlights the potential of lightweight, locally-deployable LLMs for intuitive human-robot interaction and rapid prototyping in edge robotics.},
  keywords={Feedback;Circuits;Graphical user interfaces;Communications technology;Product development;Information and communication technology;Radio access networks;Regional area networks;Protocols;Electronic mail;Large Language Models;Zero-Shot Learning;Robot Control;myCobot;DeepSeek;Edge AI;Prompt Engineering},
  doi={10.1109/CHILECON66915.2025.11476245},
  ISSN={2832-1537},
  month={Oct},}@INPROCEEDINGS{11473001,
  author={Farlow, Harriet and Garratt, Matt and Mount, Gavin and Lynar, Tim},
  booktitle={2025 International Conference on Computational Intelligence, Security, and Artificial Intelligence (IntelliSecAI)}, 
  title={Quantifying AI Security Coverage: A Metric-Based Evaluation Across Five Governance Frameworks}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={As artificial intelligence (AI) systems are increasingly integrated into more systems, there is a requirement to extend cyber and information security risk management into AI security. AI security refers to the technical and governance mechanisms that protect AI systems from external threats. A gap analysis of AI security coverage was conducted across five AI risk frameworks: National Institute of Standards and Technology's (NIST) AI Risk Management Framework (RMF), the European Union (EU) AI Act, Microsoft's Guide for Securing the AI-Powered Enterprise (GSAIPE), International Standards Organisation (ISO)/IEC 42001, and the United Kingdom's National Cyber Security Centre (NCSC) AI Security Guidelines. We define a Normalised Coverage-Depth Score (CDS) metric to systematically compare controls recommended by each framework and which risk factors they address. We perform qualitative assessment on two case studies: prompt injection and model evasion. We combine these insights to build on existing AI risk management scholarship and propose targeted recommendations for addressing AI security risk assessment and strategic prioritisation.},
  keywords={Filtering;Filters;HTTP;Protocols;Unsolicited e-mail;Artificial intelligence;Machine learning;Large language models;Computational intelligence;Retrieval augmented generation;AI Security;Cybersecurity Frameworks;Risk Management;Adversarial Machine Learning;Compliance;Regulation;AI Governance},
  doi={10.1109/IntelliSecAI66368.2025.11473001},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11472287,
  author={Kim, Hyun Jung and Yoo, Sang Hyun},
  booktitle={2025 5th International Conference on Electrical, Computer and Energy Technologies (ICECET)}, 
  title={Prompt Injection Vulnerabilities and Data Leakage in ChatGPT and Claude: Toward Safer Conversational AI}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={The security vulnerabilities of large language models (LLMs) have emerged as a critical concern due to their widespread adoption. Conversational AI systems such as ChatGPT and Claude, in particular, are exposed to prompt injection attacks and data-leakage risks. However, there has been limited research directly comparing the security vulnerabilities of models employing different alignment techniques (reinforcement learning from human feedback, RLHF, vs. Constitutional AI). In this paper, we analyze the responses of ChatGPT and Claude to over 50 diverse prompt attacks under identical experimental conditions. Both models completely defended against simple one-shot attacks (attack success rate, ASR = 0%), but for complex multi-turn attacks, ChatGPT and Claude exhibited ASRs of 22% and 17%, respectively. Interestingly, ChatGPT proved more susceptible to gradual context manipulation, whereas Claude was more vulnerable to authority-mimicking attacks—patterns we attribute to their respective alignment methods. Based on these findings, we propose novel defense strategies, including multi-layer AI filtering, attention-based detection mechanisms, and continual adversarial retraining. The limitations of this study include the rapid evolution of tested model versions and a restricted attack set. Future work should focus on deploying the proposed defenses in operational environments and developing standardized benchmarks for adversarial robustness across different alignment paradigms.},
  keywords={Nuclear weapons;Feedback;Filtering;Filters;MIMICs;Circuits;Millimeter wave integrated circuits;Monolithic integrated circuits;Circuits and systems;Internet of Things;Conversational AI;prompt injection;data leakage;security vulnerabilities;reinforcement learning from human feedback (RLHF);Constitutional AI;adversarial attacks;multi-layer defense;continual learning},
  doi={10.1109/ICECET63943.2025.11472287},
  ISSN={},
  month={July},}@INPROCEEDINGS{11471392,
  author={Rosengren, Jonas and Brynielsson, Joel and Johansson, Fredrik and Jonell, Patrik},
  booktitle={2025 International Conference on Machine Learning and Applications (ICMLA)}, 
  title={Jailbreaking Large Language Models: Safety Alignment, Response Quality, Computational Cost}, 
  year={2025},
  volume={},
  number={},
  pages={1116-1123},
  abstract={Large language models are often equipped with safety alignment mechanisms designed to prevent generation of harmful or other unwanted content. However, an increasing number of jailbreaking techniques attempt to circumvent these safeguards, raising significant safety concerns. This paper introduces an open-source evaluation framework that analyzes jailbreaking effectiveness in several dimensions: refusal bypass rate, harmful response quality, impact on general model capabilities, and computational cost. In the study, prompt injection, sampling exploits, and model manipulation techniques are examined across four open-weight instruction-tuned large language models. The results demonstrate that high refusal bypass does not necessarily equate to practical safety compromise. Specifically, model manipulation methods like single refusal direction ablation achieve a high attack success rate, but often degrade general capabilities and require significant computational resources. Meanwhile, sampling-based exploits show a minimal practical threat when assessed with a robust model classifier. The findings emphasize the importance of comprehensive, multi-dimensional evaluation to accurately characterize jailbreaking effectiveness and safety risks in large language models.},
  keywords={Nuclear weapons;Weapons;Feedback;Filtering;Circuits;Filters;Radio access networks;Regional area networks;LoRa;Protocols;Large language models;jailbreaking;safety alignment;sampling exploit;prompt injection;model manipulation},
  doi={10.1109/ICMLA66185.2025.00172},
  ISSN={1946-0759},
  month={Dec},}@INPROCEEDINGS{11471500,
  author={Pawelek, Tom and Patel, Raj and Crowell, Charlotte and Golilarz, Noorbakhsh Amiri and Mittal, Sudip and Rahimi, Shahram and Perkins, Andy},
  booktitle={2025 International Conference on Machine Learning and Applications (ICMLA)}, 
  title={LLMZ+: Contextual Prompt Whitelist Principles for Agentic LLMs}, 
  year={2025},
  volume={},
  number={},
  pages={1396-1402},
  abstract={Compared to traditional models, agentic AI represents a highly valuable target for potential attackers as they possess privileged access to data sources and API tools, which are traditionally not incorporated into classical agents. Unlike a typical software application residing in a Demilitarized Zone (DMZ), agentic LLMs consciously rely on nondeterministic behavior of the AI (only defining a final goal, leaving the path selection to LLM). This characteristic introduces substantial security risk to both operational security and information security. Most common existing defense mechanism rely on detection of malicious intent and preventing it from reaching the LLM agent, thus protecting against jailbreak attacks such as prompt injection. In this paper, we present an alternative approach, LLMZ+, which moves beyond traditional detection-based approaches by implementing prompt whitelisting. Through this method, only contextually appropriate and safe messages are permitted to interact with the agentic LLM. By leveraging the specificity of context, LLMZ+ guarantees that all exchanges between external users and the LLM conform to predefined use cases and operational boundaries. Our approach streamlines the security framework, enhances its long-term resilience, and reduces the resources required for sustaining LLM information security. Our empirical evaluation demonstrates that LLMZ+ provides strong resilience against the most common jailbreak prompts. At the same time, legitimate business communications are not disrupted, and authorized traffic flows seamlessly between users and the agentic LLM. We measure the effectiveness of approach using false positive and false negative rates, both of which can be reduced to 0 in our experimental setting.},
  keywords={Payloads;Filtering;Filters;Feedback;Circuits;Central Processing Unit;Circuits and systems;Computer networks;Virtual private networks;Protocols;security;LLM;Prompt injection;Prompt jailbreak;Agentic AI;LLMZ+;Prompt whitelisting;Contextual whitelisting},
  doi={10.1109/ICMLA66185.2025.00213},
  ISSN={1946-0759},
  month={Dec},}@INPROCEEDINGS{11471319,
  author={Das, Badhan Chandra and Jawad, Md Tasnim and Mia, Md Jueal and Amini, M. Hadi and Wu, Yanzhao},
  booktitle={2025 International Conference on Machine Learning and Applications (ICMLA)}, 
  title={Jailbreaking Large Vision Language Models in Intelligent Transportation Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1423-1429},
  abstract={Large Vision Language Models (LVLMs) demon-strate strong capabilities in multimodal reasoning and many real-world applications, such as visual question answering. However, LVLMs are highly vulnerable to jailbreaking attacks. This paper systematically analyzes the vulnerabilities of LVLMs integrated in Intelligent Transportation Systems (ITS) under carefully crafted jailbreaking attacks. First, we carefully construct a dataset with harmful queries relevant to transportation, following OpenAI’s prohibited categories to which the LVLMs should not respond. Second, we introduce a novel jailbreaking attack that exploits the vulnerabilities of LVLMs through image typography manipulation and multi-turn prompting. Third, we propose a multi-layered response filtering defense technique to prevent the model from generating inappropriate responses. We perform extensive experiments with the proposed attack and defense on the state-of-the-art LVLMs (both open-source and closed-source). To evaluate the attack method and defense technique, we use GPT-4’s judgment to determine the toxicity score of the generated responses, as well as manual verification. Further, we compare our proposed jailbreaking method with existing jailbreaking techniques and highlight severe security risks involved with jailbreaking attacks with image typography manipulation and multi-turn prompting in the LVLMs integrated in ITS.},
  keywords={Feeds;Filtering;Filters;Circuits and systems;Communication systems;Amplitude shift keying;Vehicle-to-everything;Videos;Protocols;Amplitude modulation;Intelligent Transportation Systems;Jailbreaking attack;Typography;Multi-turn Prompting},
  doi={10.1109/ICMLA66185.2025.00217},
  ISSN={1946-0759},
  month={Dec},}@INPROCEEDINGS{11452634,
  author={Ba, Zezhi and Zhao, Jiawei and Chen, Kejiang and Zhang, Weiming and Yu, Nenghai},
  booktitle={2025 International Conference on Cyber Resilience and Endogenous Safety & Security (CRESS)}, 
  title={JailbreakMaster: Low-Interaction Jailbreak Prompt Generation via Feature-Guided Strategy Search and Adaptive Fusion}, 
  year={2025},
  volume={},
  number={},
  pages={299-304},
  abstract={Large Language Models (LLMs) exhibit strong generative capabilities yet remain susceptible to jailbreak attacks that undermine safety and reliability. Existing jailbreak methods often require excessive interactions or computational resources, limiting practicality for real-world use. We present Jailbreak-Master, an automated framework for low-interaction jailbreak prompt generation via feature-guided strategy search over an extensible strategy hub, with adaptive fusion as a complementary enhancement. JailbreakMaster models target-side textual features to index and select strategies and composes them to generate adversarial prompts under black-box settings. Experiments indicate that, across closed-source models such as GPT-4, Gemini Pro, and DeepSeek V3, JailbreakMaster achieves an average attack success rate above 73% while typically completing successful attacks in fewer than ten target-model queries. On open-source models, it attains an even higher average success rate of about 93% and also demonstrates robustness against common defenses. Together, these results establish JailbreakMaster as an efficient and practical framework for automated, low-interaction jailbreak prompt generation.},
  keywords={Adaptation models;Limiting;Large language models;Computational modeling;Closed box;Search problems;Robustness;Safety;Indexes;Security;Large Language Models;Jailbreak Attacks;Feature-Guided Strategy Search;Strategy Library;Low-Interaction},
  doi={10.1109/CRESS68073.2025.11452634},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11452809,
  author={Patil, Kiran and Gupta, Poonam and Nagre, Harshal and Hadule, Harshad},
  booktitle={2025 1st International Conference on Advancement in Futuristic Technologies (ICAFT)}, 
  title={Layer Zero: The Safeguard against Malicious Prompts}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models (LLMs) are widely adopted for their ability to perform complex language understanding and generation tasks.They can produce clear text, summarize detailed documents, answer questions, and reason across many contexts. However, LLMs are still sensitive to harmful inputs, which are carefully designed prompts that can evade safety measures and cause the model to produce harmful, biased, or misleading information. Examples include prompt injection, jailbreak attacks, security bypass and automated phishing attempts. If these threats aren’t handled well, they can put users at risk and reduce people’s trust in AI systems. To tackle this issue, we propose a protective wrapper that operates outside the LLM. This wrapper reviews user inputs before they reach the model, functioning as a safety filter. We employ two methods to identify risky prompts. The first one is a lightweight logistic regression model, which quickly detects simple malicious inputs with minimal computing power. The second method is a Bidirectional Encoder Representations from Transformers (BERT) classifier, which understands the meaning and context of more complex or hidden attacks. Depending upon the classification, the wrapper either allows the input to pass through to the LLM safely or blocks it while keeping the log of each action. This wrapper adds an extra layer of protection without altering how the LLM works. It keeps the system safe and dependable, so users can interact with it confidently. By catching harmful inputs early, the wrapper makes LLMs safer to use in everyday situations, striking the right balance between security and practicality.},
  keywords={Logistic regression;Reviews;Phishing;Computational modeling;Large language models;Bidirectional control;Transformers;Encoding;Security;Protection;prompt injection;jailbreak detection;phishing;logistic regression;BERT;wrapper;LLM security},
  doi={10.1109/ICAFT66710.2025.11452809},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11452136,
  author={Chen, Xiaoxiao and Qian, Jingwei and Wang, Haitao},
  booktitle={2025 International Conference on Artificial Intelligence Security and Governance (ICAISG)}, 
  title={Transferable Ensemble Black-Box Jailbreak Attacks on Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={102-106},
  abstract={We propose a novel black-box jailbreak attacking framework that incorporates various LLM-as-Attacker methods to deliver transferable and powerful jailbreak attacks. Our method is driven by three key observations from existing jailbreaking studies and practices. First, an ensemble of multiple attack methods is more effective in exposing vulnerabilities of aligned LLMs than single attack methods, as it can cover diverse weaknesses in the target model's defense mechanism. Second, different malicious instructions inherently vary in their jailbreaking difficulty, necessitating differentiated treatment to ensure more efficient attacks. Finally, the semantic coherence of a malicious instruction is crucial for triggering the defenses of an aligned LLM; therefore, it must be carefully disrupted to manipulate its embedding representation, thereby increasing the jailbreak success rate. Experimental results validate the framework's superiority: it achieves strong jailbreak performance across diverse target LLMs, with notable improvements in transferability compared to baseline methods, and maintains high stealthiness as measured by semantic similarity metrics. Notably, with this framework, we won the championship in the jailbreaking attack track of a global LLM safety competition and received the best black-box method honor, validating its practical superiority.},
  keywords={Measurement;Target tracking;Large language models;Semantics;Closed box;Coherence;Safety;Security;Large Language Models;Black-box Jailbreak;Ensemble Attack;Transferability;Stealthiness},
  doi={10.1109/ICAISG68699.2025.11452136},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11427210,
  author={Chen, Yuzheng and Wen, Hong and Hou, Wenjing and Mao, Juntao and Luo, Wenjun and Zhao, Wei},
  booktitle={2025 IEEE 7th International Conference on Artificial Intelligence, Computer Science, and Information Processing (AICSIP)}, 
  title={Data Poisoning Attacks of Fine-Tuning for Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper proposes a novel algorithm JailPoisoning for generating poisoning datasets based on jailbreak attacks, targeting the security vulnerabilities of large language models (LLMs). Combining the gcg jailbreak attack method and fine-tuning poisoning attack method, this paper demonstrates the attack capabilities of the algorithm against recently released LLMs such as Qwen2.5 and DeepSeek-R1Distill to bypass security detection mechanisms. We evaluate it with other jailbreak attack methods like gcg. The results show that the proposed algorithm is more effective in attacking recently released LLMs while maintaining high text generation performance, revealing existing defense vulnerabilities in LLMs.},
  keywords={Computer science;Large language models;Information processing;Data models;Security;LLM;AI;poisoning attacks;jailbreak attacks},
  doi={10.1109/AICSIP65423.2025.11427210},
  ISSN={},
  month={July},}@INPROCEEDINGS{11430791,
  author={Syed, Toqeer Ali and Almutairi, Mishal Ateeq and Moaty, Mahmoud Abdel},
  booktitle={2025 International Conference on Computer and Applications (ICCA)}, 
  title={Cross-Agent Multimodal Provenance-Aware Framework for Robust Prompt Injection Defense in Large Language and Vision-Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Large Language Models (LLMs), VisionLanguage Models (VLMs), and new agentic AI systems (e.g., LangChain and GraphChain) allow autonomous systems to reason and plan, and to coordinate between an assortment of tools and agents. Nevertheless, this feature also brings vulnerability to multimodal prompt injection (PI) attacks, in which hidden or malicious instructions that are embedded in text, images, metadata, or interagent messages can spread throughout the agent graph, triggering unintended behavior or policy violation, or corrupting a state. To mitigate these threats, this paper will present a Cross-Agent Multimodal Provenance-Aware Defense Framework that will sanitize any user- or agent-generated prompts and validate the output of the LLM independently, prior to their delivery to downstream nodes. The framework incorporates a text sanitizer agent, visual sanitizer agent and an output validator agent which are synchronized by a provenance ledger which documents modality, source and trust metadata throughout the agent network. The architecture implements ordered trust boundaries, so that an injected instruction cannot spread out via LangChain- or GraphChain-style workflows. There are better multimodal PI detection accuracy, lower trust leakage between agents, and more stable agentic execution pathways, all of which are experimentalized. This framework can build secure, interpretable, and reliable agentic AI systems by augmenting the established provenance tracking and validation systems to multi-agent orchestration.},
  keywords={Agentic AI;Visualization;Large language models;Pipelines;Metadata;Nonhomogeneous media;Safety;Reliability;Synchronization;Multi-agent systems;Prompt Injection;Multi-Agent Systems;Provenance Tracking;LLM Security;Trust Validation;AI Safety},
  doi={10.1109/ICCA66035.2025.11430791},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11431088,
  author={Mamidwar, Piyush and Rajuarkar, Rani and Deshmukh, Niharika},
  booktitle={2025 International Conference on Computer and Applications (ICCA)}, 
  title={Beyond Individual Defenses: Evaluating Defense Combinations Against Prompt Injection Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models process all input as natural language, creating a fundamental vulnerability: the inability to distinguish trusted instructions from untrusted user content. This architectural design—central to LLMs’ flexibility—simultaneously enables prompt injection attacks that manipulate model behavior through carefully crafted inputs. Despite the proliferation of defense mechanisms, a critical gap persists: defenses are evaluated in isolation, leaving practitioners without guidance for production deployments balancing security against latency and complexity.This paper presents the first systematic empirical evaluation of defense mechanism combinations. Testing 15 configurations against 50 diverse attacks, we reveal combined defenses outperform individual mechanisms by 18.5% (p<0.01), yet certain pairings waste resources without security gains. We identify three Pareto-optimal strategies: PromptShield + Spotlighting (78% defense success, 215ms), PromptShield + Instruction Hierarchy (75%, 245ms), and Perplexity Filter (55%, 85ms). However, even optimal combinations achieve only 78% effectiveness with 22% residual vulnerability, degrading under adaptive attacks. We provide evidence-based deployment guidelines and identify architectural challenges requiring instruction-data separation and adaptive orchestration for advancing LLM security.},
  keywords={Systematics;Large language models;Standards organizations;Natural languages;Production;Organizations;Machine learning;Security;Guidelines;Testing;Large Language Models;Prompt Injection;Jailbreaking;AI Security;Adversarial Attacks;RAG Systems;Machine Learning Security},
  doi={10.1109/ICCA66035.2025.11431088},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11418350,
  author={Sugimoto, Takumi and Kimura, Hiryu and Yamada, Yuhei and Akiyama, Tomoki and Hojo, Minato and Nakanishi, Takafumi},
  booktitle={2025 19th IIAI International Congress on Advanced Applied Informatics (IIAI-AAI-Winter)}, 
  title={Hacking the Black Box: Prompt Injection for Visualizing LLM Reasoning as Graphs}, 
  year={2025},
  volume={},
  number={},
  pages={303-306},
  abstract={Large Language Models (LLMs) show impressive versatility in translation, summarization, dialogue generation, and reasoning; however, their internal inference mechanisms remain opaque. This lack of transparency limits trust and poses challenges in education, healthcare, and decision support, where interpretability and accountability are essential features. To address this, we propose a lightweight framework that uses prompt injection to induce LLMs to explicitly output their reasoning traces. These traces, which contain assumptions, intermediate steps, and dependencies, are automatically parsed and visualized as directed graphs, enabling users to inspect the reasoning process step-by-step. Unlike traditional XAI methods, such as LIME or SHAP, which focus on feature attribution, our approach captures the sequential reasoning flow characteristic of generative models. By generating multiple traces for the same input and comparing their structural similarities, the framework also provides a quantitative measure of reasoning stability and reproducibility. Experiments with the Gemini 2.5 Flash Lite model showed that the method effectively externalizes reasoning paths and maintains task focus, even when prompts include distracting content. Although self-reported traces may not fully reflect internal computations, the proposed framework offers a practical and interpretable window into model behavior. It supports visual auditing, transparency analysis, and educational applications, contributing to a deeper alignment between human reasoning and machine cognition.},
  keywords={Visualization;Translation;Large language models;Computational modeling;Medical services;Inspection;Cognition;Stability analysis;Reproducibility of results;Reliability;Large Language Models;Prompt Injection;Explainable AI;Reasoning Visualization;Graph-based Explanation},
  doi={10.1109/IIAI-AAI-Winter69777.2025.00064},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11418030,
  author={Nagaraja, Neha and Bahsi, Hayretdin},
  booktitle={2025 Annual Computer Security Applications Conference Workshops (ACSAC Workshops)}, 
  title={Goal-Driven Risk Assessment for LLM-Powered Systems: A Healthcare Case Study}, 
  year={2025},
  volume={},
  number={},
  pages={290-297},
  abstract={While incorporating LLMs into systems offers significant benefits in critical application areas such as healthcare, new security challenges emerge due to the potential cyber kill chain cycles that combine adversarial model, prompt injection and conventional cyber attacks. Threat modeling methods enable the system designers to identify potential cyber threats and the relevant mitigations during the early stages of development. Although the cyber security community has extensive experience in applying these methods to software-based systems, the elicited threats are usually abstract and vague, limiting their effectiveness for conducting proper likelihood and impact assessments for risk prioritization, especially in complex systems with novel attacks surfaces, such as those involving LLMs. In this study, we propose a structured, goal driven risk assessment approach that contextualizes the threats with detailed attack vectors, preconditions, and attack paths through the use of attack trees. We demonstrate the proposed approach on a case study with an LLM agent-based healthcare system. This study harmonizes the state-of-the-art attacks to LLMs with conventional ones and presents possible attack paths applicable to similar systems. By providing a structured risk assessment, this study makes a significant contribution to the literature and advances the secure-by-design practices in LLM-based systems.},
  keywords={Threat modeling;Limiting;Trees (botanical);Conferences;Prevention and mitigation;Large language models;Medical services;Vectors;Safety;Cyberattack;healthcare;large language models;cyber threats;conversational attacks;adversarial attacks;risk analysis},
  doi={10.1109/ACSACW69556.2025.00037},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11418001,
  author={Seth, Vani and Pandey, Ashish and Gundlapalli, Kavya and Duvvuri, Mahesh and Mettu, Rithvik and Zachary, Iris and Calyam, Prasad},
  booktitle={2025 Annual Computer Security Applications Conference Workshops (ACSAC Workshops)}, 
  title={EmpathAI: A Trustworthy and Secure Conversational Agent for Mental Healthcare}, 
  year={2025},
  volume={},
  number={},
  pages={298-301},
  abstract={With advancements in AI, conversational agents are increasingly being used in healthcare and could be employed aptly in counseling psychology and mental health support. However, ensuring the reliability and trustworthiness of these agents is crucial for safe, effective patient interactions. In this paper, we present methods for enhancing the reliability of conversational agents through source tagging, which enables users to assess information transparently and preemptive user metadata enrichment for providing emotion-sensitive responses. Additionally, we address security challenges such as prompt injection attacks, by proposing prompt engineering strategies to mitigate these vulnerabilities. By systematically integrating confidence metrics and fortified prompts, our approach ensures conversational agents provide secure and trustworthy responses in sensitive healthcare environments.},
  keywords={Measurement;Employee welfare;Conferences;Medical treatment;Mental health;Tagging;Metadata;Electronic healthcare;Reliability;Prompt engineering;Trustworthy AI;Secure Chatbot;Healthcare Security;Prompt Injection;LLMs;Digital Therapy;eHealth},
  doi={10.1109/ACSACW69556.2025.00038},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11417026,
  author={Mahdy, Malak and Rubio-Medrano, Carlos},
  booktitle={2025 IEEE 7th International Conference on Cognitive Machine Intelligence (CogMI)}, 
  title={Beyond the Chatbox: An Exploratory Case Study of Autonomous Computer-Use Agents}, 
  year={2025},
  volume={},
  number={},
  pages={476-485},
  abstract={Autonomous computer-use agents (ACUAs, Acqua) represent a new frontier in digital workflows, capable of operating computers end-to-end much like human users. Unlike traditional chat-based systems, ACUAs can execute commands across applications, navigate interfaces, and make independent decisions. However, their real-world effectiveness, reliability, and security remain insufficiently evaluated. This case study introduces a systematic benchmark for assessing ACUAs and distinguishes two primary classes: full computer access agents with unrestricted control and browser-based agents constrained to web environments. Twenty five trials spanning five tasks of increasing complexity were conducted using agents from OpenAI, Anthropic, and open-source projects. Performance was evaluated using a seven-factor rubric measuring accuracy, robustness, adaptability, security, efficiency, relevance, and consistency.Results indicate distinct performance patterns across agent classes: full computer access agents achieved an average task completion of 27–38%, while browser-based agents averaged 94% task completion. Full computer access agents frequently exhibited unsafe behaviors, including unauthorized software installations and brute-force login attempts, whereas browser-based agents remained susceptible to prompt injection attacks. Recurrent hallucinations, navigation errors, and limited adaptability further exposed systemic weaknesses in current designs. These results expose fundamental gaps in current ACUA design and underscore the urgent need for rigorous evaluation before deployment in security-sensitive or mission-critical settings. This exploratory study establishes a reproducible framework for assessing autonomous agents while providing a clearer picture of their current capabilities.},
  keywords={Computers;Systematics;Navigation;Benchmark testing;Reliability engineering;Autonomous agents;Software;Robustness;Complexity theory;Security;Agentic AI;autonomous agents;large language models (LLM);security},
  doi={10.1109/CogMI67134.2025.00062},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11401933,
  author={Lee, Youngjoon and Park, Taehyun and Lee, Yunho and Gong, Jinu and Kang, Joonhyuk},
  booktitle={2025 IEEE International Conference on Big Data (BigData)}, 
  title={Exploring Potential Prompt Injection Attacks in Federated Military LLMs and Their Mitigation}, 
  year={2025},
  volume={},
  number={},
  pages={6436-6440},
  abstract={Federated Learning (FL) is increasingly being adopted in military collaborations to develop Large Language Models (LLMs) while preserving data sovereignty. However, prompt injection attacks—malicious manipulations of input prompts—pose new threats that may undermine operational security, disrupt decision-making, and erode trust among allies. This perspective paper highlights four vulnerabilities in federated military LLMs: secret data leakage, free-rider exploitation, system disruption, and misinformation spread. To address these risks, we propose a human–AI collaborative framework with both technical and policy countermeasures. On the technical side, our framework uses red/blue team wargaming and quality assurance to detect and mitigate adversarial behaviors of shared LLM weights. On the policy side, it promotes joint AI–human policy development and verification of security protocols.},
  keywords={Quality assurance;Protocols;Federated learning;Large language models;Systems operation;Prevention and mitigation;Decision making;Collaboration;Security;Fake news;federated learning;large language;model;adversarial attack;military policy},
  doi={10.1109/BigData66926.2025.11401933},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{11401900,
  author={Ikbarieh, Seif and Aryal, Kshitiz and Gupta, Maanak},
  booktitle={2025 IEEE International Conference on Big Data (BigData)}, 
  title={RAG-Targeted Adversarial Attack on LLM-Based Threat Detection and Mitigation Framework}, 
  year={2025},
  volume={},
  number={},
  pages={6577-6586},
  abstract={The rapid expansion of the Internet of Things (IoT) is reshaping communication and operational practices across industries, but it also broadens the attack surface and increases susceptibility to security breaches. Artificial Intelligence has become a valuable solution in securing IoT networks, with Large Language Models (LLMs) enabling automated attack behavior analysis and mitigation suggestion in Network Intrusion Detection Systems (NIDS). Despite advancements, the use of LLMs in such systems further expands the attack surface, putting entire networks at risk by introducing vulnerabilities such as prompt injection and data poisoning. In this work, we attack an LLM-based IoT attack analysis and mitigation framework to test its adversarial robustness. We construct an attack description dataset and use it in a targeted data poisoning attack that applies word-level, meaning-preserving perturbations to corrupt the Retrieval-Augmented Generation (RAG) knowledge base of the framework. We then compare pre-attack and post-attack mitigation responses from the target model, ChatGPT-5 Thinking, to measure the impact of the attack on model performance, using an established evaluation rubric designed for human experts and judge LLMs. Our results show that small perturbations degrade LLM performance by weakening the linkage between observed network traffic features and attack behavior, and by reducing the specificity and practicality of recommended mitigations for resource-constrained devices.},
  keywords={Performance evaluation;Prevention and mitigation;Perturbation methods;Large language models;Retrieval augmented generation;Network intrusion detection;Telecommunication traffic;Threat assessment;Robustness;Internet of Things;Adversarial Poisoning Attack;Internet of Things (IoT) Security;Large Language Model;Retrieval-Augmented Generation;Cybersecurity},
  doi={10.1109/BigData66926.2025.11401900},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{11400893,
  author={Li, Laizhen and Zhao, Peicheng and Gao, Xitong and Zhao, Juanjuan and Ye, Kejiang},
  booktitle={2025 IEEE International Conference on Big Data (BigData)}, 
  title={JADE: Jailbreak-Aware Dynamic Defense Enhancer for LLMs Via Reinforcement Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1655-1660},
  abstract={Adversarial attacks pose significant threats to Large Language Models (LLMs), enabling malicious actors to generate harmful content through carefully crafted prompts. To address this challenge, we propose JADE: Jailbreak-Aware Dynamic Defense Enhancer, a novel reinforcement learning framework that dynamically enhances LLM robustness against jailbreak attacks. JADE employs a three-model architecture—Jailbreak Prompt Optimizer, Target Model, and Safety Evaluator—that engage in closed-loop adversarial training using Proximal Policy Optimization (PPO). The framework enables continuous co-evolution of attack and defense strategies through iterative policy updates. Extensive experiments across multiple benchmarks demonstrate JADE's superior performance, significantly reducing attack success rates while maintaining model utility compared to state-of-the-art defense methods.},
  keywords={Training;Large language models;Prevention and mitigation;Reinforcement learning;Benchmark testing;Robustness;Security;Iterative methods;Protection;Optimization;Adversarial Attacks;Defense Mechanisms;Re-inforcement Learning;Proximal Policy Optimization (PPO);Security;Machine Learning;Robustness;Evaluation Framework},
  doi={10.1109/BigData66926.2025.11400893},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{11401523,
  author={Biswas, Milon and Yu, Wei and Wang, Qianlong and Liao, Weixian},
  booktitle={2025 IEEE International Conference on Big Data (BigData)}, 
  title={Quantifying Privacy Leakage in Multi-Agent LLMs: A Unified Theoretical and Empirical Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={1685-1694},
  abstract={Large Language Models (LLMs) are increasingly used in multi-agent systems, where autonomous agents collaborate on complex tasks through distributed reasoning and communication. While existing work focuses on privacy in single-agent or API-bound settings, inter-agent communication introduces new privacy leakage pathways that remain underexplored. This paper proposes a unified framework for quantifying and mitigating privacy leakage in multi-agent LLMs. It unifies Mutual Information (MI), Bayesian Inference Gain (BIG), and Rényi Differential Privacy (RDP) to jointly quantify empirical leakage, belief refinement, and worst-case privacy loss in multi-agent LLMs. MI captures statistical dependence between private inputs and observable messages, detecting unintended memorization or semantic correlation. BIG models adversarial belief refinement and complements MI by offering a posteriorcentric interpretation of leakage. RDP provides formal privacy guarantees across multi-turn dialogues, quantifying divergence under repeated queries and enabling DP-style defense via output perturbation. We simulate LLM agents with distinct prompts and introduce probing adversaries capable of membership inference, prompt injection, and extraction attacks. The empirical results show that the proposed combined defense reduces MI from 0.35 to 0.10 and the attack success rate (ASR) from 82% to 29%, with minimal Bilingual Evaluation Understudy (BLEU) drop. The combined defense achieves strong privacy with acceptable utility. These findings highlight the importance of privacy-aware agent design and protocol-level defense under black-box threats in multi-agent LLMs.},
  keywords={Privacy;Differential privacy;Correlation;Large language models;Perturbation methods;Semantics;Cognition;Security;Mutual information;Multi-agent systems;Security;Privacy;Large Language Model},
  doi={10.1109/BigData66926.2025.11401523},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{11402081,
  author={Mayeesha, Tasmiah Tahsin and Ovi, Pretom Roy and Sharma, Sharad},
  booktitle={2025 IEEE International Conference on Big Data (BigData)}, 
  title={Adversarial Misdirection: Probing & Visualizing Cross-Modal Reasoning Vulnerabilities in Vision-Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={7899-7907},
  abstract={As multimodal AI systems increasingly underpin perception and reasoning in interactive environments, understanding their robustness has become a critical research frontier. Vision-language models (VLMs) are rapidly emerging as core perceptual and cognitive components in autonomous agents capable of multi-step reasoning, planning, and decision-making across complex, dynamic environments. Despite significant progress in adversarial robustness research for single-modality systems such as text or vision models, the vulnerabilities of VLMs-and particularly of VLM-based agents to cross-modal adversarial attacks that target reasoning processes remain underexplored. This paper introduces an exploratory framework for systematically studying adversarial interventions that disrupt the reasoning capabilities of VLMs. We focus on low-cost, feasible perturbations such as prompt injections and instruction manipulations that maintain surface plausibility while subtly interfering with compositional reasoning chains. Our evaluation on 200 carefully curated visual reasoning questions across four reasoning categories (counting, comparison, relational, and spatial) reveals an overall attack success rate of 9.5% and that spatial reasoning is particularly vulnerable to misdirection attacks, with accuracy dropping by 16% and a 20% attack success rate. We find that modern VLMs like GPT-4o-mini demonstrate varying robustness and accuracy across reasoning types. By framing adversarial attacks as disruptions to reasoning rather than perception alone, this work offers a foundation for analyzing and mitigating reasoning failures in multimodal systems intended for safety-critical and human-AI interaction contexts.},
  keywords={Visualization;Accuracy;Systematics;Perturbation methods;Linguistics;Cognition;Robustness;Planning;Artificial intelligence;Surface treatment;Vision-Language Models;Adversarial Attacks;Visual Reasoning;Prompt Injection;VLM Agents;Trustworthy AI;Visualization},
  doi={10.1109/BigData66926.2025.11402081},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{11412188,
  author={Joshi, Amatya and Wani, Rasika},
  booktitle={2025 3rd International Conference on Computational Intelligence and Network Systems (CINS)}, 
  title={An Empirical Analysis of Performance Trade-offs in Specialized LLMs: A Case Study of Gemini 2.5 Pro and 2.5 Flash Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The evolution of Large Language Models (LLMs) is increasingly characterized by a strategic diversification from general-purpose models to specialized architectures optimized for distinct performance profiles. This paper presents a focused, empirical analysis of this trend through a comparative case study of Google’s Gemini 2.5 Pro and Gemini 2.5 Flash models. While both models are built upon a common, advanced architecture featuring native multimodality and an extensive context window, they are explicitly engineered for different points on the performance-efficiency spectrum: Pro for deep, complex reasoning and Flash for high-speed, low-latency applications. This study conducts a multi-faceted evaluation across five critical performance vectors: (1) response latency, quantified by Time-to-First-Token (TTFT); (2) long-context information retrieval accuracy and speed; (3) qualitative factual and logical reasoning; (4) multimodal analysis of static images and data visualizations; and (5) multimodal UI generation from video prompts. In a crucial extension of our analysis, we also evaluate the models’ robustness in advanced cybersecurity tasks, including log analysis and command injection vulnerability mitigation, as well as their susceptibility to indirect prompt injection attacks. The results quantitatively confirm that Gemini 2.5 Flash exhibits significantly lower latency, making it superior for real-time interactive tasks. Conversely, the qualitative and multimodal analyses reveal that Gemini 2.5 Pro possesses a demonstrably superior capacity for nuanced reasoning, including the proactive identification of factual inaccuracies and the generation of complex, functional code from visual inputs. Our cybersecurity analysis reveals a counter-intuitive finding: the simpler Gemini 2.5 Flash model demonstrates higher proficiency and greater resilience in certain targeted security tasks compared to Gemini 2.5 Pro, despite Pro’s overall superior reasoning and coding capabilities. This research provides a data-driven quantification of the trade-offs inherent in these specialized models, offering actionable insights for developers, researchers, and practitioners selecting optimal models for specific computational intelligence applications.},
  keywords={Analytical models;Visualization;Computational modeling;Large language models;Market research;Cognition;Vectors;Computer security;Computational intelligence;Videos;Large Language Models;Gemini;Performance Analysis;Computational Intelligence;Latency;Long-Context;Reasoning;UI Generation;Multimodal Analysis;Cybersecurity;Prompt Injection;Vulnerability Analysis},
  doi={10.1109/CINS67018.2025.11412188},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11410405,
  author={Muhaimin, Sheikh Samit and Mastorakis, Spyridon},
  booktitle={2025 IEEE 7th International Conference on Trust, Privacy and Security in Intelligent Systems, and Applications (TPS-ISA)}, 
  title={Learning from Literature: A Retraining-Free Framework for LLM Jailbreak Defense via NLP-Based Adversarial Literature Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={270-281},
  abstract={Recent surge in adoption of Large Language Models (LLMs) have made them vulnerable to sophisticated adversarial attacks, manipulative prompts, and encoded malicious inputs. Existing countermeasures often require retraining models, a process that is computationally expensive and impractical for deployment. This paper introduces a novel defense framework that enables LLMs to autonomously detect, filter, and fend off malicious or adversarial inputs without requiring retraining or fine-tuning. The proposed framework consists of two core components: (1) A summarization module that processes and summarizes adversarial research literature to provide the LLM with context-aware defense knowledge and (2) A prompt filtering module that detects, decodes, and classifies harmful inputs through advanced Natural Language Processing (NLP) techniques, such as zero-shot classification, keyword analysis, and encoded content detection. By combining text extraction, summarization, and malicious prompt analysis, this approach enhances the robustness of LLMs against adversarial misuse. Experimental results demonstrate that this integrated approach successfully identifies encoded prompts, malicious patterns, and manipulative language structures with a success rate of 98.7%. The framework also enables the model to respond appropriately to malicious prompts with a higher percentage of jailbreak resistance and refusal rate, using minimal quantity of adversarial research literature as context. The framework significantly reduces LLM Attack Success Rate (ASR) as a lightweight, efficient alternative to retraining-based time and resource-consuming defenses, while upholding LLM response quality.},
  keywords={Training;Resistance;Filtering;Training data;Text summarization;Robustness;Real-time systems;Natural language processing;Security;Surges;Adversarial Attacks;Retraining-free Defense;Prompt Filtering;Text Summarization},
  doi={10.1109/TPS-ISA67132.2025.00036},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11398297,
  author={Tumma, Chaitanya and Reddy, R Archana and Yadav, Rajat and Salati, Abid and S, Surendarkumar and A, Karthikayen},
  booktitle={2025 International Conference on Modeling, Simulation & Intelligent Computing (MoSICom)}, 
  title={Robust Jailbreak Detection in Large Language Models Using Behavioral Fingerprinting}, 
  year={2025},
  volume={},
  number={},
  pages={284-289},
  abstract={Large Language Models (LLMs) are increasingly used in real-world settings, and with their growing popularity, there have also been growing jailbreak attack problems, wherein users deliberately circumvent security controls to receive harmful or illegal responses. Traditional defense techniques, including static prompt classifiers and structural fingerprinting, are not likely to be effective under adaptive adversarial attacks, particularly in multi-turn dialogue. Here, a behavioral fingerprinting technique is proposed that detects sequential user-LLM interaction patterns for distinguishing between adversarial and normal behavior. Temporal and semantic drift modeling across sessions augments the detection of adversarial purpose evaded by one-prompt inspection techniques. Experimental results show that the proposed framework attains an F1-score of 95.4%, outperforming state-of-the-art baselines like MergePrint, AAD-LLM, and static classifiers. These findings affirm that behavior fingerprinting offers an interpretable and scalable solution for enhancing jailbreak resistance in LLMs. The research encourages adaptive defense strategies that are effective at protecting LLM deployments in adversarial and dynamic environments.},
  keywords={Training;Adaptation models;Large language models;Computational modeling;Semantics;Fingerprint recognition;Real-time systems;Timing;Security;Testing;Jailbreak Detection;Large Language Models;Behavioral Fingerprinting;Adversarial Prompts;LLM Security;Sequential Modeling;Explainable AI},
  doi={10.1109/MoSICom67153.2025.11398297},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11406667,
  author={Narayan, Om and Singh, Ramkinker and Baskar, Praveen},
  booktitle={2025 8th International Conference on Algorithms, Computing and Artificial Intelligence (ACAI)}, 
  title={A Comprehensive Security Framework for the Model Context Protocol (MCP) in Multi-Agent AI Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The Model Context Protocol (MCP) enables seamless AI agent-tool interactions but introduces distinct security challenges such as prompt injection, impersonation, and supply chain vulnerabilities. These risks are amplified by the autonomous and complex reasoning of GenAI agents, necessitating a robust threat model. Prior research has tackled some of these issues through prompt filtering, architectural isolation, authentication, secure installation, monitoring, and defensive agent design patterns. However, critical gaps persist in state consistency, multi-tenant isolation, context integrity, and comprehensive authentication/authorization within dynamic MCP environments. As MCP-based multi-agent systems become integral to enterprise operations, they present unique security considerations. This paper introduces a comprehensive security framework addressing these challenges, including solutions for standard authentication and authorization, robust supply chain defense, and enhanced observability, aiming to establish a secure, scalable, and resilient foundation for MCP-based multi-agent systems suitable for sensitive applications. Specifically, we propose the MCP Server Standard Framework as a foundational architecture designed to mitigate these vulnerabilities through a combination of secure by design principles and advanced threat detection mechanisms.},
  keywords={Threat modeling;Protocols;Computational modeling;Supply chains;Authentication;Computer architecture;Security;Standards;Multi-agent systems;Context modeling;AI Agents;Cybersecurity;Large Language Models;Model Context Protocol (MCP);Multi-Agent Systems;Prompt Injection;Secure Software Development},
  doi={10.1109/ACAI68217.2025.11406667},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11404989,
  author={Yerneni, Raghuveer},
  booktitle={2025 13th International Conference on Intelligent Systems and Embedded Design (ISED)}, 
  title={RAG-Augmented Payroll Intelligence Stack: A Zero-Trust, Policy-Verified Architecture for Compliant and Explainable Payroll Automation}, 
  year={2025},
  volume={},
  number={},
  pages={997-1001},
  abstract={Payroll systems must execute jurisdiction-specific calculations, disclosures, and compliance checks under strict regulatory and audit constraints. While Retrieval-Augmented Generation (RAG) improves factual grounding, conventional RAG pipelines lack formal guarantees of correctness, authorization control, and provenance—critical for payroll. We present the RAG-Augmented Payroll Intelligence Stack (RAPIS), a policy-verified architecture that fuses hybrid retrieval with tool-based computation, attribute-based access control (ABAC), formal verification via SMT (Z3), and W3C PROV lineage for auditability. RAPIS introduces PayLang, a declarative DSL for encoding payroll rules that compiles into both authorization policies (OPA/Cedar) and verifiable constraints. Evaluated on Payroll-Bench, a multi-jurisdiction synthetic benchmark based on IRS Pub. 15, HMRC PAYE, EPF/ESI, and EU transparency directives, RAPIS outperforms existing baselines in accuracy, explainability, prompt-injection robustness, and provenance coverage. The results demonstrate that verifiable, policy-bounded reasoning is essential for deploying AI in regulated, high-assurance financial domains.},
  keywords={Authorization;Grounding;Fuses;Retrieval augmented generation;Pipelines;W3C;Computer architecture;Robustness;Real-time systems;Zero Trust;Payroll Intelligence;Retrieval-Augmented Generation;Policy-as-Code;Zero Trust;ABAC;SMT Verification;OPA;Cedar;Formal Methods;Compliance AI},
  doi={10.1109/ISED67359.2025.11404989},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11402845,
  author={Mishra, Anupama and Preet, Shiv and Gupta, Brij B. and Rawat, Satyendra Singh and Arya, Varsha and Katiyar, Vivek},
  booktitle={2025 5th International Conference on Internet of Things: Smart Innovation and Usages (IoT-SIU)}, 
  title={Mitigating Prompt Injection Attacks in ModelAgnostic Networks (MAN)}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Large Language Models (LLMs) are being used progressively in the fields like healthcare, finance, education, and cybersecurity. As they depend on natural language prompts, they are more prone to prompt injection attacks. Most traditional cyber-attacks are known and handled with latest defending tools and technology, however the prompt attacks impact severely the world. The attacks such as Jailbreaks, role overrides, and hidden injections are pretty good to steal private and personal information. The existing defense mechanisms use model-specific filters or expensive retraining, which makes them unreliable. We present MAP-Defense, a Model-Agnostic Prompt Attack Detection Framework founded on ModelAgnostic Networks (MAN). The framework includes preprocessing, semantic embedding analysis, context integrity checking, and policy enforcement to find prompts that are meant to be harmful while keeping the query’s fidelity. Tests on GPT-, BERT-, and T5-based models with more than 8,000 prompts show that MAP-Defense has an average precision of 91.7% and an F1-score of 90.5%, which is better than rule-based baselines. The results show that it can be scaled up, used with different models, and applied in real time, making it a strong defense against new prompt injection threats.},
  keywords={Training;Resistance;Technological innovation;Large language models;Semantics;Pipelines;Natural languages;Medical services;Real-time systems;Low latency communication;Prompt Injection;Model-Agnostic Networks;LLM Security;Adversarial NLP;Trustworthy AI},
  doi={10.1109/IOT-SIU65919.2025.11402845},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11398712,
  author={Hailemichael, Soliana and Chano, Maria and El-Sheikh, Eman and Hayajneh, Thaier},
  booktitle={2025 2nd International Conference on Artificial Intelligence, Metaverse, and Cybersecurity (ICAMAC)}, 
  title={Security Risks and Privacy Challenges of Large Language Models in Enterprise Environments}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Large Language Models (LLMs), such as ChatGPT and Gemini, are increasingly adopted across sectors including education, healthcare, and corporate environments. While they offer operational efficiencies, their integration raises significant data security and compliance concerns. This study evaluates whether LLMs retain and disclose sensitive organizational data when exposed to proprietary inputs such as HR records, financial documents, and code samples. Using controlled experiments, we assessed the susceptibility of these models to prompt injection and role-based manipulation attacks. Findings indicate that both models exhibit varying degrees of data leakage and compliance violations, particularly in the context of GDPR and intellectual property protections. Based on these results, we propose a practical framework to guide the responsible use of LLMs in enterprise environments. The framework includes mitigation strategies for minimizing data exposure, ensuring regulatory compliance, and reducing the risks associated with AI integration in the workplace.},
  keywords={Data privacy;Metaverse;Large language models;Prevention and mitigation;Data security;Employment;Education;Medical services;Intellectual property;Protection;Prompt Injection;Data Retention;Large Language Models;Corporate AI Security;GDPR Compliance;RoleBased Manipulation;Proprietary Data},
  doi={10.1109/ICAMAC67779.2025.11398712},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11391742,
  author={Zhao, Yi and Zhang, Youzhi},
  booktitle={2025 IEEE Annual Computer Security Applications Conference (ACSAC)}, 
  title={Siren: A Learning-Based Multi-Turn Attack Framework for Simulating Real-World Human Jailbreak Behaviors}, 
  year={2025},
  volume={},
  number={},
  pages={1209-1220},
  abstract={Large language models (LLMs) are widely used in real-world applications, raising concerns about their safety and trustworthiness. While red-teaming with jailbreak prompts exposes the vulnerabilities of LLMs, current efforts focus primarily on single-turn attacks, overlooking the multi-turn strategies used by real-world adversaries. Existing multi-turn methods rely on static patterns or predefined logical chains, failing to account for the dynamic strategies during attacks. We propose Siren, a learning-based multi-turn attack framework designed to simulate real-world human jailbreak behaviors. Siren consists of three stages: (1) MiniMax-driven training set construction utilizing Turn-Level LLM feedback, (2) post-training attackers with supervised fine-tuning (SFT) and direct preference optimization (DPO), and (3) interactions between the attacking and target LLMs. Experiments demonstrate that Siren achieves an attack success rate (ASR) of 90% with LLaMA-3-8B as the attacker against Gemini-1.5-Pro as the target model, and 70% with Mistral-7B against GPT-4o, significantly outperforming single-turn baselines. Moreover, Siren with a 7B-scale model achieves performance comparable to a multi-turn baseline that leverages GPT-4o as the attacker, while requiring fewer turns and employing decomposition strategies that are better semantically aligned with attack goals. We hope Siren inspires the development of stronger defenses against advanced multi-turn jailbreak attacks under realistic scenarios. Code is available at https://github.com/YiyiyiZhao/siren. Warning: This paper contains potentially harmful text.},
  keywords={Training;Adaptation models;Codes;Large language models;Behavioral sciences;Safety;Computer security;Optimization;Red-Teaming;LLM;Jailbreak;Defense},
  doi={10.1109/ACSAC67867.2025.00095},
  ISSN={2576-9103},
  month={Dec},}@INPROCEEDINGS{11396481,
  author={Xie, Jigang and Wang, Zhengfan and He, Junchao and Jiao, Wenjing and Dang, Pengfei and Zhou, Yadong and Zhang, Wei and Fan, Ming},
  booktitle={2025 32nd Asia-Pacific Software Engineering Conference (APSEC)}, 
  title={MAJD: Intent-Aware Multi-Agent Framework for Jailbreak Defense}, 
  year={2025},
  volume={},
  number={},
  pages={827-831},
  abstract={Large Language Models (LLMs) have shown remarkable capabilities across diverse applications, enabling broad user interaction. Despite advances in AI alignment, their susceptibility to adversarial jailbreak attacks presents serious safety challenges. To mitigate these risks, we propose MAJD, a Multi-Agent Jailbreak Defense Framework that operates entirely at inference time without retraining. Each agent performs specialized tasks: the Coordinator routes inputs based on semantic ambiguity, the Mutation Agent compresses prompts with predefined rules, the Analyzer conducts intent analysis and response generation, and the Revalidation Agent performs secondary response classification. By incorporating rulebased mutation and intent-based reasoning, our framework identifies the core malicious intent in both single-turn and multi-turn jailbreak attempts. Experimental results across multiple attack methods (AutoDAN, GPTFuzzer, PAIR, and MHJ) and across multiple target models demonstrate that MAJD significantly improves detection success rates. These results validate the efficiency and generalizability of MAJD as a scalable jailbreak defense solution for LLM applications.},
  keywords={Large language models;Semantics;Routing;Cognition;Safety;Software engineering;LLMs;multi-agent;jailbreak defense;intent-aware},
  doi={10.1109/APSEC66846.2025.00086},
  ISSN={2640-0715},
  month={Dec},}@INPROCEEDINGS{11388881,
  author={Huang, Haoben and Ma, Chenlu and Li, Zhiyu},
  booktitle={2025 8th International Conference on Machine Learning and Natural Language Processing (MLNLP)}, 
  title={MELF: Multi-Agent Evaluation for LLMs Fairness Based on Hierarchical Genetic Algorithm}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={With development in natural language processing, large language models (LLMs) are now deployed across text generation, comprehension, and translation tasks. However, fairness challenges in LLM development have grown more severe. These models risk perpetuating biases and stereotypes from training data, potentially generating unfair or discriminatory outputs. To tackle this issue, we propose MELF, a multi-agent evaluation framework for LLMs fairness based on Hierarchical Genetic Algorithm. The method targets six fairness dimensions using transferable adversarial prompts and a hierarchical genetic algorithm to enhance attack efficiency. Experiments demonstrate a 43.8 % attack success rate (ASR) against the Qwen2.5-7b model using our adversarial optimization approach. Finally, the multi-agent evaluation framework analyzes jailbreak outcomes to elucidate attack mechanisms and underlying model vulnerabilities.},
  keywords={Translation;Large language models;Training data;Machine learning;Natural language processing;Data models;Security;Optimization;Genetic algorithms;Testing;Large language models;fairness;jailbreak attack;bias testing;adversarial optimization},
  doi={10.1109/MLNLP66797.2025.11388881},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11378986,
  author={Agade, Nishant and Hajare, Shital and Timande, Devanshi and Abhvankar, Janvi and Pardhi, Nikhil and Sambhe, Nilesh U.},
  booktitle={2025 3rd DMIHER International Conference on Artificial Intelligence in Healthcare, Education and Industry (IDICAIHEI)}, 
  title={Prompt Engineering for Large Language Models: Zero-shot, Few-shot, and Beyond}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Prompt engineering has emerged as a central technique for eliciting useful behavior from large language models (LLMs), enabling capabilities ranging from zero-shot instruction-following to few-shot in-context learning and more advanced automated and security-aware strategies. However, the field remains fragmented: methods are diverse, evaluations are heterogeneous, and robustness and security concerns are under-addressed. This paper presents a unified treatment of prompt engineering across three complementary paradigms-Zero-shot, Few-shot, and Beyond (advanced/automatic prompting and security-aware methods). We synthesize recent work into a concise taxonomy, propose a reproducible experimental framework that spans reasoning, classification, feedback generation, and adversarial robustness tasks, and specify standardized metrics and thresholds for comparative evaluation. Our synthesis highlights trade-offs between accuracy, cost, and stability: few-shot and chain-of-thought methods improve performance on complex tasks but increase token cost and sensitivity, while automated prompt optimization can reduce human effort at the expense of compute and potential overfitting. We also underscore urgent security challenges such as prompt injection and poisoning, and recommend defense evaluation protocols. Together, the taxonomy, experimental blueprint, and recommended best practices aim to accelerate reproducible, robust, and responsible prompt engineering for research and deployment.},
  keywords={Costs;Sensitivity;Protocols;Large language models;Taxonomy;Robustness;Stability analysis;Prompt engineering;Security;Overfitting;Prompt engineering;large language models;zero-shot;few-shot;chain-of-thought;automatic prompting;prompt injection;robustness},
  doi={10.1109/IDICAIHEI65991.2025.11378986},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11390931,
  author={Tortora, Fabio and De Angelis, Vincenzo},
  booktitle={2025 12th International Conference on Social Networks Analysis, Management and Security (SNAMS)}, 
  title={An Experimental Evaluation of Prompt Injection Attacks on LLM-Based Content Moderation Systems}, 
  year={2025},
  volume={},
  number={},
  pages={12-16},
  abstract={Large Language Models (LLMs) are increasingly deployed to automate content moderation on social platforms, offering efficiency and scalability far beyond human capabilities. However, they are highly vulnerable to prompt injection—maliciously crafted inputs designed to manipulate model behavior and bypass intended safeguards. In this paper, we experimentally evaluate the robustness of three widely used LLMs—OpenAI, Gemini, and Mistral—against direct prompt injection attacks in a controlled moderation setting. Under identical system prompts and attack conditions, the three models displayed different levels of robustness. Initial results showed varying performance impacts, with some models experiencing more noticeable degradation than others. Moreover, a refined injection using a differently concatenated user prompt was able to further reduce the effectiveness of the moderator when considering the model that initially achieved the best performance, suggesting that subtle variations in attack design can significantly influence outcomes. These findings highlight significant differences in model robustness and underscore the importance of rigorous evaluation and informed model selection for highstakes content moderation applications, where failures can have real-world consequences.},
  keywords={Degradation;Training;Adaptation models;Analytical models;Social networking (online);Large language models;Scalability;User-generated content;Robustness;Security;LLM;Content Moderation;Prompt Injection;Model Robustness;Social Networks},
  doi={10.1109/SNAMS67467.2025.11390931},
  ISSN={2831-7343},
  month={Nov},}@INPROCEEDINGS{11389636,
  author={Reddy Junnuthula, Sai Kiran and Singh, Vibhutesh Kumar},
  booktitle={2025 14th International Conference on System Modeling & Advancement in Research Trends (SMART)}, 
  title={LLM-based Cybersecurity Honeypots Evaluation Metric Development and Persona Shaping via Structured Prompt Engineering}, 
  year={2025},
  volume={},
  number={},
  pages={617-624},
  abstract={Large language model (LLM)-based honeypots are a recent advancement in cybersecurity. Placing an LLM at the core of a honeypot offers several benefits, including contextual awareness and the low-code implementation of interaction rules. Another benefit is adaptability: an LLM-based honeypot can emulate different applications, such as an operating system shell, a web application, or an industrial control system. Integrated LLMs can also perform automated analysis of an attacker's intent. However, several challenges limit their wider adoption. These include persona breaks caused by LLM hallucinations, and they are vulnerable to prompt injection attacks. There is also no standard metric for evaluating the performance of LLM-based honeypots. This work addresses these issues by proposing a structured, modular prompt design that makes it easy to shape and maintain the LLM's persona in a honeypot context. We also design evaluation metrics and tests to assess the effectiveness of an LLM-based honeypot, taking into account hallucinations, persona consistency, and the LLM's analytical capabilities. Additionally, we evaluate multiple open-weight models and present a lightweight pre-screening method to support LLM selection for fully localized deployment. Our experiments show that prompt effectiveness is model-dependent, with different prompts performing better for specific models.},
  keywords={Measurement;Shape;Large language models;Operating systems;Industrial control;Reliability engineering;Market research;Prompt engineering;Computer security;Standards},
  doi={10.1109/SMART66937.2025.11389636},
  ISSN={2767-7362},
  month={Nov},}@INPROCEEDINGS{11383695,
  author={Gujjari, Neha and Williams, Dhruva Menon and Ravi, Nagarathna and Nallana, Mithun Babu and Hasan Ansari, Md Talib},
  booktitle={2025 Second International Conference on Pioneering Developments in Computer Science & Digital Technologies (IC2SDT)}, 
  title={Partial-Reps: Defending Large Language Models against Jailbreaks via Partial Repetition}, 
  year={2025},
  volume={},
  number={},
  pages={244-249},
  abstract={Jailbreaks in Large Language Models (LLMs) compromise their security and force them to generate malicious content. State-of-the-Art (SOTA) solutions either query the same model multiple times to use the model itself as a jailbreak detector, or use a separate classifier trained to detect malicious outputs. Training a separate classifier is inefficient when defending against jailbreaks on which the model hasn't been trained, whereas the self-querying solution has the issue that querying the same model multiple times incurs overhead in time and computational power. Addressing the issue of self-querying, we propose a novel approach that attempts to achieve better accuracy and reduce computational complexity by leveraging tokenization. We experiment with the approach on eight benchmark datasets and three benchmark LLMs. We observe that our approach preserves the accuracy while significantly reducing the computational complexity.},
  keywords={Training;Accuracy;Large language models;Computational modeling;Force;Benchmark testing;Transformers;Tokenization;Security;Computational complexity;Transformers;Jailbreak Detection;Prompt Injection;Tokenization;Large Language Models;Security;Artificial Intelligence;Deep Learning},
  doi={10.1109/IC2SDT68218.2025.11383695},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11383622,
  author={Mishra, Nidhi and Rai, Kanchan and Sharma, Dhruv},
  booktitle={2025 Second International Conference on Pioneering Developments in Computer Science & Digital Technologies (IC2SDT)}, 
  title={SecureRag: Preventing Sensitive Information Leakage In Rag Pipelines}, 
  year={2025},
  volume={},
  number={},
  pages={600-605},
  abstract={Retrieval-Augmented Generation is most commonly used to combine large language models with an external knowledge base in an attempt to ground them. This significantly improves the performance in terms of factual information, but sometimes these pipelines can also expose sensitive information if not handled properly. In this work, SecureRag a framework is presented which is designed to reduce the leakage of sensitive information in these systems. Synthetic datasets were created for six domains including legal, financial, healthcare, government, and e-commerce using Python Faker Library. To implement the SecureRag system, filtering layers were implemented that redacts confidential content before it reaches the large language model. The implementation began with regular expression based filters which were later enhanced with Microsoft Presidio based filters. The implementation was evaluated with multiple tests and large language models including MiniLm, Gemini Flash 2.5, BERT-QA. The RAG system was tested against various scenarios of adversarial attacks such as prompt injections, Base64-encoded data, and needle-in-the-haystack challenges. The results show that SecureRag can effectively prevent sensitive information leakage in RAG pipelines while keeping the retrieval performance intact, this offers a safer approach for RAG pipelines.},
  keywords={Filters;Large language models;Prevention and mitigation;Retrieval augmented generation;Pipelines;Knowledge based systems;Medical services;Information leakage;Security;Synthetic data;Retrieval Augmented Generation;Adversarial Attacks;Large Language Models;Information Security;Prompt Injections;Data Leakage Prevention},
  doi={10.1109/IC2SDT68218.2025.11383622},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11391064,
  author={Elkin, Stanislav and Anosov, Kirill and Kiselev, Dmitry},
  booktitle={2025 3rd International Conference on Foundation and Large Language Models (FLLM)}, 
  title={Retrieval-Augmented Reasoning for Offensive Security: Towards Robust LLM Agents for CTF Automation}, 
  year={2025},
  volume={},
  number={},
  pages={272-280},
  abstract={We present a retrieval-first reasoning-agent architecture for automating offensive cybersecurity tasks in the Capture The Flag (CTF) format. Our core hypothesis is that domain-specific contextual retrieval can stabilize large language model (LLM) reasoning under adversarial, multi-step challenges. To test this, we construct a bespoke retrieval corpus from scratch—excluding benchmark leakage—covering key CTF domains such as binary exploitation, reverse engineering, cryptography, and web vulnerabilities. Using FAISS indexing and Retrieval-Augmented Generation (RAG), our agent integrates this corpus with GPT-4o via a lightweight, tool-agnostic pipeline. Evaluated on NYU CTF benchmark [2], the RAG-enhanced agent achieves a 57.1% improvement in task completion over the vanilla GPT-4o baseline. Unlike prior work, which often depends on fragile tool orchestration, we demonstrate that focused retrieval alone significantly improves reasoning stability, reduces hallucinations, and enhances task-solving accuracy. Our threat model also considers prompt injection and contextual ambiguity, underlining the need for interpretable, corpus-grounded architectures in offensive reasoning.},
  keywords={Threat modeling;Automation;Accuracy;Large language models;Scalability;Pipelines;Benchmark testing;Cognition;Stability analysis;Computer security;Cybersecurity;CTF;Reasoning Agents;Language Models;RAG;Tool-Augmented LLMs},
  doi={10.1109/FLLM67465.2025.11391064},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11391009,
  author={Thaqi, Rrezearta and Martiri, Edlira and Rexha, Blerim},
  booktitle={2025 3rd International Conference on Foundation and Large Language Models (FLLM)}, 
  title={A Real-Time Framework for Prompt Injection Attacks Detection on Cloud-Hosted Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={718-723},
  abstract={This paper addresses the emerging threat of prompt injection attacks in cloud-hosted large language models (LLMs). These attacks manipulate LLM inputs, causing models to reveal sensitive information, generate harmful outputs, or perform unauthorized actions, significantly undermining data security and user trust. To counteract these threats, we introduce a real-time, modular detection framework that leverages advanced machine learning and natural language processing techniques. Our approach classifies input prompts as benign or malicious using a lightweight DistilBERT-based model, deployed on AWS SageMaker for scalable, low-latency inference. When malicious prompts are identified with high confidence, they are blocked at the gateway layer before reaching the LLM runtime, and structured telemetry events are forwarded to CloudWatch for alerting and auditing. Extensive evaluations in a realistic AWS environment demonstrate that DistilBERT not only exceeds the precision of larger state-of-the-art transformers (such as BERT-base, RoBERTa-large, and DeBERTa-v3) but also provides significantly lower inference latency and reduced deployment costs compared with traditional machine learning algorithms. The system design ensures extensibility, seamless integration with cloud-native services, and supports explainability, as well as potential future enhancements such as reinforcement learning-based adaptive detection. The proposed framework thus offers a practical and reliable defense mechanism against evolving adversarial threats, thereby strengthening the security posture and fostering trust in cloud-based AI technologies across various industries.},
  keywords={Runtime;Machine learning algorithms;Large language models;Machine learning;Transformers;Real-time systems;Natural language processing;Telemetry;Reliability;System analysis and design;prompt injection;LLM;security;cloud;AI},
  doi={10.1109/FLLM67465.2025.11391009},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11391166,
  author={Oh, Dong Hwan and Lee, Dohhyun and Kim, Seo-Yeon and Kim, Taehyeon and Choi, Seul-Ki and Lee, Saewoom and Kim, Taeeun and Lim, Joon-Hyung and Kwak, Jin},
  booktitle={2025 3rd International Conference on Foundation and Large Language Models (FLLM)}, 
  title={Enhancing AI Security through CIA+}, 
  year={2025},
  volume={},
  number={},
  pages={1094-1100},
  abstract={The three fundamental principles of information security—Confidentiality, Integrity and Availability (CIA)— have long been regarded as the core framework in traditional ICT environments. However, the rapid advancement and widespread adoption of Artificial Intelligence (AI) have introduced novel security threats that cannot be sufficiently addressed by the CIA triad alone. AI-specific vulnerabilities such as prompt injection, data poisoning, model extraction and adversarial sample attacks pose significant risks to confidentiality, integrity, availability across data, models and infrastructures. To address these challenges, this study proposes an extended security framework, CIA+, which builds upon the traditional CIA principles. CIA+ incorporates four additional principles—Transparency, Accountability, Robustness and Ethics—resulting in a total of seven elements. This research analyzes the definition and implementation strategies for each principle and presents a framework applicable to practical domains, such as medical AI. Furthermore, the study emphasizes the necessity of prototyping the CIA+-based security framework, conducting benchmark validations across diverse industries and exploring institutional alignment with international standardization bodies.},
  keywords={Industries;Ethics;Large language models;Information security;Standardization;Data models;Robustness;Information and communication technology;Security;Artificial intelligence;AI Security;CIA Triad;CIA+;Information Security;Security Framework;Trustworthy AI},
  doi={10.1109/FLLM67465.2025.11391166},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11391218,
  author={Nagaraja, Neha and Zhang, Lan and Wang, Zhilong and Zhang, Bo and Patil, Pawan},
  booktitle={2025 3rd International Conference on Foundation and Large Language Models (FLLM)}, 
  title={Image-based Prompt Injection: Hijacking Multimodal LLMs through Visually Embedded Adversarial Instructions}, 
  year={2025},
  volume={},
  number={},
  pages={916-922},
  abstract={Multimodal Large Language Models (MLLMs) integrate vision and text to power applications, but this integration introduces new vulnerabilities. We study Image-based Prompt Injection (IPI), a black-box attack in which adversarial instructions are embedded into natural images to override model behavior. Our end-to-end IPI pipeline incorporates segmentation-based region selection, adaptive font scaling, and background-aware rendering to conceal prompts from human perception while preserving model interpretability. Using the COCO dataset and GPT-4-turbo, we evaluate 12 adversarial prompt strategies and multiple embedding configurations. The results show that IPI can reliably manipulate the output of the model, with the most effective configuration achieving up to 64% attack success under stealth constraints. These findings highlight IPI as a practical threat in black-box settings and underscore the need for defenses against multimodal prompt injection.},
  keywords={Adaptation models;Visualization;Image segmentation;Large language models;Pipelines;Closed box;Pressing;Rendering (computer graphics);Reliability engineering;multimodal large language models;prompt injection;image-based attacks;visual prompt injections},
  doi={10.1109/FLLM67465.2025.11391218},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11391246,
  author={Carolina, Maria and Wit, Cornelia and Pang, Jun},
  booktitle={2025 3rd International Conference on Foundation and Large Language Models (FLLM)}, 
  title={Evaluating Multi-Agent Defences Against Jailbreaking Attacks on Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={457-464},
  abstract={Recent advances in large language models (LLMs) have raised concerns about jailbreaking attacks, i.e., prompts that bypass safety mechanisms. This paper investigates the use of multi-agent LLM systems as a defence against such attacks. We evaluate three jailbreaking strategies, including the original AutoDefence attack and two from Deepleaps: BetterDan and JB. Reproducing the AutoDefence framework, we compare single-agent setups with two- and three-agent configurations. Our results show that multi-agent systems enhance resistance to jailbreaks, especially by reducing false negatives. However, its effectiveness varies by attack type, and it introduces trade-offs such as increased false positives and computational overhead. These findings point to the limitations of current automated defences and suggest directions for improving alignment robustness in future LLM systems.},
  keywords={Resistance;Large language models;Robustness;Safety;Multi-agent systems;Large language models;jailbreaking attacks},
  doi={10.1109/FLLM67465.2025.11391246},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11391215,
  author={Gosmar, Diego and Dahl, Deborah A. and Gosmar, Dario},
  booktitle={2025 3rd International Conference on Foundation and Large Language Models (FLLM)}, 
  title={Prompt Injection Detection and Mitigation with AI Multiagent NLP-based Agentic Frameworks}, 
  year={2025},
  volume={},
  number={},
  pages={923-930},
  abstract={Prompt injection is a significant challenge for generative AI systems because it can lead to unintended outputs. We introduce a Multiagent NLP-based experimental framework, specifically designed to address prompt injection vulnerabilities through layered detection and metadata mechanisms. The framework orchestrates specialized AI agents to generate responses, detect vulnerabilities, and mitigate injection effects. An empirical evaluation of 500 engineered injection prompts was conducted, with ten different prompt injection categories properly generated and shuffled (50 prompts for each injection attack category). The experimental results show a significant reduction in the injection score and an increased detection of prompt injection markers, indicating potential applications for mitigation. Novel metrics—including Injection Success Rate (ISR), Policy Override Frequency (POF), Prompt Sanitization Rate (PSR), and Compliance Consistency Score (CCS)—are proposed to derive a composite Total Injection Vulnerability Score (TIVS). The system utilizes the vendor-independent OFP (Open Floor Protocol) framework for agentic AI communication via structured JSON messages. It encapsulates APIs using natural language while also comparing and extending a previously established multiagent experiment on hallucination mitigation to address the specific challenges of prompt injection.},
  keywords={Optical fibers;Agentic AI;Protocols;Prevention and mitigation;Pipelines;Natural languages;Metadata;Security;Prompt engineering;Observability;Agentic AI;Prompt injection;multiagent systems;LLM security;AI interoperability;Prompt Engineering;AI Security},
  doi={10.1109/FLLM67465.2025.11391215},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11387604,
  author={Meng, Xianghui and Yang, Yintian},
  booktitle={2025 International Conference on Education Technology and Computers (ICETC)}, 
  title={Predicting Trust Risks in Al-Generated Educational Feedback: A Technical Framework Using Simulated Threats and System Logs}, 
  year={2025},
  volume={},
  number={},
  pages={570-574},
  abstract={AI-generated feedback is becoming increasingly common in education, but not all responses are trustworthy. Some responses are linguistically fluent but semantically irrelevant, some are manipulated by adversarial prompts, and others evade answering altogether. These issues—semantic drift, prompt injection, and evasiveness—are rarely detected before reaching students. This paper explores whether such risks can be predicted in advance. We introduce EduTrustSim, a controlled simulation that produces these failure types using GPT-3.5 and systematically records system-level signals such as semantic divergence, response time, and linguistic uncertainty. From 900 generated cases, we retain 850 high-quality labeled instances for modeling. We train and interpret three classifiers to flag trust risks, leveraging explainable AI techniques such as SHAP and LIME to analyze their decisions. Our findings show that subtle behavioral and linguistic traces—beyond content itself—often reveal when AI feedback may fail. Rather than filtering after the fact, this approach enables proactive detection before feedback reaches learners, offering a reproducible method for anticipating trust failures in generative educational systems.},
  keywords={Uncertainty;Filtering;Explainable AI;Semantics;Education;Linguistics;Predictive models;Feature extraction;Time factors;Reliability;Trust Risk Prediction;Al-Generated Feedback;Prompt Injection;Semantic Drift;Explainable Machine Learning},
  doi={10.1109/ICETC66579.2025.11387604},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11387914,
  author={Gu, Yixiang and Chang, Qi and You, Junshuang and Li, Lulu and Chen, XingChi and Chen, Yanli},
  booktitle={2025 IEEE 6th International Conference on Computer, Big Data, Artificial Intelligence (ICCBD+AI)}, 
  title={A Systematic Survey of Jailbreak Attacks Against Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={As large language models (LLMs) are now widely deployed in natural language understanding, program synthesis and interactive dialogue systems, the security risks they introduce have attracted growing attention. A central concern is jailbreak attacks, which deliberately bypass safety alignment mechanisms and can coerce models into producing harmful or policy breaching content, thereby threatening both system reliability and user safety. This work presents a comprehensive survey of jailbreak attacks against LLMs and multimodal large language models (MLLMs). We organize existing techniques according to the adversary’s access level into white-box and black-box settings. In the white-box case, attackers exploit gradient signals or detailed model information to construct adversarial prompts, whereas black-box attacks rely solely on query interactions or carefully crafted contextual cues to elicit unsafe behavior. With the emergence of MLLMs, research has expanded from text based environments to multimodal scenarios such as vision language applications. This paper reviews representative methods and their development over time, examines the mechanisms that enable jailbreaks and highlights key challenges in maintaining alignment and ensuring the security of multimodal systems.},
  keywords={Surveys;Systematics;Large language models;Biological system modeling;Closed box;Safety;Reliability;Optimization;Glass box;Systematic literature review;jailbreak attack;LLMs;MLLMs},
  doi={10.1109/ICCBDAI66607.2025.11387914},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11383393,
  author={Peng, Hao and Wu, Shangfang and Zhao, Dandan and Ding, Zhiguo and Ji, Shouling and Zhong, Ming},
  booktitle={2025 11th International Conference on Big Data and Information Analytics (BigDIA)}, 
  title={AAL:Attention-Guided White-Box Attack on Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={486-493},
  abstract={The security of Large Language Models (LLMs) is receiving increasing attention. Recent studies have shown that LLMs can easily generate harmful content when exposed to jailbreaking attacks. These attacks add a suffix to malicious questions. However, existing methods lack clear guidance when updating the suffix location. As a result, they are unable to efficiently and accurately find suitable token positions, so they cannot achieve a higher attack success rate. In this study, we analyzed the model’s attention to different tokens and proposed an attention-guided token localization strategy. This strategy efficiently searches for and replaces tokens, thereby improving performance. Specifically, we prioritize replacing high-attention tokens with suitable candidate tokens to distract the LLM’s attention and achieve the jailbreak. We also propose a jumping mechanism in order to change the search strategy and escape the local optimum when the optimization results stagnate. Additionally, we perform a simple initialization of the suffix to mitigate the impact of identical tokens on the attention mechanism. Extensive experiments demonstrate that these strategies can optimize and improve attack algorithms. Finally, we propose the Attention-Guided Attack on LLMs(AAL), which achieves 94% and nearly 100% success rates on Llama-2-7b-chat-hf and vicuna-7b-v1.5-16k, respectively. The results show that our algorithm outperforms existing baselines in terms of optimization efficiency and success rate.},
  keywords={Location awareness;Analytical models;Attention mechanisms;Large language models;Big Data;Search problems;Data models;Security;Optimization;Glass box;Large Language Models;Jailbreak Attack;Security;Attention Mechanism},
  doi={10.1109/BigDIA68682.2025.11383393},
  ISSN={2771-6902},
  month={Nov},}@INPROCEEDINGS{11378619,
  author={S, Aswin Mallessh N and A, Ilavendhan},
  booktitle={2025 IEEE Pune Section International Conference (PuneCon)}, 
  title={Input Moderation and Injection Filtering in Large Language Model via Llama Guard Integration}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models (LLMs) have recently gained attention in the field of natural language processing owing to their impressive capabilities. However, as their use becomes more widespread, new security challenges have emerged, most notably prompt injection attacks. These attacks exploit the instruction-following nature of models such as Llama, which are particularly vulnerable. In this study, proposed a mitigation strategy in which user prompts were first filtered through Llama Guard, a policy-driven safeguard mechanism that acted as a mediator between the user and the LLM. This approach utilizes predefined safety rules (policies) and blocks malicious prompt manipulation using the LlamaGuard interface. Experimental evaluation on the DeepSet dataset demonstrated improvements in security across multiple models. With LlamaGuard integration, the 8B version maintained a high recall (91.25 %) and F1-score (77.29 %) while achieving an accuracy (78.70%) and precision (67.03%). The accuracy of the 8 B model improved by 4.23 % and that of the 1B model by 1.16 % when combined with LlamaGuard, according to the results, which proved a boost in performance.},
  keywords={Accuracy;Filtering;Large language models;Prevention and mitigation;Natural language processing;Safety;Security;Large Language Models;Input Moderation;Prompt Injection;LlamaGuard;AI Security;Model Defense},
  doi={10.1109/PuneCon67554.2025.11378619},
  ISSN={2831-5022},
  month={Dec},}@INPROCEEDINGS{11379319,
  author={Yadav, Tanushree Ravindra Pratap},
  booktitle={2025 IEEE Pune Section International Conference (PuneCon)}, 
  title={Lost in Translation, Found in Evaluation: Multilingual Jailbreak Detection Across 49 Languages}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Large language models (LLMs) have demonstrated remarkable capabilities yet remain vulnerable to jailbreak attacks where malicious prompts bypass safety mechanisms. While extensive research exists on English jailbreak detection, multilingual scenarios remain underexplored, particularly for low-resource languages. This paper introduces a comprehensive multilingual jailbreak dataset spanning 49 languages with over 11,000 samples and presents systematic evaluation of cross-lingual transfer learning for jailbreak detection. Using advanced language models for automated evaluation, we achieve 54.44 % jailbreak detection across languages with high quality metrics (grammar: 4.37 out of 5, clarity: 4.51 out of 5). Our zero-shot BERT experiments reveal that few-shot learning dramatically improves performance from $\text{4 3. 2 \%}$ (zero-shot) to $\text{7 7 \%}$ ($\text{2 0}$-shot), while cross-family transfer proves surprisingly competitive with within-family approaches. These findings challenge conventional assumptions about linguistic similarity in transfer learning and provide practical guidelines for multilingual safety systems.},
  keywords={Measurement;Translation;Systematics;Large language models;Transfer learning;Cross lingual;Performance gain;Multilingual;Safety;Few shot learning;Large Language Models;Jailbreak Detection;Multilingual NLP;Cross-Lingual Transfer Learning;AI Safety;Low-Resource Languages},
  doi={10.1109/PuneCon67554.2025.11379319},
  ISSN={2831-5022},
  month={Dec},}@INPROCEEDINGS{11379484,
  author={S, Krishnaa and S, Praveen and P, Jayabharathi},
  booktitle={2025 2nd International Conference on Artificial Intelligence and Knowledge Discovery in Concurrent Engineering (ICECONF)}, 
  title={Secure AI Agents for Cloud Compliance in Adversarial Environments}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Cloud computing has become the backbone of present digital infrastructures, yet the rapid adoption introduces significant compliance and security challenges. Traditional compliance auditing methods often fail to keep pace with the changing, multi-tenant, and adversarial nature of cloud environments. This paper proposes a novel framework for secure AI agents that leverage Retrieval-Augmented Generation (RAG), agentic reasoning, and adversarially robust mechanisms to automate cloud compliance assessment. Unlike conventional rule-based tools, the agents are designed to operate in hostile conditions, where incomplete documentation, evasive misconfigurations, and malicious obfuscation may hinder accurate auditing. The proposed system integrates knowledge from regulatory benchmarks (e.g., CIS, NIST, GDPR) with real-time cloud telemetry and command-line interactions, while incorporating defense layers against prompt injection, data poisoning, and model hallucination. Experimental results demonstrate the capability of these agents to identify compliance drift, flag anomalous behaviors, and provide explainable recommendations with higher resilience under adversarial stress compared to baseline automated audit tools. This work highlights a pathway toward trustworthy, adaptive, and secure AI-driven compliance assistants for next-generation cloud security operations.},
  keywords={Training;Accuracy;Cloud computing security;Retrieval augmented generation;Robustness;Cognition;Vectors;Security;Artificial intelligence;Resilience;Cloud security;AI agents;compliance auditing;adversarial environments;Retrieval-Augmented Generation (RAG);cloud compliance;automated auditing;secure AI;adversarial robustness;explainable AI.},
  doi={10.1109/ICECONF65644.2025.11379484},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11379668,
  author={Velrani, K. Sundara and S, Krithika and M, Maria Jansi},
  booktitle={2025 2nd International Conference on Artificial Intelligence and Knowledge Discovery in Concurrent Engineering (ICECONF)}, 
  title={Experimental Evaluation of Deploying SASE JEM Authentication and Deep Fool Techniques for Robust Generative AI Chatbot Protection}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Generative AI chatbots are used in more and more fields, but until the technology can be secured and trusted, it remains sensitive to unauthorized access and adversarial prompts. This paper will use experimental approaches to improve the safety of chatbots by testing a new model, the SACD, that combines the use of SASE JEM authentication and the DeepFool adversarial defense. The framework will block errant or malicious users, and subsequently identify and counter opposing inputs, such that only harmless prompts are passed through the chatbot. The SACD framework performed well with using the LLM Jailbreak + Safety Data on Kaggle as the program provided a high-level of robustness, scoring 98% and decreasing the number of unsafe outputs and attack success rates significantly. These findings affirm the fact that the suggested structure offers a stable, multi -layered defense system, which integrates access-level protection with the model-level adversarial protection and therefore offers secure, trustworthy, and resilient chatbot interactions.},
  keywords={Generative AI;Authentication;Chatbots;Knowledge discovery;Robustness;Concurrent engineering;Protection;Testing;SASE JEM authentication;DeepFool adversarial defense;generative AI chatbot;adversarial prompts;jailbreak detection},
  doi={10.1109/ICECONF65644.2025.11379668},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11382707,
  author={Reddy.A, Basi and Chandran, Mindala Sai Venkata and Chaithanya, Neerupaka and Koushik, Palagani Varun and Krishna, Nadella Sai},
  booktitle={2025 5th International Conference on Evolutionary Computing and Mobile Sustainable Networks (ICECMSN)}, 
  title={Explainable Transformer-based Detection of Adversarial Prompts in Chatbots}, 
  year={2025},
  volume={},
  number={},
  pages={1882-1887},
  abstract={The popularity of large language model (LLM)-based chatbots has increased their vulnerability to adversarial prompt attacks that programmable affect the model's behaviour and produce scripted responses. The paper introduces an Explainable Transformer-Based Detection (ETD) framework that is meant to detect and explain adversarial prompts on the fly. The proposed system offers a BERT-based contextual encoder and an attention-based explanation layer, which captures fine-grained semantical dependencies and assigns model decisions on attribute models to certain token influences. The experiment was done on a curated set of 12,000 benign and 8,000 adversarial prompts produced using paraphrasing, prompt injection, and contextual perturbation methods. The ETD framework attained an accuracy of 96.8, a precision of 95.4, a recall of 97.2, and an F1-score of 96.3, which are 5.7 and 8.1 points higher than the traditional LSTM- and CNN-based baselines, respectively. In addition, the built-in explainability component offers the visual interpretations at the token level, which makes it easier to be transparent in detecting adversarial intent. The findings prove that the given ETD model is rather effective in terms of balancing the performance of the detection and the interpretability of the system, which makes contemporary chatbot systems more robust and trustworthy.},
  keywords={Visualization;Accuracy;Statistical analysis;Large language models;Perturbation methods;Chatbots;Transformers;Real-time systems;Reliability;Context modeling;Adversarial prompts;Explainable AI (XAI);Transformer models;Chatbots;Prompt injection detection;Natural language processing (NLP)},
  doi={10.1109/ICECMSN68058.2025.11382707},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11380866,
  author={Armar, Abdul Muqeet and Jaleel, Nubila and Marikattay, Mohammed Sinan},
  booktitle={2025 Second International Conference on Computing, Semiconductor, Mechatronics, Intelligent Systems and Communications (COSMIC)}, 
  title={Adversarial Prompting and Jailbreak Attacks in Large Language Models: Detection and Mitigation Strategies}, 
  year={2025},
  volume={},
  number={},
  pages={222-227},
  abstract={The rapid integration of Large Language Models (LLMs) such as GPT-4 and similar architectures into real-world applications has revolutionized natural language understanding, but it has also unveiled pressing security challenges. Among the most critical are adversarial prompting and jailbreak attacks, wherein attackers craft subtle or cleverly engineered inputs to exploit model loopholes, bypassing built-in safeguards to elicit unintended, inappropriate, or harmful outputs. Addressing these evolving threats demands solutions that are not only accurate but adaptive and comprehensive. In this study, we introduce JBSHIELD—a unified detection and mitigation framework that leverages both supervised classification and unsupervised anomaly detection techniques. The proposed system employs multi-stage feature extraction and ensemble decision-making to identify a broad spectrum of hostile prompts in real time. Our mitigation stack consists of prompt filtering, robust response sanitization, and dynamic policy enforcement, working together to dramatically reduce successful attack rates. Through rigorous experimentation on a synthetic benchmark containing 5,000 diverse prompts, including 2,000 maliciously crafted examples, JBSHIELD achieves a detection accuracy of 96.4% and reduces the attack success rate from a baseline of 45% to just 5%. These results highlight the framework’s potential as a proactive defense for next-generation AI applications, promoting safer and more trustworthy deployment of LLMs in sensitive domains.},
  keywords={Semiconductor device modeling;Adaptation models;Accuracy;Prevention and mitigation;Large language models;Benchmark testing;Real-time systems;Security;Anomaly detection;Unsupervised learning;Adversarial prompting;jailbreak attacks;large language models;Anomaly detection;machine learning security;multi-tiered mitigation},
  doi={10.1109/COSMIC67569.2025.11380866},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11381740,
  author={Niloy, Md. Robiul Islam and Hasan, SM Mehady and Akimoto, Youhei and Hassan, A. S. M. Sabiqul and Noon, Md. Wardun Islam},
  booktitle={2025 IEEE 2nd International Conference on Computing, Applications and Systems (COMPAS)}, 
  title={Jailbreaking Large Language Models: A Red Teaming Perspective}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Despite their remarkable progress in natural language processing, Large Language Models (LLMs) are nevertheless susceptible to jailbreaking—adversarial prompts that circumvent security measures to elicit inappropriate or malicious content. We introduce a taxonomy that covers prompt-based, optimisation-based, multi-turn, and LLM-to-LLM assaults in this paper’s thorough red teaming research of jailbreaks. Our tests employ statistical analysis and rigorous multi-run conditions to evaluate four sample LLMs, encompassing both proprietary and open-source systems. According to the results, the most successful suffix attacks are optimisation-based, achieving up to 92.4% success on LLaMA-2 and 65.1% on ChatGPT-4. Attack success rates more than double over eight turns in multi-turn exploits, indicating that alignment deteriorates with discourse length. We also examine defence measures, demonstrating that anomaly detection, albeit at the expense of an 8.2% false positive rate on benign inputs, reduces attack success rates by 44% on average. These results show that current protections are still lacking and emphasise the trade-offs between robustness and usability. We suggest forward-looking approaches, such as federated red teaming, interpretability-driven diagnostics, uniform benchmarks, and adaptive defences, to solve these issues. Through the integration of governance insights and empirical evaluation, our work helps create LLMs that are more reliable and secure.},
  keywords={Training;Statistical analysis;Large language models;Taxonomy;Benchmark testing;Robustness;Security;Usability;Anomaly detection;Resilience;Large Language Models (LLMs);Jailbreaking;Red Teaming;Adversarial Attacks;Optimization-based Methods;Multi-turn Exploits;Transferability;AI Safety;Robustness;Governance},
  doi={10.1109/COMPAS67506.2025.11381740},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11368582,
  author={Saklani, Sumit and Chohan, Deepak Kumar and Sharma, Raman and Varshney, Niharika and Gupta, Atika and Bagla, Piyush},
  booktitle={2025 IEEE 6th Global Conference for Advancement in Technology (GCAT)}, 
  title={LLM-Guarded Clouds: Leveraging Generative AI for Proactive Threat Hunting and Adaptive Defense in Hybrid Cloud Environments}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={The ability to scale within hybrid and multi cloud infrastructures enhances liquid resource availability, However, this also dramatically increases the attack surface, leaving trivially configured defenses completely obsolete, particularly for attack sophistication levels identified as low to mid. Deploying Large Language Models brings unique risks, such as prompt injection and exposing unreasoned system vulnerability gaps. This is the focus of the research: integrating LLM-Guarded Clouds with preemptive, nonlinear, adaptive threat defense hybrid cloud frameworks with strong attack surface generative AI. This LLM system manages multi-stage attacks with GNNs, feeds LLMs through Controlled Authoring Tier Restricted Processor/Graph-Reduced PAXs for reasoning Focused Inferencing, and applies federated learning within TEEs for classified, low-surveillance, and safe reasoning operationally secure LLM inferencing. Our analysis of the UNSW-NB15, CIC-IDS2018 and AWS CloudTrail logs demonstrates an accuracy rate 96.5%, F1 score of 95.4% and 3.4% false positive rate – outperforming ML, CNN-LSTM and LLM only baselines by almost 15%. Robustness testing indicates 72% improvement in adversarial resilience against prompt injection. Overall, LLM-Guarded Clouds improves accuracy, resilience, and explainability in detection, providing a novel automated defense solution for hybrid cloud environments.},
  keywords={Accuracy;Adaptive systems;Upper bound;Federated learning;Generative AI;Large language models;Hybrid power systems;Cognition;Graph neural networks;Resilience;Hybrid Cloud Security;Large Language Models (LLMs);Threat Hunting;Graph Neural Networks (GNNs);Retrieval-Augmented Generation (RAG);Federated Learning;Trusted Execution Environments (TEEs)},
  doi={10.1109/GCAT66372.2025.11368582},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11366720,
  author={Sperlí, Giancarlo},
  booktitle={2025 International Symposium on Multimedia (ISM)}, 
  title={Exploring Privacy and Security Risks in LLMs: Data Leakage, Prompt Injection, and Membership Inference}, 
  year={2025},
  volume={},
  number={},
  pages={5-12},
  abstract={In this paper, we present an analysis of the dual role of Large Language Models (LLMs) in the context of multimedia security, examining how these models can both strengthen defensive capabilities and introduce new vulnerabilities within modern content ecosystems. As LLMs increasingly interface with multimedia workflows-ranging from text-image generation pipelines to cross-modal retrieval and content moderation-their susceptibility to attacks such as data leakage, prompt injection, and jailbreaks raises critical concerns for the integrity and trustworthiness of multimedia platforms. We focus our analysis on privacy-oriented threats, including model inversion and membership inference, and discuss their implications for systems that process or generate multimedia content. Building on this risk landscape, we outline principles for improving the robustness and resilience of LLM-driven multimedia applications, highlighting strategies suited to in-the-wild threat scenarios. Indeed, we explore the constructive application of LLMs within cybersecurity frameworks, such as the Cyber Kill Chain, demonstrating how these models can be leveraged for threat detection, risk assessment, and automated defensive operations.},
  keywords={Analytical models;Biological system modeling;Large language models;Multimedia systems;Pipelines;Ecosystems;Threat assessment;Robustness;Risk management;Resilience;Large Language Models;Security Risks;Model Inversion;Membership Inference},
  doi={10.1109/ISM66958.2025.00011},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11364988,
  author={Yadav, Hritesh and Singh, Varun and Sharma, Kshitij},
  booktitle={2025 Seventh International Conference on Research in Computational Intelligence and Communication Networks (ICRCICN)}, 
  title={Adversial Prompt Injection in Large Language Models: Taxonomy, Exploits, and Mitigation Frameworks}, 
  year={2025},
  volume={},
  number={},
  pages={244-251},
  abstract={Adversarial prompt injection attacks pose a critical security threat to Large Language Models (LLMs) by manipulating model instructions through malicious inputs. In this paper, we present a comprehensive analysis of prompt injection vulnerabilities in LLMs. We develop a taxonomy encompassing direct, indirect, and multi-stage (chained) prompt injection attacks, detailing various exploits from simple “ignore previous instructions” overrides to covert multi-turn schemes. Through case studies and experimental evidence from recent literature, we demonstrate that even state-of-the-art models (e.g. GPT-4) can be consistently coerced into producing disallowed content, leaking confidential data, or executing unintended actions. We evaluate real-world risks via documented incidents (such as system prompt leaks and compromised LLM-integrated applications) and quantitative benchmarks, finding adversarial success rates exceeding $80 \%$ in many scenarios. To address these threats, we propose a defense-in-depth mitigation framework. Our framework combines prompt sanitization (input filtering and normalization), context isolation (segregating user input from system instructions and external data), and model hardening (enhanced alignment tuning and adversarial training) to substantially reduce injection success. We also outline practical defensive strategies including role-based privilege restriction, output validation, and continuous red-teaming. Finally, we discuss the broader implications of prompt injection for AI safety, ethics, and policy, and highlight directions for future work in building robust, secure LLM systems.},
  keywords={Training;Ethics;Filtering;Large language models;Prevention and mitigation;Taxonomy;Data models;Safety;Security;Tuning;Adversarial Prompt Injection;Large Language Models;Jailbreak Attacks;Taxonomy;LLM Security;Input Sanitization;Model Alignment;AI Safety},
  doi={10.1109/ICRCICN68210.2025.11364988},
  ISSN={2832-3645},
  month={Dec},}@INPROCEEDINGS{11354818,
  author={Cheng, Siyang and Liu, Gaotian and Mei, Rui and Wang, Yilin and Zhang, Kejia and Wei, Kaishuo and Yu, Yuqi and Wen, Weiping and Wu, Xiaojie and Liu, Junhua},
  booktitle={2025 IEEE 24th International Conference on Trust, Security and Privacy in Computing and Communications (TrustCom)}, 
  title={ForgeDAN: An Evolutionary Framework for Jailbreaking Aligned Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1135-1146},
  abstract={The rapid adoption of large language models (LLMs) has brought both transformative applications and new security risks, including jailbreak attacks that bypass alignment safeguards to elicit harmful outputs. Existing automated jailbreak generation approaches e.g. AutoDAN, suffer from limited mutation diversity, shallow fitness evaluation, and fragile keyword-based detection. To address these limitations, we propose ForgeDAN, a novel evolutionary framework for generating semantically coherent and highly effective adversarial prompts against aligned LLMs. First, ForgeDAN introduces multi-strategy textual perturbations across character, word, and sentence-level operations to enhance attack diversity; then we employ interpretable semantic fitness evaluation based on a text similarity model to guide the evolutionary process toward semantically relevant and harmful outputs; finally, ForgeDAN integrates dual-dimensional jailbreak judgment, leveraging an LLM-based classifier to jointly assess model compliance and output harmfulness, thereby reducing false positives and improving detection effectiveness. Our evaluation demonstrates ForgeDAN achieves high jailbreaking success rates while maintaining naturalness and stealth, outperforming existing SOTA solutions.},
  keywords={Privacy;Large language models;Perturbation methods;Semantics;Evolutionary computation;Benchmark testing;Safety;Security;jailbreak attack;adversarial prompt generation;large language models (LLMs);evolutionary algorithm;AI safety},
  doi={10.1109/Trustcom66490.2025.00131},
  ISSN={2324-9013},
  month={Nov},}@INPROCEEDINGS{11354585,
  author={Yang, Meng and Liang, Peirou and Wu, Zhiqian and Liao, Yong},
  booktitle={2025 IEEE 24th International Conference on Trust, Security and Privacy in Computing and Communications (TrustCom)}, 
  title={Jailbreaking Multimodal Large Language Models via Consistent Cross-Modal Backgrounds}, 
  year={2025},
  volume={},
  number={},
  pages={2259-2266},
  abstract={Multimodal large language models (MLLMs) have shown remarkable capability in vision–language understanding but remain vulnerable to jailbreak attacks that bypass safety alignment. Existing methods often rely on structured input manipulations such as cross-modal signal shifting, adversarial visual injection, or semantic rephrasing, which compromise naturalness and degrade under stronger defenses. To address this, we propose Consistent Cross-Modal Backgrounds Attack (CCB-A), a jailbreak strategy that embeds benign and semantically aligned background cues across both image and text modalities. Leveraging such consistency, CCB-A dilutes safety-sensitive signals and subtly redirects model attention away from harmful content while maintaining semantic coherence. We evaluate CCB-A on six representative MLLMs, including both commercial and open-source systems, across MM-SafetyBench and HADES. Experiments show that CCB-A consistently surpasses strong baselines in harmfulness and attack success rate. Ablation and defense analyses further reveal that cross-modal semantic consistency is the key driver of its effectiveness, while current defense mechanisms remain insufficiently robust, suggesting that exploiting consistency across modalities constitutes an effective yet previously overlooked jailbreak strategy that exposes a critical vulnerability in current alignment techniques.},
  keywords={Degradation;Visualization;Privacy;Large language models;Semantics;Noise;Coherence;Safety;Security;Reliability;Multimodal Large Language Models;Jailbreak Attacks;Safety Alignment;Cross-Modal Consistency},
  doi={10.1109/Trustcom66490.2025.00263},
  ISSN={2324-9013},
  month={Nov},}@INPROCEEDINGS{11354792,
  author={Marina-Metola, Jorge and de Fuentes, Jose Maria and Gonzalez-Manzano, Lorena and Ibanez-Lissen, Luis},
  booktitle={2025 IEEE 24th International Conference on Trust, Security and Privacy in Computing and Communications (TrustCom)}, 
  title={Detecting Multi-Turn Jailbreak Attacks in Large Language Models via Linear Probes}, 
  year={2025},
  volume={},
  number={},
  pages={3111-3120},
  abstract={Multi-turn jailbreak attacks are a prominent threat for Large Language Models (LLMs). While internal LLM data has been used for single-turn jailbreaks, its suitability for multi-turn ones remains unexplored. This paper proposes a mechanism leveraging linear probes on layer activations. Interestingly, it enables characterizing the anticipation (or Early Warning, EW) in the detection, which has never been measured. To support the assessment, a novel dataset with +10k harmful and harmless conversations is produced. Experiments on Llama, Qwen and Mistral models show that the approach is specially effective in Llama – for 5-turn attacks, max F1=0.7 and average EW =2.64). Moreover, our results suggest that the effectiveness decreases with bigger model sizes.},
  keywords={Privacy;Large language models;Oral communication;Security;Probes;Large Language Models (LLMs);Multi-turn Jailbreak Attacks},
  doi={10.1109/Trustcom66490.2025.00371},
  ISSN={2324-9013},
  month={Nov},}@INPROCEEDINGS{11352474,
  author={Park, Leo Hyun and Kwon, Taekyoung},
  booktitle={2025 28th International Symposium on Research in Attacks, Intrusions and Defenses (RAID)}, 
  title={Red-Teaming LLMs with Token Control Score: Efficient, Universal, and Transferable Jailbreaks}, 
  year={2025},
  volume={},
  number={},
  pages={629-647},
  abstract={Large Language Models (LLMs) are vulnerable to jailbreak attacks, where adversaries craft malicious prompts to bypass safety mechanisms and elicit harmful, illegal, or unethical responses. To ensure robustness before deployment, red-teaming LLMs is essential. However, prior methods like GCG and AutoDAN rely on loss functions that only assess whether the output matches a fixed target, offering little insight into how well the prompt circumvents refusal behaviors. We introduce Token Control Score (TCS), a novel metric that quantifies how effectively a prompt steers the LLM toward compliance and away from refusal. TCS compares the logits of key tokens representing compliant and rejecting responses, and can be extended with gradient-based feedback into a Normalized Token Control Score (NTCS) to guide optimization. Using this metric, we propose LLM-CGF, a fuzzing-based framework that iteratively discovers effective jailbreak templates for prompt injection. LLM-CGF leverages NTCS as the fitness function to explore LLM behaviors and uncover vulnerabilities with high efficiency. Experiments show that LLM-CGF outperforms state-of-the-art methods such as LLM-Fuzzer, generating more universal, transferable, and query-efficient jailbreak prompts. These results demonstrate the utility of TCS and NTCS as new objectives for prompt injection, providing deeper insights into LLM safety and enabling more thorough red-teaming evaluations. Warning: This paper contains unfiltered content generated by LLMs that may be offensive to readers.},
  keywords={Measurement;Large language models;Impedance matching;Fuzzing;Robustness;Safety;Optimization;large language models;jailbreak;red-teaming},
  doi={10.1109/RAID67961.2025.00016},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11362401,
  author={M, Nayana and Reshma, S Rupashree and Harsha, Y Lakshmi Raj and Rajula, Swaminadhan},
  booktitle={2025 IEEE 4th International Conference for Advancement in Technology (ICONAT)}, 
  title={The Dark Side of AI: a Systematization of Knowledge on Jailbreaking and Prompt Injection in LLMs}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={The proliferation of Large Language Models (LLMs) has introduced a new frontier of security vulnerabilities that diverge significantly from traditional software exploits. This paper provides a systematization of knowledge on the emerging threat vectors targeting LLMs, focusing on two dominant attack classes: jailbreaking and prompt injection. Jailbreaking aims to bypass the safety and ethical alignments of a model, whereas prompt injection manipulates model outputs by embedding adversarial instructions within its context. We structure this landscape by proposing a comprehensive taxonomy that classifies attacks along two primary axes: attacker objective (policy bypass, output hijacking, and unauthorized execution) and technical execution (direct, indirect, and cross-modal injection). Through a structured literature review, we synthesize foundational and recent works to analyze the mechanics of these attacks, from simple role-playing scenarios to sophisticated, multi-stage indirect injections. Furthermore, we survey the current state of proposed defenses, categorizing them into a multi-layered framework of input defense, model resilience, and output monitoring, and we critically evaluate their respective limitations. This work clarifies the current threat landscape, highlights critical research gaps, and provides a foundational reference for researchers and practitioners working to build more secure and robust AI systems.},
  keywords={Surveys;Technological innovation;Systematics;Large language models;Taxonomy;Vectors;Software;Safety;Context modeling;Systematic literature review;Large Language Models;AI Security;Prompt Injection;Jailbreaking;Adversarial AI;Cybersecurity;Systematization of Knowledge},
  doi={10.1109/ICONAT66879.2025.11362401},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11360327,
  author={Liu, Zhouyang and Chen, Yanli and He, Yuyu and Wang, Zhigang and Lu, Hui and Zhang, Xinge and Wu, Jinghang},
  booktitle={2025 IEEE 10th International Conference on Data Science in Cyberspace (DSC)}, 
  title={An Arms Race in the Inbox: A Systematic Review of Phishing Generation and the Rise of LLMs}, 
  year={2025},
  volume={},
  number={},
  pages={94-101},
  abstract={Phishing attacks, as an important vector of social engineering attacks, have undergone a profound evolutionary process in their email generation techniques. In this paper, we systematically review the four stages of phishing email generation techniques from the early manual templating methods to the modern large language model-driven generation. It is shown that this evolutionary process is characterized by a continuous arms race between attack complexity and defensive measures, and its core driving force is to resolve the inherent contradiction between attack scaling and personalization. Existing research has significant shortcomings in systematically analyzing the logic of technology evolution, quantifying the economic impact, and predicting future development trends. In this paper, we propose for the first time a theoretical framework of contradiction resolution for the evolution of phishing technology, and deeply analyze how the emergence of large-scale language models (LLMs) represents a fundamental paradigm shift in phishing attack technology. By analyzing the LLM jailbreak technique and its far-reaching impact on network security defense, this paper provides important theoretical guidance and practical suggestions for the formulation of future defense strategies and research directions.},
  keywords={Technological innovation;Phishing;Weapons;Manuals;Network security;Market research;Vectors;Electronic mail;Logic;Systematic literature review;phishing attacks;social engineering;large language modeling;cybersecurity;artificial intelligence security},
  doi={10.1109/DSC67331.2025.00021},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11360440,
  author={Hou, Wenbo and Hu, Ning and Hu, Yamin and Luo, Wenjian},
  booktitle={2025 IEEE 10th International Conference on Data Science in Cyberspace (DSC)}, 
  title={Large Language Model Jailbreak Based on Stylistic Rewriting}, 
  year={2025},
  volume={},
  number={},
  pages={480-486},
  abstract={Despite security alignment efforts, large language models (LLMs) remain vulnerable to jailbreak attacks. Some existing methods modify malicious prompts by character-level substitutions (e.g., “bomb”→“b0mb”), which are easily detected after alignment training. Others modify prompts by encoding or encryption to bypass the security detection, but these approaches significantly compromise readability. This paper proposes a jailbreak attack method based on stylistic rewriting in the Shakespearean style, and further integrates it into a style-specific multi-round dialogue template to masked malicious intentions. Experimental results demonstrate that the method proposed in this paper can achieve a significant jailbreak effect.},
  keywords={Training;Large language models;Cyberspace;Data science;Encoding;Encryption;Security;Large Language Models;jailbreak;stylistic rewriting},
  doi={10.1109/DSC67331.2025.00068},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11334241,
  author={Yang, Rui and Fu, Michael and Tantithamthavorn, Chakkrit and Arora, Chetan and Gulmammadova, Gunel and Chua, Joey},
  booktitle={2025 40th IEEE/ACM International Conference on Automated Software Engineering (ASE)}, 
  title={AdaptiveGuard: Towards Adaptive Runtime Safety for LLM-Powered Software}, 
  year={2025},
  volume={},
  number={},
  pages={3381-3391},
  abstract={Guardrails are critical for the safe deployment of Large Language Models (LLMs)-powered software. Unlike traditional rule-based systems with limited, predefined input-output spaces that inherently constrain unsafe behavior, LLMs enable open-ended, intelligent interactions—opening the door to jailbreak attacks through user inputs. Guardrails serve as a protective layer, filtering unsafe prompts before they reach the LLM. However, prior research shows that jailbreak attacks can still succeed over 70% of the time, even against advanced models like GPT-4o. While guardrails such as LlamaGuard report up to 95% accuracy, our preliminary analysis shows their performance can drop sharply—to as low as 12%—when confronted with unseen attacks. This highlights a growing software engineering challenge: how to build a post-deployment guardrail that adapts dynamically to emerging threats? To address this, we propose AdaptiveGuard, an adaptive guardrail that detects novel jailbreak attacks as out-of-distribution (OOD) inputs and learns to defend against them through a continual learning framework. Through empirical evaluation, AdaptiveGuard achieves 96% OOD detection accuracy, adapts to new attacks in just two update steps, and retains over 85% F1-score on in-distribution data post-adaptation, outperforming other baselines. These results demonstrate that AdaptiveGuard is a guardrail capable of evolving in response to emerging jailbreak strategies post deployment. We release our AdaptiveGuard and studied datasets at https://github.com/awsm-research/AdaptiveGuard to support further research.},
  keywords={Continuing education;Training;Accuracy;Runtime;Large language models;Production;Reliability engineering;Software;Safety;Software reliability;Safety and Reliability;LLM Safety;Out-Of-Distribution Detection;LLM Guardrails;LLM Jailbreak Attacks},
  doi={10.1109/ASE63991.2025.00279},
  ISSN={2643-1572},
  month={Nov},}
