  booktitle={2026 IEEE Symposium on Security and Privacy (SP)}, 
  title={Parasites in the Toolchain: A Large-Scale Analysis of Attacks on the MCP Ecosystem}, 
  year={2026},
  volume={},
  number={},
  pages={138-155},
  abstract={Large language models (LLMs) are increasingly integrated with external systems through the Model Context Protocol (MCP), which standardizes tool invocation and has rapidly become a backbone for LLM-powered applications. While this paradigm enhances functionality, it also introduces a fundamental security shift: LLMs transition from passive information processors to autonomous orchestrators of taskoriented toolchains, expanding the attack surface, elevating adversarial goals from manipulating single outputs to hijacking entire execution flows. In this paper, we identify and characterize a systematic privacy-leakage attack pattern, termed Parasitic Toolchain Attacks, instantiated as MCP Unintended Privacy Disclosure (MCP-UPD). These attacks require no direct victim interaction; instead, adversaries embed malicious instructions into external data sources that LLMs access during legitimate tasks. Unlike traditional prompt injection and tool poisoning attacks, our attack targets the interconnected toolchain itself, assembling multiple legitimate tools into a coordinated workflow whose combined behavior accomplishes malicious objectives. In MCP-UPD, the malicious logic infiltrates the toolchain and unfolds in three phases: Parasitic Ingestion, Privacy Collection, and Privacy Disclosure, culminating in stealthy exfiltration of private data. Our root cause analysis reveals that MCP lacks both context-tool isolation and least-privilege enforcement, enabling adversarial instructions to propagate unchecked into sensitive tool invocations. To assess the severity, we design MCP-SEC and conduct the first large-scale security census of the MCP ecosystem, analyzing 12,230 tools across 1,360 servers. Our findings show that the MCP ecosystem is rife with real-world exploitable gadgets and diverse attack methods, underscoring systemic risks in MCP platforms and the urgent need for defense mechanisms in LLM-integrated environments.},
  keywords={Large language models;Modeling;Privacy;Servers;Tools;Security;Ecosystems;Printing;Context;Electronic mail},
  doi={10.1109/SP63933.2026.00154},
  ISSN={2375-1207},
  month={May},}@INPROCEEDINGS{11608651,
  author={Begum, Sultana and Rosenzweig, Michael},
  booktitle={2026 IEEE International Conference on AI and Data Analytics (ICAD)}, 
  title={A Privacy-Preserving On-Device Multi-Agent Architecture for AI PC (POMA) Workflow Automation}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={AI agents that automate desktop workflows can reduce time spent on repetitive knowledge work, but enterprise deployment raises acute privacy and trust challenges. Computer-use agents (CUAs) observe sensitive on-screen content and execute high-impact actions in open-world environments, making them vulnerable to prompt injection and unsafe tool use. Meanwhile, recent model evolution has significantly improved the capabilities of small language and compact multimodal models, enabling specialized low-latency inference that can run fully on-device. This paper presents AIPC-POMA, a privacy-preserving on-device multi-agent architecture for personal and enterprise AI PC workflow automation. AIPC POMA composes a set of carefully crafted, task-specialized small agents including an SLM for drafting, a compact VLM+OCR stack for document and screen understanding, and a sandboxed CUA for GUI interaction coordinated by a local Orchestrator and enforced by a Policy Verifier. POMA is designed around two principles: privacy by minimized data flow and trust by controlled action execution, achieved through least-privilege action primitives, risk-aware gating, and auditable execution traces. We describe a hardware aware implementation optimized for heterogeneous AI acceleration on AI PCs such as Panther Lake-class system, and we introduce an evaluation task suite and adversarial safety battery targeting indirect prompt injection and real-world agent threats. We define metrics spanning utility, latency, privacy leakage, and action safety, demonstrating that POMA enables practical low-cost automation while reducing exposure to untrusted inputs.},
  keywords={Modeling;Artificial intelligence;Printing;Tools;Automation;Privacy;Safety;Optical character recognition;Graphical user interfaces;Large language models;On-device AI;multi-agent systems;workflow automation;privacy-preserving inference;computer-use agents;prompt injections;multimodal models;AI PC;trustworthy autonomy},
