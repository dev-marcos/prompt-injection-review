@INPROCEEDINGS{11231998,
  author={ElSaify, Basma and Baderelden, Mohamed},
  booktitle={2025 2nd International Generative AI and Computational Language Modelling Conference (GACLM)}, 
  title={Adversarial and Multilingual Threats in Retrieval-Augmented Generation: From Prompt Injection to Model Exploitation}, 
  year={2025},
  volume={},
  number={},
  pages={155-162},
  abstract={Retrieval-Augmented Generation (RAG) systems have emerged as a cornerstone of modern generative AI by coupling large language models (LLMs) with external knowledge retrieval, thereby enabling more grounded, accurate, and context-aware outputs. Yet this paradigm simultaneously broadens the attack surface—extending vulnerabilities from generation into retrieval pipelines, language interfaces, and exposed APIs. In this paper, we propose a comprehensive threat taxonomy and adversarial framework targeting both conventional and agentic RAG systems, in which LLMs autonomously plan and execute multi-step tasks using retrieved knowledge. Our analysis spans a wide spectrum of adversarial techniques, including prompt injection, jailbreak exploits, API-driven model extraction, and multilingual prompt manipulation. Unlike prior work that primarily focuses on English-only vulnerabilities, we show that multilingual RAG pipelines—particularly those involving language blending (e.g., Arabic-English code-switching)—introduce novel attack vectors that bypass safety filters and induce unintended behaviors. To study these risks, we develop a multilingual adversarial benchmark suite that integrates both synthetic and real-world corpora across English, Arabic, and Spanish. Through systematic evaluation, we demonstrate how the retrieval layer not only amplifies leakage and inversion risks but also enables adversaries to infer system logic, extract private data from vector stores, and manipulate autonomous agent behavior through tool-integrated APIs. To mitigate these threats, we assess multiple defense strategies, including prompt sanitization, cross-lingual content filtering, retriever-stage anomaly detection, and behavior-based profiling of API interactions. Our findings reveal that existing safeguards are insufficient—particularly in agentic or low-resource language scenarios—underscoring the need for architecture-specific and multilingual defenses. This work fills a critical gap in GenAI security by presenting the first holistic, multilingual, and agent-aware security framework for RAG, offering actionable guidance for building robust and trustworthy generative AI applications across diverse linguistic and deployment contexts.},
  keywords={Filters;Generative AI;Large language models;Computational modeling;Retrieval augmented generation;Pipelines;Vectors;Multilingual;Security;Context modeling;Retrieval-Augmented Generation (RAG);Large Language Models (LLMs);Secure Generative AI;Agentic AI;Prompt Injection;Multilingual NLP;Multilingual Prompt Exploits;Generative AI Security;Model Extraction;Jailbreak Attacks;API Abuse;Contextual Prompt Injection;LLM Systems Defense Strategies;Trustworthy Generative AI and LLM Systems},
  doi={10.1109/GACLM67198.2025.11231998},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10835584,
  author={Irtiza, Saquib and Akbar, Khandakar Ashrafi and Yasmeen, Arowa and Khan, Latifur and Daescu, Ovidiu and Thuraisingham, Bhavani},
  booktitle={2024 IEEE 6th International Conference on Trust, Privacy and Security in Intelligent Systems, and Applications (TPS-ISA)}, 
  title={LLM-Sentry: A Model-Agnostic Human-in-the-Loop Framework for Securing Large Language Models}, 
  year={2024},
  volume={},
  number={},
  pages={245-254},
  abstract={LLM-Sentry represents a novel black-box defense strategy to safeguard Large Language Models (LLMs) against jailbreaking attacks. A key advantage of our approach is its model-agnostic nature, as it does not rely on specific information about the model’s architecture or parameters, thereby enabling its application to any commercial or open-source language models. Additionally, LLM-Sentry does not require retraining when new jailbreak attacks are discovered; a simple update to the knowledge base equips LLM-Sentry to defend against new threats. The widespread adoption of LLMs is attributed to their high-quality responses and user-friendly nature. However, these models are susceptible to manipulation by malicious actors exploiting vulnerabilities to generate harmful or compromised content. Recent research has identified various jailbreaking methods that exploit vulnerabilities in LLM security measures. Given the increasing complexity of jailbreaking techniques and the ambiguous nature of LLM safeguards, it is imperative to develop unique defense strategies that can seamlessly integrate into existing security frameworks and make them robust.Our work comprehensively analyzes various commercial LLMs to assess their vulnerability to sophisticated, multilingual jailbreaking prompts. We propose a defensive approach that combines a Zero-shot language classifier with the Retrieval Augmented Generation (RAG) technique to screen and filter potentially harmful input prompts before they are processed by the language model for response generation. We adopt a human-in-the-loop approach to gather a dataset comprising harmful and safe prompts, which serves as a knowledge base for the RAG retriever module to extract relevant context. Our investigation includes successful jailbreaking attempts on prominent commercial LLMs like Gemini, Mistral 7B, and ChatGPT, wherein we successfully bypass existing security measures and elicit compromised responses. We conduct a thorough evaluation of our approach against various baseline methods to validate its resilience and superiority against such attacks empirically. Our approach achieves an attack detection accuracy of 97%, surpassing all other methods in our comparative analysis.},
  keywords={Privacy;Large language models;Retrieval augmented generation;Knowledge based systems;Robustness;Human in the loop;Multilingual;Security;Intelligent systems;Resilience;Large Language Model;Defense;Human-In-The-Loop;Jailbreaking;Retrieval Augmented Generation;Model Agnostic;GPT;Gemini;Mistral;Zero-Shot Classification},
  doi={10.1109/TPS-ISA62245.2024.00036},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11075247,
  author={Dinu, Ionuţ-Vlăduţ and Danciu, Gabriel-Mihail and Vintilă, Raul Cristian and Bălan, Titus-Constantin},
  booktitle={2025 International Aegean Conference on Electrical Machines and Power Electronics (ACEMP) & 2025 International Conference on Optimization of Electrical and Electronic Equipment (OPTIM)}, 
  title={Disrupting Large Language Models with Hidden Prompt Injection Attacks Embedded in HTML Pages}, 
  year={2025},
  volume={},
  number={},
  pages={1-10},
  abstract={This research evaluates the reliability of Large Language Models (LLMs) as collaborative tools for extracting information from various web sources, including standard websites, e-commerce platforms, blogs, landing pages, or even e-mails, where the content is much shorter and the processing language models have a higher chance of getting attacked. Prior to conducting model assessments, we present some methodologies involved in web-scraping approaches, prompt injection attack types, and datasets that evaluate the attack success rate (ASR) of LLMs. Our investigation subjects LLMs to rigorous testing using HTML pages containing concealed instructions designed to terminate response generation when users make queries. The evaluation dataset consists of HTML documents of varying sizes, containing randomly positioned prompt injection attacks programmed to direct the LLM to respond with a single specific key word. Using this benchmark, we assess locally deployed LLM models, revealing their ASR across multiple architectures. The defensive mechanism we propose demonstrates a significant reduction in ASR through the implementation of a filtering system with fixed-sized windows of tokens that analyzes HTML content and eliminates compromised data, reducing the success rate of the attacks, which proved to reduce the ASR.},
  keywords={Training;Filtering;Large language models;Computer architecture;Vectors;Reliability;Security;Data mining;Standards;Software development management;Large Language Models;HTML Documents;Prompt Injection;Attack Success Rate;Filtering;Compromised Data},
  doi={10.1109/OPTIM-ACEMP62776.2025.11075247},
  ISSN={2643-3958},
  month={May},}@INPROCEEDINGS{11557724,
  author={Gantla, Sandeep Reddy and Devireddy, Srikanthreddy},
  booktitle={2025 International Conference on Computational Engineering, Sensing Technology and Management (ICCETM)}, 
  title={The Double-Edged Blade: Navigating Confidentiality in Context-Injected Language Generation}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper critically examines the nuanced privacy implications inherent in knowledge-augmented generative models. While retrieval-augmented generation (RAG) empowers large language models (LLMs) with dynamic information access, we unveil a paradoxical duality concerning data confidentiality. Our investigation, employing novel adversarial techniques, demonstrates that RAG systems can inadvertently expose sensitive information from their private retrieval corpora. Simultaneously, we reveal a compensatory effect where RAG can surprisingly attenuate the leakage risks associated with an LLM’s intrinsic training data. This work provides essential insights into the complex interplay between retrieval mechanisms, generative processes, and data privacy, offering a foundational understanding for building more secure and responsible knowledge-grounded AI.},
  keywords={Modeling;Context;Printing;Large language models;Retrieval augmented generation;Filtering;Filters;Privacy;Taxonomy;Training;Confidentiality;Context-Injected Language Models;Retrieval-Augmented Generation (RAG);Large Language Models (LLMs);Data Privacy;Semantic Leakage;Prompt Injection;Differential Privacy;Knowledge Retrieval Security;Confidentiality-Preserving AI Systems},
  doi={10.1109/ICCETM66557.2025.11557724},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11395889,
  author={Ruparel, Ritesh and Jatavallabha, Aravinda and Maringanti, Srinivasa},
  booktitle={2026 IEEE 5th International Conference on AI in Cybersecurity (ICAIC)}, 
  title={Prompting for LLM Security and RAG: A Survey from Zero-Shot to Automatic Prompt Optimization (APO) and Prompt-Injection Defenses}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models (LLMs) are increasingly embedded in security-sensitive workflows such as incident triage, code review, threat hunting, and retrieval-augmented assistants. In these settings, prompting is not only a performance tool but also a security control surface: LLMs may consume untrusted content (tickets, logs, web pages, retrieved documents) that can adversarially manipulate outputs via prompt injection. This paper presents a structured, practitioner-oriented survey that unifies (i) core prompting methods (zero-shot, few-shot), (ii) reasoning-structured prompting (chains/trees/graphs of thought), (iii) robustness methods (self-consistency), (iv) efficiency workflows (skeleton-of-thought), and (v) automatic prompt optimization (APO) and learned prompting (directional stimulus prompting). We additionally synthesize cybersecurity-specific research on prompt injection, indirect prompt injection benchmarks, retrieval-augmented generation (RAG) poisoning, coordinated Prompt–RAG attacks, and interface-level defenses (structured queries). We provide a taxonomy, summary tables, and a decision guide for selecting prompting strategies under accuracy– cost–security constraints.},
  keywords={Surveys;Reviews;Prevention and mitigation;Large language models;Taxonomy;Retrieval augmented generation;Web pages;Robustness;Prompt engineering;Optimization;Prompt engineering;prompt injection;retrieval-augmented generation (RAG);LLM security;automatic prompt optimization;survey},
  doi={10.1109/ICAIC67076.2026.11395889},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11336372,
  author={Zou, Xide},
  booktitle={2025 6th International Conference on Machine Learning and Computer Application (ICMLCA)}, 
  title={KG-Guard: Dynamic Knowledge Graph-Guided Multi-Turn Jailbreak Defense Framework for Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={930-933},
  abstract={Large Language Models (LLMs) are increasingly vulnerable to multi-turn jailbreak attacks that exploit accumulated conversational context to bypass safety constraints. These progressive attacks challenge existing defenses, which often rely on static filters or per-turn steering and lack awareness of long-range semantic evolution. We propose KG-Guard, a dynamic knowledge graph-guided defense framework that models entity-relation evolution across dialogue turns. By incrementally constructing a conversation-level knowledge graph (KG), KGGuard identifies emerging relational patterns that converge toward unsafe objectives. A novel Relation-Convergence Detector (RCD) integrates rule-based path matching and neural graph reasoning to assess convergence risk, enabling proactive intervention through prompt re-steering or response regulation. Experiments on benchmark multi-turn jailbreak datasets show that KG-Guard achieves superior robustness and interpretability, reducing Attack Success Rate (ASR) by 5-8% compared with state-of-the-art defenses while maintaining dialogue fluency.},
  keywords={Large language models;Semantics;Knowledge graphs;Detectors;Robustness;Regulation;Real-time systems;Trajectory;Safety;Security;Large Language Models;Jailbreak Attack Defense;Knowledge Graph;Multi-turn Dialogue Security},
  doi={10.1109/ICMLCA66850.2025.11336372},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11430791,
  author={Syed, Toqeer Ali and Almutairi, Mishal Ateeq and Moaty, Mahmoud Abdel},
  booktitle={2025 International Conference on Computer and Applications (ICCA)}, 
  title={Cross-Agent Multimodal Provenance-Aware Framework for Robust Prompt Injection Defense in Large Language and Vision-Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Large Language Models (LLMs), VisionLanguage Models (VLMs), and new agentic AI systems (e.g., LangChain and GraphChain) allow autonomous systems to reason and plan, and to coordinate between an assortment of tools and agents. Nevertheless, this feature also brings vulnerability to multimodal prompt injection (PI) attacks, in which hidden or malicious instructions that are embedded in text, images, metadata, or interagent messages can spread throughout the agent graph, triggering unintended behavior or policy violation, or corrupting a state. To mitigate these threats, this paper will present a Cross-Agent Multimodal Provenance-Aware Defense Framework that will sanitize any user- or agent-generated prompts and validate the output of the LLM independently, prior to their delivery to downstream nodes. The framework incorporates a text sanitizer agent, visual sanitizer agent and an output validator agent which are synchronized by a provenance ledger which documents modality, source and trust metadata throughout the agent network. The architecture implements ordered trust boundaries, so that an injected instruction cannot spread out via LangChain- or GraphChain-style workflows. There are better multimodal PI detection accuracy, lower trust leakage between agents, and more stable agentic execution pathways, all of which are experimentalized. This framework can build secure, interpretable, and reliable agentic AI systems by augmenting the established provenance tracking and validation systems to multi-agent orchestration.},
  keywords={Agentic AI;Visualization;Large language models;Pipelines;Metadata;Nonhomogeneous media;Safety;Reliability;Synchronization;Multi-agent systems;Prompt Injection;Multi-Agent Systems;Provenance Tracking;LLM Security;Trust Validation;AI Safety},
  doi={10.1109/ICCA66035.2025.11430791},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10882696,
  author={Rosari, Happy Sandhiyadini and Girinoto and Novita Yasa, Ray and Qomariasih, Nurul and Anindya Wijayanti, Rheva},
  booktitle={2024 International Conference on Computer Engineering, Network, and Intelligent Multimedia (CENIM)}, 
  title={SiJesi: Large Language Model Chatbot with Augmented Retrieval Approach Generation and Prompt Engineering}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This research designs a chatbot based on Large Language Models (LLM) for cyber incident consultation, utilizing the Retrieval Augmented Generation (RAG) approach, integrated with GPT and prompt engineering techniques. The goal is to improve public cybersecurity awareness, especially in areas with low awareness, by enhancing community consultation services through automation. The chatbot addresses security concerns by examining measures against prompt injection attacks to ensure reliability. The research follows the Waterfall System Development Life Cycle methodology. Results show that LLM chatbots using RAG and prompt engineering generate more accurate responses compared to human-based answers and GPT 3.5, achieving a top score of 35.26% in A/B testing. Additionally, the chatbot received a high satisfaction score of 86.47% in User Acceptance Testing. These findings are expected to contribute to increased cybersecurity awareness and the development of innovative, secure chatbot technology for public services.},
  keywords={Surveys;Large language models;Retrieval augmented generation;Chatbots;Transformers;Portable document format;Prompt engineering;Reliability;Computer security;Testing;Large Language Model;Retrieval Augmented Generation;Generative Pre-training Transformer;Prompt Engineering},
  doi={10.1109/CENIM64038.2024.10882696},
  ISSN={},
  month={Nov},}@ARTICLE{11048579,
  author={Mo, Yonghua and Tang, Maoyang and Lin, Ruohan and Zhou, Bohao and Li, Xiaojian},
  journal={IEEE Access}, 
  title={Broken Bags: Disrupting Service Through the Contamination of Large Language Models With Misinformation}, 
  year={2025},
  volume={13},
  number={},
  pages={109607-109623},
  abstract={Large language models (LLMs) have progressively become essential production tools in contemporary society, owing to their formidable natural language generation and contextual reasoning skills. To facilitate the development of current responses by LLMs, individuals have used retrieval-augmented generation (RAG) technology, which extracts material from the corpus to assist large language models in producing relevant replies. The extensive utilization of huge language models necessitates urgent RAG security research. Conventional RAG attack techniques exhibit inadequate hiding and a substantial volume of harmful messages. Consequently, we have introduced an innovative attack mechanism termed “Broken Bags,” which adeptly injects a minimal quantity of toxic text to mislead large language models. The attack is executed through a hybrid approach that incorporates artificial prompt templates, toxic content generated by LLMs, and filtering mechanisms. For instance, when the RAG system engages with publicly available knowledge bases, adversaries can take advantage of the accessibility of these RAG knowledge bases to introduce malicious texts into the retrieval database, so as to intentionally alter the model’s behavior. This work employs the linguistic similarity between toxic content and the geographical vector characteristics of the “query question” to influence the information returned by RAG, hence preventing the LLM from generating responses to the target questions. We developed and refined an artificial prompt template to render toxic language more akin to authentic human expressions and less detectable. Experimental data indicates that our attack success rate attains 94%. Ultimately, we systematically evaluate state-of-the-art defenses (including perplexity-based detection and knowledge extension, among others), and the findings indicate that these measures are unable to counter “Broken Bags,” hence significantly enhancing the success rate of assaults on RAG systems.},
  keywords={Security;Large language models;Internet;Knowledge based systems;Databases;Computer crime;Information technology;Generators;Fake news;Writing;Information security;information retrieval;large language models;RAG attack;prompt injection attacks},
  doi={10.1109/ACCESS.2025.3582519},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11568284,
  author={Qassim, Qais Saif and Mazumder, Dilwar},
  booktitle={2026 International Conference on Sustainable Engineering and Digital Innovation (ICSEDI)}, 
  title={Study the Effectiveness of Existing Detection Mechanisms Against Prompt Injection in LLMs}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={Prompt injection attacks pose a significant security risk to large language models (LLMs) by allowing adversaries to manipulate model behavior through crafted inputs or external context. This paper presents a structured survey and comparative analysis of recent detection mechanisms for prompt injection attacks. Using a systematic review approach, relevant studies from 2023–2025 were identified, screened, and evaluated based on reported metrics, threat models, latency overhead, and deployment constraints. The survey categorizes detection approaches into syntactic, semantic, attention-based, and ensemble methods, highlighting their strengths, limitations, and practical trade-offs. Results show that recent semantic and ensemble detectors achieve high detection rates but often introduce additional latency, while attention-based methods offer deeper insight at the cost of requiring model internals. The paper concludes with best-practice recommendations and key research challenges for developing robust and scalable prompt injection detection strategies.},
  keywords={Modeling;Signal detection;Large language models;Printing;Security;Conferences;Syntactics;Detectors;Filtering;Filters;Prompt injection detection;large language models (LLMs);adversarial attacks;jailbreak attacks;semantic filtering;ensemble detection;LLM security evaluation},
  doi={10.1109/ICSEDI66420.2026.11568284},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{10866433,
  author={Maity, Sourav and Arora, Jatin},
  booktitle={2024 3rd Edition of IEEE Delhi Section Flagship Conference (DELCON)}, 
  title={The Colossal Defense: Security Challenges of Large Language Models}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Large Language Models (LLMs) have become increasingly popular because of their strong capabilities and abilities in multiple fields, such as text generation, language translation, image, video, audio, and other forms of output generation. The ability of the model to analyze a complex input prompt and provide relevant and simplified responses, depending on its usage, elevates its desirability. LLM not only has a transformative effect on the interaction between humans and models and the usage of the models in different situations but also has a significant drawback. Although the main benefits of LLM are apparent, there is a potential landmine of security threats accompanying its existence. Exposure to artificial intelligence increases the security risk throughout its design, development, infrastructure, and incorporation. Threat actors can exploit existing vulnerabilities to control models and execute uncontrollable and divisive actions. This study thoroughly examines the fundamental security problems of prompt injection, data poisoning, and sensitive information extraction. The attacks and defenses arising from these issues related to LLM are summarized. Finally, we suggest future research directions to secure LLMs.},
  keywords={Analytical models;Translation;Landmine detection;Prevention and mitigation;Large language models;Information retrieval;Natural language processing;Security;Natural Language Processing (NLP);Large Language Models (LLMs);ChatGPT;Llama;Gemini;Transformer},
  doi={10.1109/DELCON64804.2024.10866433},
  ISSN={},
  month={Nov},}@ARTICLE{11366235,
  author={Özbay, Recep and Çelebı, Merve and Yavanoğlu, Uraz},
  journal={IEEE Access}, 
  title={The AI-Cybersecurity Nexus: How Large Language Models are Reshaping Threat Intelligence and Digital Defense}, 
  year={2026},
  volume={14},
  number={},
  pages={15558-15587},
  abstract={As cybersecurity threats become more sophisticated, the integration of Large Language Models (LLMs) into defensive and analytical systems is transforming the field. This paper presents a PRISMA-guided bibliometric and thematic review of 149 studies published between 2015 and 2025, including 117 peer-reviewed journal and conference articles, examining publication trends and dominant research themes in LLM-enabled cybersecurity, organized around five research questions: (i) secure incorporation of LLMs into cyber threat intelligence workflows; (ii) hybrid architectures for privacy-preserving and real-time threat detection; (iii) LLM-enabled secure code remediation; (iv) adversarial misuse and dual-use risks; and (v) multi-layer defense strategies addressing prompt injection, model inversion, and data poisoning. Drawing on over 100 primary studies, the analysis highlights key trends, methodological innovations, and recurring vulnerabilities. Notable developments include decentralized trust-enhanced frameworks, context-aware remediation systems, and simulation-based red teaming. However, gaps persist in adversarial robustness, standardization of evaluation, and ethical governance. By mapping research across technical, operational, and policy dimensions, this review provides a structured basis for advancing trustworthy, resilient, and secure LLM deployments in high-stakes cybersecurity contexts.},
  keywords={Computer security;Reviews;Large language models;Bibliometrics;Market research;Ethics;Cyber threat intelligence;Retrieval augmented generation;Intrusion detection;Computer architecture;Cybersecurity;large language models;artificial intelligence;cyber threat intelligence},
  doi={10.1109/ACCESS.2026.3658308},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11395696,
  author={French, Edward and Aryal, Samyam and Singh, Aman and More, Komal Subhash and Hammond, Joe and Spanier, Mark},
  booktitle={2026 IEEE 5th International Conference on AI in Cybersecurity (ICAIC)}, 
  title={Zero-Shot Tokenizer Transfer for Targeted Attacks on Retrieval-Augmented Generation}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Retrieval-Augmented Generation (RAG) is widely used to improve the reliability of Large Language Models (LLMs) by grounding responses in external documents. However, RAG systems that ingest content from internet sources remain vulnerable to prompt injection attacks embedded within retrieved documents. We introduce ZBEAST, an adaptation of Beam Search-Based Adversarial Attacks (BEAST), designed to generate malicious documents specifically for RAG settings.We evaluate ZBEAST using an embedding-based heuristic built on BAAI-BGE-base-v1.5 and compare it against the state-of-the-art BEAST approach, which relies on an instruction-tuned LLM during search. ZBEAST replaces the generator’s tokenizer with that of the embedding model via Zero-Shot Tokenizer Transfer (ZeTT), enabling more effective adversarial document optimization. Our results show that ZBEAST scales reliably with beam size, while the baseline approach exhibits diminishing returns. We further demonstrate that ZBEAST-generated documents evade common filtering mechanisms used in RAG pipelines. These findings expose an underexplored vulnerability in RAG systems and suggest existing defenses may be insufficient against optimized adversarial document generation.},
  keywords={Vocabulary;Filtering;Grounding;Large language models;Retrieval augmented generation;Pipelines;Reliability;Computer security;Optimization;Surface treatment;Retrieval-Augmented Generation (RAG);Large Language Models (LLMs);Prompt injection attacks;Adversarial document generation;Beam search;LLM security},
  doi={10.1109/ICAIC67076.2026.11395696},
  ISSN={},
  month={Feb},}@ARTICLE{11570932,
  author={He, Yu and Chen, Yifei and Li, Yiming and Shao, Shuo and Qi, Leyi and Li, Boheng and Tao, Dacheng and Qin, Zhan},
  journal={IEEE Transactions on Information Forensics and Security}, 
  title={External Data Extraction Attacks Against Retrieval-Augmented Large Language Models}, 
  year={2026},
  volume={21},
  number={},
  pages={5864-5879},
  abstract={In recent years, retrieval-augmented generation (RAG) has emerged as a key paradigm for enhancing large language models (LLMs). By integrating externally retrieved information, RAG alleviates issues like outdated knowledge and, crucially, insufficient domain expertise. While effective, RAG introduces new risks of external data extraction attacks (EDEAs), where sensitive or copyrighted data in its knowledge base may be extracted verbatim by adversaries. These risks are particularly acute when RAG is used to customize specialized LLM applications with private knowledge bases. Despite initial studies exploring these risks, they often lack a formalized framework, robust attack performance, and comprehensive evaluation, leaving critical questions about real-world EDEA feasibility unanswered. In this paper, we present the first comprehensive study to formalize EDEAs against retrieval-augmented LLMs (RA-LLMs). We first formally define EDEAs and propose a unified framework decomposing their design into three components: extraction instruction, jailbreak operator, and retrieval trigger, under which prior attacks can be considered instances within our framework. Guided by this framework, we develop Secret: a Scalable and EffeCtive exteRnal data Extraction aTtack. Specifically, Secret incorporates (1) an adaptive optimization process using LLMs as optimizers to generate specialized jailbreak prompts for EDEAs, and (2) cluster-focused triggering, an adaptive strategy that alternates between global exploration and local exploitation to efficiently generate effective retrieval triggers. Extensive evaluations across 4 models (including 3 leading commercial LLMs) reveal that Secret significantly outperforms previous attacks, and is highly effective against all 16 tested RAG instances. Notably, Secret successfully extracts 35% of the data from RAG powered by Claude 3.7 Sonnet for the first time, whereas other attacks yield 0% extraction. Secret is also evaluated against potential defenses. Our findings call for urgent attention to this concerning yet largely overlooked emerging threat. Code is available here.},
  keywords={Modeling;Large language models;Retrieval augmented generation;Optimization;Erbium;Design methodology;Generative Pre-trained transformer;Distance measurement;Seeds (agriculture);Costing;Data extraction attacks;retrieval-augmented generation;large language models;trustworthy AI},
  doi={10.1109/TIFS.2026.3705326},
  ISSN={1556-6021},
  month={},}@INPROCEEDINGS{11648022,
  author={Abzal, Shuktaev and Bakhtiyar, Karabalin and Sultan, Orynbasar and Orlova, Olga and Korochkina, Elena Aleksandrovna and Borashova, Sholpan},
  booktitle={2026 International Conference on Cybersecurity, Digital Forensics, and AI Applications (ICCSDFAI)}, 
  title={Prompt Injection as the New SQL Injection: The Emergence of Attacks on AI Reasoning}, 
  year={2026},
  volume={},
  number={},
  pages={1009-1014},
  abstract={The introduction of Large Language Models (LLMs) into enterprise application pipelines represents both a blessing and a curse — the same versatility in following instructions that enables conversational assistants, code copilots, and autonomous agents also erodes the distinction between trusted instruction and untrusted data. In this paper, we argue that Prompt Injection (PI) follows SQL Injection (SQLi) as a fundamental class of attack on machine learning systems. While SQLi leveraged the absence of distinction between code and data in relation queries, PI leverages the absence of separation between system instruction and contextual data in natural language reasoning. The target domain has shifted from syntactic parsing to semantic interpretation, and classic defenses — escaping, parameterization, and whitelisting — are insufficient because natural language lacks a formal grammar to sanitize. We perform a narrative analysis of relevant peer-reviewed and preprint publications within the period 2023–2026, structured around three major dimensions: (i) the taxonomy of direct and indirect prompt injection attacks, (ii) the tactics that PI employs to overcome defenses provided by Reinforcement Learning from Human Feedback (RLHF) and guardrails, and (iii) the elevated threat landscape of agentic LLM applications with tool capabilities. We formalize the attacker’s strategic edge through a success rate model and offer comparative studies with SQLi, a severity scale for different modes of operation, and guidance for Chief Information Security Officers (CISOs). Our core thesis is that PI represents a paradigm shift, necessitating defense strategies beyond input sanitization toward workflow isolation and defensive LLMs.},
  keywords={Modeling;Large language models;Printing;Electronic mail;Tools;Aluminum;SQL injection;Artificial intelligence;Security;Codes;prompt injection;large language models;AI security;indirect prompt injection;agentic AI;adversarial machine learning;SQL injection analogy;defensive LLMs},
  doi={10.1109/ICCSDFAI70505.2026.11648022},
  ISSN={},
  month={June},}@INPROCEEDINGS{11364988,
  author={Yadav, Hritesh and Singh, Varun and Sharma, Kshitij},
  booktitle={2025 Seventh International Conference on Research in Computational Intelligence and Communication Networks (ICRCICN)}, 
  title={Adversial Prompt Injection in Large Language Models: Taxonomy, Exploits, and Mitigation Frameworks}, 
  year={2025},
  volume={},
  number={},
  pages={244-251},
  abstract={Adversarial prompt injection attacks pose a critical security threat to Large Language Models (LLMs) by manipulating model instructions through malicious inputs. In this paper, we present a comprehensive analysis of prompt injection vulnerabilities in LLMs. We develop a taxonomy encompassing direct, indirect, and multi-stage (chained) prompt injection attacks, detailing various exploits from simple “ignore previous instructions” overrides to covert multi-turn schemes. Through case studies and experimental evidence from recent literature, we demonstrate that even state-of-the-art models (e.g. GPT-4) can be consistently coerced into producing disallowed content, leaking confidential data, or executing unintended actions. We evaluate real-world risks via documented incidents (such as system prompt leaks and compromised LLM-integrated applications) and quantitative benchmarks, finding adversarial success rates exceeding $80 \%$ in many scenarios. To address these threats, we propose a defense-in-depth mitigation framework. Our framework combines prompt sanitization (input filtering and normalization), context isolation (segregating user input from system instructions and external data), and model hardening (enhanced alignment tuning and adversarial training) to substantially reduce injection success. We also outline practical defensive strategies including role-based privilege restriction, output validation, and continuous red-teaming. Finally, we discuss the broader implications of prompt injection for AI safety, ethics, and policy, and highlight directions for future work in building robust, secure LLM systems.},
  keywords={Training;Ethics;Filtering;Large language models;Prevention and mitigation;Taxonomy;Data models;Safety;Security;Tuning;Adversarial Prompt Injection;Large Language Models;Jailbreak Attacks;Taxonomy;LLM Security;Input Sanitization;Model Alignment;AI Safety},
  doi={10.1109/ICRCICN68210.2025.11364988},
  ISSN={2832-3645},
  month={Dec},}@INPROCEEDINGS{11645927,
  author={G.Kavitha and M, Hishaam Ahamed and R, Premnath},
  booktitle={2026 4th International Conference on Sustainable Computing and Smart Systems (ICSCSS)}, 
  title={SecureContext EDU: An Open Source University Assistant using Dual - LLM Architecture}, 
  year={2026},
  volume={},
  number={},
  pages={1531-1538},
  abstract={Chatbots powered by LLMs have become popular due to their scalability and instant reply feature. There can be many security issues associated with LLM-based chatbots, which emerge in the interaction between the LLM-based model and other software components. One major problem is that chatbots can be attacked using prompt injection, jailbreaks, and harmful queries. These attacks can change the chatbot behavior and may lead to wrong answers or leakage of sensitive information. This makes security very important in such systems. Existing methods improve the chatbot performance using techniques like modular design, Retrieval-Augmented Generation (RAG) and input filtering for security. However, most of these methods use a single model and do not have strong real-time protection, making them weak against advanced attacks. Hence, this work proposes a Dual-LLM architecture where security is handled as a separate component for protection against real time threats. A classification model is designed to check the user input queries using threat categories and a confidence score is evaluated to block the harmful inputs. Only safe queries are sent to the response model, which uses a controlled RAG system to generate accurate answers. The system is built as a step-by-step pipeline combining classification and response generation. The results show an accuracy of 90% in detecting threats which leads to reduction of unsafe responses.},
  keywords={Large language models;Modeling;Retrieval augmented generation;Security;Chatbots;Printing;Filtering;Filters;Conferences;Timing;Large Language Models;Chatbot Security;LLM Security Prompt Injection;Retrieval-Augmented Generation;Threat Detection;Suspicious pattern;Similarity search},
  doi={10.1109/ICSCSS69635.2026.11645927},
  ISSN={},
  month={July},}@INPROCEEDINGS{11461745,
  author={Zhang, Ziyang and Lin, Yuechen and An, Xuanxuan and Wan, Mingyang and Jiang, Caigui and Ding, Ning},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={ATTN-Defense: Attention-Guided Detection, Location and Removal for Indirect Prompt Injection}, 
  year={2026},
  volume={},
  number={},
  pages={17532-17536},
  abstract={Large language models (LLMs) have been severely affected by prompt injection attacks due to their strong instruction-following capabilities. Among these, indirect prompt injection (IPI) attacks pose broader security threats, as their injection occurs outside the model’s system boundary. Recent research efforts to defend against such attacks primarily focus on detection and prevention strategies. However, existing detection methods often degrade user experience by directly rejecting inputs after attack identification, while prevention approaches face inherent security and utility trade-off. To address this issue, this paper proposes Attn-Defense, an IPI removal method based on the LLM attention weight. Our approach extracts attention sequence features generated during input processing to achieve both detection and location of IPI attacks, followed by precise sentence-level removal operations. This enables accurate defense implementation without compromising the model’s ability to fulfill legitimate user instructions. Our method demonstrates consistent superiority across various models, jailbreak attacks, and datasets, achieving a 10.1% lower Attack Success Rate and 14.8% higher F1 Difference compared to existing approaches on two extended and augmented datasets. Furthermore, we validate the robustness of our framework and the effectiveness of its individual components through comprehensive experiments.},
  keywords={Feeds;Antennas;Wide area networks;Protocols;Communication systems;Computer networks;HTTP;Location awareness;Mobile communication;Pins;Large Language Models;Indirect Prompt Injection;Attention Mechanism},
  doi={10.1109/ICASSP55912.2026.11461745},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{10718584,
  author={Nair, Aiswarya and Vithayathil, Jose and Nambiar, Sandeep Prem and S, Snehasree and Murali, Shalu},
  booktitle={2024 Third International Conference on Electrical, Electronics, Information and Communication Technologies (ICEEICT)}, 
  title={Exploring the Essence of Prompt Tone: A Comparative Study of Large Language Model Security}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={Chatbots powered by Large Language Model(LLM) can be manipulated by malicious prompts, generating harmful content and biased responses which would raise security concerns. Growing dependence on chatbots demands robust security for ethical development and user trust, which makes the work relevant in today’s world. The motivation behind the work is to let the user have a safe experience with no negative responses being displayed while using the chatbot, which paved the way to arrive at the goal of developing a security filter that could be integrated into any LLM feature integrated application to mitigate the risk of having security vulnerabilities like prompt injection and jailbreaking, which could be achieved by converting malicious prompt into safer prompts by the method of eliminating negative sentiment phrases. The work focuses on building and implementing the security filters to popular in-production LLMs like Large Language Model Meta AI-2 (LLaMA2) and Generative Pre-trained Transformer – 3.5 turbo (GPT-3.5) to see how they handle against prompt injection and jailbreaking before and after the security filter being integrated. A large database of 200,000 prompts has been collected and preprocessed to train on a machine learning model using binary classification algorithm having 99.7% accuracy for classification of prompts into malicious or non-malicious and further checks are being done by breaking the prompt into smaller phrases and individually analyzing their compound sentiment score using Natural Language Toolkit (NLTK) Valence Aware Dictionary for Sentiment Reasoning (VADER) algorithm to detect and drop the negative sentiment phrases for the modification of the user prompt to eliminate the possibility of malicious prompt being passed to LLM. It is difficult to determine the sentiment of prompts in a detailed way and convert it into an efficient design that will perform well with models. Once this hurdle is overcome, chatbots will become even more reliable, trustworthy, and user-friendly tools, increasing the level of people’s trust in this technology, and establishing guidelines for how to use these resources in the most beneficial ways.},
  keywords={Sentiment analysis;Accuracy;Machine learning algorithms;Large language models;Natural languages;Chatbots;Transformers;Classification algorithms;Security;Reliability;Large Language Models;Manipulated;Malicious prompts;Biased responses;Robust security;Ethical development;User trust;Filters;Sentiment;Reliable;Trustworthy},
  doi={10.1109/ICEEICT61591.2024.10718584},
  ISSN={},
  month={July},}@INPROCEEDINGS{11366720,
  author={Sperlí, Giancarlo},
  booktitle={2025 International Symposium on Multimedia (ISM)}, 
  title={Exploring Privacy and Security Risks in LLMs: Data Leakage, Prompt Injection, and Membership Inference}, 
  year={2025},
  volume={},
  number={},
  pages={5-12},
  abstract={In this paper, we present an analysis of the dual role of Large Language Models (LLMs) in the context of multimedia security, examining how these models can both strengthen defensive capabilities and introduce new vulnerabilities within modern content ecosystems. As LLMs increasingly interface with multimedia workflows-ranging from text-image generation pipelines to cross-modal retrieval and content moderation-their susceptibility to attacks such as data leakage, prompt injection, and jailbreaks raises critical concerns for the integrity and trustworthiness of multimedia platforms. We focus our analysis on privacy-oriented threats, including model inversion and membership inference, and discuss their implications for systems that process or generate multimedia content. Building on this risk landscape, we outline principles for improving the robustness and resilience of LLM-driven multimedia applications, highlighting strategies suited to in-the-wild threat scenarios. Indeed, we explore the constructive application of LLMs within cybersecurity frameworks, such as the Cyber Kill Chain, demonstrating how these models can be leveraged for threat detection, risk assessment, and automated defensive operations.},
  keywords={Analytical models;Biological system modeling;Large language models;Multimedia systems;Pipelines;Ecosystems;Threat assessment;Robustness;Risk management;Resilience;Large Language Models;Security Risks;Model Inversion;Membership Inference},
  doi={10.1109/ISM66958.2025.00011},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11628499,
  author={Sohn, Insoo and Cho, Juphil},
  booktitle={2026 Seventeenth International Conference on Ubiquitous and Future Networks (ICUFN)}, 
  title={Study on Cybersecurity for LLM Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1078-1080},
  abstract={Large Language Model (LLM) systems are rapidly emerging as a core technology for next-generation intelligent applications by enabling advanced natural language understanding, multi-step reasoning, and seamless integration with external tools and data sources. However, their probabilistic nature and complex, multi-component architectures introduce new security vulnerabilities, including prompt injection, jailbreak attacks, data poisoning, backdoor insertion, and information leakage, which can compromise system integrity and decision-making processes.},
  keywords={Modeling;Large language models;Printing;Computer security;Cognition;Cognitive systems;Cyber Security;LLM;AI agent},
  doi={10.1109/ICUFN69619.2026.11628499},
  ISSN={2165-8536},
  month={July},}@INPROCEEDINGS{10827351,
  author={Kim, Minjae and Kwon, Taehyeong and Shim, Kibeom and Kim, Beonghoon},
  booktitle={2024 15th International Conference on Information and Communication Technology Convergence (ICTC)}, 
  title={Protection of LLM Environment Using Prompt Security}, 
  year={2024},
  volume={},
  number={},
  pages={1715-1719},
  abstract={The emergence of generative AI has also brought significant attention to large language models (LLMs). LLMs are a type of generative AI that can understand users' commands and respond accordingly by generating natural human language text. However, such advancements in LLM technology have also been accompanied by an increase in hostile attempts to use the technology for malicious attacks. For example, some may execute a jailbreak on an LLM, allowing it to generate malicious content, and others can use LLMs to generate vulnerability exploit codes, taking advantage of their powerful capabilities to attempt malicious attacks. Furthermore, there are increasing numbers of cases reported where, once inadvertently entered, personally identifiable information (PII) is used to train LLMs without consent. Preventing the malicious use of LLMs and their unauthorized use of PII requires thoroughly scanning their inputs and outputs. Specifically, LLMs' inputs and outputs need to be checked for the presence of PII, malicious codes, malicious URLs, and commands to execute prompt injections. This paper presents a comprehensive description of the LLM prompt detection system (LPDS) designed to detect the presence of PII, malicious codes, malicious URLs, and prompt injection commands in LLMs' inputs and outputs. The effectiveness of the LPDS in detecting LLMs' unauthorized use of PII and LLM-based malicious attacks is also assessed.},
  keywords={Data privacy;Codes;Generative AI;Large language models;Malware;Information and communication technology;Security;Protection;Identification of persons;Convergence;LLM;Privacy Protection;AI Security;Prompt Detection},
  doi={10.1109/ICTC62082.2024.10827351},
  ISSN={2162-1241},
  month={Oct},}@INPROCEEDINGS{11594513,
  author={Hasan, Najmul and BusiReddyGari, Prashanth and Zhao, Haitao and Ren, Yihao and Xu, Jinsheng and Zhang, Shaohu},
  booktitle={2026 56th Annual IEEE International Conference on Dependable Systems and Networks Workshops (DSN-W)}, 
  title={LLM-PEA: Leveraging Large Language Models Against Phishing Email Attacks}, 
  year={2026},
  volume={},
  number={},
  pages={114-120},
  abstract={Large Language Models (LLMs) are increasingly deployed inside email-security pipelines, raising the question of how they behave not just on benign messages but on adversarially crafted phishing content. We present LLM-PEA, an evaluation framework that probes GPT-4o, Claude Sonnet 4, and Grok-3 under three prompting strategies (structured, zero-shot, chain-of-thought) across a clean baseline and three attack dimensions: adversarial rephrasing, prompt injection, and cross-lingual translation. The three models attain 95%, 94%, and 88% accuracy on the balanced baseline, but susceptibility depends on the attack. Adversarial rephrasing of 189 matched phishing samples yields attack success rates of 4.2% (GPT-4o), 12.7% (Claude Sonnet 4), and 0% (Grok-3); a separate single-template instruction-override on 1,000 original emails yields 4.2%, 1.3%, and 12.3% respectively—a different susceptibility ordering. Applying six injection templates to the same 189 rephrased samples yields 1.1%, 2.9%, and 1.6%, together with the adversarial-only results covering three of four cells of a 2×2 factorial on matched inputs. The sharpest degradation is cross-lingual: Claude Sonnet 4’s false-positive rate rises from 2.4% in English to a mean of 24.1% across Bangla, Chinese, and Hindi (a +904% relative increase), peaking at 30.6% in Bangla and erasing its baseline advantage. All runs use temperature 0; adversarial rephrases are generated by GPT-4o, itself one of the evaluated detectors. No single model is uniformly robust across these three attack dimensions.},
  keywords={Electronic mail;Modeling;Phishing;Multilingual;Signal detection;Large language models;Printing;Generative Pre-trained transformer;Poles and zeros;Conferences;Phishing email attack;LLM;prompt injection},
  doi={10.1109/DSN-W70714.2026.00038},
  ISSN={2325-6664},
  month={June},}@ARTICLE{11563638,
  author={Yang, Yuchen and Li, Yiming and Yao, Hongwei and Yang, Bingrun and He, Yiling and Zhang, Tianwei and Tao, Dacheng and Qin, Zhan},
  journal={IEEE Transactions on Dependable and Secure Computing}, 
  title={ShadowCode: Towards (Automatic) External Prompt Injection Attack against Code LLMs}, 
  year={2026},
  volume={},
  number={},
  pages={1-13},
  abstract={Recent advancements have led to the widespread adoption of code-oriented large language models (Code LLMs) for programming tasks. Despite their success in deployment, their security research is left far behind. This paper introduces a new attack paradigm: (automatic) external prompt injection against Code LLMs, where attackers generate concise, non-functional induced perturbations and inject them within a victim's code context. These induced perturbations can be disseminated through commonly used dependencies (e.g., packages or RAG's knowledge base), manipulating Code LLMs to achieve malicious objectives during the code completion process. Compared to existing attacks, this method does not necessitate control over the model's training process, unlike backdoor attacks, and can achieve specific malicious objectives that are challenging for adversarial attacks. Furthermore, we propose ShadowCode, a simple yet effective method that automatically generates induced perturbations based on code simulation to achieve effective and stealthy external prompt injection. ShadowCode designs its perturbation optimization objectives by simulating the victim's code contexts and employs a greedy optimization approach with two enhancement modules: forward reasoning enhancement and keyword-based perturbation design. We evaluate our method across 13 distinct malicious objectives, generating 31 threat cases spanning three popular programming languages. Our results demonstrate that ShadowCode successfully attacks three representative open-source Code LLMs (achieving up to a 97.9% attack success rate) and two mainstream commercial Code LLM-integrated applications (with over 90% attack success rate) across all threat cases, using only a 12-token non-functional induced perturbation. The code is available at https://github.com/LianPing-cyber/ShadowCodeEPI.},
  keywords={Codes;Modeling;Automatic speech recognition;Large language models;Optimization;Design methodology;Context;Python;Java;Training;Code-oriented Large Language Models;Prompt Injection Attack;Code Security;AI Security},
  doi={10.1109/TDSC.2026.3703498},
  ISSN={1941-0018},
  month={},}@INPROCEEDINGS{11536987,
  author={Güler, Songül Erdem and Aydın, Muhammed Ali},
  booktitle={2026 8th International Congress on Human-Computer Interaction, Optimization and Robotic Applications (ICHORA)}, 
  title={Visual and Structural Prompt Injection in Medical Rag Systems: a Comparative Robustness Analysis}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={The integration process of Large Language Models (LLM) into the healthcare ecosystem is demonstrating a shift from cloud-based systems towards local (on-premise) and opensource Retrieval-Augmented Generation (RAG) architectures due to data privacy regulations such as GDPR and HIPAA. However, these architectures harbor critical vulnerabilities against indirect prompt injection attacks that target parsing gaps in the document processing layer and manipulate model behavior. In this study, the resilience of 6 distinct local models, including Llama-3, Gemma-3, and Meditron, against visual and structural injection vectors has been quantitatively and qualitatively analyzed. Within the scope of the study, visual-semantic mismatch (white-text), micro-typography, and metadata manipulation techniques were tested on $\mathbf{1 0 0}$ original clinical discharge summaries generated via Google Gemini 2.5 Flash and dynamic prompt engineering. In the threat model, the objective was to have the model diagnose a false septic shock and prescribe meropenem, a high-risk antibiotic with no clinical indication, by suppressing a stable patient profile (context suppression). Analyses involving a total of 2,400 unique experimental steps revealed that standard RAG parsers failed to detect visual payloads hidden from human perception, and the models could be manipulated with an average Attack Success Rate (ASR) of 47.78 %. The most significant finding of the study is the security asymmetry between models. While the generalpurpose Gemma-3 model exhibited the highest vulnerability with 96.33 % ASR, the Meditron-7B model, trained specifically for the medical domain, demonstrated superior resistance with 8.67 % ASR. The results indicate that domain-specific training establishes a natural security shield (inherent robustness) against injection attacks. On the other hand, the use of general-purpose models in clinical decision support processes without visual sanitization mechanisms poses serious risks in terms of patient safety.},
  keywords={Modeling;Printing;Visualization;Retrieval augmented generation;Security;Architecture;Computer architecture;Vectors;Large language models;Antibiotics;Indirect Prompt Injection;Medical RAG Systems;Healthcare AI Security;Adversarial Robustness;LLM Security;On-Premise LLMs;Visual Injection Attacks;Clinical Decision Support Systems},
  doi={10.1109/ICHORA69329.2026.11536987},
  ISSN={2996-4393},
  month={May},}@INPROCEEDINGS{11582504,
  author={Zou, Xide and Wang, Dongyu and Tang, Chaoxing and Zhang, Lan},
  booktitle={2026 29th International Conference on Computer Supported Cooperative Work in Design (CSCWD)}, 
  title={GRED: Gradual Jailbreak Attack via Relational Decomposition on Large Language Model}, 
  year={2026},
  volume={},
  number={},
  pages={2923-2928},
  abstract={Jailbreak attack is effective in verifying the security of large language models (LLMs). With the development of LLMs, an increasing number of jailbreak attack methods have been proposed to explore the security boundaries of LLMs. Most existing methods employ more universal black-box approaches, that is, using carefully constructed prompts to bypass the security mechanisms of LLMs, enabling the models to answer malicious questions. Previous methods have attempted techniques such as specific templates and semantic obfuscation to transform the original questions into transition questions and achieve jailbreak attacks through multi-round dialogues. However, they lack to guarantee of semantic coherence and purpose consistency throughout the process. Our method uses an attack LLM, starts from the semantic perspective, extracting multiple entity-relation-entity triples from the original question and generating subquestions based on these triples. By sending these sub-questions to the target model, we create a context with background knowledge related to the original question. Then, we summarize the context and gradually generate transition questions with reference to the semantics of the original question, guiding the target LLM to answer the original question, thus completing the jailbreak attack. We call this jailbreak attack GRED (Gradual jailbreak attack based on Relational Decomposition). We conducted extensive experiments on AdvBench, and the results demonstrate that our method achieves the state-of-the-art performance.Warning: This paper contains malicious content from some model outputs.},
  keywords={Modeling;Large language models;Printing;Modules (abstract algebra);Triples (Data structure);Aluminum;Optimization;Glass box;Security;Context;large language model;jailbreak attack;security},
  doi={10.1109/CSCWD68734.2026.11582504},
  ISSN={2768-1904},
  month={May},}@INPROCEEDINGS{11631471,
  author={Abdelhamid, Sherif E. and Aly, Mona M.},
  booktitle={2026 7th International Conference on Artificial Intelligence, Robotics, and Control (AIRC)}, 
  title={LLM Shield: Detecting and Mitigating Adversarial Prompt Attacks on Large Language Models Using Machine Learning}, 
  year={2026},
  volume={},
  number={},
  pages={307-314},
  abstract={Large Language Models (LLMs) have transformed multiple domains, including education, cybersecurity, healthcare, robotics, and the Internet of Things (IoT), by enabling natural communication, contextual understanding, and intelligent automation. As these models are increasingly embedded into many software applications, robotics, and connected systems, ensuring their robustness and trustworthiness has become critical. However, most existing research focuses on LLM performance, optimization, and applications, with limited attention to security vulnerabilities and adversarial threats. Emerging attacks such as jailbreaking, prompt injection, and multi-turn manipulation can override safety mechanisms and induce unintended or harmful behavior, posing serious risks to users and systems that rely on LLMs. This study addresses this gap by developing and analyzing a comprehensive dataset of different prompts, including safe and adversarial examples, collaboratively generated mostly by human experts and some by state-of-the-art LLMs such as GPT-4o and Claude 3.5 Sonnet. Using TF-IDF feature extraction and multiple machine learning classifiers, including K-Nearest Neighbors, Decision Tree, Logistic Regression, Random Forest, Naïve Bayes, Support Vector Machine (SVM), and an ensemble model, we trained our system to automatically detect adversarial intent in LLM prompts. The SVM model achieved the best performance with 99.85% accuracy, 99.87% F1-score, 99.84% Precision, and 99.91% Recall, indicating excellent discriminatory capability. Complementary linguistic, sentiment, and structural analyses revealed that adversarial prompts typically exhibit longer sentence structures, lower lexical diversity, and negative or neutral sentiment, along with manipulative n-gram patterns designed to bypass restrictions. To translate these findings into practice, we designed and implemented LLM Shield, a real-time web platform that monitors, classifies, and alerts users about potential adversarial prompts across connected systems and APIs. The platform visualizes threat types, injection frequencies, and system health through an interactive dashboard. Additionally, LLM Shield utilizes Claude 3.5 Sonnet for linguistic and contextual breakdowns and analyses of detected adversarial prompts. Together, this research contributes an empirical and practical foundation for detecting, mitigating, and monitoring adversarial attacks on LLMs, advancing the development of secure and resilient AI-driven ecosystems.},
  keywords={Modeling;Large language models;Labeling;Support vector machines;Machine learning;Machining;Printing;Real-time systems;Training;Signal detection;Large Language Models (LLMs);Adversarial Attacks;Prompt Injection;Machine Learning;Cybersecurity},
  doi={10.1109/AIRC69745.2026.11631471},
  ISSN={},
  month={April},}@INPROCEEDINGS{11632629,
  author={Ersoy, Pınar and Erşahin, Mustafa},
  booktitle={2026 6th International Conference on Electrical, Computer and Energy Technologies (ICECET)}, 
  title={Secure MCP-Based Tool-Augmented RAG for Industrial IoT Diagnostics Under Indirect Prompt Injection, Retrieval Poisoning, and Modality Outages}, 
  year={2026},
  volume={},
  number={},
  pages={1-9},
  abstract={Industrial IoT diagnostics require integrating diverse evidence streams, such as telemetry, event logs, configuration snapshots, and operational knowledge bases, while adhering to safety and security requirements. Tool-augmented retrieval-augmented generation (RAG) facilitates this integration by merging retrieval processes with the regulated use of tools. In Operational Technology (OT) settings, two primary risks associated with deployment are: (i) indirect prompt injection through retrieved materials or tool outputs, which can disrupt the model context and result in behavior that contradicts established policies; and (ii) limited visibility caused by tool failures, gaps in telemetry, and delayed logging, which diminishes evidential support and raises the chances of producing unsubstantiated outputs. This paper examines a protocol-aligned architecture that integrates MCP-exposed tools within a defense-in-depth RAG pipeline. The approach employs hybrid retrieval and reranking, instruction-aware content filtering, typed least-privilege tool mediation with audit logging, evidence-bound generation with citation enforcement, and outage-aware abstention policies. An OT-oriented stress-test suite is defined based on prior RAG security evaluations, and utility, security, and degradation metrics are reported using a proprietary multi-site IIoT dataset. The findings indicate the importance of treating retrieval and tool interfaces as distinct security boundaries in industrial diagnostic assistants.},
  keywords={Modeling;Retrieval augmented generation;Tools;Printing;Security;Toxicology;Large language models;Context;Protocols;Calibration;Industrial IoT;retrieval-augmented generation;tool-augmented LLMs;Model Context Protocol;indirect prompt injection;retrieval poisoning},
  doi={10.1109/ICECET65726.2026.11632629},
  ISSN={},
  month={July},}@INPROCEEDINGS{11582854,
  author={Shanid, Mohammed and Prasad, Gaurav and Bawgi, Veeresh and Gowda, Srujan},
  booktitle={2026 IEEE International Conference on Emerging Synergy Science and Technology (ICESST)}, 
  title={MedRAGShield: A Three-Tier Defense Framework Against Document Poisoning and Adversarial Attacks in Medical Retrieval-Augmented Generation Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Retrieval-Augmented Generation (RAG) systems deployed in medical question-answering applications introduce novel attack surfaces not addressed by existing large language model (LLM) safety mechanisms. This research presents MedRAGShield, a three-tier middleware defense framework designed to detect and neutralise document injection poisoning, hallucination exploitation, prompt injection, and jailbreak attacks against medical RAG pipelines. The proposed system operates across three independently togglable defense modes: a baseline mode with no filtering, a confidence and hallucination gating mode, and a full defense mode augmenting the prior modes with Domain-Aware Sanity Check (DASC) rules that apply medical ontological constraints to generated outputs. This experiment constructs a 40-query adversarial evaluation dataset spanning four attack categories and conducts an empirical evaluation on a clinical pharmacology RAG system built on Llama 3.2:3B and ChromaDB. Results demonstrate that confidence-based defenses alone are insufficient against high-similarity document poisoning attacks, which achieve retrieval confidence exceeding 0.85 while delivering clinically dangerous misinformation, a phenomenon this research terms the high-confidence poisoning paradox. The full MedRAGShield defense reduces Attack Success Rate (ASR) from 13.2% (undefended) to 0.0%, with block rate increasing from 0% to 62.5%, while maintaining sub-second query latency. This work establishes a reproducible evaluation methodology for medical RAG security and identifies domain-specific semantic rule checking as a critical missing layer in current LLM defense architectures. Code, dataset, and defense rules are openly available.},
  keywords={Modeling;Retrieval augmented generation;Large language models;Toxicology;Drugs;Printing;Safety;Automatic speech recognition;Drug interactions;Middleware;retrieval-augmented generation;medical AI safety;document poisoning;adversarial machine learning;large language models;prompt injection;hallucination detection;drugdrug interaction safety},
  doi={10.1109/ICESST69086.2026.11582854},
  ISSN={},
  month={April},}@INPROCEEDINGS{11588474,
  author={S, Uthayashangar and A, Devesh and D, Hari Pragash and S, Dharshini and S, Yukthasri},
  booktitle={2026 International Conference on System, Computation, Automation and Networking (ICSCAN)}, 
  title={Forensic LLM-Trace: Interpretable Multi-Agent AI Forensic Architecture for Prompt Injection Investigation}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={The increasing deployment of autonomous Large Language Model agents in enterprise platforms, cloud services, and intelligent automation systems has introduced new cybersecurity challenges associated with prompt injection, unauthorized reasoning manipulation, and chained-agent compromise. Existing digital forensic methodologies are ineffective in reconstructing distributed AI-agent execution behavior because modern LLM ecosystems generate fragmented contextual traces, temporary reasoning states, and decentralized interaction logs. Current forensic systems primarily analyze static operating-system artifacts and network events, making them unsuitable for AI-native infrastructures. To address these limitations, this paper proposes Forensic LLM-Trace, an interpretable forensic architecture designed for hostile-operation reconstruction within multi-agent LLM ecosystems. The proposed approach integrates semantic artifact normalization, confidence-oriented attribution evaluation, graph-driven relationship reconstruction, and automated threat-intelligence reporting into a unified analytical pipeline. Neo4j-based interaction mapping is employed to visualize malicious prompt propagation between interconnected agents, APIs, and memory contexts. Additionally, transformer-assisted entity extraction improves contextual forensic interpretation by identifying hidden hostile instruction transitions embedded within communication chains. Experimental evaluation using simulated prompt-manipulation scenarios demonstrates improved timeline reconstruction precision, reduced false attribution, and enhanced forensic transparency compared with conventional log-oriented examination systems. The proposed architecture establishes a scalable investigative foundation for future AI-native digital forensic environments.},
  keywords={Forensics;Artificial intelligence;Architecture;Computer architecture;Cognition;Cognitive systems;Large language models;Printing;Ecosystems;Memory;LLM Forensics;Prompt Manipulation;AI-Agent Investigation;Digital Forensic Intelligence;Multi-Agent Security;Semantic Reconstruction;Threat Attribution;Graph-Based Analysis},
  doi={10.1109/ICSCAN66520.2026.11588474},
  ISSN={},
  month={June},}@INPROCEEDINGS{11208433,
  author={Özçam, Berkay and Solmaz, Berksu Ant and Amasyali, Mehmet Fatih and Kara, Mustafa and Aydın, Muhammed Ali and Balık, Hasan Hüseyin},
  booktitle={2025 Innovations in Intelligent Systems and Applications Conference (ASYU)}, 
  title={Prompt Injection Attack Detection with Machine Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-1},
  abstract={The introduction of large language models into our lives has created a revolution, allowing artificial intelligence to be easily used and accessible by everyone. With this opportunity, large language models are now used in every step of our lives, from education to economy, agriculture to health, and are on their way to becoming a part of us. This widespread use of large language models attracts the attention of malicious people and brings with it security problems and concerns. Despite this rapid growth and expanding attack surface area, the precautions taken by model publishers are inadequate. This study focuses on the current inadequacy in the relevant field and presents a detection suggestion against 'Prompt Injection' attacks, one of the most commonly used attacks against large language models. Within this scope, 10 different models developed using various approaches were used to analyze the input text and classify whether or not it contained attacks. The tests showed that the most successful results were obtained with the BERT-based model, achieving 88 % accuracy and an F1 score of 87 %. The most important feature that distinguishes the study from existing studies is that, unlike existing detection models, it has the ability to detect in Turkish.},
  keywords={Large language models;Logistics;Reactive power;Machine learning;Logistic regression;Transformers;Support vector machines;Social networking (online);Security;Natural language processing;large language model;machine learning;prompt injection;natural language processing},
  doi={10.1109/ASYU67174.2025.11208433},
  ISSN={2770-7946},
  month={Sep.},}@INPROCEEDINGS{11391064,
  author={Elkin, Stanislav and Anosov, Kirill and Kiselev, Dmitry},
  booktitle={2025 3rd International Conference on Foundation and Large Language Models (FLLM)}, 
  title={Retrieval-Augmented Reasoning for Offensive Security: Towards Robust LLM Agents for CTF Automation}, 
  year={2025},
  volume={},
  number={},
  pages={272-280},
  abstract={We present a retrieval-first reasoning-agent architecture for automating offensive cybersecurity tasks in the Capture The Flag (CTF) format. Our core hypothesis is that domain-specific contextual retrieval can stabilize large language model (LLM) reasoning under adversarial, multi-step challenges. To test this, we construct a bespoke retrieval corpus from scratch—excluding benchmark leakage—covering key CTF domains such as binary exploitation, reverse engineering, cryptography, and web vulnerabilities. Using FAISS indexing and Retrieval-Augmented Generation (RAG), our agent integrates this corpus with GPT-4o via a lightweight, tool-agnostic pipeline. Evaluated on NYU CTF benchmark [2], the RAG-enhanced agent achieves a 57.1% improvement in task completion over the vanilla GPT-4o baseline. Unlike prior work, which often depends on fragile tool orchestration, we demonstrate that focused retrieval alone significantly improves reasoning stability, reduces hallucinations, and enhances task-solving accuracy. Our threat model also considers prompt injection and contextual ambiguity, underlining the need for interpretable, corpus-grounded architectures in offensive reasoning.},
  keywords={Threat modeling;Automation;Accuracy;Large language models;Scalability;Pipelines;Benchmark testing;Cognition;Stability analysis;Computer security;Cybersecurity;CTF;Reasoning Agents;Language Models;RAG;Tool-Augmented LLMs},
  doi={10.1109/FLLM67465.2025.11391064},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11518808,
  author={Kraidia, Insaf and Qaddara, Iyas and Al-Shafi, Nida and Hiari, Mohammad O. and Alzubaidi, Rania and Benlecheb, Amira},
  booktitle={2026 1st International Conference on Emerging Technologies and Engineering Systems (ICETES)}, 
  title={RAG-Induced Failures in Multi-Agent Large Language Model Debate}, 
  year={2026},
  volume={},
  number={},
  pages={326-331},
  abstract={Multi-agent Large Language Model (LLM) systems based on collaborative debate have been proposed to improve reasoning accuracy and robustness by aggregating diverse reasoning trajectories. However, most debate frameworks implicitly assume that all participating agents behave honestly. This paper demonstrates that this assumption fails under a realistic threat model in which a single malicious agent manipulates Retrieval-Augmented Generation (RAG) to selectively retrieve externally sourced evidence that plausibly supports an incorrect conclusion. Unlike prior work that relies on prompt injection or complex persuasion pipelines, the proposed attack requires only retrieval control and uses legitimate documents whose relevance is strategically overstated or misinterpreted. Experiments on TruthfulQA, MMLU, MedMCQA, and SCALR show that RAG-based attacks can reduce majority-vote accuracy by up to 38% while increasing group consensus around false answers. These results indicate that retrieval-often used to improve factual grounding-can instead amplify misinformation when adversarially controlled, motivating stronger verification and trust calibration in multi-agent LLM systems.},
  keywords={Modeling;Accuracy;Large language models;Retrieval augmented generation;Cognition;Cognitive systems;Printing;Equations;Aluminum;Degradation;Multi-Agent LLMs;Retrieval-Augmented Generation;Adversarial Debate;Collaborative Reasoning;LLM Safety},
  doi={10.1109/ICETES68504.2026.11518808},
  ISSN={},
  month={April},}@INPROCEEDINGS{11476245,
  author={Lopez-Juarez, Ismael and Lopez-Valadez, Kieran I and Castillo-Barrientos, Luis A.},
  booktitle={2025 IEEE CHILEAN Conference on Electrical, Electronics Engineering, Information and Communication Technologies (CHILECON)}, 
  title={Zero-Shot Robotic Control via Custom LLM Agents: A Lightweight Framework for Embodied Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={This work presents an AI-powered framework for autonomous robot control using a custom large language model (LLM) agent built with DeepSeek. By leveraging document-based prompt injection, the system incorporates domain-specific knowl-edge—such as robot specifications and API documentation—into the LLM to enable zero-shot Python code generation. The agent extracts and executes code in real time to control a myCobot 280 Pi robotic arm, operating entirely offline without persistent cloud connectivity. A modular pipeline automates the workflow from natural language input to subprocess-based code execution. Experimental results demonstrate the agent's ability to interpret high-level voice or text instructions and translate them into functional robot behaviors. Although the current implementation is focused on motion tasks without sensory feedback, the architecture lays the groundwork for future integration of multimodal perception and closed-loop control. This study highlights the potential of lightweight, locally-deployable LLMs for intuitive human-robot interaction and rapid prototyping in edge robotics.},
  keywords={Feedback;Circuits;Graphical user interfaces;Communications technology;Product development;Information and communication technology;Radio access networks;Regional area networks;Protocols;Electronic mail;Large Language Models;Zero-Shot Learning;Robot Control;myCobot;DeepSeek;Edge AI;Prompt Engineering},
  doi={10.1109/CHILECON66915.2025.11476245},
  ISSN={2832-1537},
  month={Oct},}@INPROCEEDINGS{10903912,
  author={Rathod, Vishal and Nabavirazavi, Seyedsina and Zad, Samira and Iyengar, Sundararaja Sitharama},
  booktitle={2025 IEEE 15th Annual Computing and Communication Workshop and Conference (CCWC)}, 
  title={Privacy and Security Challenges in Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={00746-00752},
  abstract={Large Language Models (LLMs) are at the forefront of artificial intelligence advancements, demonstrating exceptional capabilities in natural language understanding and generation across diverse domains such as healthcare, finance, and customer service. However, their deployment introduces substantial secu-rity and privacy risks, including prompt injection, data leakage, and unauthorized data disclosures. These vulnerabilities highlight the need for robust frameworks to safeguard sensitive data and prevent misuse. This paper provides a comprehensive analysis of the security and privacy challenges in LLMs, examines existing mitigation strategies such as intelligent LLM firewalls, differen-tial privacy, and OW ASP-based security principles, and discusses future directions for ethical and secure LLM deployment. By addressing these challenges in detail, we identify gaps in current practices and propose a roadmap for the secure and responsible deployment of LLMs in high-stakes applications. Our findings underscore the importance of tailored security frameworks and privacy-preserving techniques to ensure the ethical and reliable use of LLMs in sensitive environments. Additionally, this pa-per emphasizes the significance of a human-in-the-loop (HITL) approach to ensure accountability and accuracy, particularly in critical domains. The discussion extends to emerging technologies such as retrieval-augmented generation (RAG) and adaptive threat detection systems, which hold promise for enhancing the security and ethical deployment of LLMs.},
  keywords={Industries;Ethics;Privacy;Technological innovation;Firewalls (computing);Large language models;Computational modeling;Medical services;Threat assessment;Security;Artificial intelligence;Natural language processing;Large language models (LLM);Privacy;OWASP;Data Protection;AI Ethics;Firewall;Threat Modeling;Data Leakage;Ethical Bias Mitigation;Federated Learning;Healthcare AI;Human-in-the-Loop (HITL);Adaptive Security Frameworks;Privacy-Preserving Computation},
  doi={10.1109/CCWC62904.2025.10903912},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11604866,
  author={John, Ankita and Thamilarasu, Geethapriya},
  booktitle={2026 International Conference on Smart Applications, Communications and Networking (SmartNets)}, 
  title={Veritas: Dynamic Evaluation Framework for Rag Systems' Defense Against Prompt Injection Attacks}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Prompt injection poses a significant security risk to Retrieval-Augmented Generation (RAG) systems, enabling adversaries to embed malicious instructions within retrieved documents and hijack model behavior to exfiltrate sensitive information or execute unauthorized actions. This work presents a modular dynamic evaluation environment for systematically testing and comparing defense mechanisms against prompt injection attacks in RAG architectures. The framework simulates diverse injection scenarios targeting the retrieval pipeline, integrates optional mitigation strategies such as input filtering, prompt rewriting, and retrieval-aware defenses, and automatically logs model behavior to assess attack success. By varying retrieval parameters and quantifying defense robustness across diverse attack verticals and RAG configurations, the system enables reproducible and scalable evaluation of prompt injection resilience. The results highlight strengths and weaknesses of existing defenses in RAGspecific threat models and establish a foundation for standardized benchmarking of defense mechanisms in knowledge-grounded generative AI systems.},
  keywords={Retrieval augmented generation;Modeling;Optimization;Automatic speech recognition;Filtering;Large language models;Printing;Security;Filters;Tools;Prompt Injection;Evaluation;Security;RAG},
  doi={10.1109/SmartNets69662.2026.11604866},
  ISSN={2837-4940},
  month={July},}@INPROCEEDINGS{11636629,
  author={Mittal, Anshika and Kaur, Jaspreet and Chatterjee, Tarun Kumar},
  booktitle={2026 International Conference on Sustainable Engineering and Technology Innovations (ICSETI)}, 
  title={A Systematic Review of Jailbreaking Attacks and Defense Mechanisms in Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={507-512},
  abstract={This paper is a systematic review of the current situation regarding jailbreaking attacks and defensive against Large Language Models (LLMs). The LLMs have performed very well in the field of software engineering and conversational systems. Nevertheless, regardless of such impressive capabilities, there are general weak points, namely, to prompt injection and jailbreaking attacks. Jailbreaking is the tactically designed control of input prompts to evade safety guardrails to cause adversarial or prohibited outputs. The current paper is proposing a comprehensive taxonomy that splits attacks into target visibility: White-Box, attack seeks the exploitation of inner architecture on the basis of gradient or logit exposure, and Black-Box, where the mechanisms of attack are grounded in prompt engineering and linguistic obfuscation. There are also the division of defense methods to Prompt-Level (pre-processing filtering) and Model-Level (intrinsic safety alignment). The findings describe the mathematical concepts of optimization-based attacks, including Greedy Coordinate Gradient (GCG) and inroads into novel deep learning-based advanced alignment models, including Deep Refusal. This proceeds on the background of emphasizing an everlasting adversarial arms race enabled by the current trade-off between robustly helpful and ultra-safe standards of the LLM and further underscoring the ultimate significance of defenses that are robustly anti-out-of-distribution (OOD) attack vectors.},
  keywords={Modeling;Large language models;Safety;Glass box;Printing;Retrieval augmented generation;Optimization;Filtering;Security;Equations;LLM;Out-of-Distribution;Jailbreaking Attacks;Defense Mechanisms},
  doi={10.1109/ICSETI67678.2026.11636629},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{10863664,
  author={Rahman, Md Abdur and Shahriar, Hossain and Wu, Fan and Cuzzocrea, Alfredo},
  booktitle={2024 2nd International Conference on Artificial Intelligence, Blockchain, and Internet of Things (AIBThings)}, 
  title={Applying Pre-trained Multilingual BERT in Embeddings for Improved Malicious Prompt Injection Attacks Detection}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={Large language models (LLMs) are renowned for their exceptional capabilities, and applying to a wide range of applications. However, this widespread use brings significant vulnerabilities. Also, it is well observed that there are huge gap which lies in the need for effective detection and mitigation strategies against malicious prompt injection attacks in large language models, as current approaches may not adequately address the complexity and evolving nature of these vulnerabilities in real-world applications. Therefore, this work focuses the impact of malicious prompt injection attacks which is one of most dangerous vulnerability on real LLMs applications. It examines to apply various BERT (Bidirectional Encoder Representations from Transformers) like multilingual BERT, DistilBert for classifying malicious prompts from legitimate prompts. Also, we observed how tokenizing the prompt texts and generating embeddings using multilingual BERT contributes to improve the performance of various machine learning methods: Gaussian Naive Bayes, Random Forest, Support Vector Machine, and Logistic Regression. The performance of each model is rigorously analyzed with various parameters to improve the binary classification to discover malicious prompts. Multilingual BERT approach to embed the prompts significantly improved and outperformed the existing works and achieves an outstanding accuracy of 96.55% by Logistic regression. Additionally, we investigated the incorrect predictions of the model to gain insights into its limitations. The findings can guide researchers in tuning various BERT for finding the most suitable model for diverse LLMs vulnerabilities.},
  keywords={Support vector machines;Logistic regression;Accuracy;Large language models;Bidirectional control;Transformers;Encoding;Multilingual;Tuning;Random forests;Prompt Injections;Natural Language Processing;BERT;Vulnerabilities},
  doi={10.1109/AIBThings63359.2024.10863664},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10825267,
  author={Wang, Zhe and Tayebi, Mohammad A.},
  booktitle={2024 IEEE International Conference on Big Data (BigData)}, 
  title={AutoRed: Automated Attack Scenario Generation Framework for Red Teaming of LLMs}, 
  year={2024},
  volume={},
  number={},
  pages={2376-2383},
  abstract={Even though Large Language Models (LLMs) are highly beneficial, they pose significant security concerns, particularly in the realm of privacy protection. Sensitive information is often provided to LLMs during conversations and may be retained as in-context memory. This raises the risk of unintended data exposure. In the existing paradigm, a red team comprising human testers is tasked with generating input prompts (i.e., test cases) to provoke undesirable responses from LLMs. Yet, relying solely on human testers is both costly and time-intensive. This paper presents AutoRed, an innovative learning framework developed to automatically generate malicious attack scenarios for extracting sensitive information from LLMs. Our framework places particular emphasis on prompt injection—the process of injecting malicious prompts to extract conversation histories from LLMs to uncover private data. AutoRed comprises three key components: malicious prompt generator, sensitive information extractor, and stop point identifier. These components work together to enable prompt injection, ensuring a seamless process. Our extensive experimental evaluation, spanning diverse defense strategies and various LLMs, demonstrates the efficacy of AutoRed. This evaluation not only rigorously assesses the resilience of defense mechanisms but also measures the safety alignment of LLMs, thereby highlighting the potential of our automated framework as an efficient red teaming tool for identifying vulnerabilities and enhancing security within LLMs.},
  keywords={Privacy;Training data;Oral communication;Robustness;Security;Data mining;Scenario generation;Standards;Testing;Resilience;Large Language Model;Red Teaming;Prompt Injection;Reinforcement Learning;Supervised Fine-tuning},
  doi={10.1109/BigData62323.2024.10825267},
  ISSN={2573-2978},
  month={Dec},}@ARTICLE{11551573,
  author={Woesle, Christian and Buettner, Ricardo},
  journal={IEEE Access}, 
  title={A Systematic Literature Review of Prompt Injection Attacks in LLM-Integrated Systems}, 
  year={2026},
  volume={14},
  number={},
  pages={86797-86818},
  abstract={Prompt injection exploits a fundamental property of large language models: the inability to distinguish trusted instructions from untrusted content when both are processed as natural language tokens. As these models are integrated into tool-augmented and memory-enabled systems, the attack surface expands beyond the prompt interface, yet no existing review maps this landscape against standardised adversarial frameworks or analyses the balance between offensive and defensive research. This review follows the Preferred Reporting Items for Systematic Reviews and Meta-Analyses (PRISMA) guidelines. We searched IEEE Xplore, ACM Digital Library, and ScienceDirect for peer-reviewed studies published between 2015 and October 2025, yielding 89 included publications of which 81 form the analytical corpus. Aligned to the MITRE Adversarial Threat Landscape for AI Systems framework (version 5.4.0), each paper was coded along three axes: trust boundary, attacker objective, and research orientation with attacker objectives further classified into seventeen operational patterns aligned to MITRE ATLAS techniques. The corpus is dominated by research on the prompt interface and by two attacker objectives, Instruction Hijack and Policy Bypass, leaving underexplored boundaries lacking both attack characterization and defence proposals. This architectural narrowness does not reflect the multi-component architecture of production LLM systems. The three-axis framework and coded corpus establish a baseline for tracking how coverage evolves as deployment architectures expand. The concentration reflects a research incentive structure that favours reproducible prompt-level experiments over architecturally complex assessments at tool and memory boundaries. The field exhibits a maturity gradient in which defence development is concentrated at the prompt interface while other boundaries remain in early or absent characterization. The corpus treats prompt injection as a model-level property rather than a system-level vulnerability.},
  keywords={Conferences;Large language models;Licenses;Modeling;Nuclear facility regulation;Security;Codes;Tools;Reviews;Weighted sum model;Prompt injection;large language models;LLM security;trust boundaries;adversarial attacks;MITRE ATLAS;jailbreaking;attack-defence analysis;retrieval-augmented generation;systematic literature review},
  doi={10.1109/ACCESS.2026.3700492},
  ISSN={2169-3536},
  month={},}@BOOK{10745288,
  author={Bahree, Amit},
  booktitle={Generative AI in Action},
  year={2024},
  volume={},
  number={},
  pages={},
  abstract={Generative AI can transform your business by streamlining the process of creating text, images, and code. This book will show you how to get in on the action! Generative AI in Action is the comprehensive and concrete guide to generative AI you’ve been searching for. It introduces both AI’s fundamental principles and its practical applications in an enterprise context—from generating text and images for product catalogs and marketing campaigns, to technical reporting, and even writing software. Inside, author Amit Bahree shares his experience leading Generative AI projects at Microsoft for nearly a decade, starting well before the current GPT revolution. Inside Generative AI in Action you will find:  A practical overview of of generative AI applications Architectural patterns, integration guidance, and best practices for generative AI The latest techniques like RAG, prompt engineering, and multi-modality The challenges and risks of generative AI like hallucinations and jailbreaks How to integrate generative AI into your business and IT strategy  Generative AI in Action is full of real-world use cases for generative AI, showing you where and how to start integrating this powerful technology into your products and workflows. You’ll benefit from tried-and-tested implementation advice, as well as application architectures to deploy GenAI in production at enterprise scale.},
  keywords={prompt engineering;model fine tuning;enterprise;safety;ethics;integration;RAG;multi-modality;LLMs;hallucinations;jailbreaks;architectural patterns;ChatGPT;Bard;Copilot},
  doi={},
  ISSN={},
  publisher={Manning},
  isbn={9781633436947},
  url={https://ieeexplore.ieee.org/document/10745288},}@INPROCEEDINGS{11410405,
  author={Muhaimin, Sheikh Samit and Mastorakis, Spyridon},
  booktitle={2025 IEEE 7th International Conference on Trust, Privacy and Security in Intelligent Systems, and Applications (TPS-ISA)}, 
  title={Learning from Literature: A Retraining-Free Framework for LLM Jailbreak Defense via NLP-Based Adversarial Literature Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={270-281},
  abstract={Recent surge in adoption of Large Language Models (LLMs) have made them vulnerable to sophisticated adversarial attacks, manipulative prompts, and encoded malicious inputs. Existing countermeasures often require retraining models, a process that is computationally expensive and impractical for deployment. This paper introduces a novel defense framework that enables LLMs to autonomously detect, filter, and fend off malicious or adversarial inputs without requiring retraining or fine-tuning. The proposed framework consists of two core components: (1) A summarization module that processes and summarizes adversarial research literature to provide the LLM with context-aware defense knowledge and (2) A prompt filtering module that detects, decodes, and classifies harmful inputs through advanced Natural Language Processing (NLP) techniques, such as zero-shot classification, keyword analysis, and encoded content detection. By combining text extraction, summarization, and malicious prompt analysis, this approach enhances the robustness of LLMs against adversarial misuse. Experimental results demonstrate that this integrated approach successfully identifies encoded prompts, malicious patterns, and manipulative language structures with a success rate of 98.7%. The framework also enables the model to respond appropriately to malicious prompts with a higher percentage of jailbreak resistance and refusal rate, using minimal quantity of adversarial research literature as context. The framework significantly reduces LLM Attack Success Rate (ASR) as a lightweight, efficient alternative to retraining-based time and resource-consuming defenses, while upholding LLM response quality.},
  keywords={Training;Resistance;Filtering;Training data;Text summarization;Robustness;Real-time systems;Natural language processing;Security;Surges;Adversarial Attacks;Retraining-free Defense;Prompt Filtering;Text Summarization},
  doi={10.1109/TPS-ISA67132.2025.00036},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11130138,
  author={Jadhav, Gaurav and Singh, Amit Kumar and Khanam, Zeba and Hercock, Robert},
  booktitle={2025 IEEE International Conference on Cyber Security and Resilience (CSR)}, 
  title={A Novel GNN-based Approach for Detection of Prompt Injection Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={77-82},
  abstract={Prompt injection attacks manipulate language model inputs to bypass intended constraints, extract sensitive information, or generate misleading responses, posing a significant security risk in real-world applications. To address this challenge, we propose a Graph Neural Network (GNN)based approach that integrates sentiment features and Bidirectional Encoder Representations from Transformers (BERT) embeddings to effectively detect malicious prompt injections. By transforming textual data into structured graph representations, our approach captures both semantic and contextual relationships that conventional models often overlook. We evaluated our approach against traditional machine learning techniques, including Random Forest, Logistic Regression, and XGBoost, demonstrating its superior performance. Experimental results show that our approach achieves a high detection accuracy of $98.70 \%$ and an F1-score of 0.9799, significantly outperforming conventional methods. Additionally, we provide an in-depth analysis of computational efficiency, highlighting the trade-offs between detection effectiveness and model complexity, ensuring a practical balance between security and performance.},
  keywords={Training;Logistic regression;Accuracy;Large language models;Semantics;Feature extraction;Transformers;Graph neural networks;Computational efficiency;Random forests;GNN;Random Forest;GPT-4;Prompt Injection;Neural Network;Large Language Model;BERT;Semantic analysis;Sentiment Analysis},
  doi={10.1109/CSR64739.2025.11130138},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11475947,
  author={Jadav, VasanthRao and Bussari, Shravya and Aurangabadkar, Mukesh and Garg, Anshul},
  booktitle={SoutheastCon 2026}, 
  title={Red-Team Prompt Injection Defense Using Multi-Context Protocol (MCP)}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Prompt injection attacks represent a critical security risk in Large Language Model (LLM)–powered applications, enabling adversaries to manipulate model behavior, bypass safety controls, and trigger unauthorized actions. Existing defenses predominantly rely on prompt hardening or output filtering, which remain brittle against adaptive and indirect attack techniques. This paper introduces a red-team–driven defense framework based on a Multi-Context Protocol (MCP) that enforces strict isolation and validation of prompt layers. MCP separates system, developer, retrieval, and user prompts into independently trusted contexts and applies context validation, version control, semantic consistency checks, and input reputation scoring prior to model inference. Through empirical evaluation using representative prompt injection attacks, the proposed approach demonstrates a significant reduction in successful injection attempts while preserving low latency and minimal false positives. The framework is model-agnostic and designed for secure deployment in enterprise and regulated LLM environments.},
  keywords={Filtering;Filters;Circuits and systems;Protocols;HTTP;Communication systems;Artificial intelligence;Large language models;Retrieval augmented generation;Logic;Prompt Injection;Large Language Models;AI Security;Red Teaming;Multi-Context Protocol;Context Isolation;Input Validation;Secure LLM Systems},
  doi={10.1109/SoutheastCon63549.2026.11475947},
  ISSN={1558-058X},
  month={Feb},}@INPROCEEDINGS{11573466,
  author={Kaya, Yigitcan and Landerer, Anton and Pletinckx, Stijn and Zimmermann, Michelle and Kruegel, Christopher and Vigna, Giovanni},
  booktitle={2026 IEEE Symposium on Security and Privacy (SP)}, 
  title={When AI Meets the Web: Prompt Injection Risks in Third-Party AI Chatbot Plugins}, 
  year={2026},
  volume={},
  number={},
  pages={4223-4242},
  abstract={Prompt injection attacks pose a critical threat to large language models (LLMs), with prior work focusing on cutting-edge LLM applications like personal copilots. In contrast, simpler LLM applications, such as customer service chatbots, are widespread on the web, yet their security posture and exposure to such attacks remain poorly understood. These applications often rely on third-party chatbot plugins that act as intermediaries to commercial LLM APIs, offering non-expert website builders intuitive ways to customize chatbot behaviors. To bridge this gap, we present the first large-scale study of 17 third-party chatbot plugins used by over $\mathbf{1 0, 0 0 0}$ public websites, uncovering previously unknown prompt injection risks in practice. First, 8 of these plugins (used by 8,000 websites) fail to enforce the integrity of the conversation history transmitted in network requests between the website visitor and the chatbot. This oversight amplifies the impact of direct prompt injection attacks by allowing adversaries to forge conversation histories (including fake system messages), boosting their ability to elicit unintended behavior (e.g., code generation) by $\mathbf{3}-\mathbf{8} \times$. Second, 15 plugins offer tools, such as web-scraping, to enrich the chatbot's context with website-specific content. However, these tools do not distinguish the website's trusted content (e.g., product descriptions) from untrusted, third-party content (e.g., customer reviews), introducing a risk of indirect prompt injection. Notably, we found that $\sim \mathbf{1 3 \%}$ of e-commerce websites have already exposed their chatbots to third-party content. We systematically evaluate both vulnerabilities through controlled experiments grounded in real-world observations, focusing on factors such as system prompt design and the underlying LLM. Our findings show that many plugins adopt insecure practices that undermine the built-in LLM safeguards.},
  keywords={Chatbots;Large language models;Modeling;Printing;Tools;Security;Application programming interfaces;Conferences;Retrieval augmented generation;Context;large language models;prompt injection;chatbot security},
  doi={10.1109/SP63933.2026.00062},
  ISSN={2375-1207},
  month={May},}@INPROCEEDINGS{11398712,
  author={Hailemichael, Soliana and Chano, Maria and El-Sheikh, Eman and Hayajneh, Thaier},
  booktitle={2025 2nd International Conference on Artificial Intelligence, Metaverse, and Cybersecurity (ICAMAC)}, 
  title={Security Risks and Privacy Challenges of Large Language Models in Enterprise Environments}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Large Language Models (LLMs), such as ChatGPT and Gemini, are increasingly adopted across sectors including education, healthcare, and corporate environments. While they offer operational efficiencies, their integration raises significant data security and compliance concerns. This study evaluates whether LLMs retain and disclose sensitive organizational data when exposed to proprietary inputs such as HR records, financial documents, and code samples. Using controlled experiments, we assessed the susceptibility of these models to prompt injection and role-based manipulation attacks. Findings indicate that both models exhibit varying degrees of data leakage and compliance violations, particularly in the context of GDPR and intellectual property protections. Based on these results, we propose a practical framework to guide the responsible use of LLMs in enterprise environments. The framework includes mitigation strategies for minimizing data exposure, ensuring regulatory compliance, and reducing the risks associated with AI integration in the workplace.},
  keywords={Data privacy;Metaverse;Large language models;Prevention and mitigation;Data security;Employment;Education;Medical services;Intellectual property;Protection;Prompt Injection;Data Retention;Large Language Models;Corporate AI Security;GDPR Compliance;RoleBased Manipulation;Proprietary Data},
  doi={10.1109/ICAMAC67779.2025.11398712},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10350690,
  author={Schlarmann, Christian and Hein, Matthias},
  booktitle={2023 IEEE/CVF International Conference on Computer Vision Workshops (ICCVW)}, 
  title={On the Adversarial Robustness of Multi-Modal Foundation Models}, 
  year={2023},
  volume={},
  number={},
  pages={3679-3687},
  abstract={Multi-modal foundation models combining vision and language models such as Flamingo or GPT-4 have recently gained enormous interest. Alignment of foundation models is used to prevent models from providing toxic or harmful output. While malicious users have successfully tried to jailbreak foundation models, an equally important question is if honest users could be harmed by malicious third-party content. In this paper we show that imperceivable attacks on images $\left({{\varepsilon _\infty } = 1/255}\right)$ in order to change the caption output of a multi-modal foundation model can be used by malicious content providers to harm honest users e.g. by guiding them to malicious websites or broadcast fake information. This indicates that countermeasures to adversarial attacks should be used by any deployed multi-modal foundation model. Note: This paper contains fake information to illustrate the outcome of our attacks. It does not reflect the opinion of the authors.},
  keywords={Visualization;Computer vision;Perturbation methods;Computational modeling;Conferences;Robustness;Behavioral sciences;adversarial robustness;multi modal models;security;foundation models},
  doi={10.1109/ICCVW60793.2023.00395},
  ISSN={2473-9944},
  month={Oct},}@INPROCEEDINGS{11493291,
  author={R, Likitha and D C, Dhanyashree and H R, Lavanya and Preeti},
  booktitle={2026 International Conference on Emerging Smart Computing and Informatics (ESCI)}, 
  title={AI Prompt Injection Attack Tester}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models are widely integrated into chatbots, enterprise applications, and automation systems. However, these systems are vulnerable to prompt injection attacks - malicious instructions embedded in text, files, images, or translated content, attempting to override system rules. This paper presents the design and implementation of the AI Prompt Injection Attack Tester: a multi-modal system for detecting and mitigating Prompt Injection attempts against Large Language Models. While the ubiquitous deployment of LLMs has introduced a critical security vulnerability, where untrusted user input hijacks the model’s policy and system prompt, we introduce the following concept: a Heuristic-Based Prompt Injection Detection Engine integrated into a pre-processing guardrail layer. The PIDE applies a specialized ruleset, which includes instruction-overriding pattern matching and sensitive keyword identification, to incoming data for a risk score. Importantly, the system normalizes and scans inputs from four different modalities: direct text, embedded code comments/literals, image text via OCR, and text that has been processed through a mock translation service. On detection, a Mitigation Pipeline applies sequential steps of sanitization, instruction stripping, and policy-based blocking prior to any input reaching the LLM. As confirmed within a safe, mock environment for LLMs, experimental results validate that this approach provides both successful detection and neutralization of malicious instructions across all types of input tested in this work. This paper confirms that a robust, multi-modal pre-processing policy layer is required as an integral component of a broad defense-in-depth strategy against sophisticated Prompt Injection attacks.},
  keywords={Feedback;Filtering;Circuits;Filters;Graphical user interfaces;Product development;Internet;Bot (Internet);Protocols;Communication systems;Prompt Injection;LLM Security;OCR;AI Safety;Streamlit;Multi-Modal Detection},
  doi={10.1109/ESCI68015.2026.11493291},
  ISSN={2996-1815},
  month={March},}@INPROCEEDINGS{11431088,
  author={Mamidwar, Piyush and Rajuarkar, Rani and Deshmukh, Niharika},
  booktitle={2025 International Conference on Computer and Applications (ICCA)}, 
  title={Beyond Individual Defenses: Evaluating Defense Combinations Against Prompt Injection Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models process all input as natural language, creating a fundamental vulnerability: the inability to distinguish trusted instructions from untrusted user content. This architectural design—central to LLMs’ flexibility—simultaneously enables prompt injection attacks that manipulate model behavior through carefully crafted inputs. Despite the proliferation of defense mechanisms, a critical gap persists: defenses are evaluated in isolation, leaving practitioners without guidance for production deployments balancing security against latency and complexity.This paper presents the first systematic empirical evaluation of defense mechanism combinations. Testing 15 configurations against 50 diverse attacks, we reveal combined defenses outperform individual mechanisms by 18.5% (p<0.01), yet certain pairings waste resources without security gains. We identify three Pareto-optimal strategies: PromptShield + Spotlighting (78% defense success, 215ms), PromptShield + Instruction Hierarchy (75%, 245ms), and Perplexity Filter (55%, 85ms). However, even optimal combinations achieve only 78% effectiveness with 22% residual vulnerability, degrading under adaptive attacks. We provide evidence-based deployment guidelines and identify architectural challenges requiring instruction-data separation and adaptive orchestration for advancing LLM security.},
  keywords={Systematics;Large language models;Standards organizations;Natural languages;Production;Organizations;Machine learning;Security;Guidelines;Testing;Large Language Models;Prompt Injection;Jailbreaking;AI Security;Adversarial Attacks;RAG Systems;Machine Learning Security},
  doi={10.1109/ICCA66035.2025.11431088},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11581051,
  author={Sodankoor, Prerana and Joshi, Sampada and K, Vinodha},
  booktitle={2025 IEEE 7th International Conference on Cybernetics, Cognition and Machine Learning Applications (ICCCMLA)}, 
  title={SecurePrompt – Detecting and Mitigating Prompt Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Prompt injection attacks pose serious security and privacy risks in applications that use large language models (LLMs) and sensitive data. Conventional techniques that rely on input validation at the single layer are unable to identify intricate attack vectors or stop the disclosure of private information. To solve these issues in LLM-based systems, a multi-layer defense architecture is suggested. The design adds a Response layer and a Prompt Validation layer. To assess the safety of prompts and responses, each layer combines machine learning models with static rule-based classification. Unsafe instances are either blocked or referred for further administrative review. Feedback loops facilitate continuous filtering rule improvement. The architecture incorporates administrative interfaces for updating validation criteria and integrates with the current LLM infrastructure. To lessen the possibility that private information will be exposed by outside retrieval methods, the system supports retrieval augmented generation settings. According to preliminary tests, injection attempts can be detected more accurately than with baseline methods while preserving tolerable latency and user performance.},
  keywords={Modeling;Large language models;Retrieval augmented generation;Filtering;Machine learning;Filters;Architecture;Computer architecture;Finance;Pipelines;Large Language Models;Prompt Injection;Input Validation;Response Filtering;Secure NLP;Retrieval Augmented Generation;AI Safety;Machine Learning Security;Content Moderation;Adversarial Attacks},
  doi={10.1109/ICCCMLA66092.2025.11581051},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11368582,
  author={Saklani, Sumit and Chohan, Deepak Kumar and Sharma, Raman and Varshney, Niharika and Gupta, Atika and Bagla, Piyush},
  booktitle={2025 IEEE 6th Global Conference for Advancement in Technology (GCAT)}, 
  title={LLM-Guarded Clouds: Leveraging Generative AI for Proactive Threat Hunting and Adaptive Defense in Hybrid Cloud Environments}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={The ability to scale within hybrid and multi cloud infrastructures enhances liquid resource availability, However, this also dramatically increases the attack surface, leaving trivially configured defenses completely obsolete, particularly for attack sophistication levels identified as low to mid. Deploying Large Language Models brings unique risks, such as prompt injection and exposing unreasoned system vulnerability gaps. This is the focus of the research: integrating LLM-Guarded Clouds with preemptive, nonlinear, adaptive threat defense hybrid cloud frameworks with strong attack surface generative AI. This LLM system manages multi-stage attacks with GNNs, feeds LLMs through Controlled Authoring Tier Restricted Processor/Graph-Reduced PAXs for reasoning Focused Inferencing, and applies federated learning within TEEs for classified, low-surveillance, and safe reasoning operationally secure LLM inferencing. Our analysis of the UNSW-NB15, CIC-IDS2018 and AWS CloudTrail logs demonstrates an accuracy rate 96.5%, F1 score of 95.4% and 3.4% false positive rate – outperforming ML, CNN-LSTM and LLM only baselines by almost 15%. Robustness testing indicates 72% improvement in adversarial resilience against prompt injection. Overall, LLM-Guarded Clouds improves accuracy, resilience, and explainability in detection, providing a novel automated defense solution for hybrid cloud environments.},
  keywords={Accuracy;Adaptive systems;Upper bound;Federated learning;Generative AI;Large language models;Hybrid power systems;Cognition;Graph neural networks;Resilience;Hybrid Cloud Security;Large Language Models (LLMs);Threat Hunting;Graph Neural Networks (GNNs);Retrieval-Augmented Generation (RAG);Federated Learning;Trusted Execution Environments (TEEs)},
  doi={10.1109/GCAT66372.2025.11368582},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11651315,
  author={Bhardwaj, Yogendra K and Chauhan, Prashant S and Sharma, Priyank Raj},
  booktitle={2026 International Conference on Emerging Trends in Information, Communication & Systems (ICETICS)}, 
  title={Guarding the Gateway: Securing MCP-Mediated RAG Pipelines Against Injection with the Guru Framework}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The adoption of Large Language Models (LLMs) within the context of Retrieval-Augmented Generation (RAG) frameworks has revolutionized intelligent information processing, by offering the ability to retrieve knowledge that is accurate, contextually relevant, and up-to-date. However, by integrating Model Context Protocol (MCP) services, the integration of intelligent agents, APIs, plugins and external tools repositories further adds to the interoperability but also exposes to severe security issues like prompt injection, context poisoning and malicious tools manipulation attacks. In this paper, Guru, a security framework for protecting RAG pipelines using semantic anomaly analysis, contextual integrity verification, dynamic trust scoring and adaptive privilege isolation, are proposed. The framework periodically checks for threats from the retrieved content through entropy-based threat detection, checks for trustworthiness of the content by engaging in retrieval ranking based on trust and monitors the interaction of the content by employing interaction dependency monitoring, and then forwards the contextual information to the language model. Through experimental evaluation, it is shown that the proposed framework achieves almost 6–14% higher performance than existing methods in some of the security metrics, including contextual integrity preservation (96.8%), injection resistance (95.9%) and secure interaction stability (96.1%). This proposed framework will allow the secure, scalable and trusted deployment of intelligent retrieval ecosystems in critical enterprise environments.},
  keywords={Modeling;Retrieval augmented generation;Context;Equations;Security;Printing;Large language models;Tagging;Pipelines;Artificial intelligence;Retrieval-Augmented Generation (RAG);Model Context Protocol (MCP);Prompt Injection Defence;Secure AI Pipelines;Context Integrity Verification},
  doi={10.1109/ICETICS69505.2026.11651315},
  ISSN={},
  month={July},}@INPROCEEDINGS{11401900,
  author={Ikbarieh, Seif and Aryal, Kshitiz and Gupta, Maanak},
  booktitle={2025 IEEE International Conference on Big Data (BigData)}, 
  title={RAG-Targeted Adversarial Attack on LLM-Based Threat Detection and Mitigation Framework}, 
  year={2025},
  volume={},
  number={},
  pages={6577-6586},
  abstract={The rapid expansion of the Internet of Things (IoT) is reshaping communication and operational practices across industries, but it also broadens the attack surface and increases susceptibility to security breaches. Artificial Intelligence has become a valuable solution in securing IoT networks, with Large Language Models (LLMs) enabling automated attack behavior analysis and mitigation suggestion in Network Intrusion Detection Systems (NIDS). Despite advancements, the use of LLMs in such systems further expands the attack surface, putting entire networks at risk by introducing vulnerabilities such as prompt injection and data poisoning. In this work, we attack an LLM-based IoT attack analysis and mitigation framework to test its adversarial robustness. We construct an attack description dataset and use it in a targeted data poisoning attack that applies word-level, meaning-preserving perturbations to corrupt the Retrieval-Augmented Generation (RAG) knowledge base of the framework. We then compare pre-attack and post-attack mitigation responses from the target model, ChatGPT-5 Thinking, to measure the impact of the attack on model performance, using an established evaluation rubric designed for human experts and judge LLMs. Our results show that small perturbations degrade LLM performance by weakening the linkage between observed network traffic features and attack behavior, and by reducing the specificity and practicality of recommended mitigations for resource-constrained devices.},
  keywords={Performance evaluation;Prevention and mitigation;Perturbation methods;Large language models;Retrieval augmented generation;Network intrusion detection;Telecommunication traffic;Threat assessment;Robustness;Internet of Things;Adversarial Poisoning Attack;Internet of Things (IoT) Security;Large Language Model;Retrieval-Augmented Generation;Cybersecurity},
  doi={10.1109/BigData66926.2025.11401900},
  ISSN={2573-2978},
  month={Dec},}@ARTICLE{11207588,
  author={Emekci, Hakan and Budakoglu, Gülsüm},
  journal={IEEE Access}, 
  title={Securing With Dual-LLM Architecture: ChatTEDU an Open Access Chatbot’s Defense}, 
  year={2025},
  volume={13},
  number={},
  pages={183156-183170},
  abstract={Open access chatbots face escalating cybersecurity risks due to adversarial exploitation. This paper presents the case of ChatTEDU, a dual-LLM architecture designed to protect open-access AI systems from sophisticated adversarial attacks while maintaining the user experience quality. During a two-month deployment at TED University, we analyzed 4501 unique real-world interactions, including 180 malicious attempts targeting the system through prompt injection, jailbreaking, and content manipulation attacks. Our dual-layer security approach separates content moderation from response generation by using two specialized language models. The first model (LLM-1) acts as a security filter, analyzing incoming queries for threats, whereas the second model (LLM-2) generates educational responses only after validation. This architecture successfully blocked 100% of the identified attacks, with only 0.28% false positives, demonstrating robust protection without compromising legitimate educational interactions. The system handles over 100 concurrent users during peak registration periods without security breaches or performance degradation. Attack analysis of the case revealed that 77.8% of the threats used technical exploitation rather than content-based manipulation, with multilingual attacks comprising 15% of the attempts. The dual-LLM approach introduced only 18% latency overhead, while providing comprehensive protection against prompt injection, jailbreaking, spam insertion, and denial-of-service attacks. This study provides practical guidance for implementing robust security measures in public-faced AI deployments worldwide.},
  keywords={Security;Chatbots;Microservice architectures;Vectors;Retrieval augmented generation;Protection;Prevention and mitigation;Open Access;Large language models;Databases;Adversarial attacks;artificial intelligence security;open access chatbot security;large language models;prompt injection},
  doi={10.1109/ACCESS.2025.3623268},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11462306,
  author={Sun, Mengjie and Zheng, Yaowen and Lv, Shichao and Li, Zhi and Liu, Kaixiang and Wang, Yuncheng and Chen, Yongle and Sun, Limin},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={A Malicious Policy Detection Approach Enhanced by Threat Knowledge in LLM-Based Embodied Robots}, 
  year={2026},
  volume={},
  number={},
  pages={20072-20076},
  abstract={Integrating Large Language Models (LLMs) into robot systems enables natural language task planning but also raises safety risks, e.g., jailbreak attacks. Existing LLM safety alignment efforts primarily address textual harms, while insufficiently covering physical risks from malicious task planning. Moreover, current defenses against embodied robots lack interpretability and generalization to diverse, real-world attack scenarios. To address these challenges, we propose a novel threat knowledge-enhanced approach for malicious policy detection. Our method builds a structured knowledge base of known malicious behaviors by standardizing multi-format sub-task policies into unified semantic representations. During inference, we retrieve relevant malicious cases and leverage chain-of-thought reasoning for analogy-based semantic analysis. Experiments demonstrate that our approach effectively detects malicious behaviors and generalizes well across tasks. It reduces attack success rates to an average of 2.67% on SafeAgentBench and 2.30% on BadRobot benchmarks, while maintaining high clean task performance of 76.04% on SafeAgentBench.},
  keywords={Protocols;HTTP;Radio access networks;Regional area networks;Artificial intelligence;Cognitive systems;Large language models;Retrieval augmented generation;Generative Pre-trained transformer;Logic;Embodied Robots;Attack Detection},
  doi={10.1109/ICASSP55912.2026.11462306},
  ISSN={2379-190X},
  month={May},}@ARTICLE{11124871,
  author={Yang, Guan and Sun, Zhengzheng and Wang, Yu},
  journal={IEEE Access}, 
  title={ShellBox: Adversarially Enhanced LLM-Interactive Honeypot Framework}, 
  year={2025},
  volume={13},
  number={},
  pages={143618-143630},
  abstract={Honeypot technology is an active defence strategy designed to mitigate the asymmetry inherent in network attacks and defence dynamics. In recent years, honeypot systems powered by large language models (LLMs) have become a focal point of research owing to their ability to simulate complex network environments and generate highly deceptive virtual assets. However, response inconsistency in multi-turn dialogues and prompt injection vulnerabilities inherent to LLMs significantly reduce the deceptive capability of honeypots. This study first defines the threat model, and then introduces a relevance-based interaction history pruning algorithm and dynamic error simulation strategy to mitigate these challenges. Considering practical issues such as response latency and network instability, our experiments were conducted using multiple locally deployed open-source LLMs. The experimental results demonstrated that the proposed dynamic error simulation mechanism achieved a maximum accuracy of 81.63% for the DeepSeek-R1 model. Furthermore, applying the interaction history pruning algorithm improved the turn-level coherence score (TCS) by 34.5% compared with the baseline. Finally, this paper outlines potential future research directions for LLM-based honeypot technologies in active multi-turn mechanisms.},
  keywords={Heuristic algorithms;History;Databases;Chatbots;Linux;Large language models;Threat modeling;HTTP;Adaptation models;Prompt engineering;Network attack and multi-turn;honeypot;large language model;dynamic error simulation;interaction history pruning algorithm},
  doi={10.1109/ACCESS.2025.3598779},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11016426,
  author={AlOmar, Ban and Trabelsi, Zouheir},
  booktitle={2025 IEEE Global Engineering Education Conference (EDUCON)}, 
  title={Integrating Generative AI in Cybersecurity Curricula}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={Artificial intelligence technologies with generative capabilities have accelerated fundamental transformations in security architectures, necessitating reconceptualization of security frameworks and threat assessment protocols. This study presents a pedagogical framework for integrating generative AI (GenAI) into university-level cybersecurity curricula. The methodology establishes foundational knowledge in generative models and language processing architectures, followed by applications across defensive security measures. The framework includes automated cyber threat intelligence, malicious code and malware detection, log anomaly detection, digital image forensics, and AI-assisted penetration testing. The framework acknowledges the dual-use nature of GenAI in security domains, incorporating prompt injection attacks that manipulate model behaviors and compromise system integrity. Laboratory modules presented will provide students with hands-on experience on advanced tools including large language models, diffusion models, and cognitive architectures for automated security assessment. This study seeks to prepare cybersecurity professionals with critical competencies necessary for effective operation within an environment increasingly shaped by artificial intelligence systems.},
  keywords={Protocols;Generative AI;Large language models;Forensics;Diffusion models;Malware;Threat assessment;Regulation;Engineering education;Penetration testing;Generative AI;Cybersecurity;LLMs;Diffusion Models;Penetration Testing},
  doi={10.1109/EDUCON62633.2025.11016426},
  ISSN={2165-9567},
  month={April},}@INPROCEEDINGS{11497073,
  author={Bajaj, Sajal and Dutta, Kamlesh},
  booktitle={2026 IEEE International Conference on AI Engineering and Innovations (AIEI)}, 
  title={Evaluating LoRA Adaptation and Fine-Tuning for Multi-Class Adversarial Prompt Detection in Transformer Models}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models (LLMs) have changed the way we interact with AI, but their openness also makes them vulnerable to malicious prompt attacks. Two of the most common threats are jailbreak attacks, where users trick models into bypassing safety filters, and prompt injection attacks, where hidden instructions are inserted into otherwise normal text. Detecting these adversarial prompts is challenging because attacks evolve at a fast pace and appear benign at first sight. In this work, we explore how different supervised fine-tuning strategies affect the ability of transformer models to detect such types of attack. We compare LoRA-based parameter-efficient fine-tuning on Google’s Gemma2B, Microsoft’s Phi-2 and TinyLlama with full fine-tuning of smaller transformer models like BERT-base, mDeBERTa and DistilBERT. Our dataset takes examples from several widely used datasets, including JailBreakV-28K, TrustAIRLab’s In-the-Wild Jailbreak Prompts and deepset/prompt-injections, covering three categories: benign, prompt injection, and jailbreaking. We have found LoRA-tuned Gemma-2B, TinyLlama and Phi2 performs competitively with fully fine-tuned BERT models while training only at fractions (less than 1%) of parameters. This shows that LoRA fine-tuning can maintain strong detection performance while reducing the computational cost significantly in large models, making it a practical solution for improving the safety of language models while keeping the base model weights freezed and still usable for general tasks like generating explanations for the detection. Our findings suggest that efficient supervised fine-tuning techniques like LoRA can help build faster, efficient, and scalable defense systems against evolving jailbreak and prompt injection attacks.},
  keywords={Nuclear weapons;Weapons;Filtering;Filters;Feedback;Circuits;Circuits and systems;LoRa;Protocols;Communication systems;Large language models;adversarial prompts;jailbreak attacks;prompt injection;transformer models;LoRA fine-tuning;parameter-efficient fine-tuning;supervised learning;model safety},
  doi={10.1109/AIEI69164.2026.11497073},
  ISSN={},
  month={March},}@INPROCEEDINGS{11647875,
  author={Manohar, Lokesh Prakash},
  booktitle={2026 International Conference on Cybersecurity, Digital Forensics, and AI Applications (ICCSDFAI)}, 
  title={Zero-Shot Prompt Injection Detection via N-gram Pooling of Token-Level Hidden States}, 
  year={2026},
  volume={},
  number={},
  pages={1198-1203},
  abstract={Retrieval-augmented generation (RAG) pipelines are vulnerable to prompt injection attacks, where adversaries embed malicious instructions inside retrieved documents. Existing embedding-based detectors rely on mean-pooled sentence vectors, which suppress short injection spans hidden within long benign text — a phenomenon we formalize as semantic dilution. We extract per-token hidden states from a frozen 22M-parameter sentence transformer already present in the pipeline and apply N-gram pooling over sliding windows to localize injection signals. On a controlled chunk-level benchmark (1,575 chunks, Enron corpus), our method achieves AUC=0.901 (95% CI [0.869, 0.930]), with confidence intervals non-overlapping with the mean-pool baseline (AUC=0.808). On the public xTRam1 dataset, zero-shot AUC=0.870 exceeds the supervised baseline of 0.764. All three scoring variants execute at identical CPU latency (≈44ms per 500-character chunk). The method requires no labeled data, no fine-tuning, and no access to the generative LLM at inference time.},
  keywords={Large language models;Training;Labeling;Equations;Retrieval augmented generation;Modeling;Poles and zeros;Windows;Signal detection;Manuals},
  doi={10.1109/ICCSDFAI70505.2026.11647875},
  ISSN={},
  month={June},}@INPROCEEDINGS{11593453,
  author={Malladi, Gayatri and Thamilarasu, Geethapriya},
  booktitle={2026 56th Annual IEEE International Conference on Dependable Systems and Networks (DSN)}, 
  title={RIPE-II: Retrieval In-Place Poisoning Evaluation with Indirect Injections}, 
  year={2026},
  volume={},
  number={},
  pages={800-812},
  abstract={Retrieval Augmented Generation (RAG) systems have enhanced the performance of Large Language Models (LLMs) by effectively addressing challenges such as hallucinations and generating irrelevant responses. However, integrating the RAG technique into LLMs introduces privacy risks and potential data leakage issues from the retrieval pipeline. Indirect Prompt Injections (IPIs) occur when hidden instructions inside retrieved documents slip into a model’s context as trusted evidence, exploiting weak guardrails in RAG systems and leading to unauthorized data leaks, ambiguous outcomes, and policy overrides. Existing defenses rely on brittle delimiter heuristics or limited retriever adjustments, leaving RAG systems vulnerable to adversarial directives blended seamlessly into retrieved content.In this paper, we present RIPE-II, a corpus-level benchmark that evaluates IPIs under a realistic content-poisoning threat model. RIPE-II constructs delimiter-free, position-aware poisoned corpora across multiple domains and includes both textual and visual injections. Our design explicitly models mid-document placement, chunking, truncation, and cross-component propagation, reflecting how enterprise RAG systems ingest and process content. We introduce a two-stage evaluation framework that separates retrieval exposure from generation-time compliance and distinguishes embedding-based similarity from semantic override using a calibrated LLM-based judge. Across biomedical, financial, scientific, open-domain question answering, including multi-hop reasoning and web passage retrieval settings, we find that poisoned documents can reach the final model context in up to 97% of queries and rank first in up to 94% of cases, showing that retriever and reranker choices substantially shape RAG security exposure. We further show that cosine-based attack scoring can underreport semantic compromise by more than 5×, demonstrating that lexical or embedding similarity alone is insufficient for evaluating indirect prompt injection risk.},
  keywords={Modeling;Toxicology;Ranking (statistics);Retrieval augmented generation;Erbium;Automatic speech recognition;Printing;Context;Optical character recognition;Large language models;Retrieval-Augmented Generation;Indirect Prompt Injections;Adversarial Retrieval;Multimodal Attacks},
  doi={10.1109/DSN69566.2026.00078},
  ISSN={2158-3927},
  month={June},}@INPROCEEDINGS{10888800,
  author={He, Yao and Liu, Jiajun and Ke, Wenjun and Wang, Peng and Xiao, Congda and Li, Yining},
  booktitle={ICASSP 2025 - 2025 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Exploring Meta Evidence for Prompt Optimization}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Prompt optimization aims to construct effective prompts to fully leverage the capabilities of large language models (LLMs). The key challenge lies in analyzing the outputs of LLMs, identifying fine-grained errors as explicit evidence and guiding reverse prompt correction. However, existing dominant methods feed all evidence into LLMs, leading to excessive redundancy that misleads the models. Moreover, this redundant input could increase computational costs. To address the issue, we introduce a novel meta evidence-aware prompt optimization method (MEPO), which performs fine-grained analysis of the causal relationships within evidence using clustering and Bayesian inference. Initially, MEPO generates preliminary evidence to describe the drawbacks of the given prompt. Subsequently, the evidence is clustered and constructed into a directed acyclic graph (DAG) to produce meta evidence. Finally, we edit the initial prompt based on the obtained meta evidence and employ the beam search to select the best-performing prompt. Experimental results show that MEPO outperforms state-of-the-art baselines, achieving absolute F1 score improvements of 5.8% and 5.0% on two common-used Liar and Jailbreak datasets, respectively. The datasets and codes are available at https://anonymous.4open.science/r/MEPO-E1A0.},
  keywords={Training;Directed acyclic graph;Large language models;Computational modeling;Termination of employment;Optimization methods;Signal processing;Computational efficiency;Feeds;Speech processing;Prompt Optimization;Large Language Models},
  doi={10.1109/ICASSP49660.2025.10888800},
  ISSN={2379-190X},
  month={April},}@INPROCEEDINGS{11642234,
  author={Cahyo, Aditya Nur and Koprawi, Muhammad and Wantoro, Jan},
  booktitle={2026 International Seminar on Intelligent Technology and Its Applications (ISITIA)}, 
  title={Security and Assurance Evaluation of RAG-Based AI Assistants in Learning Management Systems: A Pilot Study on Prompt Injection and Data Leakage}, 
  year={2026},
  volume={},
  number={},
  pages={750-755},
  abstract={Learning management systems increasingly use retrieval-augmented generation (RAG) assistants to answer questions from course documents, but connecting heterogeneous learning materials to large language models also creates new security risks. This paper presents a pilot security-and-assurance evaluation of an LMS-oriented RAG assistant using Indonesian PDF materials from an Administrasi Jaringan course. We construct a role-aware corpus of 26 PDFs covering public instructional modules, internal staff notes, restricted synthetic-sensitive documents, and poisoned public documents. The benchmark contains 80 queries across benign use, direct prompt injection, indirect prompt injection, and leakage attempts, executed under three profiles: vanilla RAG, prompt-guarded RAG, and retrieval-aware hardened RAG. Across 240 Gemini 2.5 Flash runs, the vanilla profile achieved the highest benign utility score of 1.90 but remained vulnerable, with a direct prompt-injection ASR of 0.35, a leakage rate of 0.15, an unauthorized retrieval rate of 0.90, and a poisoned retrieval rate of 0.90. Prompt guarding reduced direct attack success to 0.05 but left retrieval exposure unchanged. The hardened profile eliminated observed leakage, unauthorized retrieval, and poisoned retrieval, with a modest utility reduction and residual direct-prompt-injection susceptibility. These findings indicate that LMS-RAG assurance should evaluate both answer-level behavior and retrieval-layer exposure.},
  keywords={Retrieval augmented generation;Modeling;Security;Toxicology;Printing;Learning (artificial intelligence);Conferences;Context;Automatic speech recognition;Materials;learning management systems;retrieval-augmented generation;prompt injection;data leakage;security evaluation},
  doi={10.1109/ISITIA71267.2026.11642234},
  ISSN={2769-5492},
  month={July},}@INPROCEEDINGS{11280014,
  author={Pan, Jonathan and Wong, Swee Liang and Yuan, Yidi and Chia, Xin Wei},
  booktitle={2025 International Conference on Machine Learning and Cybernetics (ICMLC)}, 
  title={Prompt Inject Detection with Generative Explanation as an Investigative Tool}, 
  year={2025},
  volume={},
  number={},
  pages={7-12},
  abstract={Large Language Models (LLMs) are vulnerable to adversarial prompt based injects. These injects could jailbreak or exploit vulnerabilities within these models with explicit prompt requests leading to undesired responses. In the context of investigating prompt injects, the challenge is the sheer volume of input prompts involved that are likely to be largely benign. This investigative challenge is further complicated by the semantics and subjectivity of the input prompts involved in the LLM conversation with its user and the context of the environment to which the conversation is being carried out. Hence, the challenge for AI security investigators would be twofold. The first is to identify adversarial prompt injects and then to assess whether the input prompt is contextually benign or adversarial. For the first step, this could be done using existing AI security solutions like guardrails to detect and protect the LLMs. Guardrails have been developed using a variety of approaches. A popular approach is to use signature based. Another popular approach to develop AI models to classify such prompts include the use of NLP based models like a language model. However, in the context of conducting an AI security investigation of prompt injects, these guardrails lack the ability to aid investigators in triaging or assessing the identified input prompts. In this applied research exploration, we explore the use of a text generation capabilities of LLM to detect prompt injects and generate explanation for its detections to aid AI security investigators in assessing and triaging of such prompt inject detections. The practical benefit of such a tool is to ease the task of conducting investigation into prompt injects.},
  keywords={Large language models;Semantics;Oral communication;Machine learning;Security;Artificial intelligence;Cybernetics;AI Security;Prompt Inject Investigation;Generated Explanation},
  doi={10.1109/ICMLC66258.2025.11280014},
  ISSN={2160-1348},
  month={July},}@ARTICLE{11574655,
  author={Leburu, Nandakishore},
  journal={IEEE Access}, 
  title={Trust-Aware Orchestration Architecture for LLM-Assisted Workflows in Multi-Tenant Enterprise Systems}, 
  year={2026},
  volume={14},
  number={},
  pages={97094-97117},
  abstract={Large language models (LLMs) now call tools and APIs in enterprise systems, creating concrete risks: hallucinated parameters, cross-tenant data leakage, and prompt injection. This paper presents an orchestration architecture for multi-tenant deployments where the LLM proposes actions and a deterministic control plane validates and executes them, organized as three hard enforcement gates (authentication and tenant resolution, role-based tool authorization, and schema validation), four advisory filters (input sanitization, retrieval scoping, execution monitoring, output compliance), and append-only audit logging. The hard gates provide three structural guarantees (tenant isolation, tool-allowlist enforcement, schema conformance) specified as deterministic predicates and verified at the logical control-plane level; they do not defend against within-scope intent manipulation, in which an authorized role invokes an authorized tool with schema-valid parameters for a malicious purpose. A 20-prompt adaptive case study shows within-scope attacks succeed on every one of five LLMs tested, at point-estimate rates of 30%–70%, including the three frontier Claude models (Haiku 4.5, Sonnet 4, Opus 4.6). The structural guarantees hold uniformly across 14,885 evaluations: 1,497 custom prompts plus adversarial prompts from two established benchmarks (683 TensorTrust and 777 AgentDojo across three domains and three attack strategies) and a 20-prompt adaptive case study. Targeted attack-success rate on AgentDojo is  $\leq 1.9\%$  across all five models, comparable to published defended baselines. Deterministic syntax recovery reduces the 3B model’s false rejection rate from 52% to 15.2% at zero latency cost; frontier models achieve 0%. Input sanitization flagged injection patterns in only 10.2% of injection prompts without solo-rejecting any, confirming pattern-based detection is insufficient. Within-scope intent manipulation remains an open problem the hard gates do not address. The architecture targets enterprise systems requiring explainability, safety, and regulatory compliance.},
  keywords={Modeling;Tools;Large language models;Architecture;Computer architecture;Pipelines;Filtering;Retrieval augmented generation;Filters;Artificial intelligence;Large language models;trust-aware systems;orchestration architecture;multi-tenant systems;retrieval-augmented generation;schema validation;AI governance;guardrails;enterprise AI safety},
  doi={10.1109/ACCESS.2026.3706063},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11573479,
  author={Wang, Yanting and Geng, Runpeng and Chen, Ying and Jia, Jinyuan},
  booktitle={2026 IEEE Symposium on Security and Privacy (SP)}, 
  title={AttnTrace: Contextual Attribution of Prompt Injection and Knowledge Corruption}, 
  year={2026},
  volume={},
  number={},
  pages={4320-4338},
  abstract={Long-context large language models (LLMs), such as GPT-5, Gemini-2.5-Pro, and Claude-Sonnet-4, are increasingly used to empower advanced AI systems, including retrievalaugmented generation (RAG) systems and autonomous agents. In these systems, an LLM receives an instruction along with a context-often consisting of texts retrieved from a knowledge database, memory, or the Internet-and generates a response that is contextually grounded by following the instruction. Many recent studies showed that these LLM-empowered systems are vulnerable to prompt injection and knowledge corruption attacks, where an attacker can inject malicious texts into the context such that the LLM generates an output as the attacker desires. One important research question is how to trace back to these malicious texts from a long context in leading to the attacker-desired output of the LLM. While significant efforts have been made, state-of-the-art solutions still achieve a sub-optimal performance and/or incur high computation cost. In this work, we propose AttnTrace, a new context traceback method based on the attention weights produced by an LLM for a prompt. To effectively utilize attention weights, we introduce two techniques designed to enhance the effectiveness of AttnTrace, and we provide theoretical insights for our design choice. We also perform a systematic evaluation for AttnTrace. The results demonstrate that AttnTrace is more accurate and efficient than existing state-of-the-art context traceback methods. We also show AttnTrace can improve state-of-the-art methods in detecting prompt injection under long contexts through the attribution-before-detection paradigm. As a real-world application, we demonstrate that AttnTrace can effectively pinpoint injected instructions in a paper designed to manipulate LLM-generated reviews. The code and data are available: https://github.com/Wang-Yanting/AttnTrace.},
  keywords={Context;Large language models;Modeling;Printing;Retrieval augmented generation;Equations;Reviews;Signal detection;Toxicology;Art;llm;prompt injection attack;knowledge corruption attack;contextual attribution},
  doi={10.1109/SP63933.2026.00198},
  ISSN={2375-1207},
  month={May},}@INPROCEEDINGS{11545895,
  author={Farhana, Mst Habiba and Roy, Ridoy Kumar},
  booktitle={2026 IEEE 2nd International Conference on Quantum Photonics, Artificial Intelligence & Networking (QPAIN)}, 
  title={Multimodal Prompt Injection: A Formal 4D Taxonomy for Image and Document Pipelines}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Despite rapid advances in multimodal large language models (MLLMs), their cross-modal fusion architectures pose significant security concerns. Multimodal prompt injection (MPI) attacks enable adversaries to incorporate malicious instructions within non-textual inputs such as images, PDFs, and slides to manipulate model behavior, bypass controls, and exploit processes such as optical character recognition (OCR) and metadata parsing. Current research is fragmented due to a lack of a cohesive risk classification and consistent evaluation techniques. This paper introduces a formal 4D taxonomy $\mathcal{T}=\langle C, L, O, S\rangle$ that categorizes MPI attacks according to carrier type, pipeline location, attacker objective, and stealth level, resulting in 96 potentially unique attack classes and indicates that merely 7.3% are documented in existing research. Analysis indicates that no singular defense provides comprehensive coverage; a confirmed limit of 75% dimensional coverage is established across all deployable defenders. Layered architectures with provenance and standardized multimodal benchmarks are recognized as critical conditions for effective MPI mitigation.},
  keywords={Modeling;Taxonomy;Pipelines;Printing;Large language models;Security;Tools;Threat modeling;Context;Optical character recognition;Multimodal Prompt Injection;LLM Security;Attack Taxonomy;Cross-Modal Threats;Adversarial Stealth},
  doi={10.1109/QPAIN69676.2026.11545895},
  ISSN={},
  month={April},}@INPROCEEDINGS{11476026,
  author={Kolavennu, Gayathri Priya and Shi, Yong and Suo, Kun and Nguyen, Tu and Zhao, Chen and Xie, Zongxing},
  booktitle={SoutheastCon 2026}, 
  title={Security-Aware Retrieval-Augmented Generation System for Post-Quantum Cryptography Intelligence}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Retrieval-Augmented Generation (RAG) systems have become popular tools for adding external information sources to Large Language Models (LLMs) to enhance their capabilities. However, there are significant concerns connected with their use in cybersecurity sectors, such as the possibility of hallucinations, vulnerability to rapid injection attacks, and difficulties in confirming the reliability of the sources that are retrieved. This study proposes a production-grade, security-aware RAG framework designed for cybersecurity knowledge management and Post-Quantum Cryptography (PQC) intelligence in order to overcome these issues. Multiple security-focused improvements are included in the proposed system, such as evidence-based abstention controlled by a confidence threshold of 0.4, prompt injection defense mechanisms that achieve 100% detection on known attack patterns, multi-source agreement verification that requires corroboration across trusted sources, and trust-weighted retrieval with authority-based scoring-assigning weights of $\mathbf{1. 0}$ to NIST standards and 0.95 to CVE databases. The system generates answers to technical queries with a mean confidence score of 0.719 after processing nine NIST standard publications totaling 2.78 million characters. The addition of security-aware constraints considerably lowers hallucination rates while maintaining query accuracy, according to experimental results. With the addition of cryptographic metadata annotation to FAISS-based vector retrieval, the implementation uses the HuggingFace SmolLM2-1.7B-Instruct model for text generation and sentencetransformers to produce 384-dimensional embeddings.},
  keywords={Filtering;Central Processing Unit;Filters;Protocols;Communication systems;Computer networks;Electronic mail;Storage area networks;HTTP;Internet;Retrieval-Augmented Generation;Large Language Models;Prompt Injection Defense;Post-Quantum Cryptography;Cybersecurity;Trust-Weighted Retrieval;FAISS;Vector Databases},
  doi={10.1109/SoutheastCon63549.2026.11476026},
  ISSN={1558-058X},
  month={Feb},}@INPROCEEDINGS{11468767,
  author={R, Nishmitha M and S, Tejakshi N and Sharma, Anshu and Kiran and M, Abhishek Gowda R and Karan},
  booktitle={2026 International Conference on Computing, Sciences and Communications (ICCSC)}, 
  title={PromptShield: LoRA-Based Parameter-Efficient Refusal Alignment for Election-Targeted Adversarial LLM Attacks}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large language models (LLMs) are increasingly deployed in public-facing information systems, where their misuse poses serious risks in high-stakes domains such as democratic elections. Despite extensive safety alignment, contemporary LLMs remain vulnerable to adversarial “jailbreak” prompting, enabling the generation of election-related misinformation, voter suppression narratives, and procedural manipulation. Recent election cycles have documented hundreds of verified instances of LLM-assisted disinformation campaigns, highlighting the urgent need for targeted, domain-specific defenses [1]–[3].We introduce PromptShield, a domain-specific, parameter-efficient refusal alignment approach based on Low-Rank Adaptation (LoRA) that strengthens LLM robustness against election-targeted jailbreak attacks. To support systematic training and evaluation, we present ElectionJailBench, a benchmark of $\mathbf{1 0, 0 0 0}$ synthetic adversarial prompts that combine election harm templates with diverse, state-of-the-art jailbreak strategies, including roleplaying, obfuscation, and optimization-based attacks [4]–[6]. PromptShield is trained via supervised fine-tuning on a 4-bit quantized Llama-3.1-8B-Instruct model and can be deployed in under one hour on commodity GPU hardware. Experimental results show a reduction in Attack Success Rate from $\mathbf{7 2. 0 \%}$ to $\mathbf{1 8. 0 \%}$ ($\mathbf{7 5 \%}$ relative improvement) on ElectionJailBench, while preserving general-purpose reasoning performance on the MMLU benchmark. Ablation studies further highlight the impact of dataset scale and LoRA rank on refusal robustness. Our findings demonstrate that lightweight, LoRAbased alignment can deliver effective, election-specific jailbreak resistance without incurring a measurable safety tax.},
  keywords={Feeds;Filtering;Feedback;Filters;Circuits;Recommender systems;Information filtering;Circuits and systems;LoRa;Deepfakes;Large Language Models;Adversarial Prompting;Jailbreak Defense;Election Misinformation;Parameter-Efficient Fine-Tuning;LoRA;Safety Alignment},
  doi={10.1109/ICCSC67078.2026.11468767},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11344243,
  author={Ding, Zi Han and Labrinidis, Alexandros},
  booktitle={2025 IEEE International Conference on Collaborative Advances in Software and COmputiNg (CASCON)}, 
  title={DaMiT-SQL: Detecting and Mitigating Text-to-SQL Prompt Injection Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={641-646},
  abstract={Large Language Models (LLMs) are known for their ability to understand and respond to human instructions/prompts. As such, LLMs can be used to produce natural language interfaces for databases. However, LLMs also have an attack surface that, if not properly secured, can cause serious damage. This paper aims to explore the possibilities of exploiting LLMs as an attack surface for SQL injection. The paper proposes a time- and cost-efficient approach to quickly detect malicious prompts by comparing the semantic similarity of the attack against a dedicated list of known patterns.},
  keywords={Databases;Large language models;Computational modeling;Semantics;Natural languages;Collaboration;SQL injection;Software;Hardware;Data models;security;text-to-sql injection;prompt injection;embeddings},
  doi={10.1109/CASCON66301.2025.00116},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11573507,
  author={Zhu, Wentian and Xiang, Zhen and Niu, Wei and Guan, Le},
  booktitle={2026 IEEE Symposium on Security and Privacy (SP)}, 
  title={MetaBreak: Jailbreaking Online LLM Services via Special Token Manipulation}, 
  year={2026},
  volume={},
  number={},
  pages={98-117},
  abstract={Unlike regular tokens derived from existing text corpora, special tokens are artificially created to annotate structured conversations during the fine-tuning process of Large Language Models (LLMs). Serving as metadata of training data, these tokens play a crucial role in instructing LLMs to generate coherent and context-aware responses. We demonstrate that special tokens can be exploited to construct four attack primitives, with which malicious users can reliably bypass the internal safety alignment of online LLM services and circumvent state-of-the-art (SOTA) external content moderation systems simultaneously. Moreover, we found that addressing this threat is challenging, as aggressive defense mechanisms-such as input sanitization by removing special tokens entirely, as suggested in academia-are less effective than anticipated. This is because such defense can be evaded when the special tokens are replaced by regular ones with high semantic similarity within the tokenizer's embedding space. We systemically evaluated our method, named MetaBreak, on both lab environment and commercial LLM platforms. Our approach achieves jailbreak rates comparable to SOTA prompt-engineering-based solutions when no content moderation is deployed. However, when there is content moderation, MetaBreak outperforms SOTA solutions PAP and GPTFuzzer by $\mathbf{1 1. 6} \boldsymbol{\%}$ and 34.8 %, respectively. Finally, since MetaBreak employs a fundamentally different strategy from prompt engineering, the two approaches can work synergistically. Notably, empowering MetaBreak on PAP and GPTFuzzer boosts jailbreak rates by $\mathbf{2 4. 3 \%}$ and $\mathbf{2 0. 2 \%}$, respectively.},
  keywords={Large language models;Modeling;Printing;Security;Context;Safety;Application programming interfaces;Automatic speech recognition;Turning;Prompt engineering},
  doi={10.1109/SP63933.2026.00095},
  ISSN={2375-1207},
  month={May},}@INPROCEEDINGS{10992559,
  author={Abdelnabi, Sahar and Fay, Aideen and Cherubin, Giovanni and Salem, Ahmed and Fritz, Mario and Paverd, Andrew},
  booktitle={2025 IEEE Conference on Secure and Trustworthy Machine Learning (SaTML)}, 
  title={Get My Drift? Catching LLM Task Drift with Activation Deltas}, 
  year={2025},
  volume={},
  number={},
  pages={43-67},
  abstract={Large Language Models (LLMs) are commonly used in retrieval-augmented applications to execute user instructions based on data from external sources. For example, modern search engines use LLMs to answer queries based on relevant search results; email plugins summarize emails by processing their content through an LLM. However, the potentially untrusted provenance of these data sources can lead to prompt injection attacks, where the LLM is manipulated by natural language instructions embedded in the external data, causing it to deviate from the user's original instruction(s). We define this deviation as task drift. Task drift is a significant concern as it allows attackers to exfiltrate data or influence the LLM's output for other users. We study LLM activations as a solution to detect task drift, showing that activation deltas - the difference in activations before and after processing external data - are strongly correlated with this phenomenon. Through two probing methods, we demonstrate that a simple linear classifier can detect drift with near-perfect ROC AUC on an out-of-distribution test set. We evaluate these methods by making minimal assumptions about how users' tasks, system prompts, and attacks can be phrased. We observe that this approach generalizes surprisingly well to unseen task domains, such as prompt injections, jailbreaks, and malicious instructions, without being trained on any of these attacks. Interestingly, the fact that this solution does not require any modifications to the LLM (e.g., fine-tuning), as well as its compatibility with existing meta-prompting solutions, makes it cost-efficient and easy to deploy. To encourage further research on activation-based task inspection, decoding, and interpretability, we release our large-scale TaskTracker toolkit, featuring a dataset of over 500K instances, representations from six SoTA language models, and a suite of inspection tools.},
  keywords={Soft sensors;Large language models;Natural languages;Machine learning;Inspection;Search engines;Decoding;TaskTracker;Prompt Injections;Task Drift},
  doi={10.1109/SaTML64287.2025.00011},
  ISSN={},
  month={April},}@INPROCEEDINGS{11327728,
  author={Shi, Tuo and Li, Danyang},
  booktitle={2025 International Conference on Advances in Electrical Engineering and Computer Applications (AEECA)}, 
  title={ACPO: An Automated Contextual Prompt Optimization Using the Snake Optimizer and Self-Feedback Mechanism}, 
  year={2025},
  volume={},
  number={},
  pages={827-833},
  abstract={Prompt-based learning has become a powerful strategy for adapting large language models (LLMs) to various natural language processing (NLP) tasks. However, manually crafting effective prompts remains labor-intensive and often suboptimal. To address this challenge, we propose Automated Contextual Prompt Optimization (ACPO)—a novel three-stage framework that integrates self-reflective feedback, Easy Data Augmentation (EDA), and heuristic search via a Snake Optimizer. Starting from a base prompt, ACPO iteratively improves task instructions by analyzing classification errors, generating diversified prompt variants, and adaptively searching the prompt space for optimal performance. Extensive experiments on three benchmark datasets—Ethos, Liar, and Jailbreak—demonstrate that ACPO significantly outperforms existing prompt optimization baselines such as ProTeGi, PromptBoosting, and APO in terms of F1-score, accuracy, and convergence stability. Moreover, ablation and base-model transfer experiments confirm the robustness and generalizability of ACPO under various model architectures. Our results highlight the potential of combining reflective generation, semantic augmentation, and biologically inspired optimization for automated prompt engineering.},
  keywords={Accuracy;Large language models;Text categorization;Semantics;Data augmentation;Stability analysis;Robustness;Prompt engineering;Iterative methods;Optimization;prompt optimization;large language models;text classification;snake optimizer;data augmentation;self-feedback learning},
  doi={10.1109/AEECA65693.2025.00150},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11008269,
  author={Brach, William and Petrik, Matej and Košt’ál, Kristián and Ries, Michal},
  booktitle={2025 37th Conference of Open Innovations Association (FRUCT)}, 
  title={Ghosts in the Markup: Techniques to Fight Large Language Model-Powered Web Scrapers}, 
  year={2025},
  volume={},
  number={},
  pages={37-46},
  abstract={The rise of large language models (LLMs) has revolutionized web scraping, creating new challenges for website owners seeking to protect valuable content. Traditional defenses such as CAPTCHAs and rate limiting are insufficient against sophisticated AI-driven scraping systems. Current state-of-the-art approaches primarily rely on server-side implementations requiring significant computational resources, IP-based blocking mechanisms, and complex pattern recognition systems that struggle to distinguish between legitimate users and advanced AI scrapers. This paper presents a two-step client-side defense strategy that combines content obfuscation and defensive prompt injection. Our approach dynamically alters HTML structure by wrapping characters in span elements with randomized content and strategic CSS rules while simultaneously injecting carefully crafted prompts designed to manipulate LLM extraction behavior. Experimental evaluation on three diverse datasets demonstrates the effectiveness of this combined approach, achieving near-zero extraction rates (0.6% Exact Match, 0.030 ROUGE-L) for structured content while maintaining a seamless user experience. Performance analysis shows that our method increases the HTML document file size by approximately 1773%, compared to over 6593% for alternative techniques such as Content Overload, providing a practical balance between security and usability while keeping rendering times comparable to unprotected pages. This lightweight implementation integrates seamlessly with existing Web infrastructure without requiring significant computational resources, addressing key limitations of server-side defenses while providing robust protection against unauthorized LLM-based content extraction. For further information, source code, and associated resources, please refer to the source code repository 1.},
  keywords={Source coding;Large language models;Rendering (computer graphics);User experience;HTML;Security;Resource management;Data mining;Protection;Wrapping},
  doi={10.23919/FRUCT65909.2025.11008269},
  ISSN={2305-7254},
  month={May},}@INPROCEEDINGS{11521941,
  author={Raj, Saravanan},
  booktitle={2026 International Conference on Multidisciplinary Innovations For Smart & Sustainable Future (MISSF)}, 
  title={A Secure Retrieval-Augmented LLM Framework for Cloud-Based Incident Response}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The response to a cloud incident is characterized by the need to make fast decisions and maintain evidentiary integrity, tenant isolation, and adherence to policies. In this paper, the authors introduce SRAG-IR, a secure retrievalaugmented LLM framework governing an incident response on the cloud that interconnects a controlled evidence lake and an attested retrieval and action layer. SRAG-IR builds a timeindexed part of incident memory over logs, alerts, tickets, and certified threat intelligence and determines only those fragments that are policy authorized through attribute-based access control and tenant-bound vector indices. A context firewall removes untrusted instructions in text accessed and enforces schema constrained prompts to minimize prompt injection and data exfiltration. Chunks of evidence are hash-chained and signed and produce verifiable cites and auditable respondent provenance. To have containment and recovery, sandboxed tool broker runs approved cloud actions as per playbook templates, producing change plans and rollback hints. The design enhances trust, privacy, and operational safety and does not need model retraining with multi-tenant production clouds. Dual retrieval integrates semantic search and asset-dependency graphs allowing root-cause hypothesis and prioritized triage suggestions should there be strict latency and cost budget limits.},
  keywords={Modeling;Clouds;Equations;Security;Large language models;Cognition;Cognitive systems;Printing;Machine learning;Signal detection;Retrieval-Augmented Generation;Large Language Models;Cloud Incident Response;Secure AI;Evidence Governance;Zero-Trust Retrieval},
  doi={10.1109/MISSF68264.2026.11521941},
  ISSN={},
  month={April},}@INPROCEEDINGS{11463376,
  author={Zhong, Qidi and Liu, Siyang and Liu, Jiani and Pan, Kaikai and Cheng, Yushi and Xu, Wenyuan},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={IPI2: Mitigating Indirect Prompt Injections on Unmanned Aerial Vehicle Agents Using Physical Invariants}, 
  year={2026},
  volume={},
  number={},
  pages={14042-14046},
  abstract={Large language model (LLM)-powered unmanned aerial vehicle (UAV) agents enable natural human–machine interaction, broadening UAV applications in complex scenarios. However, these agents are vulnerable to indirect prompt injection (IPI) attacks, where adversaries exploit untrusted external data sources (e.g., corrupted knowledge bases) to redirect LLMs from legitimate instructions toward malicious ones. Existing defenses either rely on keyword filters or auxiliary LLMs, which are often computationally costly and insufficiently robust. In this paper, we present IPI2, a defense framework that mitigates IPI attacks by leveraging UAVs’ physical invariant properties. Our key insight is that, despite the diversity of UAV tasks and attack strategies, benign UAV logs consistently exhibit stable invariant patterns. IPI2 profiles these distributions from benign data and performs similarity analysis using Kullback–Leibler divergence to detect anomalies indicative of IPI corruption. Extensive experiments across 2 UAV agents, 3 tasks, 4 LLMs, and 5 attack types demonstrate that IPI2 achieves a 68.3% reduction (92.0%→23.7%) in average attack success rate. We further show that IPI2 remains robust against adaptive adversaries.},
  keywords={Filtering;Filters;Circuits and systems;Internet of Things;Communication systems;Internet;Internet of Vehicles;Protocols;Radio access networks;HTTP;LLM-integrated UAV Agents;Prompt Injection Attack;Physical Invariants},
  doi={10.1109/ICASSP55912.2026.11463376},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11497307,
  author={Bajaj, Sajal and Dutta, Kamlesh},
  booktitle={2026 IEEE International Conference on AI Engineering and Innovations (AIEI)}, 
  title={Parallel Hybrid Classical-Quantum Architecture for AI Safety and LLM Jailbreak Detection}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large language models (LLMs) are increasingly vulnerable to adversarial "jailbreak" attacks designed to elude safety and privacy controls. Detection is still a challenging task due to the complexity of adversarial prompts and labeled data scarcity. While fine-tuning a traditional Transformer model, such as BERT and its variants, provides strong backbone results with frequently limited recall of complex edge cases, it often comes with extensive computational costs. This work proposes a parallel hybrid classical-quantum architecture. Unlike previous serial approaches which constraint information through a quantum circuit, the proposed model uses an ensemble of a classical multilayer perceptron and a data re-uploading quantum circuit, working in parallel on top of a partially unfrozen BERT backbone. Results on the Jailbreak Classification task show that this indeed provides promising results by serving as a residual correction mechanism. The proposed parallel model achieves an F1-score of 0.911 and an accuracy of 0.910, outperforming the fully fine-tuned classical BERT baseline by over 3%. Apart from the hybrid model, several Serial Variational Quantum Circuit (VQC) arrangements have been considered. These lightweight quantum-only classifiers achieve results comparable to the classical baseline across various metrics by only using a few thousand trainable parameters and operating on heavily compressed BERT embeddings. What is more important is that this emphasizes the fact that compact quantum circuits can outline meaningful decision boundaries under extreme dimensionality constraints. Therefore, such quantum components can reinforce the efficiency and scalability perspective as modules for the safety-focused monitoring of LLMs systems.},
  keywords={Feeds;Antennas;Circuits;Filtering;Quantum circuit;Filters;Circuits and systems;Feedback;Quantum circuit;Quantum communication;LLM safety;jailbreak detection;quantum machine learning;hybrid classical-quantum models;BERT;variational quantum circuits},
  doi={10.1109/AIEI69164.2026.11497307},
  ISSN={},
  month={March},}@INPROCEEDINGS{11420779,
  author={Laczi, Szandra Anna and Póser, Valéria},
  booktitle={2026 IEEE 24th World Symposium on Applied Machine Intelligence and Informatics (SAMI)}, 
  title={Exploiting Generative AI: How Children Bypass Safety Filters with Prompt Injection}, 
  year={2026},
  volume={},
  number={},
  pages={000053-000058},
  abstract={Generative AI systems are increasingly used by children, raising new safety and security challenges. While jailbreak and prompt injection techniques have been extensively documented among adult users, little is known about how similar attack mechanisms may appear in child-language interactions. This paper presents a taxonomy-based theoretical framework for systematically mapping adult jailbreak strategies to child-language adaptations. We collected 20 representative adult jailbreak techniques from scientific and community sources, categorized them using established adult taxonomies, and transformed them into child-language variants through a structured linguistic–pragmatic rule set. Our analysis suggests conceptual shifts in surface structure: while meta-prompt and roleplay dominate adult attacks, indirect requests and playful role assignments become prevalent in child-language adaptations. These linguistic transformations preserve the functional attack logic but may reduce detectability by current safety classifiers, which are typically trained on adult-like formulations. The findings highlight a critical gap in existing red teaming and evaluation practices and underline the need to explicitly include child-language variations in safety testing pipelines.},
  keywords={Systematics;Generative AI;Taxonomy;Pipelines;Surface structures;Safety;Security;Logic;Pragmatics;Testing;jailbreak attacks;prompt injection;child-language;generative AI security;safety classifiers;red teaming;taxonomy-based evaluation},
  doi={10.1109/SAMI68106.2026.11420779},
  ISSN={2767-9438},
  month={Jan},}@INPROCEEDINGS{11579902,
  author={Ghouil, Chaima and Aloui, Radhoine and Khalfaoui, Nejib and Mhatli, Sofien and Aldalbahi, Adel and Garro, Ignacio Llamas},
  booktitle={2026 International Wireless Communications and Mobile Computing (IWCMC)}, 
  title={A Comprehensive Framework for Secure Multi-Agent Retrieval-Augmented Generation Systems}, 
  year={2026},
  volume={},
  number={},
  pages={225-231},
  abstract={This paper presents a comprehensive framework for securing Retrieval-Augmented Generation (RAG) systems in multi-agent environments. We introduce two complementary architectures: the Secure RAG Framework (SecRAG) for layered defense mechanisms and the Secure Multi-Agent RAG Simulator (SMARS) for systematic security evaluation. Our framework addresses critical vulnerabilities including prompt injection, data poisoning, and coordinated attacks through quantitative risk assessment and mitigation strategies. Experimental results demonstrate that our hybrid defense approach reduces attack success rates by up to 89% while maintaining system performance within acceptable thresholds. The proposed framework provides a holistic solution for securing complex multi-agent RAG systems in real-world deployments.},
  keywords={Retrieval augmented generation;Security;Modeling;Printing;Simulation;Measurement;Multi-agent systems;Risk management;Architecture;Computer architecture;Multi-Agent Systems;Retrieval-Augmented Generation;RAG Security;Cybersecurity;Adversarial Attacks;Simulation Framework},
  doi={10.1109/IWCMC69287.2026.11579902},
  ISSN={2376-6506},
  month={June},}@INPROCEEDINGS{11463457,
  author={Yang, Xikang and Tang, Xuehai and Han, Jizhong and Hu, Songlin},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={DarkCite: Unveiling Authority Bias as Implicit Rag Jailbreak Attacks}, 
  year={2026},
  volume={},
  number={},
  pages={13402-13406},
  abstract={This paper reveals a critical and underexplored vulnerability in the safety alignment of Large Language Models (LLMs): an inherent bias toward authoritative information. We demonstrate that this authority bias can be exploited to bypass safety filters, transforming a beneficial model feature into a significant flaw. We hypothesize and show that this attack vector functions as a form of Implicit Retrieval-Augmented Generation (RAG), where a fabricated citation prompts the model to internally retrieve and surface harmful knowledge, bypassing typical safeguards. To systematize this exploit, we introduce DarkCite, a black-box jailbreak framework that adaptively matches risk types with optimal citation styles to generate potent adversarial prompts. Our experiments show DarkCite achieves a state-of-the-art Attack Success Rate (ASR), reaching 63% on average and outperforming prior methods across a range of models. To address this, we propose a practical defense based on authenticity and harm verification, which elevates the average Defense Pass Rate (DPR) from a mere 11% to 74%. Our code is available at https://github.com/YancyKahn/DarkCite},
  keywords={Weapons;Feeds;Filtering;Filters;Feedback;Circuits;Circuits and systems;Protocols;HTTP;Internet;Jailbreak;LLM Safety;Cognitive Bias},
  doi={10.1109/ICASSP55912.2026.11463457},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11565414,
  author={Gudipuri, Nithesh},
  booktitle={2026 International Conference on Integrated Intelligence and Cognitive Engineering (ICIICE)}, 
  title={Enterprise Search Portals: Hybrid RAG at Scale for Compliance-Sensitive Knowledge Work}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Enterprise search portals are starting to use large language models to produce direct answers, but regulated advisor workflows need stricter controls than normal chat systems. The system must be fast, must not leak restricted content, and must produce outputs that can be audited. This paper presents a policy-first Hybrid Retrieval-Augmented Generation (RAG) architecture for enterprise portals at scale. The design combines lexical retrieval (BM25) and dense vector retrieval, enforces access control before any text reaches reranking or generation, fuses rankings using Reciprocal Rank Fusion, and generates answers only from an evidence pack with required citations. We describe the end-to-end architecture, threat model, and security controls for prompt injection and retriever poisoning, along with an evaluation scorecard that reports retrieval quality, answer grounding, hallucination rate, audit coverage, and latency. Experiments on compliance-focused enterprise QA benchmarks show that the proposed approach improves Recall@K and answer accuracy while reducing hallucinations and achieving full audit trace coverage.},
  keywords={Retrieval augmented generation;Modeling;Printing;Ranking (statistics);Portals;Labeling;Indexing;Indexes;NIST;Filtering;enterprise search;retrieval-augmented generation;hybrid retrieval;compliance;audit logging;vector databases},
